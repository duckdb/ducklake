# name: ${FILE_PATH}
# description: ${DESCRIPTION}
# group: [sf1]

argument sf 1

name DuckLake Q${QUERY_NUMBER_PADDED}
group tpch
subgroup sf${sf}

require ducklake

require parquet

require tpch

cache_file tpch_sf${sf}_ducklake_ready.marker

load
ATTACH ':memory:' AS mem;
USE mem;
CALL dbgen(sf=${sf});
@create tpch_sf${sf}_ducklake
@attach tpch_sf${sf}_ducklake AS ducklake (DATA_PATH '${BENCHMARK_DIR}/tpch_sf${sf}_ducklake_files')
COPY FROM DATABASE mem TO ducklake;
USE memory;
DETACH mem;
CALL ducklake_delete_orphaned_files('ducklake', cleanup_all => true);
DETACH ducklake;
@seal tpch_sf${sf}_ducklake
COPY (SELECT 1) TO '${BENCHMARK_DIR}/tpch_sf${sf}_ducklake_ready.marker' (FORMAT CSV);
@attach tpch_sf${sf}_ducklake AS ducklake
USE ducklake;

reload
@attach tpch_sf${sf}_ducklake AS ducklake
USE ducklake;

run duckdb/extension/tpch/dbgen/queries/q${QUERY_NUMBER_PADDED}.sql

result duckdb/extension/tpch/dbgen/answers/sf1/q${QUERY_NUMBER_PADDED}.csv sf=1

result duckdb/extension/tpch/dbgen/answers/sf100/q${QUERY_NUMBER_PADDED}.csv sf=100
