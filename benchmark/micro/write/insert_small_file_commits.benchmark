# name: benchmark/micro/write/insert_small_file_commits.benchmark
# description: Commit 100 files in separate ten-row transactions
# group: [write]

name Insert Small File Commits
group micro
subgroup write

require ducklake

require parquet

argument lake insert_small_file_commits

argument work insert_small_file_commits_work

include benchmark/micro/fixtures/metadata_commit.benchmark.in

include benchmark/micro/fixtures/restore_cleanup.benchmark.in

run
INSERT INTO lake.t SELECT 0, i, i / 7.0, 'row-' || i, TIMESTAMP '2026-01-01' + to_seconds(i) FROM range(0, 10) r(i);
