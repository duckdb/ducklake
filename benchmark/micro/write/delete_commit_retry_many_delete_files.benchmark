# name: benchmark/micro/write/delete_commit_retry_many_delete_files.benchmark
# description: Commit a delete of 11 more rows from each of 4096 files with a delete file after a concurrent flush, so the retry dates the new deletes of every delete file again
# group: [write]

name Delete Commit Retry Many Delete Files
group micro
subgroup write

require ducklake

require parquet

argument work delete_commit_retry_many_work

include benchmark/micro/fixtures/delete_files.benchmark.in

include benchmark/micro/fixtures/restore_cleanup.benchmark.in

# Retries do not sleep, so the timing has no random backoff
init
SET ducklake_retry_wait_ms = 0;

# lake2 shares the metadata catalog of lake and commits first, so the delete retries and rewrites every delete file
run
@attach ${work} AS lake2 (METADATA_CATALOG '__ducklake_metadata_lake')
BEGIN; DELETE FROM lake.bg WHERE id % 2048 BETWEEN 1 AND 11; CALL ducklake_flush_inlined_data('lake2', table_name => 't_0'); COMMIT;
DETACH lake2;

# A missed reset leaves the rows deleted already, so the counts would differ
result_query III
SELECT (SELECT count(*) FROM lake.snapshots()), (SELECT count(*) FROM lake.bg),
(SELECT count(*) FROM __ducklake_metadata_lake.ducklake_delete_file WHERE delete_count = 12)
----
7	8339456	4096
