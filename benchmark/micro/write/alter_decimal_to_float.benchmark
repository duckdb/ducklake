# name: benchmark/micro/write/alter_decimal_to_float.benchmark
# description: Retype a DECIMAL column with a scale stored in ~1024 files to FLOAT, which reads every value
# group: [write]

name Alter Decimal To Float
group micro
subgroup write

require ducklake

require parquet

argument work decimal_to_float_work

include benchmark/micro/fixtures/decimal_files.benchmark.in

include benchmark/micro/fixtures/restore_cleanup.benchmark.in

# Every run starts from the pristine DECIMAL column
assert III
SELECT (SELECT data_type FROM duckdb_columns() WHERE database_name = 'lake' AND column_name = 'd'),
(SELECT count(*) FROM lake.events), (SELECT max(snapshot_id) FROM lake.snapshots())
----
DECIMAL(9,1)	2097152	2

run
ALTER TABLE lake.events ALTER COLUMN d TYPE FLOAT;

result_query III
SELECT (SELECT data_type FROM duckdb_columns() WHERE database_name = 'lake' AND column_name = 'd'),
(SELECT count(*) FROM lake.events), (SELECT max(snapshot_id) FROM lake.snapshots())
----
FLOAT	2097152	3
