# name: benchmark/micro/fixtures/tpch05.benchmark.in
# description: TPC-H SF0.5 source database, an empty ctas lake and a dml lake with lineitem in 8MB files
# group: [fixtures]

cache_file tpch05_ready.marker

# The consumer picks the restored lake (ctas or dml) and its work copy with the lake and work arguments
load
COPY (SELECT 1 AS part, 1 AS v) TO '${BENCHMARK_DIR}/tpch05_blank'
(FORMAT CSV, PARTITION_BY (part), OVERWRITE);
ATTACH '${BENCHMARK_DIR}/tpch05_blank/blank.db' AS blank;
DETACH blank;
COPY (SELECT content FROM read_blob('${BENCHMARK_DIR}/tpch05_blank/blank.db'))
TO '${BENCHMARK_DIR}/tpch05_src.duckdb' (FORMAT blob);
COPY (SELECT ''::BLOB AS content) TO '${BENCHMARK_DIR}/tpch05_src.duckdb.wal' (FORMAT blob);
ATTACH '${BENCHMARK_DIR}/tpch05_src.duckdb' AS src;
CALL dbgen(sf=0.5, catalog='src');
@create ctas_pristine
@attach ctas_pristine AS lake (DATA_PATH '${BENCHMARK_DIR}/ctas_files')
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
DETACH lake;
@create dml_pristine
@attach dml_pristine AS lake (DATA_PATH '${BENCHMARK_DIR}/dml_files')
CALL lake.set_option('target_file_size', '8MB');
CREATE TABLE lake.lineitem AS FROM src.lineitem;
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
DETACH lake;
DETACH src;
COPY (SELECT count(*) FROM glob('${BENCHMARK_DIR}/ctas_files/**'))
TO '${BENCHMARK_DIR}/ctas_filecount.csv' (FORMAT CSV, HEADER false);
COPY (SELECT count(*) FROM glob('${BENCHMARK_DIR}/dml_files/**'))
TO '${BENCHMARK_DIR}/dml_filecount.csv' (FORMAT CSV, HEADER false);
@seal ctas_pristine
@seal dml_pristine
COPY (SELECT 1) TO '${BENCHMARK_DIR}/tpch05_ready.marker' (FORMAT CSV);
DETACH DATABASE IF EXISTS lake;
@copy ${lake}_pristine TO ${work}
@attach ${work} AS lake
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
SELECT CASE WHEN (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**'))
<> (SELECT column0 FROM read_csv('${BENCHMARK_DIR}/${lake}_filecount.csv', header = false))
THEN error('the fixture files were not restored') END;
ATTACH IF NOT EXISTS '${BENCHMARK_DIR}/tpch05_src.duckdb' AS src (READ_ONLY);

# The restore_reload block plus the read-only source database, which the restore cleanup leaves attached
reload
DETACH DATABASE IF EXISTS lake;
@copy ${lake}_pristine TO ${work}
@attach ${work} AS lake
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
SELECT CASE WHEN (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**'))
<> (SELECT column0 FROM read_csv('${BENCHMARK_DIR}/${lake}_filecount.csv', header = false))
THEN error('the fixture files were not restored') END;
ATTACH IF NOT EXISTS '${BENCHMARK_DIR}/tpch05_src.duckdb' AS src (READ_ONLY);
