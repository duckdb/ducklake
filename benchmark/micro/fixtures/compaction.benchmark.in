# name: benchmark/micro/fixtures/compaction.benchmark.in
# description: Lake with 1000 small files in frag and 500 small files with positional deletes in rw
# group: [fixtures]

argument lake compaction

cache_file compaction_ready.marker

# Row group size 2048 and a 16KB target give one file per 2048 rows
load
ATTACH 'ducklake:${BENCHMARK_DIR}/compaction_pristine.db' AS lake (DATA_PATH '${BENCHMARK_DIR}/compaction_files');
CALL lake.set_option('data_inlining_row_limit', 0);
CREATE TABLE lake.frag (id BIGINT, k INTEGER, s VARCHAR);
CREATE TABLE lake.rw (id BIGINT, k INTEGER, s VARCHAR);
CALL lake.set_option('parquet_row_group_size', 2048, table_name => 'frag');
CALL lake.set_option('parquet_row_group_size', 2048, table_name => 'rw');
SET ducklake_target_file_size = '16KB';
INSERT INTO lake.frag SELECT i, hash(i) % 1000, 'value_' || i FROM range(2048000) t(i);
INSERT INTO lake.rw SELECT i, hash(i) % 1000, 'value_' || i FROM range(1024000) t(i);
RESET ducklake_target_file_size;
DELETE FROM lake.rw WHERE id % 100 < 60;
CALL lake.set_option('parquet_row_group_size', 122880, table_name => 'frag');
CALL lake.set_option('parquet_row_group_size', 122880, table_name => 'rw');
DETACH lake;
COPY (SELECT count(*) FROM glob('${BENCHMARK_DIR}/compaction_files/**'))
TO '${BENCHMARK_DIR}/compaction_filecount.csv' (FORMAT CSV, HEADER false);
COPY (SELECT 1) TO '${BENCHMARK_DIR}/compaction_ready.marker' (FORMAT CSV);
DETACH DATABASE IF EXISTS lake;
COPY (SELECT content FROM read_blob('${BENCHMARK_DIR}/${lake}_pristine.db')) TO '${BENCHMARK_DIR}/${work}.db' (FORMAT blob);
ATTACH 'ducklake:${BENCHMARK_DIR}/${work}.db' AS lake;
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
SELECT CASE WHEN (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**')) <> (SELECT column0 FROM read_csv('${BENCHMARK_DIR}/${lake}_filecount.csv', header = false)) THEN error('the fixture files were not restored') END;

include benchmark/micro/fixtures/rblob_reload.benchmark.in
