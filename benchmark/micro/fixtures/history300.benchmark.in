# name: benchmark/micro/fixtures/history300.benchmark.in
# description: A 1M-row table with 300 generated insert, delete, update and add-column commits, attached read-only
# group: [fixtures]

cache_file history300_ready.marker

# Iteration k commits snapshot k + 3, and snapshots 100 and 200 resolve ts_a and ts_b
load
@create history300
@attach history300 AS lake (DATA_PATH '${BENCHMARK_DIR}/history300_files', DATA_INLINING_ROW_LIMIT 0)
CREATE TABLE lake.events (id BIGINT, g INTEGER, v VARCHAR, x DOUBLE);
INSERT INTO lake.events SELECT i, i % 100, 'v' || i, i * 0.5 FROM range(1000000) t(i);
BEGIN;
@for k in range(300)
@if k % 50 == 49
ALTER TABLE lake.events ADD COLUMN c@{k} INTEGER DEFAULT @{k};
@end
@if k % 50 != 49 and k % 3 == 0
INSERT INTO lake.events (id, g, v, x) SELECT i, i % 100, 'v' || i, i * 0.5
FROM range(1000000 + @{k} * 1000, 1000000 + (@{k} + 1) * 1000) t(i);
@end
@if k % 50 != 49 and k % 3 == 1
DELETE FROM lake.events WHERE id < 1000000 AND id % 1000 = @{k};
@end
@if k % 50 != 49 and k % 3 == 2
UPDATE lake.events SET x = x + 1 WHERE id % 2000 = @{k};
@end
COMMIT; BEGIN;
@end
COMMIT;
SELECT CASE WHEN (SELECT count(*) <> 303 OR max(schema_version) <> 7 FROM lake.snapshots())
THEN error('history300: expected 303 snapshots and 7 schema versions') END;
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
DETACH lake;
@seal history300
COPY (SELECT 1) TO '${BENCHMARK_DIR}/history300_ready.marker' (FORMAT CSV);
@attach history300 AS lake (READ_ONLY)
SET VARIABLE ts_a = (SELECT snapshot_time FROM lake.snapshots() WHERE snapshot_id = 100);
SET VARIABLE ts_b = (SELECT snapshot_time FROM lake.snapshots() WHERE snapshot_id = 200);

reload
@attach history300 AS lake (READ_ONLY)
SET VARIABLE ts_a = (SELECT snapshot_time FROM lake.snapshots() WHERE snapshot_id = 100);
SET VARIABLE ts_b = (SELECT snapshot_time FROM lake.snapshots() WHERE snapshot_id = 200);
