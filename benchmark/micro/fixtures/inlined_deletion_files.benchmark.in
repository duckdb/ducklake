# name: benchmark/micro/fixtures/inlined_deletion_files.benchmark.in
# description: A lake with a table of 10000 partition files that each have one inlined deletion, restored before every run
# group: [fixtures]

argument lake inlined_deletion_files

cache_file ${lake}_ready.marker

load
@create ${lake}_pristine
@attach ${lake}_pristine AS lake (DATA_PATH '${BENCHMARK_DIR}/${lake}_files')
CALL lake.set_option('data_inlining_row_limit', 1);
CREATE TABLE lake.t (id INTEGER, p INTEGER);
ALTER TABLE lake.t SET PARTITIONED BY (p);
INSERT INTO lake.t SELECT i, i % 10000 FROM range(200000) t(i);
DELETE FROM lake.t WHERE id < 10000;
SELECT CASE WHEN (SELECT count(*) FROM ducklake_list_files('lake', 't')) <> 10000
OR (SELECT count(*) FROM ducklake_list_files('lake', 't') WHERE delete_file IS NOT NULL) <> 0
THEN error('t must consist of 10000 files with inlined deletions') END;
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
DETACH lake;
COPY (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**'))
TO '${BENCHMARK_DIR}/${lake}_filecount.csv' (FORMAT CSV, HEADER false);
@seal ${lake}_pristine
COPY (SELECT 1) TO '${BENCHMARK_DIR}/${lake}_ready.marker' (FORMAT CSV);
DETACH DATABASE IF EXISTS lake;
@copy ${lake}_pristine TO ${work}
@attach ${work} AS lake
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
SELECT CASE WHEN (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**'))
<> (SELECT column0 FROM read_csv('${BENCHMARK_DIR}/${lake}_filecount.csv', header = false))
THEN error('the fixture files were not restored') END;

include benchmark/micro/fixtures/restore_reload.benchmark.in
