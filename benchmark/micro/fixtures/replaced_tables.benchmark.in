# name: benchmark/micro/fixtures/replaced_tables.benchmark.in
# description: Lake with 10 tables replaced in 50 rounds of CREATE OR REPLACE, so 500 dropped table versions keep a file each
# group: [fixtures]

argument lake replaced_tables

cache_file ${lake}_ready.marker

# Every round replaces all 10 tables in one commit, and each replacement gives its table a new id
load
@create ${lake}_pristine
@attach ${lake}_pristine AS lake (DATA_PATH '${BENCHMARK_DIR}/${lake}_files', DATA_INLINING_ROW_LIMIT 0)
BEGIN;
@for t in range(10)
CREATE TABLE lake.t@{t} AS SELECT range AS v FROM range(10);
@end
COMMIT;
@for r in range(50)
BEGIN;
@for t in range(10)
CREATE OR REPLACE TABLE lake.t@{t} AS SELECT range + @{r} AS v FROM range(10);
@end
COMMIT;
@end
SELECT CASE WHEN (SELECT count(*) FROM lake.snapshots()) <> 52
OR (SELECT count(*) FROM __ducklake_metadata_lake.ducklake_table WHERE end_snapshot IS NOT NULL) <> 500
THEN error('replaced_tables: expected 52 snapshots and 500 dropped table versions') END;
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
DETACH lake;
COPY (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**'))
TO '${BENCHMARK_DIR}/${lake}_filecount.csv' (FORMAT CSV, HEADER false);
@seal ${lake}_pristine
COPY (SELECT 1) TO '${BENCHMARK_DIR}/${lake}_ready.marker' (FORMAT CSV);
DETACH DATABASE IF EXISTS lake;
@copy ${lake}_pristine TO ${work}
@attach ${work} AS lake
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
SELECT CASE WHEN (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**'))
<> (SELECT column0 FROM read_csv('${BENCHMARK_DIR}/${lake}_filecount.csv', header = false))
THEN error('the fixture files were not restored') END;

include benchmark/micro/fixtures/restore_reload.benchmark.in
