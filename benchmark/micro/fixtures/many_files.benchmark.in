# name: benchmark/micro/fixtures/many_files.benchmark.in
# description: Read-only lake with ~4096 small files with disjoint id, timestamp and string ranges
# group: [fixtures]

cache_file many_files_ready.marker

# events holds disjoint id/ts/s ranges per 2048-row file
load
@create many_files
@attach many_files AS lake (DATA_PATH '${BENCHMARK_DIR}/many_files_data')
CREATE TABLE lake.events (id BIGINT, ts TIMESTAMP, grp INTEGER, val DOUBLE, s VARCHAR);
CALL lake.set_option('parquet_row_group_size', 2048, table_name => 'events');
SET ducklake_target_file_size = '4KB';
INSERT INTO lake.events
SELECT i, TIMESTAMP '2024-01-01' + INTERVAL (i) SECOND, i % 100, i * 0.5, printf('v%07d', i)
FROM range(4096 * 2048) t(i);
RESET ducklake_target_file_size;
SELECT CASE WHEN (SELECT count(*) FROM ducklake_list_files('lake', 'events')) < 4000
THEN error('events must consist of ~4096 small files') END;
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
DETACH lake;
@seal many_files
COPY (SELECT 1) TO '${BENCHMARK_DIR}/many_files_ready.marker' (FORMAT CSV);
@attach many_files AS lake (READ_ONLY)

reload
@attach many_files AS lake (READ_ONLY)
