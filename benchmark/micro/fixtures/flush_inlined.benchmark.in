# name: benchmark/micro/fixtures/flush_inlined.benchmark.in
# description: Forty inlined tables and ten file-backed tables with both Parquet and inlined deletions
# group: [fixtures]

argument lake flush_inlined_v2

cache_file ${lake}_ready.marker

# Per-table checks of current and historical contents, run during validation
init
SET VARIABLE flush_checks = (SELECT string_agg(stmt, ' UNION ALL ' ORDER BY o, k, version) FROM (
SELECT 0 AS o, k, version, 'SELECT count(*) = 100 AND sum(id) = 4950 AND sum(v) = ' || (14850 + 100 * k)
|| ' AS valid FROM lake.i' || k || version AS stmt
FROM range(40) t(k), (VALUES (''), (' AT (VERSION => 1)')) v(version)
UNION ALL
SELECT 1, k, version, 'SELECT count(*) = ' || (hi - lo) || ' AND sum(id) = ' || ((hi * (hi - 1) - lo * (lo - 1)) // 2)
|| ' AND sum(v) = ' || (3 * ((hi * (hi - 1) - lo * (lo - 1)) // 2) + k * (hi - lo)) || ' FROM lake.f' || k || version
FROM (SELECT k, version, CASE WHEN version IN ('', ' AT (VERSION => 3)') THEN 5 + k ELSE 0 END AS lo,
CASE WHEN version = ' AT (VERSION => 1)' THEN 1000 ELSE 850 - k END AS hi
FROM range(10) t(k), (VALUES (''), (' AT (VERSION => 3)'), (' AT (VERSION => 2)'), (' AT (VERSION => 1)')) v(version))
));

# Three import transactions create the data, Parquet deletions, then inlined deletions; every table differs by k
load
EXPORT DATABASE '${BENCHMARK_DIR}/${lake}_gen';
COPY (SELECT stmt FROM (
SELECT 0 AS o, k, 'CREATE TABLE lake.i' || k
|| ' AS SELECT r AS id, r * 3 + ' || k || ' AS v FROM range(100) t(r);' AS stmt FROM range(40) t(k)
UNION ALL
SELECT 1, k, 'CREATE TABLE lake.f' || k
|| ' AS SELECT r AS id, r * 3 + ' || k || ' AS v FROM range(1000) t(r);' FROM range(10) t(k)
UNION ALL
SELECT 2, 0, 'COMMIT; BEGIN;'
UNION ALL
SELECT 3, k, 'DELETE FROM lake.f' || k || ' WHERE id >= ' || (850 - k) || ';' FROM range(10) t(k)
UNION ALL
SELECT 4, 0, 'COMMIT; BEGIN;'
UNION ALL
SELECT 5, k, 'DELETE FROM lake.f' || k || ' WHERE id < ' || (5 + k) || ';' FROM range(10) t(k)
) ORDER BY o, k) TO '${BENCHMARK_DIR}/${lake}_gen/schema.sql' (HEADER false, QUOTE '');
@create ${lake}_pristine
@attach ${lake}_pristine AS lake (DATA_PATH '${BENCHMARK_DIR}/${lake}_files')
CALL lake.set_option('data_inlining_row_limit', 100);
IMPORT DATABASE '${BENCHMARK_DIR}/${lake}_gen';
SET VARIABLE flush_delete_tables = (SELECT list('__ducklake_metadata_lake.ducklake_inlined_delete_' || table_id)
FROM __ducklake_metadata_lake.ducklake_table WHERE table_name LIKE 'f%');
SELECT CASE WHEN (SELECT count(*) <> 4 OR max(snapshot_id) <> 3 FROM lake.snapshots())
OR (SELECT count(*) <> 10 FROM __ducklake_metadata_lake.ducklake_data_file WHERE end_snapshot IS NULL)
OR (SELECT count(*) <> 10 OR sum(delete_count) <> 1545
FROM __ducklake_metadata_lake.ducklake_delete_file WHERE end_snapshot IS NULL)
OR (SELECT count(*) <> 95 FROM query_table(getvariable('flush_delete_tables')))
OR (SELECT NOT bool_and(valid IS TRUE) FROM query(getvariable('flush_checks')))
THEN error('unexpected inlined flush fixture') END;
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
DETACH lake;
COPY (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**'))
TO '${BENCHMARK_DIR}/${lake}_filecount.csv' (FORMAT CSV, HEADER false);
@seal ${lake}_pristine
COPY (SELECT 1) TO '${BENCHMARK_DIR}/${lake}_ready.marker' (FORMAT CSV);
DETACH DATABASE IF EXISTS lake;
@copy ${lake}_pristine TO ${work}
@attach ${work} AS lake
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
SELECT CASE WHEN (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**'))
<> (SELECT column0 FROM read_csv('${BENCHMARK_DIR}/${lake}_filecount.csv', header = false))
THEN error('the fixture files were not restored') END;

include benchmark/micro/fixtures/restore_reload.benchmark.in
