# name: benchmark/micro/time_travel/at_version_local_changes.benchmark
# description: Nineteen AT (VERSION) scans in a transaction that inserted and deleted rows, rolled back after each run
# group: [time_travel]

name At Version Local Changes
group micro
subgroup time_travel

require ducklake

require parquet

argument work at_local_work

include benchmark/micro/fixtures/snap1000.benchmark.in

# The local rows of m are deleted again, so the AT scans give the same results whether they read them or not
run benchmark/micro/queries/at_version_local_changes.sql

# The rollback discards the local rows of t, so a missed reset doubles them in the next run
cleanup
@rollback ${lake}_pristine TO ${work}

result III
