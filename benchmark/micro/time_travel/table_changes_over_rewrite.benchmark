# name: benchmark/micro/time_travel/table_changes_over_rewrite.benchmark
# description: Three table_changes windows that contain the rewrite of all files of a table, warm catalog
# group: [time_travel]

name Table Changes Over Rewrite
group micro
subgroup time_travel

require ducklake

include benchmark/micro/fixtures/rewritten_history.benchmark.in

# The run is read-only, so the catalog stays attached and warm between runs
run
SELECT w, change_type, count(*) AS cnt, sum(v) AS sum_v FROM (
SELECT 'all' AS w, change_type, v FROM lake.table_changes('t', 2, 32)
UNION ALL SELECT 'around', change_type, v FROM lake.table_changes('t', 20, 24)
UNION ALL SELECT 'rewrite', change_type, v FROM lake.table_changes('t', 22, 22)
) GROUP BY ALL ORDER BY ALL;

result IIII
all	delete	20000	999590000
all	insert	100000	4999950000
around	delete	4000	199918000
