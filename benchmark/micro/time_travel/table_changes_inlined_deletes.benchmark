# name: benchmark/micro/time_travel/table_changes_inlined_deletes.benchmark
# description: Four table_changes windows over a table whose deletions are inlined, warm catalog like a CDC consumer
# group: [time_travel]

name Table Changes Inlined Deletes
group micro
subgroup time_travel

require ducklake

include benchmark/micro/fixtures/inlined_deletes_history.benchmark.in

# The run is read-only, so the catalog stays attached and warm between runs
run
SELECT w, change_type, count(*) AS cnt, sum(x) AS sum_x FROM (
SELECT 'w201' AS w, change_type, x FROM lake.table_changes('events', 201, 201)
UNION ALL SELECT 'w200', change_type, x FROM lake.table_changes('events', 200, 200)
UNION ALL SELECT 'w190_201', change_type, x FROM lake.table_changes('events', 190, 201)
UNION ALL SELECT 'all', change_type, x FROM lake.table_changes('events', 0, 201)
) GROUP BY ALL ORDER BY ALL;

result IIII
all	delete	1000	45173250.0
all	insert	200000	9999950000.0
w190_201	delete	120	5439270.0
w200	delete	10	453430.0
w201	delete	10	453465.0
