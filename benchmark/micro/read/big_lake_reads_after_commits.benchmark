# name: benchmark/micro/read/big_lake_reads_after_commits.benchmark
# description: 20 single-row commits to one table of a 2110-table lake, each followed by a read of another table
# group: [read]

name Big Lake Reads After Commits
group micro
subgroup read

require ducklake

require parquet

argument work big_lake_reads_after_commits_work

include benchmark/micro/fixtures/big_lake.benchmark.in

# Each commit writes a file, after which the read looks up the stats of a table the commit did not change
run
INSERT INTO lake.main.bg_0 SELECT * FROM lake.main.bg_0 LIMIT 1;
SELECT sum(c1) FROM lake.main.bg_1 WHERE c0 >= 0;
INSERT INTO lake.main.bg_0 SELECT * FROM lake.main.bg_0 LIMIT 1;
SELECT sum(c1) FROM lake.main.bg_1 WHERE c0 >= 0;
