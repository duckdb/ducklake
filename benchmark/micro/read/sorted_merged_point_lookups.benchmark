SELECT count(*) AS c FROM lake.t WHERE k BETWEEN 581000 AND 581010;
SELECT count(*) AS c FROM lake.t WHERE k BETWEEN 613000 AND 613010;

result_query I
SELECT * FROM __answer
----
11
