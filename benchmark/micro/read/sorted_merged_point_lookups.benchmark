INSERT INTO lake.t SELECT i, md5(i::VARCHAR) FROM range(290000, 300000) r(i);
INSERT INTO lake.t SELECT i, md5(i::VARCHAR) FROM range(340000, 350000) r(i);
INSERT INTO lake.t SELECT i, md5(i::VARCHAR) FROM range(390000, 400000) r(i);
INSERT INTO lake.t SELECT i, md5(i::VARCHAR) FROM range(440000, 450000) r(i);
INSERT INTO lake.t SELECT i, md5(i::VARCHAR) FROM range(490000, 500000) r(i);
INSERT INTO lake.t SELECT i, md5(i::VARCHAR) FROM range(540000, 550000) r(i);
INSERT INTO lake.t SELECT i, md5(i::VARCHAR) FROM range(590000, 600000) r(i);
CALL ducklake_merge_adjacent_files('lake', 't');
SELECT CASE WHEN (SELECT count(*) FROM ducklake_list_files('lake', 't')) NOT BETWEEN 2 AND 32 THEN error('the blocks must be merged into a few files') END;
DETACH lake;
@seal sorted_merged_lookups
COPY (SELECT 1) TO '${BENCHMARK_DIR}/sorted_merged_lookups_ready.marker' (FORMAT CSV);
@attach sorted_merged_lookups AS lake (READ_ONLY)

reload
@attach sorted_merged_lookups AS lake (READ_ONLY)

run
SELECT count(*) AS c FROM lake.t WHERE k BETWEEN 5000 AND 5010;
SELECT count(*) AS c FROM lake.t WHERE k BETWEEN 37000 AND 37010;
SELECT count(*) AS c FROM lake.t WHERE k BETWEEN 69000 AND 69010;
