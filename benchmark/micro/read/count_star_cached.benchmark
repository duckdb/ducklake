# name: benchmark/micro/read/count_star_cached.benchmark
# description: Repeat the metadata-only COUNT(*) over 1000 files at one snapshot
# group: [read]

name Count Star Cached
group micro
subgroup read

require ducklake

require parquet

argument work count_star_cached_work

include benchmark/micro/fixtures/compaction.benchmark.in

run
@for i in range(400)
SELECT count(*) FROM lake.frag;
@end

result_query I
SELECT * FROM __answer
----
2048000
