# name: benchmark/micro/read/multi_column_pruning_many_files.benchmark
# description: Count the rows of a filter on 8 columns that 817 of 1000 files pass through the metadata stats
# group: [read]

name Multi Column Pruning Many Files
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/wide_files.benchmark.in

run
SELECT count(*) FROM lake.t
WHERE c1 >= 300 AND c2 <= 5500 AND c3 >= 3 AND c4 <= 11500 AND c5 >= 5 AND c6 <= 17500 AND c7 >= 7 AND c8 <= 23500;

result I
2410
