# name: benchmark/micro/ingest/add_files_hive.benchmark
# description: Add many small parquet files whose partition columns come from hive directories of several types
# group: [ingest]

argument file_count 1000

argument lake add_files_hive_${file_count}

argument work ${lake}_work

name DuckLake Add Files Hive
group micro
subgroup ingest

require ducklake

require parquet

cache_file ${lake}_ready.marker

# One single-row file per hive directory, the partition values only in the directory names
load
COPY (SELECT i::INTEGER AS id, (i % 10)::INTEGER AS p_int, DATE '2024-01-01' + (i // 10 % 10)::INTEGER AS p_date,
TIMESTAMP '2024-01-01 12:00:00' + INTERVAL (i // 100 % 5) HOUR AS p_ts, ((i // 500) * 1.25)::DECIMAL(9,2) AS p_dec
FROM range(${file_count}) t(i))
TO '${BENCHMARK_DIR}/${lake}_source' (FORMAT PARQUET, PARTITION_BY (p_int, p_date, p_ts, p_dec), OVERWRITE);
@create ${lake}_pristine
@attach ${lake}_pristine AS lake (DATA_PATH '${BENCHMARK_DIR}/${lake}_files')
CREATE TABLE lake.hive_files (id INTEGER, p_int INTEGER, p_date DATE, p_ts TIMESTAMP, p_dec DECIMAL(9,2));
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
DETACH lake;
COPY (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**'))
TO '${BENCHMARK_DIR}/${lake}_filecount.csv' (FORMAT CSV, HEADER false);
@seal ${lake}_pristine
COPY (SELECT 1) TO '${BENCHMARK_DIR}/${lake}_ready.marker' (FORMAT CSV);
DETACH DATABASE IF EXISTS lake;
@copy ${lake}_pristine TO ${work}
@attach ${work} AS lake
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
SELECT CASE WHEN (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**'))
<> (SELECT column0 FROM read_csv('${BENCHMARK_DIR}/${lake}_filecount.csv', header = false))
THEN error('the fixture files were not restored') END;

include benchmark/micro/fixtures/restore_reload.benchmark.in

run
CALL ducklake_add_data_files('lake', 'hive_files', '${BENCHMARK_DIR}/${lake}_source/**/*.parquet', hive_partitioning => true);

include benchmark/micro/fixtures/restore_cleanup.benchmark.in

# A reset that misses re-registers the same files and doubles the row count
result_query III
SELECT count(*), count(DISTINCT (p_int, p_date, p_ts, p_dec)), sum(p_dec) FROM lake.hive_files
----
${file_count}	${file_count}	625.00
