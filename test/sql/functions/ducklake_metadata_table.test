# name: test/sql/functions/ducklake_metadata_table.test
# description: Read the tables of the metadata catalog with ducklake_metadata_table
# group: [functions]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_metadata_table_files')

statement ok
CREATE TABLE ducklake.t(i INTEGER)

query II
SELECT table_id, table_name FROM ducklake_metadata_table('ducklake', 'ducklake_table')
----
1	t

query I
SELECT count(*) FROM ducklake_metadata_table('ducklake', 'ducklake_snapshot')
----
2

statement error
SELECT * FROM ducklake_metadata_table('ducklake', 'ducklake_does_not_exist')
----
is not a table of the DuckLake metadata catalog
