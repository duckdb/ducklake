# name: test/sql/functions/ducklake_snapshots_chunked.test
# description: Snapshot maps and commit metadata are preserved across output chunks
# group: [functions]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/snapshots_chunked', METADATA_CATALOG 'meta')

# Populate enough history to span several output chunks without thousands of commits.
statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id)
SELECT i, to_timestamp(i), schema_version, next_catalog_id, next_file_id
FROM range(1, 4098) r(i), meta.ducklake_snapshot
WHERE snapshot_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes (snapshot_id, changes_made, author, commit_message, commit_extra_info)
SELECT i,
       CASE WHEN i % 2 = 1 THEN 'inserted_into_table:' || i || ',deleted_from_table:' || (i + 1) END,
       CASE WHEN i % 2 = 1 THEN 'author ' || i END,
       CASE WHEN i % 2 = 1 THEN 'message ' || i END,
       CASE WHEN i % 2 = 1 THEN 'extra ' || i END
FROM range(1, 4098) r(i)

query IIII
SELECT count(*), count(DISTINCT snapshot_id), min(snapshot_id), max(snapshot_id) FROM ducklake_snapshots('dl')
----
4098	4098	0	4097

query I
SELECT count(*)
FROM dl.snapshots()
WHERE snapshot_id > 0 AND (
    snapshot_time IS DISTINCT FROM to_timestamp(snapshot_id) OR
    schema_version IS DISTINCT FROM 0 OR
    changes IS DISTINCT FROM CASE WHEN snapshot_id % 2 = 1
        THEN map(['tables_inserted_into', 'tables_deleted_from'], [[snapshot_id::VARCHAR], [(snapshot_id + 1)::VARCHAR]])
        ELSE map() END OR
    author IS DISTINCT FROM CASE WHEN snapshot_id % 2 = 1 THEN 'author ' || snapshot_id END OR
    commit_message IS DISTINCT FROM CASE WHEN snapshot_id % 2 = 1 THEN 'message ' || snapshot_id END OR
    commit_extra_info IS DISTINCT FROM CASE WHEN snapshot_id % 2 = 1 THEN 'extra ' || snapshot_id END
)
----
0

query III
SELECT changes, commit_message, snapshot_id FROM ducklake_snapshots('dl') WHERE snapshot_id = 4097
----
{tables_inserted_into=[4097], tables_deleted_from=[4098]}	message 4097	4097

query IIII
SELECT snapshot_id, author, commit_message, commit_extra_info
FROM ducklake_expire_snapshots('dl', dry_run => true, versions => [4095])
----
4095	author 4095	message 4095	extra 4095

statement ok
UPDATE meta.ducklake_snapshot_changes SET changes_made = 'unknown:1' WHERE snapshot_id = 4097

query I
SELECT count(*) FROM ducklake_snapshots('dl')
----
4098

statement error
SELECT changes FROM ducklake_snapshots('dl') WHERE snapshot_id = 4097
----
Unsupported change type
