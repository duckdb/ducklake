require ducklake

statement ok
PREPARE commit AS SELECT * FROM ducklake_commit('missing_schema', 1)

statement error
EXECUTE commit
----
Server-side ducklake_commit

statement error
EXECUTE commit
----
Server-side ducklake_commit
