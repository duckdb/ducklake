ALTER TABLE meta.ducklake_inlined_data_1_1 ADD COLUMN _ducklake_end_snapshot BIGINT

statement ok
UPDATE meta.ducklake_inlined_data_1_1 SET _ducklake_end_snapshot = 3 WHERE _ducklake_row_id = 1 AND _ducklake_begin_snapshot = 2

statement ok
UPDATE meta.ducklake_inlined_data_1_1 SET _ducklake_end_snapshot = 4 WHERE _ducklake_row_id = 2 AND _ducklake_begin_snapshot = 2

statement ok
UPDATE meta.ducklake_inlined_data_1_1 SET _ducklake_end_snapshot = 7 WHERE _ducklake_row_id = 0 AND _ducklake_begin_snapshot = 2

statement ok
