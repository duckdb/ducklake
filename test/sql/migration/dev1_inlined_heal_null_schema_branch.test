# name: test/sql/migration/dev1_inlined_heal_null_schema_branch.test
# description: schema versions whose branch an interrupted heal left NULL do not hide an inlined user column collision
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t(a INTEGER)

statement ok
ALTER TABLE dl.t ADD COLUMN b INTEGER

statement ok
INSERT INTO dl.t VALUES (1, NULL), (2, 9)

# the payload shape and the user column of an older dev catalog
statement ok
UPDATE meta.ducklake_column SET column_name = '_ducklake_branch_id' WHERE table_id = 1 AND column_name = 'b'

statement ok
ALTER TABLE meta.ducklake_inlined_data_1_2 DROP COLUMN _ducklake_branch_id

statement ok
ALTER TABLE meta.ducklake_inlined_data_1_2 RENAME COLUMN b TO _ducklake_branch_id

statement ok
ALTER TABLE meta.ducklake_inlined_data_1_2 ADD COLUMN _ducklake_end_snapshot BIGINT

# the branch column of the schema versions was added but not backfilled
statement ok
ALTER TABLE meta.ducklake_schema_versions DROP COLUMN branch_id

statement ok
ALTER TABLE meta.ducklake_schema_versions ADD COLUMN branch_id BIGINT

statement ok
DELETE FROM meta.ducklake_metadata WHERE key = 'heal_complete'

statement ok
DETACH dl

# the heal finds the user column at the version of the payload and refuses before altering it
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (METADATA_CATALOG 'meta')
----
table "t" has a column "_ducklake_branch_id" colliding with the branch column of its inlined data. Rename the column and call ducklake_flush_inlined_data() before migrating

statement ok
ATTACH IF NOT EXISTS '{DUCKLAKE_CONNECTION}' AS meta

# both rows and the end column survive the refusal, no heal marker is written
query III
SELECT a, _ducklake_branch_id, _ducklake_end_snapshot FROM meta.ducklake_inlined_data_1_2 ORDER BY a
----
1	NULL	NULL
2	9	NULL

query I
SELECT count(*) FROM meta.ducklake_metadata WHERE key = 'heal_complete'
----
0

statement ok
DETACH meta
