# name: test/sql/migration/v20_interrupted_first_batch_attach.test
# description: a 1.1 catalog whose migration stopped after the committed renames is refused until a writable attach migrates it
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

# the first batch of the migration renames the snapshot and file tables and commits with the version still 1.1
statement ok
ALTER TABLE meta.ducklake_snapshot RENAME TO ducklake_snapshot_old

statement ok
ALTER TABLE meta.ducklake_snapshot_changes RENAME TO ducklake_snapshot_changes_old

statement ok
ALTER TABLE meta.ducklake_data_file RENAME TO ducklake_data_file_ranges

statement ok
ALTER TABLE meta.ducklake_delete_file RENAME TO ducklake_delete_file_ranges

statement ok
DETACH dl

# a plain attach and a read only attach name the migration instead of failing on the first read
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta')
----
a migration to 2.0-dev1 has begun on it

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', READ_ONLY)
----
a migration to 2.0-dev1 has begun on it

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', READ_ONLY, AUTOMATIC_MIGRATION TRUE)
----
read-only mode

statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta_check

query I
SELECT value FROM meta_check.ducklake_metadata WHERE key = 'version'
----
1.1

statement ok
DETACH meta_check

# the writable migrating attach resumes the sequence
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', AUTOMATIC_MIGRATION TRUE)

query I
SELECT * FROM dl.t
----
42

query I
SELECT value FROM meta.ducklake_metadata WHERE key = 'version'
----
2.0-dev1

query IIII
SELECT branch_id, table_id, data_file_id, is_delete::BOOLEAN FROM meta.ducklake_file_visibility
----
0	1	0	false

statement error
SELECT * FROM meta.ducklake_snapshot_old
----
does not exist

statement ok
INSERT INTO dl.t VALUES (43)

query I
SELECT list(i ORDER BY i) FROM dl.t
----
[42, 43]
