statement ok
DETACH dl

# a release version cannot be requested for it
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_to_v20_dev1_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1')
----
Cannot downgrade
