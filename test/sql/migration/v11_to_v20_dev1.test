query IIII
SELECT t.value, e.row_branch_id, e.row_snapshot, e.snapshot_id FROM meta.ducklake_tag_visibility e JOIN meta.ducklake_tag t ON t.object_id = e.object_id AND t.key = e.key AND t.branch_id = e.row_branch_id AND t.begin_snapshot = e.row_snapshot
----
first	0	12	13

query IIII
SELECT t.value, e.row_branch_id, e.row_snapshot, e.snapshot_id FROM meta.ducklake_column_tag_visibility e JOIN meta.ducklake_column_tag t ON t.table_id = e.table_id AND t.column_id = e.column_id AND t.key = e.key AND t.branch_id = e.row_branch_id AND t.begin_snapshot = e.row_snapshot
----
column	0	18	19

query IIII
SELECT t.value, e.row_branch_id, e.row_snapshot, e.snapshot_id FROM meta.ducklake_view_column_tag_visibility e JOIN meta.ducklake_view_column_tag t ON t.view_id = e.view_id AND t.column_name = e.column_name AND t.key = e.key AND t.branch_id = e.row_branch_id AND t.begin_snapshot = e.row_snapshot
----
view column	0	15	16

query I
SELECT comment FROM duckdb_tables() WHERE database_name = 'dl' AND table_name = 't'
----
second

query I
SELECT comment FROM duckdb_columns() WHERE database_name = 'dl' AND table_name = 'tagged'
----
view column 2

query I
SELECT column_name FROM (DESCRIBE dl.t)
----
i

query I
SELECT column_name FROM (DESCRIBE FROM dl.t AT (VERSION => 4))
----
i
j

query I
SELECT * FROM dl.t
----
42

statement ok
DETACH dl

# the dev version is attached as it is
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_to_v20_dev1_files', METADATA_CATALOG 'meta')

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_to_v20_dev1_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '2.0-dev1')

query I
SELECT * FROM dl.t
----
