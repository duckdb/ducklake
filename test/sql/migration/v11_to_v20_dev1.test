# name: test/sql/migration/v11_to_v20_dev1.test
# description: a 1.1 catalog is migrated to 2.0-dev1 only with AUTOMATIC_MIGRATION, and the dev version is attached as it is
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_to_v20_dev1_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

# a view dropped under 1.1 ends in place, the migration turns the end into an end row
statement ok
CREATE VIEW dl.gone AS SELECT 1 AS i

statement ok
DROP VIEW dl.gone

statement error
SELECT * FROM meta.ducklake_branch
----
does not exist

statement ok
DETACH dl

# a release catalog is attached at its own version
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_to_v20_dev1_files', METADATA_CATALOG 'meta')

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
1.1

statement ok
DETACH dl

# the migration creates the tag and branch tables and backfills the main branch
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_to_v20_dev1_files', METADATA_CATALOG 'meta', AUTOMATIC_MIGRATION TRUE)

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

query IIII
SELECT branch_id, branch_name, parent_id, parent_branch_snapshot FROM meta.ducklake_branch
----
0	main	NULL	NULL

# existing snapshots and their changes are backfilled to main
query II
SELECT snapshot_id, branch_id FROM meta.ducklake_snapshot ORDER BY snapshot_id
----
0	0
1	0
2	0
3	0

query II
SELECT snapshot_id, branch_id FROM meta.ducklake_snapshot_changes ORDER BY snapshot_id
----
0	0
1	0
2	0
3	0

query II
SELECT begin_snapshot, branch_id FROM meta.ducklake_schema_versions
----
1	0

# the migrated snapshot table is keyed by branch and snapshot
statement error
INSERT INTO meta.ducklake_snapshot SELECT snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id FROM meta.ducklake_snapshot WHERE snapshot_id = 1
----
constraint

# SQLite reports the timestamp column as text
query II
SELECT column_name, CASE WHEN column_name = 'expires_at' AND data_type = 'VARCHAR' THEN 'TIMESTAMP WITH TIME ZONE' ELSE data_type END FROM (SELECT DISTINCT column_index, column_name, data_type FROM duckdb_columns() WHERE database_name = 'meta' AND schema_name IN ('main', 'public') AND table_name = 'ducklake_snapshot_tag') ORDER BY column_index
----
tag_name	VARCHAR
snapshot_id	BIGINT
begin_snapshot	BIGINT
end_snapshot	BIGINT
expires_at	TIMESTAMP WITH TIME ZONE

query I
SELECT COUNT(*) FROM meta.ducklake_snapshot_tag
----
0

query I
SELECT COUNT(*) FROM meta.ducklake_file_visibility
----
1

query I
SELECT COUNT(*) FROM meta.ducklake_delete_file_visibility
----
0

# the version rows of the catalog tables carry their birth branch and end in the companion tables
query I
SELECT column_name FROM (SELECT DISTINCT column_index, column_name FROM duckdb_columns() WHERE database_name = 'meta' AND schema_name IN ('main', 'public') AND table_name = 'ducklake_table') ORDER BY column_index
----
table_id
table_uuid
begin_snapshot
schema_id
table_name
path
path_is_relative
branch_id

query I
SELECT column_name FROM (SELECT DISTINCT column_index, column_name FROM duckdb_columns() WHERE database_name = 'meta' AND schema_name IN ('main', 'public') AND table_name = 'ducklake_schema') ORDER BY column_index
----
schema_id
schema_uuid
begin_snapshot
schema_name
path
path_is_relative
parent_schema_id
branch_id

query I
SELECT column_name FROM (SELECT DISTINCT column_index, column_name FROM duckdb_columns() WHERE database_name = 'meta' AND schema_name IN ('main', 'public') AND table_name = 'ducklake_view') ORDER BY column_index
----
view_id
view_uuid
begin_snapshot
schema_id
view_name
dialect
sql
column_aliases
branch_id

query IIIII
SELECT e.branch_id, v.view_name, e.row_branch_id, e.row_snapshot, e.snapshot_id FROM meta.ducklake_view_visibility e JOIN meta.ducklake_view v ON v.view_id = e.view_id
----
0	gone	0	2	3

query II
SELECT (SELECT COUNT(*) FROM meta.ducklake_schema_visibility), (SELECT COUNT(*) FROM meta.ducklake_table_visibility)
----
0	0

query I
SELECT * FROM dl.t
----
42

statement ok
DETACH dl

# the dev version is attached as it is
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_to_v20_dev1_files', METADATA_CATALOG 'meta')

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_to_v20_dev1_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '2.0-dev1')

query I
SELECT * FROM dl.t
----
42

statement ok
DETACH dl

# a release version cannot be requested for it
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_to_v20_dev1_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1')
----
Cannot downgrade
