# name: test/sql/migration/dev1_inlined_orphan_companion.test
# description: the heal of a writable attach drops a companion whose payload table an interrupted drop left behind
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
CREATE TABLE dl.u (i INTEGER)

statement ok
INSERT INTO dl.u VALUES (2)

query I
SELECT table_name FROM meta.ducklake_inlined_data_tables ORDER BY ALL
----
ducklake_inlined_data_1_1
ducklake_inlined_data_2_2

# the older dev build wrote no heal marker
statement ok
DELETE FROM meta.ducklake_metadata WHERE key = 'heal_complete'

# the drop of the second inlined table stopped after its payload went
statement ok
DELETE FROM meta.ducklake_inlined_data_tables WHERE table_name = 'ducklake_inlined_data_2_2'

statement ok
DROP TABLE meta.ducklake_inlined_data_2_2

query I
SELECT count(*) FROM meta.ducklake_inlined_data_2_2_visibility
----
0

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', READ_ONLY)
----
attach it writable once

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement error
SELECT count(*) FROM meta.ducklake_inlined_data_2_2_visibility
----
does not exist

query I
SELECT i FROM dl.t
----
1

query I
SELECT count(*) FROM dl.u
----
0

# the companion of the remaining inlined table stays
query I
SELECT count(*) FROM meta.ducklake_inlined_data_1_1_visibility
----
0

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', READ_ONLY)

query I
SELECT i FROM dl.t
----
1

statement ok
DETACH dl
