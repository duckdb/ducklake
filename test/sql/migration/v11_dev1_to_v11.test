# name: test/sql/migration/v11_dev1_to_v11.test
# description: a 1.1-dev1 catalog is only attached after its migration to 1.1
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_dev1_to_v11_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1')

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

# simulate a catalog created by a dev build
statement ok
UPDATE meta.ducklake_metadata SET value = '1.1-dev1' WHERE key = 'version'

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_dev1_to_v11_files')
----
DuckLake catalog version mismatch: catalog version is 1.1-dev1, but the extension requires version 2.0-dev1.

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_dev1_to_v11_files', DUCKLAKE_VERSION '1.1')
----
DuckLake catalog version mismatch: catalog version is 1.1-dev1, but the extension requires version 1.1.

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_dev1_to_v11_files', DUCKLAKE_VERSION '1.1-dev1')
----
ducklake_version must be '1.0', '1.1' or '2.0-dev1', got '1.1-dev1'

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_dev1_to_v11_files', DUCKLAKE_VERSION '1.0', AUTOMATIC_MIGRATION TRUE)
----
Cannot downgrade

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_dev1_to_v11_files', AUTOMATIC_MIGRATION TRUE)

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

query I
SELECT * FROM dl.t
----
42

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_dev1_to_v11_files')

query I
SELECT * FROM dl.t
----
42
