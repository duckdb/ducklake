# name: test/sql/migration/v20_dev3_ended_delete_file_migration.test
# description: Migration preserves ended delete files and their snapshot history
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT range AS i FROM range(10)

statement ok
DELETE FROM dl.t WHERE i = 3

statement ok
CALL ducklake_rewrite_data_files('dl', 't', delete_threshold => 0)

query II
SELECT begin_snapshot, end_snapshot FROM meta.ducklake_delete_file
----
2	3

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '2.0-dev3', AUTOMATIC_MIGRATION TRUE)

query IIII
SELECT branch_id, delete_file_id, snapshot_id, is_delete::BOOLEAN FROM meta.ducklake_delete_file_visibility ORDER BY snapshot_id
----
0	1	2	false
0	1	3	true

query II
SELECT count(*), sum(i) FROM dl.t AT (VERSION => 1)
----
10	45

query II
SELECT count(*), sum(i) FROM dl.t AT (VERSION => 2)
----
9	42

query II
SELECT count(*), sum(i) FROM dl.t
----
9	42

query II
SELECT count(*), sum(i) FROM dl.table_deletions('t', 2, 2)
----
1	3

query II
SELECT file_count, delete_file_count FROM ducklake_table_info('dl') WHERE table_name = 't'
----
1	0

statement ok
CALL ducklake_expire_snapshots('dl', versions => [1, 2])

query II
SELECT (SELECT count(*) FROM meta.ducklake_delete_file), (SELECT count(*) FROM meta.ducklake_delete_file_visibility)
----
0	0

query II
SELECT count(*), sum(i) FROM dl.t
----
9	42

statement ok
DETACH dl
