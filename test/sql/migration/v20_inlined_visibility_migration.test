# name: test/sql/migration/v20_inlined_visibility_migration.test
# description: the migration to 2.0-dev1 folds the end snapshots of the inlined rows into the shared companion
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DUCKLAKE_VERSION '1.1', DATA_INLINING_ROW_LIMIT 10)

# snapshot 1 creates t, 2 fills it, 3 deletes a row, 4 updates one, 5 adds a column, 6 fills the new payload
statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

statement ok
DELETE FROM dl.t WHERE i = 2

statement ok
UPDATE dl.t SET i = 30 WHERE i = 3

statement ok
ALTER TABLE dl.t ADD COLUMN j INTEGER

statement ok
INSERT INTO dl.t VALUES (4, 40)

# snapshot 7 creates u, whose rows share the ids of t, 8 fills it, 9 creates f with a data file, 10 inlines a deletion
statement ok
CREATE TABLE dl.u(i INTEGER)

statement ok
INSERT INTO dl.u VALUES (1), (2)

statement ok
CREATE TABLE dl.f AS SELECT range AS i FROM range(100)

statement ok
DELETE FROM dl.f WHERE i = 5

query IIII
SELECT _ducklake_row_id, _ducklake_begin_snapshot, _ducklake_end_snapshot, i FROM meta.ducklake_inlined_data_1_1
ORDER BY ALL
----
0	2	NULL	1
1	2	3	2
2	2	4	3
2	4	NULL	30

query II
SELECT row_id, begin_snapshot FROM meta.ducklake_inlined_delete_3
----
5	10

statement ok
DETACH dl

# the migration folds the ends into the companion, drops the end column and adds the branch columns
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE)

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

query I
SELECT column_name FROM (SELECT DISTINCT column_index, column_name FROM duckdb_columns()
    WHERE database_name = 'meta' AND schema_name IN ('main', 'public') AND table_name = 'ducklake_inlined_data_1_1')
ORDER BY column_index
----
_ducklake_row_id
_ducklake_begin_snapshot
i
_ducklake_branch_id

query I
SELECT column_name FROM (SELECT DISTINCT column_index, column_name FROM duckdb_columns()
    WHERE database_name = 'meta' AND schema_name IN ('main', 'public') AND table_name = 'ducklake_inlined_data_1_2')
ORDER BY column_index
----
_ducklake_row_id
_ducklake_begin_snapshot
i
j
_ducklake_branch_id

query IIII
SELECT _ducklake_row_id, _ducklake_begin_snapshot, _ducklake_branch_id, i FROM meta.ducklake_inlined_data_1_1
ORDER BY ALL
----
0	2	0	1
1	2	0	2
2	2	0	3
2	4	0	30

query IIIIII
FROM meta.ducklake_inlined_data_visibility ORDER BY ALL
----
1	1	0	2	0	3
1	2	0	2	0	4

query III
SELECT row_id, begin_snapshot, branch_id FROM meta.ducklake_inlined_delete_3
----
5	10	0

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE database_name = 'meta' AND schema_name IN ('main', 'public')
    AND table_name LIKE '%_visibility_pending'
----
0

# the reads are unchanged
query II
SELECT i, j FROM dl.t ORDER BY i
----
1	NULL
4	40
30	NULL

query I
SELECT i FROM dl.t AT (VERSION => 2) ORDER BY i
----
1
2
3

query I
SELECT i FROM dl.t AT (VERSION => 3) ORDER BY i
----
1
3

query IIII
SELECT snapshot_id, rowid, change_type, i FROM dl.table_changes('t', 3, 4) ORDER BY ALL
----
3	1	delete	2
4	2	update_postimage	30
4	2	update_preimage	3

query I
SELECT i FROM dl.u ORDER BY i
----
1
2

query I
SELECT COUNT(*) FROM dl.f
----
99

# the writers end and flush through the companion
statement ok
DELETE FROM dl.u WHERE i = 1

query IIIIII
FROM meta.ducklake_inlined_data_visibility ORDER BY ALL
----
1	1	0	2	0	3
1	2	0	2	0	4
2	0	0	8	0	11

statement ok
CALL ducklake_flush_inlined_data('dl', table_name => 't')

query I
SELECT COUNT(*) FROM meta.ducklake_inlined_data_visibility WHERE table_id = 1
----
0

query II
SELECT i, j FROM dl.t ORDER BY i
----
1	NULL
4	40
30	NULL

query I
SELECT i FROM dl.t AT (VERSION => 2) ORDER BY i
----
1
2
3

query I
SELECT i FROM dl.u ORDER BY i
----
2

statement ok
DETACH dl
