# name: test/sql/migration/v20_dev1_new_catalog.test
# description: a new catalog is created at 2.0-dev1 with the snapshot tag table and the catalog mutex row
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v20_dev1_new_catalog_files', METADATA_CATALOG 'meta')

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

query II
SELECT column_name, data_type FROM (SELECT DISTINCT column_index, column_name, data_type FROM duckdb_columns() WHERE database_name = 'meta' AND table_name = 'ducklake_snapshot_tag') ORDER BY column_index
----
tag_name	VARCHAR
snapshot_id	BIGINT
begin_snapshot	BIGINT
end_snapshot	BIGINT

query I
SELECT COUNT(*) FROM meta.ducklake_snapshot_tag
----
0

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

query I
SELECT * FROM dl.t
----
42

statement ok
DETACH dl

# the catalog is attached again without a migration
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v20_dev1_new_catalog_files', METADATA_CATALOG 'meta')

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

query I
SELECT * FROM dl.t
----
42
