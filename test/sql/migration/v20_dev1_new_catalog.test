main	0	0

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

query I
SELECT * FROM dl.t
----
42

statement ok
DETACH dl

# the catalog is attached again without a migration
statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v20_dev1_new_catalog_files', METADATA_CATALOG 'meta')

statement ok
CALL disable_logging()

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%ADD COLUMN branch_id%' OR query LIKE '%INSERT INTO%_visibility%'
    OR query LIKE '%DROP COLUMN end_snapshot%' OR query LIKE '%CREATE TABLE%_visibility%'
----
0

query I
SELECT * FROM dl.t
----
42
