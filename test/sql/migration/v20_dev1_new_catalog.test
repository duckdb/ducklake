# name: test/sql/migration/v20_dev1_new_catalog.test
# description: a new catalog is created at 2.0-dev1 with the snapshot tag table and the catalog mutex row
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v20_dev1_new_catalog_files', METADATA_CATALOG 'meta')

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

# SQLite reports the timestamp column as text
query II
SELECT column_name, CASE WHEN column_name = 'expires_at' AND data_type = 'VARCHAR' THEN 'TIMESTAMP WITH TIME ZONE'
    ELSE data_type END
FROM (SELECT DISTINCT column_index, column_name, data_type FROM duckdb_columns()
    WHERE database_name = 'meta' AND schema_name IN ('main', 'public') AND table_name = 'ducklake_snapshot_tag')
ORDER BY column_index
----
tag_name	VARCHAR
snapshot_id	BIGINT
begin_snapshot	BIGINT
expires_at	TIMESTAMP WITH TIME ZONE
branch_id	BIGINT

query I
SELECT COUNT(*) FROM meta.ducklake_snapshot_tag
----
0

# the catalog rows carry their birth branch and end in companion tables, like a migrated catalog
query I
SELECT column_name FROM (SELECT DISTINCT column_index, column_name FROM duckdb_columns()
    WHERE database_name = 'meta' AND schema_name IN ('main', 'public') AND table_name = 'ducklake_table')
ORDER BY column_index
----
table_id
table_uuid
begin_snapshot
schema_id
table_name
path
path_is_relative
branch_id

