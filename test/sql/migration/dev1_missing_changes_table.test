# name: test/sql/migration/dev1_missing_changes_table.test
# description: a catalog without a snapshot changes table or its old copy cannot be healed
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DROP TABLE meta.ducklake_snapshot_changes

statement ok
DETACH dl

# a read only attach sees a snapshot table layout it cannot read
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', READ_ONLY)
----
attach it writable once

# no interrupted heal leaves the catalog without the table and its old copy, so there is nothing to rebuild from
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)
----
Cannot heal this DuckLake catalog: the snapshot changes table is missing
