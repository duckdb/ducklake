# name: test/sql/migration/v20_inlined_visibility_collisions.test
# description: the migration to 2.0-dev1 refuses an inlined data table whose name or user columns collide with the shared companion
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

# a 1.0 catalog reserved the three bare names alone, so a user column can be named like the branch column of 2.0
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DUCKLAKE_VERSION '1.0', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t(i INTEGER, _ducklake_branch_id INTEGER)

statement ok
INSERT INTO dl.t VALUES (1, 7), (2, NULL), (3, 0)

statement ok
DETACH dl

# the step refuses the column and the catalog stays at 1.0
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE)
----
table 1 has a column _ducklake_branch_id colliding with the branch column of the inlined data tables

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta')

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
1.0

query II
SELECT i, _ducklake_branch_id FROM dl.t ORDER BY i
----
1	7
2	NULL
3	0

# renaming the column and flushing the rows leaves no payload with the column
statement ok
ALTER TABLE dl.t RENAME COLUMN _ducklake_branch_id TO b

statement ok
CALL ducklake_flush_inlined_data('dl')

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE)

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

query II
SELECT i, b FROM dl.t ORDER BY i
----
1	7
2	NULL
3	0

statement ok
INSERT INTO dl.t VALUES (4, 40)

statement ok
DELETE FROM dl.t WHERE i = 4

query I
SELECT COUNT(*) FROM meta.ducklake_inlined_data_visibility WHERE table_id = 1
----
1

query II
SELECT i, b FROM dl.t ORDER BY i
----
1	7
2	NULL
3	0

statement ok
DETACH dl

# the readers take the table of a version from the name of its payload, so a payload named for another table is refused
statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

statement ok
ALTER TABLE meta.ducklake_inlined_data_1_2 RENAME TO ducklake_inlined_data_42_2

statement ok
UPDATE meta.ducklake_inlined_data_tables SET table_name = 'ducklake_inlined_data_42_2' WHERE table_id = 1

statement ok
ALTER TABLE meta.ducklake_inlined_data_visibility RENAME TO ducklake_inlined_data_visibility_pending

statement ok
DETACH meta

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE)
----
inlined data table ducklake_inlined_data_42_2 is registered for table 1
