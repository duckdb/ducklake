# name: test/sql/migration/v20_inlined_visibility_collisions.test
# description: the migration to 2.0-dev1 refuses an inlined data table whose name or user columns collide with the shared companion
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

# a 1.0 catalog reserved the three bare names alone, so a user column can be named like the branch column
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DUCKLAKE_VERSION '1.0', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t(i INTEGER, _ducklake_branch_id INTEGER)

statement ok
INSERT INTO dl.t VALUES (1, 7), (2, NULL), (3, 0)

# a table without inlining has no payload to refuse, its column collides once inlining is enabled
statement ok
CALL dl.set_option('data_inlining_row_limit', 0)

statement ok
CREATE TABLE dl.u(i INTEGER, _ducklake_branch_id INTEGER)

statement ok
INSERT INTO dl.u VALUES (1, 7)

statement ok
CALL dl.set_option('data_inlining_row_limit', 10)

statement ok
DETACH dl

# the step refuses the column, the catalog stays at 1.0 or at 1.1 where the rename of the metadata columns committed
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE)
----
inlined data table ducklake_inlined_data_1_1 has a column _ducklake_branch_id, which the inlined data tables of 2.0 reserve

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta')

query I
SELECT value IN ('1.0', '1.1') FROM dl.options() WHERE option_name = 'version'
----
true

query II
SELECT i, _ducklake_branch_id FROM dl.t ORDER BY i
----
1	7
2	NULL
3	0

# renaming the column and flushing the rows leaves no payload with the column
statement ok
ALTER TABLE dl.t RENAME COLUMN _ducklake_branch_id TO b

statement ok
CALL ducklake_flush_inlined_data('dl')

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE)

# the migrated table keeps its column and cannot inline until the column is renamed
query II
SELECT i, _ducklake_branch_id FROM dl.u
----
1	7

statement error
CALL dl.set_option('data_inlining_row_limit', 10, table_name => 'u')
----
conflicts with a reserved DuckLake internal column name used for inlining

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

query II
SELECT i, b FROM dl.t ORDER BY i
----
1	7
2	NULL
3	0

statement ok
INSERT INTO dl.t VALUES (4, 40)

statement ok
DELETE FROM dl.t WHERE i = 4

query I
SELECT COUNT(*) FROM meta.ducklake_inlined_data_visibility WHERE table_id = 1
----
1

query II
SELECT i, b FROM dl.t ORDER BY i
----
1	7
2	NULL
3	0

statement ok
DETACH dl

# the readers take the table of a version from the name of its payload, so a payload named for another table is refused
statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

statement ok
ALTER TABLE meta.ducklake_inlined_data_1_3 RENAME TO ducklake_inlined_data_42_3

statement ok
UPDATE meta.ducklake_inlined_data_tables SET table_name = 'ducklake_inlined_data_42_3' WHERE table_id = 1

statement ok
ALTER TABLE meta.ducklake_inlined_data_visibility RENAME TO ducklake_inlined_data_visibility_pending

statement ok
DETACH meta

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE)
----
inlined data table ducklake_inlined_data_42_3 is registered for table 1

# a table id beyond the range of the ids is no name of this build either
statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

statement ok
ALTER TABLE meta.ducklake_inlined_data_42_3 RENAME TO ducklake_inlined_data_18446744073709551616_3

statement ok
UPDATE meta.ducklake_inlined_data_tables SET table_name = 'ducklake_inlined_data_18446744073709551616_3'
    WHERE table_id = 1

statement ok
DETACH meta

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE)
----
inlined data table ducklake_inlined_data_18446744073709551616_3 is registered for table 1
