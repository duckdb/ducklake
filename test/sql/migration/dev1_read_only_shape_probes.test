# name: test/sql/migration/dev1_read_only_shape_probes.test
# description: a read only attach refuses the snapshot tag table and the inlined data tables of an older dev build, and a dropped catalog table is left to its reader
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2)

statement ok
CALL ducklake_create_tag('dl', 'v2', version => 2)

# the older dev build wrote no heal marker and knew no branch of the snapshot a tag names
statement ok
DELETE FROM meta.ducklake_metadata WHERE key = 'heal_complete'

statement ok
ALTER TABLE meta.ducklake_snapshot_tag DROP COLUMN snapshot_branch_id

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', READ_ONLY)
----
has the catalog tables of an older dev build, attach it writable once to heal it

# the writable attach adds the branch of the target back
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

query II
SELECT tag_name, snapshot_id FROM ducklake_tags('dl')
----
v2	2

query I
SELECT count(*) FROM dl.t AT (VERSION => 'v2')
----
2

# the older dev build knew no birth branch of the inlined rows
statement ok
DELETE FROM meta.ducklake_metadata WHERE key = 'heal_complete'

statement ok
ALTER TABLE meta.ducklake_inlined_data_1_1 DROP COLUMN _ducklake_branch_id

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', READ_ONLY)
----
has the inlined data tables of an older dev build, attach it writable once to heal it

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

query I
SELECT i FROM dl.t ORDER BY i
----
1
2

# a dropped catalog table is left to its reader, the probes of the other shapes reach the missing marker
statement ok
DELETE FROM meta.ducklake_metadata WHERE key = 'heal_complete'

statement ok
DROP TABLE meta.ducklake_snapshot_tag

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', READ_ONLY)
----
no marker of a completed heal

# the writable attach creates the table again
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

query I
SELECT count(*) FROM ducklake_tags('dl')
----
0

statement ok
CALL ducklake_create_tag('dl', 'v3', version => 3)

query II
SELECT tag_name, snapshot_id FROM ducklake_tags('dl')
----
v3	3

query I
SELECT value FROM meta.ducklake_metadata WHERE key = 'heal_complete'
----
2.0-dev1.4

statement ok
DETACH dl
