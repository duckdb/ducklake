# name: test/sql/migration/dev1_heal_keeps_current_branches.test
# description: a leftover table of an interrupted heal next to branch rows of the current layout is finished keeping the branch rows
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

# a branch with a snapshot of its own on the current layout
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 1)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 2, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 1 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (2, NULL, NULL, NULL, NULL, 1)

# the old table of a heal that stopped before dropping it
statement ok
CREATE TABLE meta.ducklake_snapshot_old(snapshot_id BIGINT, snapshot_time TIMESTAMPTZ, schema_version BIGINT, next_catalog_id BIGINT, next_file_id BIGINT, branch_id BIGINT)

statement ok
INSERT INTO meta.ducklake_snapshot_old SELECT snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id FROM meta.ducklake_snapshot

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement error
SELECT * FROM meta.ducklake_snapshot_old
----
does not exist

query II
SELECT snapshot_id, branch_id FROM meta.ducklake_snapshot ORDER BY branch_id, snapshot_id
----
0	0
1	0
2	1

# the rebuild table of a heal that stopped before the renames is completed with the rows of every branch
statement ok
CREATE TABLE meta.ducklake_snapshot_changes_rebuild(snapshot_id BIGINT, changes_made VARCHAR, author VARCHAR, commit_message VARCHAR, commit_extra_info VARCHAR, branch_id BIGINT, PRIMARY KEY(branch_id, snapshot_id))

statement ok
INSERT INTO meta.ducklake_snapshot_changes_rebuild SELECT snapshot_id, changes_made, author, commit_message, commit_extra_info, branch_id FROM meta.ducklake_snapshot_changes WHERE snapshot_id = 0

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement error
SELECT * FROM meta.ducklake_snapshot_changes_rebuild
----
does not exist

statement error
SELECT * FROM meta.ducklake_snapshot_changes_old
----
does not exist

query II
SELECT snapshot_id, branch_id FROM meta.ducklake_snapshot_changes ORDER BY branch_id, snapshot_id
----
0	0
1	0
2	1

# the healed catalog commits on main while the branch keeps its snapshot of the same id
statement ok
INSERT INTO dl.t VALUES (43)

query II
SELECT snapshot_id, branch_id FROM meta.ducklake_snapshot ORDER BY branch_id, snapshot_id
----
0	0
1	0
2	0
2	1

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', BRANCH 'dev')

query I
SELECT id FROM dl.current_snapshot()
----
2

query I
SELECT * FROM dl.t
----
42

statement ok
DETACH dl
