# the ends are rebuilt from the end snapshots and the end column is gone
query IIII
SELECT t.table_name, t.branch_id, e.row_snapshot, e.end_snapshot
FROM meta.ducklake_table t
LEFT JOIN meta.ducklake_table_visibility e ON e.table_id = t.table_id AND e.row_branch_id = t.branch_id
    AND e.row_snapshot = t.begin_snapshot
ORDER BY t.begin_snapshot
----
t	0	1	11
t2	0	11	12
t	0	NULL	NULL

query IIII
SELECT v.view_name, v.branch_id, e.row_snapshot, e.end_snapshot
FROM meta.ducklake_view v
JOIN meta.ducklake_view_visibility e ON e.view_id = v.view_id AND e.row_branch_id = v.branch_id
    AND e.row_snapshot = v.begin_snapshot
----
v	0	9	10

query IIII
SELECT s.schema_name, s.branch_id, e.row_snapshot, e.end_snapshot
FROM meta.ducklake_schema s
JOIN meta.ducklake_schema_visibility e ON e.schema_id = s.schema_id AND e.row_branch_id = s.branch_id
    AND e.row_snapshot = s.begin_snapshot
----
s	0	13	14

query I
SELECT COUNT(*) FROM duckdb_columns() WHERE database_name = 'meta' AND schema_name IN ('main', 'public')
    AND table_name IN ('ducklake_schema', 'ducklake_table', 'ducklake_view') AND column_name = 'end_snapshot'
----
0

