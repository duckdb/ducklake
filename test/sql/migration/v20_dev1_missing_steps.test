# the ends are rebuilt from the end snapshots, a replaced tag ends where its successor is born
query II
SELECT t.value, e.end_snapshot = (SELECT t2.begin_snapshot FROM meta.ducklake_tag t2 WHERE t2.value = 'retagged')
FROM meta.ducklake_tag_visibility e
JOIN meta.ducklake_tag t ON t.object_id = e.object_id AND t.key = e.key AND t.branch_id = e.row_branch_id
    AND t.begin_snapshot = e.row_snapshot
----
tagged	true

query II
SELECT t.value, e.end_snapshot > t.begin_snapshot
FROM meta.ducklake_column_tag_visibility e
JOIN meta.ducklake_column_tag t ON t.table_id = e.table_id AND t.column_id = e.column_id AND t.key = e.key
    AND t.branch_id = e.row_branch_id AND t.begin_snapshot = e.row_snapshot
----
col a	true

query II
SELECT t.value, e.end_snapshot = (SELECT t2.begin_snapshot FROM meta.ducklake_view_column_tag t2
    WHERE t2.value = 'x again')
FROM meta.ducklake_view_column_tag_visibility e
JOIN meta.ducklake_view_column_tag t ON t.view_id = e.view_id AND t.column_name = e.column_name AND t.key = e.key
    AND t.branch_id = e.row_branch_id AND t.begin_snapshot = e.row_snapshot
----
x	true

query II
SELECT t.tag_name, e.end_snapshot > t.begin_snapshot
FROM meta.ducklake_snapshot_tag_visibility e
JOIN meta.ducklake_snapshot_tag t ON t.tag_name = e.tag_name AND t.branch_id = e.row_branch_id
    AND t.begin_snapshot = e.row_snapshot
----
steps	true

