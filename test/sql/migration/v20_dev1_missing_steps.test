# name: test/sql/migration/v20_dev1_missing_steps.test
# description: a 2.0-dev1 catalog of an older dev build or an interrupted migration completes its missing steps on a writable attach
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta')

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

# the 2.0-dev1 layout of main has the tag table, no branch table and snapshot tables keyed by the snapshot id alone
statement ok
UPDATE meta.ducklake_metadata SET value = '2.0-dev1' WHERE key = 'version'

statement ok
DROP TABLE meta.ducklake_branch

statement ok
CREATE TABLE meta.snapshot_backup(snapshot_id BIGINT, snapshot_time TIMESTAMPTZ, schema_version BIGINT,
    next_catalog_id BIGINT, next_file_id BIGINT)

statement ok
INSERT INTO meta.snapshot_backup
SELECT snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id FROM meta.ducklake_snapshot

statement ok
DROP TABLE meta.ducklake_snapshot

statement ok
CREATE TABLE meta.ducklake_snapshot(snapshot_id BIGINT PRIMARY KEY, snapshot_time TIMESTAMPTZ, schema_version BIGINT,
    next_catalog_id BIGINT, next_file_id BIGINT)

statement ok
INSERT INTO meta.ducklake_snapshot SELECT * FROM meta.snapshot_backup

statement ok
DROP TABLE meta.snapshot_backup

statement ok
CREATE TABLE meta.changes_backup(snapshot_id BIGINT, changes_made VARCHAR, author VARCHAR, commit_message VARCHAR,
    commit_extra_info VARCHAR)

statement ok
INSERT INTO meta.changes_backup
SELECT snapshot_id, changes_made, author, commit_message, commit_extra_info FROM meta.ducklake_snapshot_changes

statement ok
DROP TABLE meta.ducklake_snapshot_changes

statement ok
CREATE TABLE meta.ducklake_snapshot_changes(snapshot_id BIGINT PRIMARY KEY, changes_made VARCHAR, author VARCHAR,
    commit_message VARCHAR, commit_extra_info VARCHAR)

statement ok
INSERT INTO meta.ducklake_snapshot_changes SELECT * FROM meta.changes_backup

statement ok
DROP TABLE meta.changes_backup

statement ok
DETACH dl

# the incomplete layout is refused without the migration option
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta')
----
catalog version is 2.0-dev1, but the catalog lacks the branch key of the snapshot tables

# a read only attach cannot migrate
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    READ_ONLY, AUTOMATIC_MIGRATION TRUE)
----
read-only mode

# the writable attach rebuilds the tables
statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE)

statement ok
CALL disable_logging()

# the rename batch commits before the copy and leaves the version alone
query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%RENAME TO ducklake_snapshot_old%' AND query NOT LIKE '%2.0-dev1%'
----
1

# the second batch writes the version after it renames the rebuilt tables into place
query I
SELECT instr(query, '2.0-dev1') > instr(query, 'RENAME TO ducklake_snapshot;')
FROM duckdb_logs_parsed('DuckLakeMetadata') WHERE query LIKE '%RENAME TO ducklake_snapshot;%'
----
true

query I
SELECT value FROM meta.ducklake_metadata WHERE key = 'version'
----
2.0-dev1

query IIII
SELECT branch_id, branch_name, parent_id, parent_branch_snapshot FROM meta.ducklake_branch
----
0	main	NULL	NULL

query I
SELECT column_name FROM (SELECT DISTINCT column_index, column_name FROM duckdb_columns()
    WHERE database_name = 'meta' AND schema_name IN ('main', 'public') AND table_name = 'ducklake_snapshot')
ORDER BY column_index
----
snapshot_id
snapshot_time
schema_version
next_catalog_id
next_file_id
branch_id

query I
SELECT column_name FROM (SELECT DISTINCT column_index, column_name FROM duckdb_columns()
    WHERE database_name = 'meta' AND schema_name IN ('main', 'public') AND table_name = 'ducklake_snapshot_changes')
ORDER BY column_index
----
snapshot_id
changes_made
author
commit_message
commit_extra_info
branch_id

# the rows are kept and belong to main
query II
SELECT snapshot_id, branch_id FROM meta.ducklake_snapshot ORDER BY snapshot_id
----
0	0
1	0

query II
SELECT snapshot_id, branch_id FROM meta.ducklake_snapshot_changes ORDER BY snapshot_id
----
0	0
1	0

query I
SELECT changes_made FROM meta.ducklake_snapshot_changes WHERE snapshot_id = 0
----
created_schema:"main"

# the rebuilt tables are keyed by branch and snapshot
statement error
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id,
    branch_id)
SELECT snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id
FROM meta.ducklake_snapshot WHERE snapshot_id = 1
----
constraint

statement error
INSERT INTO meta.ducklake_snapshot_changes (snapshot_id, changes_made, author, commit_message, commit_extra_info,
    branch_id)
SELECT snapshot_id, changes_made, author, commit_message, commit_extra_info, branch_id
FROM meta.ducklake_snapshot_changes WHERE snapshot_id = 1
----
constraint

statement error
SELECT * FROM meta.ducklake_snapshot_rebuild
----
does not exist

statement error
SELECT * FROM meta.ducklake_snapshot_changes_rebuild
----
does not exist

statement error
SELECT * FROM meta.ducklake_snapshot_old
----
does not exist

statement error
SELECT * FROM meta.ducklake_snapshot_changes_old
----
does not exist

# the migrated catalog commits
query I
SELECT * FROM dl.t
----
42

statement ok
INSERT INTO dl.t VALUES (43)

query I
SELECT list(snapshot_id ORDER BY snapshot_id) FROM dl.snapshots()
----
[0, 1, 2]

query II
SELECT snapshot_id, branch_id FROM meta.ducklake_snapshot_changes ORDER BY snapshot_id
----
0	0
1	0
2	0

statement ok
INSERT INTO dl.t VALUES (44)

query I
SELECT list(snapshot_id ORDER BY snapshot_id) FROM dl.snapshots()
----
[0, 1, 2, 3]

