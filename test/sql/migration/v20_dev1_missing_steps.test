# the ends are rebuilt from the end snapshots, the renamed column ends where its successor is born
query II
SELECT c.column_name,
    e.end_snapshot = (SELECT c2.begin_snapshot FROM meta.ducklake_column c2 WHERE c2.column_name = 'b2')
FROM meta.ducklake_column_visibility e
JOIN meta.ducklake_column c ON c.table_id = e.table_id AND c.column_id = e.column_id AND c.branch_id = e.row_branch_id
    AND c.begin_snapshot = e.row_snapshot
----
b	true

query II
SELECT m.macro_name, e.end_snapshot > m.begin_snapshot
FROM meta.ducklake_macro_visibility e
JOIN meta.ducklake_macro m ON m.macro_id = e.macro_id AND m.branch_id = e.row_branch_id
    AND m.begin_snapshot = e.row_snapshot
----
mc	true

