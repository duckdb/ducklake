# a migration interrupted while copying the changes table copies the missing rows without duplicating the copied ones
statement ok
UPDATE meta.ducklake_metadata SET value = '2.0-dev1' WHERE key = 'version'

statement ok
CREATE TABLE meta.ducklake_snapshot_changes_old(snapshot_id BIGINT PRIMARY KEY, changes_made VARCHAR, author VARCHAR,
    commit_message VARCHAR, commit_extra_info VARCHAR)

statement ok
INSERT INTO meta.ducklake_snapshot_changes_old
SELECT snapshot_id, changes_made, author, commit_message, commit_extra_info FROM meta.ducklake_snapshot_changes

statement ok
CREATE TABLE meta.ducklake_snapshot_changes_rebuild(snapshot_id BIGINT, changes_made VARCHAR, author VARCHAR,
    commit_message VARCHAR, commit_extra_info VARCHAR, branch_id BIGINT DEFAULT 0, PRIMARY KEY(branch_id, snapshot_id))

statement ok
INSERT INTO meta.ducklake_snapshot_changes_rebuild
SELECT snapshot_id, changes_made, author, commit_message, commit_extra_info, 0 FROM meta.ducklake_snapshot_changes_old
WHERE snapshot_id < 2

statement ok
