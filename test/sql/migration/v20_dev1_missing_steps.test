query I
SELECT count(*) > 0 FROM duckdb_logs_parsed('DuckLakeMetadata')
----
true

query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE (query LIKE '%ducklake_branch%' OR query LIKE '%_rebuild%' OR query LIKE '%RENAME TO%'
    OR query LIKE '%ADD COLUMN branch_id%' OR query LIKE '%INSERT INTO%_visibility%'
    OR query LIKE '%DROP COLUMN end_snapshot%' OR query LIKE '%_visibility_pending%') AND query NOT LIKE '%LIMIT 0%'
----
0

# the one statement binds the snapshot tag table and the row companions, so it fails until the step renamed them
query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%ducklake_snapshot_tag_visibility%' AND query LIKE '%ducklake_schema_visibility%'
    AND query LIKE '%LIMIT 0%'
----
1

