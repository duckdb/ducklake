# name: test/sql/migration/v20_file_events_migration.test
# description: the migration to 2.0-dev1 turns the inline file ranges of a 1.1 catalog into branch 0 events and drops the range columns
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1', DATA_INLINING_ROW_LIMIT 0)

# snapshot 1 creates t, snapshots 2 and 3 add a file each
statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t SELECT range FROM range(10)

statement ok
INSERT INTO dl.t SELECT range FROM range(10, 20)

# snapshot 4 writes a delete file for the first file, snapshot 5 replaces it with a cumulative one
statement ok
DELETE FROM dl.t WHERE i = 1

statement ok
DELETE FROM dl.t WHERE i = 2

# snapshot 6 ends the second file
statement ok
DELETE FROM dl.t WHERE i >= 10

# snapshots 7 to 9 create, fill and drop a second table, which ends its file
statement ok
CREATE TABLE dl.u(j INTEGER)

statement ok
INSERT INTO dl.u VALUES (42)

statement ok
DROP TABLE dl.u

# the ranges of the 1.1 catalog
query IIII
SELECT data_file_id, table_id, begin_snapshot, end_snapshot FROM meta.ducklake_data_file ORDER BY data_file_id
----
0	1	2	NULL
1	1	3	6
4	2	8	9

query IIII
SELECT delete_file_id, table_id, begin_snapshot, end_snapshot FROM meta.ducklake_delete_file ORDER BY delete_file_id
----
3	1	4	NULL

statement error
SELECT * FROM meta.ducklake_file_visibility
----
does not exist

statement ok
DETACH dl

# the migration backfills the branch 0 events from the ranges and drops the range columns
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', AUTOMATIC_MIGRATION TRUE, DATA_INLINING_ROW_LIMIT 0)

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

query IIIII
SELECT branch_id, table_id, data_file_id, snapshot_id, is_delete::BOOLEAN FROM meta.ducklake_file_visibility ORDER BY data_file_id, is_delete
----
0	1	0	2	false
0	1	1	3	false
0	1	1	6	true
0	2	4	8	false
0	2	4	9	true

query IIIII
SELECT branch_id, table_id, delete_file_id, snapshot_id, is_delete::BOOLEAN FROM meta.ducklake_delete_file_visibility ORDER BY delete_file_id, is_delete
----
0	1	3	4	false

query I
SELECT column_name FROM duckdb_columns() WHERE database_name = 'meta' AND table_name IN ('ducklake_data_file', 'ducklake_delete_file') AND column_name IN ('begin_snapshot', 'end_snapshot')
----

# the event tables carry the key of the design, SQLite reports the boolean as an integer
query II
SELECT column_name, CASE WHEN column_name = 'is_delete' AND data_type = 'BIGINT' THEN 'BOOLEAN' ELSE data_type END FROM (SELECT DISTINCT column_index, column_name, data_type FROM duckdb_columns() WHERE database_name = 'meta' AND table_name = 'ducklake_file_visibility') ORDER BY column_index
----
branch_id	BIGINT
table_id	BIGINT
data_file_id	BIGINT
snapshot_id	BIGINT
is_delete	BOOLEAN

query II
SELECT column_name, CASE WHEN column_name = 'is_delete' AND data_type = 'BIGINT' THEN 'BOOLEAN' ELSE data_type END FROM (SELECT DISTINCT column_index, column_name, data_type FROM duckdb_columns() WHERE database_name = 'meta' AND table_name = 'ducklake_delete_file_visibility') ORDER BY column_index
----
branch_id	BIGINT
table_id	BIGINT
delete_file_id	BIGINT
snapshot_id	BIGINT
is_delete	BOOLEAN

# the reads of the migrated catalog see the ranges the events span
query I
SELECT count(*) FROM dl.t
----
8

query I
SELECT count(*) FROM dl.t AT (VERSION => 3)
----
20

query I
SELECT count(*) FROM dl.t AT (VERSION => 5)
----
18

query II
SELECT count(*), sum(i) FROM dl.table_insertions('t', 3, 3)
----
10	145

query II
SELECT count(*), sum(i) FROM dl.table_deletions('t', 6, 6)
----
10	145

query II
SELECT file_count, delete_file_count FROM ducklake_table_info('dl') WHERE table_name = 't'
----
1	1

# the migrated catalog keeps writing events
statement ok
INSERT INTO dl.t VALUES (100)

query IIIII
SELECT branch_id, table_id, data_file_id, snapshot_id, is_delete::BOOLEAN FROM meta.ducklake_file_visibility WHERE data_file_id > 4
----
0	1	5	10	false

# the expiry of the snapshots of u removes its file with the events
statement ok
CALL ducklake_expire_snapshots('dl', versions => [7, 8])

query II
SELECT (SELECT count(*) FROM meta.ducklake_data_file WHERE table_id = 2), (SELECT count(*) FROM meta.ducklake_file_visibility WHERE table_id = 2)
----
0	0

statement ok
DETACH dl
