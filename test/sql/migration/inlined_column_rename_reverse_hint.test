# name: test/sql/migration/inlined_column_rename_reverse_hint.test
# description: a v1.0 session reading inlined tables that were migrated underneath hints at reattaching
# group: [migration]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:{TEST_DIR}/reverse_hint.db' AS dl (DATA_PATH '{TEST_DIR}/reverse_hint_files', DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE dl.t(i INTEGER, j INTEGER);

statement ok
INSERT INTO dl.t VALUES (1, 2), (3, 4);

# rename the inlined columns underneath the v1.0 session, as a migration on another connection does
statement ok
ALTER TABLE __ducklake_metadata_dl.ducklake_inlined_data_1_1 RENAME COLUMN row_id TO _ducklake_row_id

statement ok
ALTER TABLE __ducklake_metadata_dl.ducklake_inlined_data_1_1 RENAME COLUMN begin_snapshot TO _ducklake_begin_snapshot

statement ok
ALTER TABLE __ducklake_metadata_dl.ducklake_inlined_data_1_1 RENAME COLUMN end_snapshot TO _ducklake_end_snapshot

# reading the migrated inlined table from the v1.0 session hints at reattaching
statement error
SELECT * FROM dl.t
----
migrated by another connection

statement ok
DETACH dl

# a reattach that migrates the catalog reads the data
statement ok
ATTACH 'ducklake:{TEST_DIR}/reverse_hint.db' AS dl (DATA_PATH '{TEST_DIR}/reverse_hint_files', AUTOMATIC_MIGRATION TRUE)

query II
SELECT * FROM dl.t ORDER BY i
----
1	2
3	4

statement ok
DETACH dl
