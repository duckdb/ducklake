# name: test/sql/migration/rejected_migrating_attach_keeps_catalog.test
# description: a migrating attach that is rejected for its data path leaves the catalog as it was
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DUCKLAKE_VERSION '1.1')

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DETACH dl

# an attach without the migration option reads the 1.1 catalog
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta')

query I
SELECT i FROM dl.t
----
42

statement ok
DETACH dl

# the data path is checked before the migration runs
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/other', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE)
----
does not match existing data path

# the attach without the migration option still works, so the catalog kept its version
statement ok
DETACH DATABASE IF EXISTS meta

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta')

query I
SELECT value FROM meta.ducklake_metadata WHERE key = 'version'
----
1.1

# the snapshot tables were not renamed and no tag table was added
query I
SELECT list(table_name ORDER BY table_name) FROM duckdb_tables() WHERE database_name = 'meta'
    AND schema_name IN ('main', 'public') AND table_name LIKE 'ducklake_snapshot%'
----
[ducklake_snapshot, ducklake_snapshot_changes]

query I
SELECT i FROM dl.t
----
42

statement ok
DETACH dl

# the migrating attach with the stored data path migrates the catalog
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE)

query I
SELECT value FROM meta.ducklake_metadata WHERE key = 'version'
----
2.0-dev1

query I
SELECT list(table_name ORDER BY table_name) FROM duckdb_tables() WHERE database_name = 'meta'
    AND schema_name IN ('main', 'public') AND table_name LIKE 'ducklake_snapshot%'
----
[ducklake_snapshot, ducklake_snapshot_changes, ducklake_snapshot_tag, ducklake_snapshot_tag_visibility]

query I
SELECT i FROM dl.t
----
42
