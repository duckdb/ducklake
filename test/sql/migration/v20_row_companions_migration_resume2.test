# name: test/sql/migration/v20_row_companions_migration_resume2.test
# description: the migration to 2.0-dev1 resumes the catalog row companions from a pending companion or a birth branch
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DUCKLAKE_VERSION '1.1', DATA_INLINING_ROW_LIMIT 0)

# snapshot 1 creates s, 2 creates t, 3 creates v, 4 renames t, 5 drops v, 6 drops s
statement ok
CREATE SCHEMA dl.s

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
CREATE VIEW dl.v AS SELECT 1 AS x

statement ok
ALTER TABLE dl.t RENAME TO t2

statement ok
DROP VIEW dl.v

statement ok
DROP SCHEMA dl.s

statement ok
DETACH dl

# the interrupted step stopped before the rename of the pending companion of the schemas, after the birth branch of
# the tables and after the empty pending companion of the views
statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

statement ok
ALTER TABLE meta.ducklake_schema ADD COLUMN branch_id BIGINT DEFAULT 0

statement ok
UPDATE meta.ducklake_schema SET branch_id = 0 WHERE branch_id IS NULL

statement ok
CREATE TABLE meta.ducklake_schema_visibility_pending(branch_id BIGINT, schema_id BIGINT, row_branch_id BIGINT,
    row_snapshot BIGINT, end_snapshot BIGINT, PRIMARY KEY(branch_id, schema_id, row_branch_id, row_snapshot))

statement ok
INSERT INTO meta.ducklake_schema_visibility_pending
SELECT 0, schema_id, 0, begin_snapshot, end_snapshot FROM meta.ducklake_schema WHERE end_snapshot IS NOT NULL

statement ok
ALTER TABLE meta.ducklake_schema DROP COLUMN end_snapshot

statement ok
ALTER TABLE meta.ducklake_table ADD COLUMN branch_id BIGINT DEFAULT 0

statement ok
ALTER TABLE meta.ducklake_view ADD COLUMN branch_id BIGINT DEFAULT 0

statement ok
UPDATE meta.ducklake_view SET branch_id = 0 WHERE branch_id IS NULL

statement ok
CREATE TABLE meta.ducklake_view_visibility_pending(branch_id BIGINT, view_id BIGINT, row_branch_id BIGINT,
    row_snapshot BIGINT, end_snapshot BIGINT, PRIMARY KEY(branch_id, view_id, row_branch_id, row_snapshot))

statement ok
DETACH meta

# the resumed step renames the companion of the schemas, fills and renames the one of the views and converts the tables
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE, DATA_INLINING_ROW_LIMIT 0)

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

query IIII
SELECT s.schema_name, e.branch_id, e.row_snapshot, e.end_snapshot
FROM meta.ducklake_schema_visibility e
JOIN meta.ducklake_schema s ON s.schema_id = e.schema_id AND s.branch_id = e.row_branch_id
    AND s.begin_snapshot = e.row_snapshot
----
s	0	1	6

query IIII
SELECT t.table_name, e.branch_id, e.row_snapshot, e.end_snapshot
FROM meta.ducklake_table_visibility e
JOIN meta.ducklake_table t ON t.table_id = e.table_id AND t.branch_id = e.row_branch_id
    AND t.begin_snapshot = e.row_snapshot
----
t	0	2	4

query IIII
SELECT v.view_name, e.branch_id, e.row_snapshot, e.end_snapshot
FROM meta.ducklake_view_visibility e
JOIN meta.ducklake_view v ON v.view_id = e.view_id AND v.branch_id = e.row_branch_id
    AND v.begin_snapshot = e.row_snapshot
----
v	0	3	5

query II
SELECT table_name, branch_id FROM meta.ducklake_table ORDER BY begin_snapshot
----
t	0
t2	0

query I
SELECT COUNT(*) FROM duckdb_columns() WHERE database_name = 'meta' AND schema_name IN ('main', 'public')
    AND table_name IN ('ducklake_schema', 'ducklake_table', 'ducklake_view') AND column_name = 'end_snapshot'
----
0

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE database_name = 'meta' AND schema_name IN ('main', 'public')
    AND table_name LIKE '%_visibility_pending'
----
0

query I
SELECT table_name FROM ducklake_table_info('dl')
----
t2

query I
SELECT x FROM dl.v AT (VERSION => 4)
----
1

statement error
SELECT * FROM dl.v
----
does not exist

query I
SELECT COUNT(*) FROM duckdb_schemas() WHERE database_name = 'dl' AND schema_name = 's'
----
0

# the migrated catalog keeps ending its rows in the renamed companions, snapshot 7 renames t2
statement ok
ALTER TABLE dl.t2 RENAME TO t3

query II
SELECT row_snapshot, end_snapshot FROM meta.ducklake_table_visibility ORDER BY end_snapshot
----
2	4
4	7

statement ok
DETACH dl
