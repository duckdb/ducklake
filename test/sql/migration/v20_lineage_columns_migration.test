# name: test/sql/migration/v20_lineage_columns_migration.test
# description: a 2.0-dev1 catalog without the branch of its schema versions or tagged snapshots completes those steps
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
ALTER TABLE dl.t ADD COLUMN j INTEGER

statement ok
CALL ducklake_create_tag('dl', 'first', version => 2)

query IIII
SELECT begin_snapshot, schema_version, table_id, branch_id FROM meta.ducklake_schema_versions ORDER BY begin_snapshot
----
1	1	1	0
3	2	1	0

query IIII
SELECT tag_name, snapshot_id, snapshot_branch_id, branch_id FROM meta.ducklake_snapshot_tag
----
first	2	0	0

statement ok
DETACH dl

# the layout of an older dev build, before the schema versions and the tagged snapshots carried a branch
statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

statement ok
ALTER TABLE meta.ducklake_schema_versions DROP COLUMN branch_id

statement ok
ALTER TABLE meta.ducklake_snapshot_tag DROP COLUMN snapshot_branch_id

statement ok
DETACH meta

# the incomplete layout is refused without the migration option, the schema versions come first
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta')
----
catalog version is 2.0-dev1, but the catalog lacks the branch of the schema versions

statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE, DATA_INLINING_ROW_LIMIT 0)

statement ok
CALL disable_logging()

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

# both columns are added and the existing rows are filled with the main branch
query II
SELECT count(*) FILTER (WHERE query LIKE '%ducklake_schema_versions ADD COLUMN branch_id%'),
    count(*) FILTER (WHERE query LIKE '%ducklake_snapshot_tag ADD COLUMN snapshot_branch_id%')
FROM duckdb_logs_parsed('DuckLakeMetadata')
----
1	1

query IIII
SELECT begin_snapshot, schema_version, table_id, branch_id FROM meta.ducklake_schema_versions ORDER BY begin_snapshot
----
1	1	1	0
3	2	1	0

query IIII
SELECT tag_name, snapshot_id, snapshot_branch_id, branch_id FROM meta.ducklake_snapshot_tag
----
first	2	0	0

# the migrated catalog resolves its tag and reads its schema versions
query I
SELECT COUNT(*) FROM dl.t AT (VERSION => 'first')
----
1

query I
SELECT column_name FROM (DESCRIBE SELECT * FROM dl.t AT (VERSION => 'first'))
----
i

statement ok
ALTER TABLE dl.t ADD COLUMN k INTEGER

query IIII
SELECT begin_snapshot, schema_version, table_id, branch_id FROM meta.ducklake_schema_versions ORDER BY begin_snapshot
----
1	1	1	0
3	2	1	0
5	3	1	0

statement ok
CALL ducklake_create_tag('dl', 'second', version => 5)

query IIII
SELECT tag_name, snapshot_id, snapshot_branch_id, branch_id FROM meta.ducklake_snapshot_tag ORDER BY tag_name
----
first	2	0	0
second	5	0	0

statement ok
DETACH dl

# a step interrupted after the schema versions resumes with the tagged snapshots alone
statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

statement ok
ALTER TABLE meta.ducklake_snapshot_tag DROP COLUMN snapshot_branch_id

statement ok
DETACH meta

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta')
----
catalog version is 2.0-dev1, but the catalog lacks the branch of the tagged snapshots

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE, DATA_INLINING_ROW_LIMIT 0)

statement ok
CALL disable_logging()

query II
SELECT count(*) FILTER (WHERE query LIKE '%ducklake_schema_versions ADD COLUMN branch_id%'),
    count(*) FILTER (WHERE query LIKE '%ducklake_snapshot_tag ADD COLUMN snapshot_branch_id%')
FROM duckdb_logs_parsed('DuckLakeMetadata')
----
0	1

query IIII
SELECT tag_name, snapshot_id, snapshot_branch_id, branch_id FROM meta.ducklake_snapshot_tag ORDER BY tag_name
----
first	2	0	0
second	5	0	0

statement ok
DETACH dl

# a complete layout is probed with one statement that binds both columns and runs no migration statement
statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DATA_INLINING_ROW_LIMIT 0)

statement ok
CALL disable_logging()

query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%ducklake_schema_versions%' AND query LIKE '%snapshot_branch_id%' AND query LIKE '%LIMIT 0%'
----
1

query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%ADD COLUMN%' OR (query LIKE '%UPDATE%' AND query LIKE '%branch_id = 0 WHERE%')
----
0

query I
SELECT COUNT(*) FROM dl.t AT (VERSION => 'second')
----
1

statement ok
DETACH dl

# a step interrupted after the ADD COLUMN of a backend that commits each statement left the rows without a branch
statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

statement ok
ALTER TABLE meta.ducklake_schema_versions DROP COLUMN branch_id

statement ok
ALTER TABLE meta.ducklake_schema_versions ADD COLUMN branch_id BIGINT

statement ok
ALTER TABLE meta.ducklake_snapshot_tag DROP COLUMN snapshot_branch_id

query I
SELECT COUNT(*) FILTER (WHERE branch_id IS NULL) FROM meta.ducklake_schema_versions
----
3

statement ok
DETACH meta

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE, DATA_INLINING_ROW_LIMIT 0)

# the resumed step fills the branch of the rows the interrupted one left
query IIII
SELECT begin_snapshot, schema_version, table_id, branch_id FROM meta.ducklake_schema_versions ORDER BY begin_snapshot
----
1	1	1	0
3	2	1	0
5	3	1	0

query IIII
SELECT tag_name, snapshot_id, snapshot_branch_id, branch_id FROM meta.ducklake_snapshot_tag ORDER BY tag_name
----
first	2	0	0
second	5	0	0

# the lineage filters of main read the filled rows
query I
SELECT column_name FROM (DESCRIBE SELECT * FROM dl.t AT (VERSION => 'first'))
----
i

statement ok
ALTER TABLE dl.t SET PARTITIONED BY (i)

statement ok
DETACH dl
