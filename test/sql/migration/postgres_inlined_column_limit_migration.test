# name: test/sql/migration/postgres_inlined_column_limit_migration.test
# description: a table at the column limit of postgres inlines again after the migration to 2.0-dev1 dropped its flushed payload
# group: [migration]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

require-env DUCKLAKE_CONNECTION postgres:dbname=ducklakedb

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS pg

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS inlined_limit_migration CASCADE')

statement ok
DETACH pg

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/inlined_limit_migration',
    METADATA_SCHEMA 'inlined_limit_migration', DATA_INLINING_ROW_LIMIT 10, DUCKLAKE_VERSION '1.1')

# 1597 columns and the three inlining columns fill the 1600 columns postgres allows
statement ok
CREATE TABLE dl.fits AS
SELECT * FROM (PIVOT (SELECT 'c' || i AS k, 1 AS v FROM range(1597) r(i)) ON k USING first(v)) LIMIT 0

statement ok
INSERT INTO dl.fits (c0) VALUES (1)

statement ok
INSERT INTO dl.fits (c0) VALUES (2)

statement ok
DELETE FROM dl.fits WHERE c0 = 1

query II
SELECT (SELECT count(*) FROM dl.fits), (SELECT count(*) FROM ducklake_list_files('dl', 'fits'))
----
1	0

# the migration converts no inlined rows, the flush writes them to a file
statement ok
CALL ducklake_flush_inlined_data('dl')

statement ok
DETACH dl

# the step drops the payload, the writer creates it again with the branch column within the limit
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/inlined_limit_migration',
    METADATA_SCHEMA 'inlined_limit_migration', AUTOMATIC_MIGRATION TRUE, DATA_INLINING_ROW_LIMIT 10)

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

statement ok
INSERT INTO dl.fits (c0) VALUES (3)

# the new payload is registered under the schema version of its commit
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM __ducklake_metadata_dl.inlined_limit_migration.ducklake_inlined_data_1_2)
----
1600

query I
SELECT count(*) FROM __ducklake_metadata_dl.inlined_limit_migration.ducklake_inlined_data_visibility
----
0

query I
SELECT c0 FROM dl.fits ORDER BY c0
----
2
3

query I
SELECT c0 FROM dl.fits AT (VERSION => 3) ORDER BY c0
----
1
2

statement ok
DETACH dl

statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS pg

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA inlined_limit_migration CASCADE')

statement ok
DETACH pg
