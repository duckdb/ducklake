# name: test/sql/migration/dev1_partial_heal.test
# description: healing rebuilds each visibility table from its own preserved ranges and rejects unrecoverable catalogs
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/dev1_partial_heal_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT i FROM range(10) t(i)

statement ok
DELETE FROM dl.t WHERE i = 5

# the older dev build wrote no heal marker
statement ok
DELETE FROM meta.ducklake_metadata WHERE key = 'heal_complete'

# simulate an older dev catalog that kept the delete ranges but lost the delete visibility
statement ok
ALTER TABLE meta.ducklake_delete_file ADD COLUMN begin_snapshot BIGINT

statement ok
ALTER TABLE meta.ducklake_delete_file ADD COLUMN end_snapshot BIGINT

statement ok
UPDATE meta.ducklake_delete_file SET begin_snapshot = v.snapshot_id FROM meta.ducklake_delete_file_visibility v WHERE v.branch_id = 0 AND v.is_delete = FALSE AND v.delete_file_id = ducklake_delete_file.delete_file_id

statement ok
UPDATE meta.ducklake_delete_file SET end_snapshot = v.snapshot_id FROM meta.ducklake_delete_file_visibility v WHERE v.branch_id = 0 AND v.is_delete = TRUE AND v.delete_file_id = ducklake_delete_file.delete_file_id

statement ok
DROP TABLE meta.ducklake_delete_file_visibility

statement ok
DETACH dl

# the writable attach rebuilds the delete visibility from the preserved ranges
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/dev1_partial_heal_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

query I
SELECT COUNT(*) FROM meta.ducklake_delete_file_visibility
----
1

query I
SELECT COUNT(*) FROM dl.t
----
9

# the older dev build wrote no heal marker
statement ok
DELETE FROM meta.ducklake_metadata WHERE key = 'heal_complete'

# losing the visibility rows without the ranges cannot be healed
statement ok
DROP TABLE meta.ducklake_file_visibility

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/dev1_partial_heal_files', METADATA_CATALOG 'meta')
----
Cannot heal
