# name: test/sql/migration/v20_inlined_registry_names.test
# description: a registered payload whose name carries another table is refused on the complete layout as well
# group: [migration]
require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 100, DUCKLAKE_VERSION '1.1')

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1),(2)

statement ok
DELETE FROM dl.t WHERE i=1

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (METADATA_CATALOG 'meta', AUTOMATIC_MIGRATION TRUE)

statement ok
DETACH dl

statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

statement ok
ALTER TABLE meta.ducklake_inlined_data_1_1 RENAME TO ducklake_inlined_data_42_1

statement ok
UPDATE meta.ducklake_inlined_data_tables SET table_name='ducklake_inlined_data_42_1' WHERE table_id=1

statement ok
DETACH meta

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (METADATA_CATALOG 'meta', READ_ONLY)

# the readers take the table of a version from the name of its payload, so the mismatch is refused before a read
statement error
SELECT list(i ORDER BY i) FROM dl.t
----
inlined data table ducklake_inlined_data_42_1 is registered for table 1

statement ok
DETACH dl

# the registry put right reads the live row alone
statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

statement ok
ALTER TABLE meta.ducklake_inlined_data_42_1 RENAME TO ducklake_inlined_data_1_1

statement ok
UPDATE meta.ducklake_inlined_data_tables SET table_name='ducklake_inlined_data_1_1' WHERE table_id=1

statement ok
DETACH meta

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (METADATA_CATALOG 'meta', READ_ONLY)

query I
SELECT list(i ORDER BY i) FROM dl.t
----
[2]
