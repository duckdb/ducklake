# name: test/sql/migration/v10_inlined_nested_types.test
# description: a v1.0 catalog with inlined LIST, MAP and STRUCT columns migrates to v1.1
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/v10_inlined_nested_types.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v10_inlined_nested_types', DATA_INLINING_ROW_LIMIT 10, DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE dl.t (id INTEGER, l INTEGER[], m MAP(VARCHAR, INTEGER), s STRUCT(a INTEGER))

statement ok
INSERT INTO dl.t VALUES (1, [1, 2], MAP {'a': 1}, {'a': 5}), (2, NULL, NULL, NULL)

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v10_inlined_nested_types', DATA_INLINING_ROW_LIMIT 10, DUCKLAKE_VERSION '1.1-dev1', AUTOMATIC_MIGRATION TRUE)

query IIII
SELECT id, l, m, s FROM dl.t ORDER BY id
----
1	[1, 2]	{a=1}	{'a': 5}
2	NULL	NULL	NULL

statement ok
INSERT INTO dl.t VALUES (3, [3], MAP {'b': 2}, {'a': 6})

statement ok
CALL ducklake_flush_inlined_data('dl')

query IIII
SELECT id, l, m, s FROM dl.t ORDER BY id
----
1	[1, 2]	{a=1}	{'a': 5}
2	NULL	NULL	NULL
3	[3]	{b=2}	{'a': 6}
