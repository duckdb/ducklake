# name: test/sql/migration/dev1_inlined_deletes_heal.test
# description: an inlined deletion table of an older dev build without the branch column is refused read only, heals on a writable attach and resumes after its column was added
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t AS SELECT range AS i FROM range(20)

statement ok
DELETE FROM dl.t WHERE i IN (1, 2)

statement ok
CREATE TABLE dl.u AS SELECT range AS i FROM range(20)

statement ok
DELETE FROM dl.u WHERE i = 3

query II
SELECT (SELECT count(*) FROM dl.t), (SELECT count(*) FROM dl.u)
----
18	19

# the older dev build wrote no heal marker
statement ok
DELETE FROM meta.ducklake_metadata WHERE key = 'heal_complete'

# the older dev build knew no branch of a deletion
statement ok
ALTER TABLE meta.ducklake_inlined_delete_1 DROP COLUMN branch_id

statement ok
ALTER TABLE meta.ducklake_inlined_delete_2 DROP COLUMN branch_id

statement ok
DETACH dl

# a read only attach cannot add the column
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', READ_ONLY)
----
attach it writable once

# the writable attach appends the column to every deletion table and reads the same deletions
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

query I
SELECT column_name FROM (SELECT DISTINCT column_index, column_name FROM duckdb_columns() WHERE database_name = 'meta' AND schema_name IN ('main', 'public') AND table_name = 'ducklake_inlined_delete_1') ORDER BY column_index
----
file_id
row_id
begin_snapshot
branch_id

query IIII
SELECT file_id, row_id, begin_snapshot, branch_id FROM meta.ducklake_inlined_delete_1 ORDER BY row_id
----
0	1	2	0
0	2	2	0

query IIII
SELECT file_id, row_id, begin_snapshot, branch_id FROM meta.ducklake_inlined_delete_2 ORDER BY row_id
----
1	3	4	0

query II
SELECT (SELECT count(*) FROM dl.t), (SELECT count(*) FROM dl.u)
----
18	19

# the healed catalog writes the branch of new deletions
statement ok
DELETE FROM dl.t WHERE i = 4

query IIII
SELECT file_id, row_id, begin_snapshot, branch_id FROM meta.ducklake_inlined_delete_1 ORDER BY row_id
----
0	1	2	0
0	2	2	0
0	4	5	0

# an interrupted heal wrote no marker
statement ok
DELETE FROM meta.ducklake_metadata WHERE key = 'heal_complete'

# a heal interrupted after the column of the first table was added, before its branches were filled and before the
# second table, resumes with the rest
statement ok
ALTER TABLE meta.ducklake_inlined_delete_1 DROP COLUMN branch_id

statement ok
ALTER TABLE meta.ducklake_inlined_delete_1 ADD COLUMN branch_id BIGINT

statement ok
ALTER TABLE meta.ducklake_inlined_delete_2 DROP COLUMN branch_id

query I
SELECT count(*) FILTER (WHERE branch_id IS NULL) FROM meta.ducklake_inlined_delete_1
----
3

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', READ_ONLY)
----
attach it writable once

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

query IIII
SELECT file_id, row_id, begin_snapshot, branch_id FROM meta.ducklake_inlined_delete_1 ORDER BY row_id
----
0	1	2	0
0	2	2	0
0	4	5	0

query IIII
SELECT file_id, row_id, begin_snapshot, branch_id FROM meta.ducklake_inlined_delete_2 ORDER BY row_id
----
1	3	4	0

query II
SELECT (SELECT count(*) FROM dl.t), (SELECT count(*) FROM dl.u)
----
17	19

# a healed catalog attaches read only
statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', READ_ONLY)

query I
SELECT count(*) FROM dl.t
----
17

statement ok
DETACH dl
