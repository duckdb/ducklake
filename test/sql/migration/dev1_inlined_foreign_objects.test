# name: test/sql/migration/dev1_inlined_foreign_objects.test
# description: a view and tables named like an inlined deletion table or a per payload companion without their columns are left alone by the probes of the metadata schema
# group: [migration]

require ducklake

require parquet

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{TEST_DIR}/{BASE_TEST_NAME}.db' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

# objects another tool keeps in the metadata schema
statement ok
CREATE VIEW meta.note AS SELECT 1 AS n

statement ok
CREATE TABLE meta.ducklake_inlined_delete_7 (note VARCHAR)

statement ok
CREATE TABLE meta.ducklake_inlined_data_1_1_visibility (note VARCHAR)

# the older dev build wrote no heal marker
statement ok
DELETE FROM meta.ducklake_metadata WHERE key = 'heal_complete'

statement ok
DETACH dl

# the probes skip the view and the tables without the columns of a deletion table or a companion and reach the missing marker
statement error
ATTACH 'ducklake:{TEST_DIR}/{BASE_TEST_NAME}.db' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', READ_ONLY)
----
no marker of a completed heal

# the heal of a writable attach skips them as well
statement ok
ATTACH 'ducklake:{TEST_DIR}/{BASE_TEST_NAME}.db' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files',
    METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

query I
SELECT i FROM dl.t
----
1

# the heal wrote its marker last
query I
SELECT value FROM meta.ducklake_metadata WHERE key = 'heal_complete'
----
2.0-dev1.4

statement ok
INSERT INTO dl.t VALUES (2)

query I
SELECT i FROM dl.t ORDER BY i
----
1
2

query I
SELECT n FROM meta.note
----
1

query I
SELECT count(*) FROM meta.ducklake_inlined_delete_7
----
0

query I
SELECT count(*) FROM meta.ducklake_inlined_data_1_1_visibility
----
0

statement ok
DETACH dl
