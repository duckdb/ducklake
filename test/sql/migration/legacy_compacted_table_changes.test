# name: test/sql/migration/legacy_compacted_table_changes.test
# description: snapshots() lists the compactions that older catalogs recorded as compacted_table
# group: [migration]

require ducklake

require parquet

unzip data/old_ducklake/compacted_files.db.gz {TEST_DIR}/legacy_compacted_table_changes.db

statement ok
ATTACH 'ducklake:{TEST_DIR}/legacy_compacted_table_changes.db' AS ducklake (DATA_PATH '{TEST_DIR}/legacy_compacted_table_changes', OVERRIDE_DATA_PATH TRUE, AUTOMATIC_MIGRATION TRUE)

# the migration of a catalog of an older release ends at the current version
query I
SELECT value FROM ducklake.options() WHERE option_name = 'version'
----
2.0-dev1

query I
SELECT COUNT(*) FROM __ducklake_metadata_ducklake.ducklake_snapshot_tag
----
0

query II
SELECT snapshot_id, changes FROM ducklake.snapshots() WHERE snapshot_id BETWEEN 7 AND 9 ORDER BY snapshot_id
----
7	{flushed_inlined=[1]}
8	{compacted_table=[1]}
9	{inlined_insert=[1]}

# snapshot 8 compacted table 1 with the legacy compacted_table change type
query II
SELECT snapshot_id, changes FROM ducklake.snapshots() WHERE snapshot_id IN (6, 7, 9) ORDER BY snapshot_id
----
6	{tables_inserted_into=[1]}
7	{flushed_inlined=[1]}
9	{inlined_insert=[1]}

query I
SELECT count(*) FROM ducklake.snapshots() WHERE snapshot_id = 8
----
1

query I
SELECT cardinality(changes) > 0 FROM ducklake.snapshots() WHERE snapshot_id = 8
----
true
