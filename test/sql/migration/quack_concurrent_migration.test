# name: test/sql/migration/quack_concurrent_migration.test
# description: concurrent attaches that migrate the same Quack catalog do not fail on the migration of another one
# group: [migration]

require ducklake

require parquet

require-env DUCKLAKE_CONNECTION quack:localhost:19999

require quack

test-env DATA_PATH {TEST_DIR}

loop round 0 6

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS setup${round} (DATA_PATH '{DATA_PATH}/concurrent_migration_${round}',
METADATA_SCHEMA 'concurrent_migration_${round}', DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE setup${round}.t (a INTEGER)

statement ok
INSERT INTO setup${round}.t VALUES (1)

statement ok
DETACH setup${round}

concurrentloop i 0 12

# FIXME: concurrent attaches in one process can abort each other's queries on a Quack server
statement maybe
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake${round}_${i} (DATA_PATH '{DATA_PATH}/concurrent_migration_${round}',
METADATA_SCHEMA 'concurrent_migration_${round}', AUTOMATIC_MIGRATION TRUE)
----
superseded by a new query

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS check${round} (DATA_PATH '{DATA_PATH}/concurrent_migration_${round}',
METADATA_SCHEMA 'concurrent_migration_${round}')

query I
SELECT count(*) FROM check${round}.t
----
1

statement ok
DETACH check${round}

endloop
