# name: test/sql/migration/v20_file_events_migration_resume.test
# description: the migration to 2.0-dev1 resumes from file tables an interrupted step left renamed
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT range AS i FROM range(10)

statement ok
INSERT INTO dl.t SELECT range FROM range(10, 20)

statement ok
DELETE FROM dl.t WHERE i = 3

statement ok
DELETE FROM dl.t WHERE i >= 10

statement ok
DETACH dl

# the step moves the file tables aside before it turns their ranges into events, an interruption leaves them there
statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

statement ok
ALTER TABLE meta.ducklake_data_file RENAME TO ducklake_data_file_ranges

statement ok
ALTER TABLE meta.ducklake_delete_file RENAME TO ducklake_delete_file_ranges

statement ok
DETACH meta

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', AUTOMATIC_MIGRATION TRUE)

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

query IIIII
SELECT branch_id, table_id, data_file_id, snapshot_id, is_delete::BOOLEAN FROM meta.ducklake_file_visibility ORDER BY data_file_id, is_delete
----
0	1	0	1	false
0	1	1	2	false
0	1	1	4	true

query IIIII
SELECT branch_id, table_id, delete_file_id, snapshot_id, is_delete::BOOLEAN FROM meta.ducklake_delete_file_visibility ORDER BY delete_file_id, is_delete
----
0	1	2	3	false

query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'meta' AND schema_name IN ('main', 'public') AND table_name IN ('ducklake_data_file', 'ducklake_data_file_ranges', 'ducklake_delete_file', 'ducklake_delete_file_ranges', 'ducklake_file_visibility', 'ducklake_delete_file_visibility') ORDER BY table_name
----
ducklake_data_file
ducklake_delete_file
ducklake_delete_file_visibility
ducklake_file_visibility

query I
SELECT column_name FROM duckdb_columns() WHERE database_name = 'meta' AND table_name IN ('ducklake_data_file', 'ducklake_delete_file') AND column_name IN ('begin_snapshot', 'end_snapshot')
----

query II
SELECT count(*), sum(i) FROM dl.t
----
9	42

query I
SELECT count(*) FROM dl.t AT (VERSION => 2)
----
20

statement ok
DETACH dl
