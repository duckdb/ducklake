# name: test/sql/migration/migration_load_error.test
# description: a load error after a migration fails the attach at once, without the retries of a migration
# group: [migration]

require ducklake

require parquet

test-env DATA_PATH {TEST_DIR}

statement ok
CREATE TABLE metadata_reads(retries INTEGER, reads BIGINT)

statement ok
SET ducklake_retry_wait_ms = 1

# the rename of the snapshot tables commits before the load error, so every round migrates its own catalog
foreach retries 0 8

statement ok
ATTACH 'ducklake:{TEST_DIR}/migration_load_error_{retries}.db' AS setup
(DATA_PATH '{DATA_PATH}/migration_load_error_{retries}', DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE setup.t (a INTEGER)

statement ok
DETACH setup

statement ok
SET ducklake_max_retry_count = {retries}

statement ok
CALL enable_logging('DuckLakeMetadata')

# the migration succeeds and the data path that follows does not match
statement error
ATTACH 'ducklake:{TEST_DIR}/migration_load_error_{retries}.db' AS dl (DATA_PATH '{DATA_PATH}/other',
METADATA_CATALOG 'meta', AUTOMATIC_MIGRATION TRUE)
----
does not match existing data path

statement ok
CALL disable_logging()

statement ok
INSERT INTO metadata_reads SELECT {retries}, count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')

statement ok
CALL truncate_duckdb_logs()

endloop

query I
SELECT max(reads) FILTER (retries = 0) = max(reads) FILTER (retries = 8) FROM metadata_reads
----
true

# the failed attach left a 2.0-dev1 catalog, its snapshot tables renamed
statement ok
DETACH DATABASE IF EXISTS meta

statement ok
ATTACH '{TEST_DIR}/migration_load_error_8.db' AS meta

query I
SELECT value FROM meta.ducklake_metadata WHERE key = 'version'
----
2.0-dev1

query I
SELECT list(table_name ORDER BY table_name) FROM duckdb_tables() WHERE database_name = 'meta'
AND table_name LIKE 'ducklake_snapshot%'
----
[ducklake_snapshot_changes_old, ducklake_snapshot_old, ducklake_snapshot_tag]

statement ok
DETACH meta

# an attach without the migration option refuses the dev version
statement error
ATTACH 'ducklake:{TEST_DIR}/migration_load_error_8.db' AS dl (DATA_PATH '{DATA_PATH}/migration_load_error_8',
METADATA_CATALOG 'meta')
----
catalog version is 2.0-dev1, but the extension requires version 2.0-dev2

# the next writable attach with the migration option completes the migration
statement ok
ATTACH 'ducklake:{TEST_DIR}/migration_load_error_8.db' AS dl (DATA_PATH '{DATA_PATH}/migration_load_error_8',
METADATA_CATALOG 'meta', AUTOMATIC_MIGRATION TRUE)

query I
SELECT count(*) FROM dl.t
----
0

query I
SELECT value FROM meta.ducklake_metadata WHERE key = 'version'
----
2.0-dev2

query I
SELECT list(table_name ORDER BY table_name) FROM duckdb_tables() WHERE database_name = 'meta'
AND table_name LIKE 'ducklake_snapshot%'
----
[ducklake_snapshot, ducklake_snapshot_changes, ducklake_snapshot_tag]
