# name: test/sql/migration/migration_load_error.test
# description: a load error after a migration fails the attach at once, without the retries of a migration
# group: [migration]

require ducklake

require parquet

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{TEST_DIR}/migration_load_error.db' AS setup (DATA_PATH '{DATA_PATH}/migration_load_error',
DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE setup.t (a INTEGER)

statement ok
DETACH setup

statement ok
CREATE TABLE metadata_reads(retries INTEGER, reads BIGINT)

statement ok
SET ducklake_retry_wait_ms = 1

foreach retries 0 8

statement ok
SET ducklake_max_retry_count = {retries}

statement ok
CALL enable_logging('DuckLakeMetadata')

# the migration succeeds and the data path that follows does not match
statement error
ATTACH 'ducklake:{TEST_DIR}/migration_load_error.db' AS dl (DATA_PATH '{DATA_PATH}/other', AUTOMATIC_MIGRATION TRUE)
----
does not match existing data path

statement ok
CALL disable_logging()

statement ok
INSERT INTO metadata_reads SELECT {retries}, count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')

statement ok
CALL truncate_duckdb_logs()

endloop

query I
SELECT max(reads) FILTER (retries = 0) = max(reads) FILTER (retries = 8) FROM metadata_reads
----
true
