# name: test/sql/migration/v20_inlined_dropped_table_rows.test
# description: the migration to 2.0-dev1 names the expiry for the inlined rows and deletions of a dropped table, which no flush reaches
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DUCKLAKE_VERSION '1.1', DATA_INLINING_ROW_LIMIT 10)

# snapshot 1 creates keep, 2 fills it, 3 creates d, 4 fills it, 5 creates f with a file, 6 inlines a deletion of f
statement ok
CREATE TABLE dl.keep (i INTEGER)

statement ok
INSERT INTO dl.keep VALUES (1)

statement ok
CREATE TABLE dl.d (i INTEGER)

statement ok
INSERT INTO dl.d VALUES (7), (8)

statement ok
CREATE TABLE dl.f AS SELECT range AS i FROM range(100)

statement ok
DELETE FROM dl.f WHERE i = 5

# snapshot 7 drops d, 8 drops f
statement ok
DROP TABLE dl.d

statement ok
DROP TABLE dl.f

query I
SELECT i FROM dl.d AT (VERSION => 4) ORDER BY i
----
7
8

# the flush reaches the tables of the current snapshot alone
statement ok
CALL ducklake_flush_inlined_data('dl')

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE, DATA_INLINING_ROW_LIMIT 10)
----
inlined data table ducklake_inlined_data_2_2 holds rows of the dropped table d, kept for time travel, and the migration to 2.0 converts no inlined rows. Attach the catalog at its current version, expire the snapshots that read the table with ducklake_expire_snapshots and attach again with the migration

# the catalog stays at its version and still reads the history of the dropped table
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DATA_INLINING_ROW_LIMIT 10)

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
1.1

query I
SELECT i FROM dl.d AT (VERSION => 4) ORDER BY i
----
7
8

# without the snapshots that read d its payload is gone, the deletion of f is kept for snapshot 7
statement ok
CALL ducklake_expire_snapshots('dl', versions => [3, 4, 5, 6])

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE, DATA_INLINING_ROW_LIMIT 10)
----
inlined deletion table ducklake_inlined_delete_3 holds rows of the dropped table f, kept for time travel, and the migration to 2.0 converts no inlined rows

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DATA_INLINING_ROW_LIMIT 10)

statement ok
CALL ducklake_expire_snapshots('dl', versions => [7])

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE, DATA_INLINING_ROW_LIMIT 10)

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

query I
SELECT i FROM dl.keep
----
1

# the kept table inlines again
statement ok
INSERT INTO dl.keep VALUES (2)

query I
SELECT i FROM dl.keep ORDER BY i
----
1
2
