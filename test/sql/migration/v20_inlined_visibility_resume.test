# name: test/sql/migration/v20_inlined_visibility_resume.test
# description: the migration to 2.0-dev1 resumes the inlined data visibility from the state an interrupted step left
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DATA_INLINING_ROW_LIMIT 10)

# snapshot 1 creates t, 2 fills it, 3 deletes a row, 4 creates u, 5 fills it, 6 deletes a row, 7 creates f with a
# data file, 8 inlines a deletion of its rows
statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

statement ok
DELETE FROM dl.t WHERE i = 2

statement ok
CREATE TABLE dl.u(i INTEGER)

statement ok
INSERT INTO dl.u VALUES (1), (2)

statement ok
DELETE FROM dl.u WHERE i = 1

statement ok
CREATE TABLE dl.f AS SELECT range AS i FROM range(100)

statement ok
DELETE FROM dl.f WHERE i = 5

query IIIIII
FROM meta.ducklake_inlined_data_visibility ORDER BY ALL
----
1	1	0	2	0	3
2	0	0	5	0	6

statement ok
DETACH dl

# the interrupted step converted the payload of u into the pending companion and left the payload of t and the
# deletion table of f untouched
statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

statement ok
ALTER TABLE meta.ducklake_inlined_data_1_1 ADD COLUMN _ducklake_end_snapshot BIGINT

statement ok
UPDATE meta.ducklake_inlined_data_1_1 SET _ducklake_end_snapshot = (SELECT e.snapshot_id
    FROM meta.ducklake_inlined_data_visibility e
    WHERE e.table_id = 1 AND e.row_id = ducklake_inlined_data_1_1._ducklake_row_id
    AND e.row_snapshot = ducklake_inlined_data_1_1._ducklake_begin_snapshot)

statement ok
ALTER TABLE meta.ducklake_inlined_data_1_1 DROP COLUMN _ducklake_branch_id

statement ok
DELETE FROM meta.ducklake_inlined_data_visibility WHERE table_id = 1

statement ok
ALTER TABLE meta.ducklake_inlined_data_visibility RENAME TO ducklake_inlined_data_visibility_pending

statement ok
ALTER TABLE meta.ducklake_inlined_delete_3 DROP COLUMN branch_id

statement ok
DETACH meta

# the incomplete layout is refused without the migration option
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta')
----
catalog version is 2.0-dev1, but the catalog lacks the inlined data visibility

# a read only attach cannot migrate
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    READ_ONLY, AUTOMATIC_MIGRATION TRUE)
----
read-only mode

# the writable attach completes the step
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE)

query IIIIII
FROM meta.ducklake_inlined_data_visibility ORDER BY ALL
----
1	1	0	2	0	3
2	0	0	5	0	6

query I
SELECT column_name FROM (SELECT DISTINCT column_index, column_name FROM duckdb_columns()
    WHERE database_name = 'meta' AND schema_name IN ('main', 'public') AND table_name = 'ducklake_inlined_data_1_1')
ORDER BY column_index
----
_ducklake_row_id
_ducklake_begin_snapshot
i
_ducklake_branch_id

query III
SELECT row_id, begin_snapshot, branch_id FROM meta.ducklake_inlined_delete_3
----
5	8	0

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE database_name = 'meta' AND schema_name IN ('main', 'public')
    AND table_name LIKE '%_visibility_pending'
----
0

query I
SELECT i FROM dl.t ORDER BY i
----
1
3

query I
SELECT i FROM dl.t AT (VERSION => 2) ORDER BY i
----
1
2
3

query I
SELECT i FROM dl.u ORDER BY i
----
2

query I
SELECT COUNT(*) FROM dl.f
----
99

statement ok
DETACH dl

# a companion left under its pending name waits for the rename into place, the last statement of the step
statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

statement ok
ALTER TABLE meta.ducklake_inlined_data_visibility RENAME TO ducklake_inlined_data_visibility_pending

statement ok
DETACH meta

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta')
----
catalog version is 2.0-dev1, but the catalog lacks the inlined data visibility

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE)

query I
SELECT COUNT(*) FROM meta.ducklake_inlined_data_visibility
----
2

query I
SELECT i FROM dl.t AT (VERSION => 2) ORDER BY i
----
1
2
3

statement ok
DETACH dl

# a missing companion held the ends of the payloads without end column, so the migration refuses it
statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

statement ok
DROP TABLE meta.ducklake_inlined_data_visibility

statement ok
DETACH meta

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta')
----
catalog version is 2.0-dev1, but the catalog lacks the inlined data visibility

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE)
----
the end snapshots of the inlined rows of ducklake_inlined_data_1_1 were dropped and the end rows that replaced them are missing
