# name: test/sql/migration/global_scope_migration.test
# description: Migrating to v1.1 names the global option scope, and refuses options with conflicting rows
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/global_scope_migration.db

test-env DATA_PATH {TEST_DIR}

# a v1.0 catalog stores global options with a NULL scope and allows duplicate rows
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/global_scope_migration', METADATA_CATALOG 'ducklake_meta', DUCKLAKE_VERSION '1.0')

statement ok
SET VARIABLE before_option = (SELECT max(snapshot_id) FROM ducklake.snapshots())

statement ok
CALL ducklake.set_option('parquet_compression', 'gzip')

# nor does setting an option commit a snapshot, so v1.0 readers never see a set_option change
query I
SELECT count(*) FROM ducklake.snapshots() WHERE snapshot_id > getvariable('before_option')
----
0

statement ok
CALL ducklake.set_option('target_file_size', '1MB')

statement ok
INSERT INTO ducklake_meta.ducklake_metadata (key, value, scope, scope_id) SELECT key, value, scope, scope_id FROM ducklake_meta.ducklake_metadata WHERE key = 'target_file_size'

statement ok
INSERT INTO ducklake_meta.ducklake_metadata (key, value, scope, scope_id) VALUES ('parquet_compression', 'zstd', NULL, NULL)

statement ok
DETACH ducklake

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/global_scope_migration', METADATA_CATALOG 'ducklake_meta', AUTOMATIC_MIGRATION TRUE)
----
option "parquet_compression" has more than one value

# the catalog is still at v1.0, where the user picks the value to keep
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/global_scope_migration', METADATA_CATALOG 'ducklake_meta')

statement ok
DELETE FROM ducklake_meta.ducklake_metadata WHERE key = 'parquet_compression' AND value = 'gzip'

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/global_scope_migration', METADATA_CATALOG 'ducklake_meta', AUTOMATIC_MIGRATION TRUE)

# the identical rows of target_file_size collapse into one
query I
SELECT count(*) FROM ducklake_meta.ducklake_metadata WHERE key = 'target_file_size'
----
1

query III
SELECT value, scope, scope_id FROM ducklake_meta.ducklake_metadata WHERE key = 'parquet_compression'
----
zstd	global	0

query I
SELECT count(*) FROM ducklake_meta.ducklake_metadata WHERE scope IS NULL
----
0

query I
SELECT value FROM ducklake.options() WHERE option_name = 'parquet_compression'
----
zstd

statement error
INSERT INTO ducklake_meta.ducklake_metadata (key, value, scope, scope_id, begin_snapshot) VALUES ('parquet_compression', 'gzip', 'global', 0, 0)
----
