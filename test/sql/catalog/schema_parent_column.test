# name: test/sql/catalog/schema_parent_column.test
# description: New 1.1 catalogs store a nullable schema parent without changing flat schema operations
# group: [catalog]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/schema_parent_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1-dev1')

statement ok
CREATE SCHEMA ducklake.s;

statement ok
DETACH ducklake;

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/schema_parent_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1-dev1')

query II
SELECT schema_name, parent_schema_id FROM meta.ducklake_schema ORDER BY schema_name;
----
main	NULL
s	NULL

statement ok
DROP SCHEMA ducklake.s;

query II
SELECT schema_name, end_snapshot IS NULL FROM meta.ducklake_schema ORDER BY schema_name;
----
main	true
s	false
