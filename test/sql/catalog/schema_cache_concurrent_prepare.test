# name: test/sql/catalog/schema_cache_concurrent_prepare.test
# description: Concurrent prepared inserts retain a live schema cache entry
# group: [catalog]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/schema_cache_concurrent_prepare', DATA_INLINING_ROW_LIMIT 0)

statement ok
SET threads=1

statement ok
SET ducklake_max_retry_count=100

statement ok
CREATE TABLE lake.target(i INTEGER)

statement ok
