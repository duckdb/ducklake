loop iteration 0 5

statement ok
CREATE OR REPLACE TABLE lake.churn AS SELECT 42 AS i

concurrentloop threadid 0 8

statement ok
PREPARE ins AS INSERT INTO lake.target VALUES ({threadid})

sleep 100 millisecond

statement ok
