# name: test/sql/catalog/nested_schema/nested_scan_serialization.test
# description: DuckLake scans of tables in nested schemas survive plan serialization
# group: [nested_schema]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DUCKLAKE_VERSION '1.1-dev1', DATA_PATH '{DATA_PATH}/nested_scan_serialization_files')

statement ok
CREATE SCHEMA ducklake.s1;

statement ok
CREATE SCHEMA ducklake.s1.child;

statement ok
CREATE SCHEMA ducklake.s1.child.grandchild;

statement ok
CREATE SCHEMA ducklake."x.y";

statement ok
CREATE TABLE ducklake.s1.t(i INTEGER);

statement ok
CREATE TABLE ducklake.s1.child.t(i INTEGER);

statement ok
CREATE TABLE ducklake.s1.child.grandchild.t(i INTEGER);

statement ok
CREATE TABLE ducklake."x.y".t(i INTEGER);

statement ok
INSERT INTO ducklake.s1.t VALUES (1);

statement ok
INSERT INTO ducklake.s1.child.t VALUES (1), (2);

statement ok
INSERT INTO ducklake.s1.child.grandchild.t VALUES (1), (2), (3);

statement ok
INSERT INTO ducklake."x.y".t VALUES (1), (2), (3), (4);

# FIXME: DuckDB fails to bind catalog-qualified nested schema references in views
mode skip

statement ok
CREATE VIEW ducklake.s1.child.v AS SELECT i * 10 AS x FROM ducklake.s1.child.t;

mode unskip

statement ok
SET SESSION debug_verify_serializer = true;

query I
SELECT count(*) FROM ducklake.s1.t
----
1

query I
SELECT count(*) FROM ducklake.s1.child.t
----
2

query I
SELECT count(*) FROM ducklake.s1.child.grandchild.t
----
3

query I
SELECT count(*) FROM ducklake."x.y".t
----
4

# FIXME: DuckDB fails to bind catalog-qualified nested schema references in views
mode skip

query I
SELECT sum(x) FROM ducklake.s1.child.v
----
30

mode unskip

query I
SELECT count(*) FROM ducklake.s1.child.grandchild.t AT (VERSION => 11)
----
3

# the same nested path resolves to the still-empty table one snapshot earlier
query I
SELECT count(*) FROM ducklake.s1.child.grandchild.t AT (VERSION => 10)
----
0

query I
SELECT count(*) FROM ducklake_table_insertions('ducklake', 's1.child.grandchild', 't', 10, 11)
----
3

query I
SELECT count(*) FROM ducklake.s1.child.t t1 JOIN ducklake.s1.child.grandchild.t t2 USING (i)
----
2
