# name: test/sql/catalog/nested_schema/quoted_schema_helpers.test
# description: Escaped quotes survive schema arguments and metadata reloads
# group: [nested_schema]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DUCKLAKE_VERSION '1.1-dev1', DATA_PATH '{DATA_PATH}/quoted_schema_helpers');

statement ok
CREATE SCHEMA dl.s;

statement ok
CREATE SCHEMA dl.s."quo""ted";

statement ok
CREATE TABLE dl.s."quo""ted".t AS SELECT 42 AS i;

statement ok
CREATE VIEW dl.s."quo""ted".v AS SELECT i AS "a""b" FROM dl.s."quo""ted".t;

statement ok
CALL ducklake_set_option('dl', 'parquet_compression', 'lz4', schema => 's."quo""ted"');

query II
SELECT value, scope_entry FROM dl.options() WHERE scope = 'SCHEMA' AND option_name = 'parquet_compression';
----
lz4	s."quo""ted"

query I
SELECT "a""b" FROM dl.s."quo""ted".v;
----
42

statement ok
DETACH dl;

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DUCKLAKE_VERSION '1.1-dev1', DATA_PATH '{DATA_PATH}/quoted_schema_helpers');

query I
SELECT i FROM dl.s."quo""ted".t;
----
42

query I
SELECT "a""b" FROM dl.s."quo""ted".v;
----
42

statement ok
DROP SCHEMA dl.s CASCADE;
