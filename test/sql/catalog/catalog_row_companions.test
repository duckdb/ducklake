# name: test/sql/catalog/catalog_row_companions.test
# description: the version rows of schemas, tables and views keep their birth and end in companion tables
# group: [catalog]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DATA_INLINING_ROW_LIMIT 0)

# snapshot 1 creates s, 2 creates t, 3 creates v, 4 fills t
statement ok
CREATE SCHEMA dl.s

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
CREATE VIEW dl.v AS SELECT 1 AS x

statement ok
INSERT INTO dl.t VALUES (1)

# snapshots 5 and 6 rename the table and the view, 7 creates a table in the schema, 8 to 10 drop all of them
statement ok
ALTER TABLE dl.t RENAME TO t2

statement ok
ALTER VIEW dl.v RENAME TO v2

statement ok
CREATE TABLE dl.s.u AS SELECT 2 AS j

statement ok
DROP TABLE dl.t2

statement ok
DROP VIEW dl.v2

statement ok
DROP SCHEMA dl.s CASCADE

# a rename writes a new version row and ends the old one, a drop ends the live row
query IIII
SELECT table_name, begin_snapshot, branch_id, (SELECT e.snapshot_id FROM meta.ducklake_table_visibility e
    WHERE e.table_id = t.table_id AND e.row_branch_id = t.branch_id AND e.row_snapshot = t.begin_snapshot)
FROM meta.ducklake_table t ORDER BY begin_snapshot
----
t	2	0	5
t2	5	0	8
u	7	0	10

query IIII
SELECT view_name, begin_snapshot, branch_id, (SELECT e.snapshot_id FROM meta.ducklake_view_visibility e
    WHERE e.view_id = v.view_id AND e.row_branch_id = v.branch_id AND e.row_snapshot = v.begin_snapshot)
FROM meta.ducklake_view v ORDER BY begin_snapshot
----
v	3	0	6
v2	6	0	9

query IIII
SELECT schema_name, begin_snapshot, branch_id, (SELECT e.snapshot_id FROM meta.ducklake_schema_visibility e
    WHERE e.schema_id = s.schema_id AND e.row_branch_id = s.branch_id AND e.row_snapshot = s.begin_snapshot)
FROM meta.ducklake_schema s ORDER BY begin_snapshot
----
main	0	0	NULL
s	1	0	10

# an end names the row by its birth and carries the branch that ended it
query IIII
SELECT e.branch_id, t.table_name, e.row_snapshot, e.snapshot_id
FROM meta.ducklake_table_visibility e
JOIN meta.ducklake_table t ON t.table_id = e.table_id AND t.branch_id = e.row_branch_id
    AND t.begin_snapshot = e.row_snapshot
ORDER BY e.snapshot_id
----
0	t	2	5
0	t2	5	8
0	u	7	10

# one end per row per branch
statement error
INSERT INTO meta.ducklake_table_visibility SELECT * FROM meta.ducklake_table_visibility WHERE snapshot_id = 5
----
constraint

# the head reads none of them, time travel reads the earlier states
statement error
SELECT * FROM dl.t
----
does not exist

statement error
SELECT * FROM dl.t2
----
does not exist

query I
SELECT i FROM dl.t AT (VERSION => 4)
----
1

query I
SELECT i FROM dl.t2 AT (VERSION => 7)
----
1

query I
SELECT x FROM dl.v AT (VERSION => 5)
----
1

query I
SELECT x FROM dl.v2 AT (VERSION => 8)
----
1

query I
SELECT j FROM dl.s.u AT (VERSION => 7)
----
2

query I
SELECT COUNT(*) FROM duckdb_schemas() WHERE database_name = 'dl' AND schema_name = 's'
----
0

query I
SELECT COUNT(*) FROM ducklake_table_info('dl')
----
0

# a table created and renamed in one transaction has one version row and no end, snapshot 11
statement ok
BEGIN

statement ok
CREATE TABLE dl.a(i INTEGER)

statement ok
ALTER TABLE dl.a RENAME TO b

statement ok
COMMIT

query III
SELECT table_name, begin_snapshot, (SELECT COUNT(*) FROM meta.ducklake_table_visibility e WHERE e.table_id = t.table_id)
FROM meta.ducklake_table t WHERE begin_snapshot = 11
----
b	11	0

# a replaced view ends the old row in the commit that bears the new one, snapshots 12 and 13
statement ok
CREATE VIEW dl.w AS SELECT 1 AS y

statement ok
CREATE OR REPLACE VIEW dl.w AS SELECT 2 AS y

query III
SELECT v.begin_snapshot, e.row_snapshot, e.snapshot_id
FROM meta.ducklake_view v
LEFT JOIN meta.ducklake_view_visibility e ON e.view_id = v.view_id AND e.row_branch_id = v.branch_id
    AND e.row_snapshot = v.begin_snapshot
WHERE v.view_name = 'w' ORDER BY v.begin_snapshot
----
12	12	13
13	NULL	NULL

query I
SELECT y FROM dl.w
----
2

query I
SELECT y FROM dl.w AT (VERSION => 12)
----
1

statement ok
DETACH dl

# a fresh attach reads the same catalog
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DATA_INLINING_ROW_LIMIT 0)

query I
SELECT table_name FROM ducklake_table_info('dl')
----
b

query I
SELECT y FROM dl.w
----
2

query I
SELECT i FROM dl.t2 AT (VERSION => 7)
----
1

statement ok
DETACH dl
