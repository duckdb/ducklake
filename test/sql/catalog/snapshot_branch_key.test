# name: test/sql/catalog/snapshot_branch_key.test
# description: a new catalog keys its snapshot tables by branch and snapshot, seeds the main branch and commits on it
# group: [catalog]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta')

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev1

# the branch table holds the main branch alone
query IIII
SELECT branch_id, branch_name, parent_id, parent_branch_snapshot FROM meta.ducklake_branch
----
0	main	NULL	NULL

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
INSERT INTO dl.t VALUES (43)

# a commit takes the head of main plus one
query II
SELECT snapshot_id, branch_id FROM meta.ducklake_snapshot ORDER BY snapshot_id
----
0	0
1	0
2	0

query II
SELECT snapshot_id, branch_id FROM meta.ducklake_snapshot_changes ORDER BY snapshot_id
----
0	0
1	0
2	0

# the primary keys are (branch_id, snapshot_id), so a snapshot id repeats on another branch but not on main
statement error
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id,
    branch_id)
SELECT snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, 0
FROM meta.ducklake_snapshot WHERE snapshot_id = 1
----
constraint

statement error
INSERT INTO meta.ducklake_snapshot_changes (snapshot_id, changes_made, author, commit_message, commit_extra_info,
    branch_id)
SELECT snapshot_id, changes_made, author, commit_message, commit_extra_info, 0
FROM meta.ducklake_snapshot_changes WHERE snapshot_id = 1
----
constraint

# the key admits the snapshot id of main on another branch, which nothing writes before branches exist
statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id,
    branch_id)
SELECT snapshot_id, snapshot_time, 7, next_catalog_id, next_file_id, 1
FROM meta.ducklake_snapshot WHERE snapshot_id = 1

statement ok
INSERT INTO meta.ducklake_snapshot_changes (snapshot_id, changes_made, author, commit_message, commit_extra_info,
    branch_id)
SELECT snapshot_id, changes_made, 'dev', 'on a branch', commit_extra_info, 1
FROM meta.ducklake_snapshot_changes WHERE snapshot_id = 1

query II
SELECT snapshot_id, branch_id FROM meta.ducklake_snapshot ORDER BY branch_id, snapshot_id
----
0	0
1	0
2	0
1	1

query II
SELECT snapshot_id, branch_id FROM meta.ducklake_snapshot_changes ORDER BY branch_id, snapshot_id
----
0	0
1	0
2	0
1	1

# the readers of this version take every row for main, so the rows of the branch are removed again
statement ok
DELETE FROM meta.ducklake_snapshot WHERE branch_id = 1

statement ok
DELETE FROM meta.ducklake_snapshot_changes WHERE branch_id = 1

query IIII
SELECT snapshot_id, schema_version, author, commit_message FROM dl.snapshots() ORDER BY snapshot_id
----
0	0	NULL	NULL
1	1	NULL	NULL
2	1	NULL	NULL

query I
SELECT i FROM dl.t AT (VERSION => 1)
----
42

query I
SELECT i FROM dl.t AT (VERSION => 2) ORDER BY i
----
42
43

# a commit takes the head of main plus one
statement ok
INSERT INTO dl.t VALUES (44)

query II
SELECT snapshot_id, branch_id FROM meta.ducklake_snapshot ORDER BY snapshot_id
----
0	0
1	0
2	0
3	0

query I
SELECT list(snapshot_id ORDER BY snapshot_id) FROM dl.snapshots()
----
[0, 1, 2, 3]

statement ok
DETACH dl

# the catalog is attached again without a migration
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta')

statement ok
INSERT INTO dl.t VALUES (45)

query I
SELECT list(snapshot_id ORDER BY snapshot_id) FROM dl.snapshots()
----
[0, 1, 2, 3, 4]

query I
SELECT list(i ORDER BY i) FROM dl.t
----
[42, 43, 44, 45]

statement ok
DETACH dl
