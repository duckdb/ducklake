# a failing native read reports the error of the read with the statement SQLite ran
statement ok
ATTACH '{TEST_DIR}/sqlite_native_head_and_stats.db' AS raw (TYPE sqlite)

statement ok
DROP TABLE raw.ducklake_table_column_stats

statement ok
DETACH raw

statement ok
ATTACH 'ducklake:sqlite:{TEST_DIR}/sqlite_native_head_and_stats.db' AS sl (DATA_INLINING_ROW_LIMIT 0)

statement error
SELECT count(*), sum(i), count(s) FROM sl.t
----
<REGEX>:.*Failed to get global stats information from DuckLake.*Statement: SELECT \* FROM sqlite_query\(.*ducklake_table_stats.*

statement ok
ATTACH '{TEST_DIR}/sqlite_native_head_and_stats.db' AS raw (TYPE sqlite)

statement ok
DROP TABLE raw.ducklake_snapshot

statement ok
DETACH raw

statement error
SELECT count(*), sum(i), count(s) FROM sl.t
----
<REGEX>:.*Failed to query most recent snapshot for DuckLake.*Statement: SELECT \* FROM sqlite_query\(.*ducklake_snapshot.*
