# name: test/sql/compaction/user_columns_named_like_internal_columns.test
# description: compaction keeps the row ids and snapshot ids of tables whose columns have the names of internal columns
# group: [compaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

# a 1.0 catalog without inlining accepts these column names
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/user_columns_named_like_internal_columns', DUCKLAKE_VERSION '1.0', DATA_INLINING_ROW_LIMIT 0)

# rewriting a file writes row ids
statement ok
CREATE TABLE lake.t (id INTEGER, _ducklake_internal_row_id BIGINT)

statement ok
INSERT INTO lake.t SELECT i, 1000 + i FROM range(10) r(i)

statement ok
DELETE FROM lake.t WHERE id < 5

statement ok
CALL ducklake_rewrite_data_files('lake', 't', delete_threshold => 0.1)

# the columns of the user have stats in the new file
query I
SELECT list(c.column_name ORDER BY c.column_name)
FROM __ducklake_metadata_lake.ducklake_file_column_stats st
JOIN __ducklake_metadata_lake.ducklake_data_file f USING (data_file_id)
JOIN __ducklake_metadata_lake.ducklake_column c ON c.table_id = st.table_id AND c.column_id = st.column_id AND c.end_snapshot IS NULL
JOIN __ducklake_metadata_lake.ducklake_table t ON t.table_id = st.table_id AND t.end_snapshot IS NULL
WHERE t.table_name = 't' AND f.end_snapshot IS NULL
----
[_ducklake_internal_row_id, id]

statement ok
DELETE FROM lake.t WHERE id = 5

statement ok
UPDATE lake.t SET _ducklake_internal_row_id = 0 WHERE id = 6

query II
SELECT id, _ducklake_internal_row_id FROM lake.t ORDER BY id
----
6	0
7	1007
8	1008
9	1009

# merging files writes snapshot ids, and the name of the internal row id skips a suffix that a column has
statement ok
CREATE TABLE lake.s (id INTEGER, _ducklake_internal_snapshot_id BIGINT, _ducklake_internal_row_id BIGINT, _ducklake_internal_row_id_1 BIGINT)

statement ok
INSERT INTO lake.s VALUES (1, 100, 10, 11)

statement ok
SET VARIABLE v = (SELECT max(snapshot_id) FROM lake.snapshots())

statement ok
INSERT INTO lake.s VALUES (2, 200, 20, 21)

statement ok
CALL ducklake_merge_adjacent_files('lake', 's')

# the columns of the user have stats in the new file
query I
SELECT list(c.column_name ORDER BY c.column_name)
FROM __ducklake_metadata_lake.ducklake_file_column_stats st
JOIN __ducklake_metadata_lake.ducklake_data_file f USING (data_file_id)
JOIN __ducklake_metadata_lake.ducklake_column c ON c.table_id = st.table_id AND c.column_id = st.column_id AND c.end_snapshot IS NULL
JOIN __ducklake_metadata_lake.ducklake_table t ON t.table_id = st.table_id AND t.end_snapshot IS NULL
WHERE t.table_name = 's' AND f.end_snapshot IS NULL
----
[_ducklake_internal_row_id, _ducklake_internal_row_id_1, _ducklake_internal_snapshot_id, id]

query IIII
SELECT * FROM lake.s AT (VERSION => getvariable('v'))
----
1	100	10	11

statement ok
DELETE FROM lake.s WHERE id = 2

query IIII
SELECT * FROM lake.s
----
1	100	10	11

# names differ from internal ones only in case
statement ok
CREATE TABLE lake.u (id INTEGER, "_DuckLake_Internal_Row_Id" BIGINT)

statement ok
INSERT INTO lake.u SELECT i, i FROM range(10) r(i)

statement ok
DELETE FROM lake.u WHERE id < 5

statement ok
CALL ducklake_rewrite_data_files('lake', 'u', delete_threshold => 0.1)

statement ok
DELETE FROM lake.u WHERE id = 5

query II
SELECT count(*), sum("_DuckLake_Internal_Row_Id") FROM lake.u
----
4	30
