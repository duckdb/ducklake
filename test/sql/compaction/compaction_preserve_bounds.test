# name: test/sql/compaction/compaction_preserve_bounds.test
# description: Partial rewrites retain conservative bounds without making stale extrema exact
# group: [compaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/compaction_preserve_bounds.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/refresh_bounds', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.r(i INTEGER, j INTEGER)

statement ok
INSERT INTO lake.r VALUES (1, 10), (2, 20)

statement ok
INSERT INTO lake.r VALUES (3, 30), (4, 40), (5, 50), (6, 60)

statement ok
DELETE FROM lake.r WHERE i IN (1, 3)

statement ok
CALL ducklake_rewrite_data_files('lake', 'r', delete_threshold => 0.4)

statement ok
INSERT INTO lake.r VALUES (100, 1000)

query II
SELECT column_id, min_value IS NOT NULL AND max_value IS NOT NULL FROM meta.ducklake_table_column_stats ORDER BY column_id
----
1	true
2	true

query III
SELECT count(*), min(i), max(j) FROM lake.r
----
5	2	1000

# Removing the last stored deletion makes exact bounds safe to recompute.
statement ok
CALL ducklake_rewrite_data_files('lake', 'r', delete_threshold => 0)

statement ok
INSERT INTO lake.r VALUES (-100, -1000)

query III
SELECT count(*), min(i), max(j) FROM lake.r
----
6	-100	1000

query II
SELECT min_value, max_value FROM meta.ducklake_table_column_stats ORDER BY column_id
----
-100	100
-1000	1000

statement ok
DETACH lake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/refresh_bounds', METADATA_CATALOG 'meta')

query III
SELECT count(*), min(i), max(j) FROM lake.r
----
6	-100	1000
