# name: test/sql/compaction/compaction_idle_metadata_transaction.test
# description: compaction does not hold the Postgres metadata transaction open while it rewrites files
# group: [compaction]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'dbname=ducklakedb' AS pg (TYPE postgres)

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS idle_compaction CASCADE')

statement ok
DETACH pg

# the server closes a session that stays idle in a transaction for half a second
statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb options=''-c idle_in_transaction_session_timeout=500''' AS lake
(DATA_PATH '{DATA_PATH}/idle_compaction', METADATA_SCHEMA 'idle_compaction', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t (i INTEGER)

statement ok
INSERT INTO lake.t VALUES (1)

statement ok
INSERT INTO lake.t VALUES (2)

# each row of a rewrite sleeps for a second
statement ok
ALTER TABLE lake.t SET SORTED BY (COALESCE(sleep_ms(1000), i))

query II
SELECT files_processed, files_created FROM ducklake_merge_adjacent_files('lake', 't')
----
2	1

statement ok
DELETE FROM lake.t WHERE i = 1

query II
SELECT files_processed, files_created FROM ducklake_rewrite_data_files('lake', 't', delete_threshold => 0)
----
1	1

query II
SELECT count(*), sum(i) FROM lake.t
----
1	2

query I
SELECT count(*) FROM ducklake_list_files('lake', 't')
----
1

# a metadata function bound after the compaction
statement ok
CREATE TABLE lake.c (i INTEGER)

statement ok
INSERT INTO lake.c VALUES (1)

statement ok
INSERT INTO lake.c VALUES (2)

statement ok
ALTER TABLE lake.c SET SORTED BY (COALESCE(sleep_ms(1000), i))

query III
SELECT c.files_processed, c.files_created, s.snapshot_id > 0
FROM ducklake_merge_adjacent_files('lake', 'c') c
CROSS JOIN (SELECT max(snapshot_id) snapshot_id FROM lake.snapshots()) s
----
2	1	true

# a fresh attach loads the name maps of added files on first use
statement ok
CREATE TABLE lake.imported (i INTEGER)

statement ok
COPY (SELECT 1 AS i) TO '{DATA_PATH}/idle_i1.parquet'

statement ok
COPY (SELECT 2 AS i) TO '{DATA_PATH}/idle_i2.parquet'

statement ok
CALL ducklake_add_data_files('lake', 'imported', ['{DATA_PATH}/idle_i1.parquet', '{DATA_PATH}/idle_i2.parquet'])

statement ok
ALTER TABLE lake.imported SET SORTED BY (COALESCE(sleep_ms(1000), i))

statement ok
DETACH lake

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb options=''-c idle_in_transaction_session_timeout=500''' AS lake
(DATA_PATH '{DATA_PATH}/idle_compaction', METADATA_SCHEMA 'idle_compaction')

query II
SELECT files_processed, files_created FROM ducklake_merge_adjacent_files('lake', 'imported')
----
2	1

query II
SELECT count(*), sum(i) FROM lake.imported
----
2	3
