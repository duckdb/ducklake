# name: test/sql/compaction/merge_adjacent_partial_max.test
# description: Merge adjacent of  files generate partial_max
# group: [compaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}


statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/merge_adjacent_partial_max/')

statement ok
USE ducklake;

statement ok
create table t (a integer);

statement ok
insert into t values (0);

statement ok
CALL ducklake_flush_inlined_data('ducklake')

statement ok
insert into t values (0);

statement ok
CALL ducklake_flush_inlined_data('ducklake')

statement ok
insert into t values (0);

statement ok
CALL ducklake_flush_inlined_data('ducklake')

statement ok
insert into t values (0);

statement ok
CALL ducklake_flush_inlined_data('ducklake')

statement ok
insert into t values (0);

statement ok
CALL ducklake_flush_inlined_data('ducklake')

statement ok
insert into t values (0);

statement ok
CALL ducklake_flush_inlined_data('ducklake')

# Capture expected partial_max before merge: max begin_snapshot of active files
statement ok
SET VARIABLE expected_pm = (SELECT max(v.snapshot_id) FROM __ducklake_metadata_ducklake.ducklake_file_visibility v WHERE v.branch_id = 0 AND v.is_delete = FALSE AND NOT EXISTS (SELECT 1 FROM __ducklake_metadata_ducklake.ducklake_file_visibility d WHERE d.branch_id = 0 AND d.is_delete = TRUE AND d.data_file_id = v.data_file_id));

query III
SELECT table_name, files_processed, files_created FROM ducklake_merge_adjacent_files('ducklake', 't')
----
t	6	1

query I
SELECT partial_max = getvariable('expected_pm') FROM (SELECT f.*, v.begin_snapshot, v.end_snapshot FROM __ducklake_metadata_ducklake.ducklake_data_file f JOIN (SELECT data_file_id, MAX(CASE WHEN is_delete = FALSE THEN snapshot_id END) begin_snapshot, MAX(CASE WHEN is_delete = TRUE THEN snapshot_id END) end_snapshot FROM __ducklake_metadata_ducklake.ducklake_file_visibility WHERE branch_id = 0 GROUP BY data_file_id) v ON v.data_file_id = f.data_file_id) WHERE end_snapshot IS NULL
----
true