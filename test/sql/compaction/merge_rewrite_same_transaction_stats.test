# name: test/sql/compaction/merge_rewrite_same_transaction_stats.test
# description: a merge and a rewrite in one transaction recompute the table stats from the files once
# group: [compaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/merge_rewrite_same_transaction_stats', DATA_INLINING_ROW_LIMIT 0, METADATA_CATALOG 'meta')

statement ok
CREATE TABLE lake.t (i INTEGER);

statement ok
INSERT INTO lake.t VALUES (1);

statement ok
INSERT INTO lake.t VALUES (2);

statement ok
INSERT INTO lake.t VALUES (3), (4);

statement ok
DELETE FROM lake.t WHERE i = 4;

statement ok
BEGIN

statement ok
CALL ducklake_merge_adjacent_files('lake', 't');

statement ok
CALL ducklake_rewrite_data_files('lake', 't', delete_threshold => 0);

statement ok
COMMIT

statement ok
SET VARIABLE live_size = (SELECT sum(file_size_bytes) FROM meta.ducklake_data_file WHERE end_snapshot IS NULL)

query II
SELECT record_count, file_size_bytes = getvariable('live_size') FROM meta.ducklake_table_stats
----
3	true

query I
SELECT estimated_size FROM duckdb_tables() WHERE table_name = 't'
----
3

query II
SELECT min_value, max_value FROM meta.ducklake_table_column_stats
----
1	3

query III
SELECT count(*), min(i), max(i) FROM lake.t
----
3	1	3
