# name: test/sql/compaction/rewrite_narrow_next_file_id.test
# description: A zero-output rewrite that recomputes the table stats advances the next file id for readers that cache by it
# group: [compaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/rewrite_narrow_next_file_id.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/rewrite_narrow_next_file_id', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t SELECT range FROM range(100)

statement ok
INSERT INTO dl.t SELECT range FROM range(1000, 1050)

statement ok
DELETE FROM dl.t WHERE i >= 1000 AND i < 1010

statement ok
DELETE FROM dl.t WHERE i >= 1010 AND i < 1020

statement ok
DELETE FROM dl.t WHERE i >= 1020 AND i < 1030

statement ok
DELETE FROM dl.t WHERE i >= 1030 AND i < 1040

statement ok
DELETE FROM dl.t WHERE i >= 1040 AND i < 1050

statement ok
SET VARIABLE before_rewrite_id = (SELECT max(next_file_id) FROM __ducklake_metadata_dl.ducklake_snapshot)

query II
SELECT COUNT(*), SUM(files_created) FROM ducklake_rewrite_data_files('dl', 't', delete_threshold => 0)
----
1	0

query I
SELECT max(next_file_id) = getvariable('before_rewrite_id') + 1 FROM __ducklake_metadata_dl.ducklake_snapshot
----
true
