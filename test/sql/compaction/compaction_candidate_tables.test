# name: test/sql/compaction/compaction_candidate_tables.test
# description: a rewrite or a merge over the catalog lists the files of the candidate tables only, found by one read
# group: [compaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/compaction_candidate_tables', DATA_INLINING_ROW_LIMIT 0)

# one file, nothing to merge or rewrite
statement ok
CREATE TABLE dl.single AS SELECT range AS i FROM range(10)

# two files without deletes, a merge candidate
statement ok
CREATE TABLE dl.pair (i INTEGER)

statement ok
INSERT INTO dl.pair VALUES (1)

statement ok
INSERT INTO dl.pair VALUES (2)

# a delete file, a rewrite candidate
statement ok
CREATE TABLE dl.deleted AS SELECT range AS i FROM range(10)

statement ok
DELETE FROM dl.deleted WHERE i = 3

# an inlined deletion, a rewrite candidate found through its deletion table
statement ok
CREATE TABLE dl.inlined_deletes AS SELECT range AS i FROM range(10)

statement ok
CALL dl.set_option('data_inlining_row_limit', 5, table_name => 'inlined_deletes')

statement ok
DELETE FROM dl.inlined_deletes WHERE i = 4

statement ok
CALL enable_logging('DuckLakeMetadata')

query I
SELECT sum(files_processed) FROM ducklake_rewrite_data_files('dl', delete_threshold => 0)
----
2

statement ok
CALL disable_logging()

# one read of the delete files and at most one listing of the inlined deletion tables (a Postgres catalog lists them
# on the server) name the candidates, the two candidate tables list their files; a quack catalog wraps every
# statement in a call, so its log is not counted
query III
SELECT CASE WHEN counted THEN reads ELSE 1 END, CASE WHEN counted THEN listings <= 1 ELSE true END,
       CASE WHEN counted THEN lists ELSE 2 END
FROM (SELECT (SELECT catalog_type FROM ducklake_settings('dl')) IN ('duckdb', 'sqlite', 'postgres') AS counted,
             count(*) FILTER (WHERE regexp_matches(query, '^\s*SELECT') AND query LIKE '%ducklake_delete_file%'
                              AND query NOT LIKE '%ducklake_data_file%' AND query NOT LIKE '%snapshot_ranges%') AS reads,
             count(*) FILTER (WHERE query LIKE '%pg_tables%') AS listings,
             count(*) FILTER (WHERE query LIKE '%candidate_files AS%') AS lists
      FROM duckdb_logs_parsed('DuckLakeMetadata'))
----
1	true	2

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata')

query II
SELECT sum(files_processed), sum(files_created) FROM ducklake_merge_adjacent_files('dl')
----
2	1

statement ok
CALL disable_logging()

# one read of the data files names the tables with two live files, the one candidate lists its files
query II
SELECT CASE WHEN counted THEN reads ELSE 1 END, CASE WHEN counted THEN lists ELSE 1 END
FROM (SELECT (SELECT catalog_type FROM ducklake_settings('dl')) IN ('duckdb', 'sqlite', 'postgres') AS counted,
             count(*) FILTER (WHERE query LIKE '%GROUP BY table_id HAVING%') AS reads,
             count(*) FILTER (WHERE query LIKE '%snapshot_ranges AS%' AND query NOT LIKE '%candidate_files%') AS lists
      FROM duckdb_logs_parsed('DuckLakeMetadata'))
----
1	1

# a size bound of the call rules out every file, so no table lists its files
statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata')

query I
SELECT count(*) FROM ducklake_merge_adjacent_files('dl', max_file_size => 1)
----
0

statement ok
CALL disable_logging()

query II
SELECT CASE WHEN counted THEN reads ELSE 1 END, CASE WHEN counted THEN lists ELSE 0 END
FROM (SELECT (SELECT catalog_type FROM ducklake_settings('dl')) IN ('duckdb', 'sqlite', 'postgres') AS counted,
             count(*) FILTER (WHERE query LIKE '%GROUP BY table_id HAVING%' AND query LIKE '%file_size_bytes < 1%') AS reads,
             count(*) FILTER (WHERE query LIKE '%snapshot_ranges AS%') AS lists
      FROM duckdb_logs_parsed('DuckLakeMetadata'))
----
1	0

query IIII
SELECT (SELECT count(*) FROM dl.single), (SELECT list(i ORDER BY i) FROM dl.pair),
       (SELECT list(i ORDER BY i) FROM dl.deleted), (SELECT list(i ORDER BY i) FROM dl.inlined_deletes)
----
10	[1, 2]	[0, 1, 2, 4, 5, 6, 7, 8, 9]	[0, 1, 2, 3, 5, 6, 7, 8, 9]
