# name: test/sql/secrets/ducklake_secret_null_options.test
# description: NULL options of a DuckLake secret give the error of a NULL ATTACH option
# group: [secrets]

require ducklake

require parquet

statement ok
CREATE SECRET encrypted_null (TYPE ducklake, METADATA_PATH '{TEST_DIR}/secret_null_options.db', ENCRYPTED NULL)

statement error
ATTACH 'ducklake:encrypted_null' AS ducklake
----
NULL is not supported as a valid option for ATTACH option "encrypted"

statement ok
CREATE SECRET parameters_null (TYPE ducklake, METADATA_PATH '{TEST_DIR}/secret_null_options.db', METADATA_PARAMETERS NULL)

statement error
ATTACH 'ducklake:parameters_null' AS ducklake
----
NULL is not supported as a valid option for ATTACH option "metadata_parameters"

statement ok
CREATE SECRET data_path_null (TYPE ducklake, METADATA_PATH '{TEST_DIR}/secret_null_options.db', DATA_PATH NULL)

statement error
ATTACH 'ducklake:data_path_null' AS ducklake
----
NULL is not supported as a valid option for ATTACH option "data_path"

statement ok
CREATE SECRET valid (TYPE ducklake, METADATA_PATH '{TEST_DIR}/secret_null_options.db',
    DATA_PATH '{TEST_DIR}/secret_null_options_files')

statement ok
ATTACH 'ducklake:valid' AS ducklake

statement ok
CREATE TABLE ducklake.t AS SELECT 42 AS i

query I
SELECT i FROM ducklake.t
----
42

statement ok
DETACH ducklake

# a persistent secret keeps its NULL value across a restart
statement ok
CREATE PERSISTENT SECRET persistent_encrypted_null (TYPE ducklake, METADATA_PATH '{TEST_DIR}/secret_null_options.db',
    ENCRYPTED NULL)

restart

statement error
ATTACH 'ducklake:persistent_encrypted_null' AS ducklake
----
NULL is not supported as a valid option for ATTACH option "encrypted"

statement ok
DROP PERSISTENT SECRET persistent_encrypted_null
