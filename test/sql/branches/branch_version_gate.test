# name: test/sql/branches/branch_version_gate.test
# description: attaching at a branch needs a 2.0 catalog
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/branch_version_gate_files', DUCKLAKE_VERSION '1.1')

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/branch_version_gate_files', BRANCH 'dev')
----
DuckLake 1.1 does not support branches
