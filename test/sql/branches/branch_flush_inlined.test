# name: test/sql/branches/branch_flush_inlined.test
# description: flushing inlined rows on main keeps them visible on a branch forked after their insert
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/branch_flush_inlined_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
INSERT INTO dl.t VALUES (2)

statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 3)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 4, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 3 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (4, NULL, NULL, NULL, NULL, 1)

# the flush rehomes the inlined rows into a file that starts before the fork, which the fork inherits
statement ok
CALL ducklake_flush_inlined_data('dl')

query I
SELECT COUNT(*) FROM meta.ducklake_file_visibility WHERE branch_id = 1
----
0

query I
SELECT COUNT(*) FROM meta.ducklake_file_visibility WHERE branch_id = 0 AND is_delete = FALSE AND snapshot_id <= 3
----
1

# the flush of main leaves no row version or end of main behind
query I
SELECT COUNT(*) FROM meta.ducklake_inlined_data_1_1 WHERE _ducklake_branch_id = 0
----
0

query I
SELECT COUNT(*) FROM meta.ducklake_inlined_data_1_1_visibility WHERE branch_id = 0
----
0

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/branch_flush_inlined_files', METADATA_CATALOG 'meta', BRANCH 'dev')

query I
SELECT i FROM dl.t ORDER BY i
----
1
2

statement ok
DETACH dl
