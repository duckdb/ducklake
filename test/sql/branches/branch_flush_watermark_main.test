# name: test/sql/branches/branch_flush_watermark_main.test
# description: a scan reading the inlined rows before the files compares them against the file counter of main
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

# dev forks from main at 2 and holds the snapshot 3, with a file counter far above the one of main
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 2)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id,
    branch_id) SELECT 3, NOW(), schema_version, next_catalog_id, 1001, 1 FROM meta.ducklake_snapshot
    WHERE snapshot_id = 2 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (3, NULL, NULL, NULL, NULL, 1)

# the file of dev at its 3 carries an id above the file counter of main
statement ok
COPY (SELECT 30::INTEGER AS i) TO '{TEST_DIR}/{BASE_TEST_NAME}_dev_3.parquet' (FORMAT PARQUET, FIELD_IDS {i: 1})

statement ok
INSERT INTO meta.ducklake_data_file (data_file_id, table_id, path, path_is_relative, file_format, record_count,
    file_size_bytes, row_id_start) SELECT 1000, 1, '{TEST_DIR}/{BASE_TEST_NAME}_dev_3.parquet', false, 'parquet', 1,
    file_size_bytes, 100 FROM parquet_file_metadata('{TEST_DIR}/{BASE_TEST_NAME}_dev_3.parquet')

statement ok
INSERT INTO meta.ducklake_file_visibility VALUES (1, 1, 1000, 3, false)

query II
SELECT MAX(next_file_id) FILTER (WHERE branch_id = 0) < 1000, MAX(next_file_id) FROM meta.ducklake_snapshot
----
true	1001

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata', storage => 'memory')

query I
SELECT i FROM dl.t ORDER BY i
----
1
2
3

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

# dev reads the inherited inlined rows and its own file, which no file counter of main reaches
query I
SELECT i FROM dev.t ORDER BY i
----
1
2
3
30

statement ok
CALL disable_logging()

# no read takes the file counter across every branch, a flush of main allocates from the head of main
query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE regexp_matches(query, 'MAX\(next_file_id\) FROM [^ ]*ducklake_snapshot\)')
----
0

statement ok
DETACH dev

statement ok
DETACH dl
