# name: test/sql/branches/branch_flush_dual_end.test
# description: a flush of main writes the dated delete of a version main had ended and the rehomed end of another branch on it, both naming one position
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

# dev forks from main at 2 and holds the snapshot 3, the delete main commits at its 3 lies above that cap
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 2)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 3, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 2 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (3, NULL, NULL, NULL, NULL, 1)

# dev ends the second row at its 3
statement ok
INSERT INTO meta.ducklake_inlined_data_visibility VALUES (1, 1, 0, 2, 1, 3)

# main ends the same row at its 3
statement ok
DELETE FROM dl.t WHERE i = 2

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

query IIIIII
FROM meta.ducklake_inlined_data_visibility ORDER BY ALL
----
1	1	0	2	0	3
1	1	0	2	1	3

query I
SELECT i FROM dl.t ORDER BY i
----
1
3

query I
SELECT i FROM dev.t ORDER BY i
----
1
3

statement ok
CALL ducklake_flush_inlined_data('dl')

# the end of main dates the delete of the position in the flush delete file, whose add event lies above the cap of dev
query II
SELECT delete_count, data_file_id = (SELECT data_file_id FROM meta.ducklake_data_file) FROM meta.ducklake_delete_file
----
1	true

query II
SELECT branch_id, snapshot_id FROM meta.ducklake_delete_file_visibility WHERE NOT is_delete
----
0	3

# the end of dev is a deletion row of dev on the same position, dated at its own 3
query III
SELECT row_id, begin_snapshot, branch_id FROM meta.ducklake_inlined_delete_1
----
1	3	1

query I
SELECT file_id = (SELECT data_file_id FROM meta.ducklake_data_file) FROM meta.ducklake_inlined_delete_1
----
true

# both ends left the companion with the rows
query I
SELECT count(*) FROM meta.ducklake_inlined_data_1_1
----
0

query I
SELECT count(*) FROM meta.ducklake_inlined_data_visibility WHERE table_id = 1
----
0

# every view deletes the row once
query I
SELECT i FROM dl.t ORDER BY i
----
1
3

query I
SELECT i FROM dl.t AT (VERSION => 3) ORDER BY i
----
1
3

query I
SELECT i FROM dl.t AT (VERSION => 2) ORDER BY i
----
1
2
3

query I
SELECT i FROM dev.t ORDER BY i
----
1
3

query I
SELECT i FROM dev.t AT (VERSION => 2) ORDER BY i
----
1
2
3

query III
SELECT rowid, snapshot_id, i FROM ducklake_table_deletions('dev', 'main', 't', 3, 3) ORDER BY rowid
----
1	3	2

statement ok
DETACH dev

statement ok
DETACH dl
