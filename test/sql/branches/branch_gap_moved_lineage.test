# name: test/sql/branches/branch_gap_moved_lineage.test
# description: a commit over a moved lineage with branch snapshots refreshes instead of filling the id gap
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok con1
BEGIN

query I con1
SELECT id FROM dl.current_snapshot()
----
2

statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 2, 2, NULL)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 100, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 2

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (100, NULL, NULL, NULL, NULL)

statement ok con2
CREATE TABLE dl.u(j INTEGER)

query I
SELECT id FROM dl.current_snapshot()
----
101

statement ok con1
INSERT INTO dl.t VALUES (2)

statement ok con1
COMMIT

query I
SELECT list(snapshot_id ORDER BY snapshot_id) FROM dl.snapshots()
----
[0, 1, 2, 101, 102]
