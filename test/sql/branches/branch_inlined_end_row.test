# name: test/sql/branches/branch_inlined_end_row.test
# description: an end a branch writes on an inherited inlined row hides the row on the branch alone
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 2)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 3, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 2 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (3, NULL, NULL, NULL, NULL, 1)

# dev ends the version of the second row at its own snapshot 3
statement ok
INSERT INTO meta.ducklake_inlined_data_1_1_visibility VALUES (1, 1, 0, 2, 3)

query I
SELECT i FROM dl.t ORDER BY i
----
1
2
3

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

query I
SELECT i FROM dev.t ORDER BY i
----
1
3

query I
SELECT count(*) FROM dev.t
----
2

# below its own snapshot the end is not in the view of dev
query I
SELECT i FROM dev.t AT (VERSION => 2) ORDER BY i
----
1
2
3

# an end of main after the fork is not in the view of dev either
statement ok
DELETE FROM dl.t WHERE i = 3

query I
SELECT i FROM dl.t ORDER BY i
----
1
2

query I
SELECT i FROM dev.t ORDER BY i
----
1
3

query IIIII
FROM meta.ducklake_inlined_data_1_1_visibility ORDER BY ALL
----
0	2	0	2	3
1	1	0	2	3

statement ok
DETACH dev

statement ok
DETACH dl
