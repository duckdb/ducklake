# name: test/sql/branches/branch_feed_inherited_partial_file.test
# description: the insertions feed of a branch reads an inherited flushed file up to the fork and skips it when nothing of the range is in it
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE lake.t(i INTEGER)

statement ok
CREATE TABLE lake.u(i INTEGER)

statement ok
INSERT INTO lake.t VALUES (3)

statement ok
INSERT INTO lake.t VALUES (4)

statement ok
INSERT INTO lake.u VALUES (5)

statement ok
INSERT INTO lake.t VALUES (6)

statement ok
CALL ducklake_flush_inlined_data('lake', table_name => 't')

query I
SELECT id FROM lake.current_snapshot()
----
7

# the flush wrote one file dated per row whose add event is back dated to the first row
query II
SELECT record_count, partial_max FROM meta.ducklake_data_file
----
3	6

query I
SELECT snapshot_id FROM meta.ducklake_file_visibility WHERE is_delete = false
----
3

# dev forks main at 5 and holds a snapshot of its own
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 5)

statement ok
INSERT INTO meta.ducklake_snapshot SELECT 6, NOW(), schema_version, 1099511627776, 1099511627776, 1 FROM meta.ducklake_snapshot WHERE branch_id = 0 AND snapshot_id = 5

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (6, NULL, NULL, NULL, NULL, 1)

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

query I
SELECT i FROM dev.t ORDER BY i
----
3
4

# the row main flushed in after the fork is no insertion of dev
query II
SELECT snapshot_id, i FROM ducklake_table_insertions('dev', 'main', 't', 3, 6) ORDER BY i
----
3	3
4	4

query II
SELECT snapshot_id, i FROM ducklake_table_insertions('lake', 'main', 't', 3, 6) ORDER BY i
----
3	3
4	4
6	6

# the file holds nothing of a range above the fork and is not opened for it
statement ok
CALL enable_logging('FileSystem', storage => 'memory')

query II
SELECT snapshot_id, i FROM ducklake_table_insertions('dev', 'main', 't', 6, 6)
----

query I
SELECT count(*) FROM duckdb_logs_parsed('FileSystem') WHERE path LIKE '%.parquet' AND op = 'OPEN'
----
0

query II
SELECT snapshot_id, i FROM ducklake_table_insertions('dev', 'main', 't', 3, 6) ORDER BY i
----
3	3
4	4

query I
SELECT count(*) > 0 FROM duckdb_logs_parsed('FileSystem') WHERE path LIKE '%.parquet' AND op = 'OPEN'
----
true

statement ok
CALL disable_logging()

statement ok
DETACH dev

statement ok
DETACH lake
