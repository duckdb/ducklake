# name: test/sql/branches/branch_feed_undated_cumulative.test
# description: an undated cumulative delete file of a branch keeps the earlier deletion dates of the rows it copied
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{TEST_DIR}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t(i INTEGER)

statement ok
INSERT INTO lake.t VALUES (1), (2), (3), (4)

statement ok
DELETE FROM lake.t WHERE i = 1

# dev forks main at 3, at its 4 it replaces the delete file of main with an undated cumulative one naming the rows 0 and 1
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 3)

statement ok
INSERT INTO meta.ducklake_snapshot SELECT 4, NOW(), schema_version, 1099511627776, 1099511627777, 1 FROM meta.ducklake_snapshot WHERE branch_id = 0 AND snapshot_id = 3

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (4, NULL, NULL, NULL, NULL, 1)

statement ok
COPY (SELECT ''::VARCHAR AS file_path, p::BIGINT AS pos FROM (VALUES (0), (1)) v(p)) TO '{TEST_DIR}/{BASE_TEST_NAME}_dev_delete.parquet' (FORMAT PARQUET)

statement ok
INSERT INTO meta.ducklake_delete_file (delete_file_id, table_id, data_file_id, path, path_is_relative, format, delete_count, file_size_bytes) SELECT 1099511627776, 1, 0, '{TEST_DIR}/{BASE_TEST_NAME}_dev_delete.parquet', false, 'parquet', 2, file_size_bytes FROM parquet_file_metadata('{TEST_DIR}/{BASE_TEST_NAME}_dev_delete.parquet')

statement ok
INSERT INTO meta.ducklake_delete_file_visibility SELECT 1, 1, delete_file_id, 4, true FROM meta.ducklake_delete_file WHERE delete_file_id <> 1099511627776

statement ok
INSERT INTO meta.ducklake_delete_file_visibility VALUES (1, 1, 1099511627776, 4, false)

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

query I
SELECT i FROM dev.t ORDER BY i
----
3
4

query IIII
FROM dev.table_changes('t', 3, 3) ORDER BY ALL
----
3	0	delete	1

query IIII
FROM dev.table_changes('t', 4, 4) ORDER BY ALL
----
4	1	delete	2

# the row main deleted at 3 keeps its date, the row dev deleted is dated at the begin of the undated file
query IIII
FROM dev.table_changes('t', 3, 4) ORDER BY ALL
----
3	0	delete	1
4	1	delete	2

query III
SELECT rowid, snapshot_id, i FROM ducklake_table_deletions('dev', 'main', 't', 3, 4) ORDER BY rowid
----
0	3	1
1	4	2

# main deletes the rows 2 and 1 at its 4 and 5, its dated cumulative replacement is back dated to 3 and capped at 3 on dev
statement ok
DELETE FROM lake.t WHERE i = 3

statement ok
DELETE FROM lake.t WHERE i = 2

query I
SELECT snapshot_id FROM meta.ducklake_delete_file_visibility WHERE branch_id = 0 AND NOT is_delete
----
3

query IIII
FROM lake.table_changes('t', 3, 5) ORDER BY ALL
----
3	0	delete	1
4	2	delete	3
5	1	delete	2

query I
SELECT i FROM dev.t ORDER BY i
----
3
4

# the date 5 of main for the row 1 is above the cap, dev dates the row at the begin of its own file
query IIII
FROM dev.table_changes('t', 3, 4) ORDER BY ALL
----
3	0	delete	1
4	1	delete	2

query IIII
FROM dev.table_changes('t', 4, 4) ORDER BY ALL
----
4	1	delete	2

query IIII
FROM dev.table_changes('t', 3, 3) ORDER BY ALL
----
3	0	delete	1

statement ok
DETACH dev

statement ok
DETACH lake
