# name: test/sql/branches/branch_listing_after_main_flush.test
# description: a branch attach keeps reading the inherited deletions after main flushes the inlined deletions into a delete file
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE lake.t (i BIGINT)

statement ok
INSERT INTO lake.t SELECT range FROM range(20)

statement ok
DELETE FROM lake.t WHERE i = 0

query I
SELECT count(*) FROM meta.ducklake_inlined_delete_1
----
1

statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 3)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 4, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 3 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (4, NULL, NULL, NULL, NULL, 1)

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

query I con1
SELECT i FROM dev.t WHERE i < 2 ORDER BY i
----
1

query I con1
SELECT count(*) FROM dev.t
----
19

statement ok con2
CALL ducklake_flush_inlined_data('lake', table_name => 't')

query I con2
SELECT count(*) FROM meta.ducklake_inlined_delete_1
----
0

query I con2
SELECT count(*) FROM lake.t
----
19

query I con1
SELECT i FROM dev.t WHERE i < 2 ORDER BY i
----
1

query I con1
SELECT count(*) FROM dev.t
----
19

query I con2
SELECT count(*) FROM dev.t
----
19
