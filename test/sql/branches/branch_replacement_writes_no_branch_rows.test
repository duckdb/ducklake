# name: test/sql/branches/branch_replacement_writes_no_branch_rows.test
# description: a replacement and a flush of main write delete file events of main alone, which the branches read through their fork
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t(i INTEGER)

statement ok
INSERT INTO lake.t VALUES (1), (2), (3), (4), (5)

statement ok
DELETE FROM lake.t WHERE i = 1

# the second delete of main is inlined
statement ok
CALL ducklake_set_option('lake', 'data_inlining_row_limit', 10)

statement ok
DELETE FROM lake.t WHERE i = 2

query I
SELECT id FROM lake.current_snapshot()
----
4

# dev forks main at 4 and feature forks dev at 5, neither holds an event of its own
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 4), (2, 'feature', 1, 5)

statement ok
INSERT INTO meta.ducklake_snapshot SELECT 5, NOW(), schema_version, 1099511627776, 1099511627776, 1 FROM meta.ducklake_snapshot WHERE branch_id = 0 AND snapshot_id = 4

statement ok
INSERT INTO meta.ducklake_snapshot SELECT 6, NOW(), schema_version, 2199023255552, 2199023255552, 2 FROM meta.ducklake_snapshot WHERE branch_id = 0 AND snapshot_id = 4

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (5, NULL, NULL, NULL, NULL, 1), (6, NULL, NULL, NULL, NULL, 2)

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS feature (METADATA_CATALOG 'meta', BRANCH 'feature')

query I
SELECT i FROM dev.t ORDER BY i
----
3
4
5

query I
SELECT i FROM feature.t ORDER BY i
----
3
4
5

# the third delete of main replaces its delete file with a cumulative one
statement ok
CALL ducklake_set_option('lake', 'data_inlining_row_limit', 0)

statement ok
DELETE FROM lake.t WHERE i = 3

query I
SELECT i FROM lake.t ORDER BY i
----
4
5

query I
SELECT COUNT(*) FROM meta.ducklake_delete_file_visibility WHERE branch_id <> 0
----
0

# the flush of main replaces the delete file once more
statement ok
CALL ducklake_flush_inlined_data('lake')

query I
SELECT i FROM lake.t ORDER BY i
----
4
5

query I
SELECT COUNT(*) FROM meta.ducklake_delete_file_visibility WHERE branch_id <> 0
----
0

query II
SELECT COUNT(*), MAX(partial_max) FROM meta.ducklake_delete_file
----
1	5

# both branches keep the state of their fork
query I
SELECT i FROM dev.t ORDER BY i
----
3
4
5

query I
SELECT i FROM feature.t ORDER BY i
----
3
4
5

# the feed of main reports the new deletion once
query IIII
FROM lake.table_changes('t', 5, 5) ORDER BY ALL
----
5	2	delete	3

query IIII
FROM lake.table_changes('t', 3, 6) ORDER BY ALL
----
3	0	delete	1
4	1	delete	2
5	2	delete	3

statement ok
DETACH feature

statement ok
DETACH dev

statement ok
DETACH lake
