# name: test/sql/branches/branch_merge_keeps_deleted_files.test
# description: a merge of main keeps the files the delete files and inlined deletions of a branch name
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
CREATE TABLE dl.u (i INTEGER)

# the rows of t are inlined at 3, u gets two files at 4 and 5
statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

statement ok
INSERT INTO dl.u SELECT range FROM range(100, 111)

statement ok
INSERT INTO dl.u SELECT range FROM range(200, 211)

query I
SELECT id FROM dl.current_snapshot()
----
5

# dev forks from main at 5 and holds the snapshot 6
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 5)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id,
    branch_id) SELECT 6, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot
    WHERE snapshot_id = 5 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (6, NULL, NULL, NULL, NULL, 1)

# dev ends the second row of t at its 6
statement ok
INSERT INTO meta.ducklake_inlined_data_visibility VALUES (1, 1, 0, 3, 1, 6)

# dev deletes the first row of the first file of u with a delete file of its own at its 6
statement ok
SET VARIABLE u_file = (SELECT MIN(data_file_id) FROM meta.ducklake_data_file WHERE table_id = 2)

statement ok
COPY (SELECT ''::VARCHAR AS file_path, 0::BIGINT AS pos, 6::BIGINT AS _ducklake_internal_snapshot_id)
    TO '{TEST_DIR}/{BASE_TEST_NAME}_dev_u_delete.parquet' (FORMAT PARQUET)

statement ok
INSERT INTO meta.ducklake_delete_file (delete_file_id, table_id, data_file_id, path, path_is_relative, format,
    delete_count, file_size_bytes) SELECT 1000, 2, getvariable('u_file'),
    '{TEST_DIR}/{BASE_TEST_NAME}_dev_u_delete.parquet', false, 'parquet', 1, file_size_bytes
    FROM parquet_file_metadata('{TEST_DIR}/{BASE_TEST_NAME}_dev_u_delete.parquet')

statement ok
INSERT INTO meta.ducklake_delete_file_visibility VALUES (1, 2, 1000, 6, false)

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

query I
SELECT i FROM dev.t ORDER BY i
----
1
3

query II
SELECT count(*), min(i) FROM dev.u
----
21	101

# main flushes at its 6, the end of dev becomes a deletion row of dev on the flushed file of t
statement ok
CALL ducklake_flush_inlined_data('dl')

query III
SELECT row_id, begin_snapshot, branch_id FROM meta.ducklake_inlined_delete_1
----
1	6	1

# main writes two more files of t and one more of u
statement ok
INSERT INTO dl.t SELECT range FROM range(100, 111)

statement ok
INSERT INTO dl.t SELECT range FROM range(200, 211)

statement ok
INSERT INTO dl.u SELECT range FROM range(300, 311)

query I
SELECT count(*) FROM meta.ducklake_data_file
----
6

statement ok
CALL ducklake_merge_adjacent_files('dl')

# the files without a deletion of dev merge, the flushed file of t and the first file of u keep their identity
query I
SELECT count(*) FROM meta.ducklake_data_file
----
4

query I
SELECT count(*) FROM meta.ducklake_inlined_delete_1 d JOIN meta.ducklake_data_file f ON f.data_file_id = d.file_id
----
1

query I
SELECT count(*) FROM meta.ducklake_delete_file d JOIN meta.ducklake_data_file f ON f.data_file_id = d.data_file_id
----
1

query II
SELECT count(*), sum(i) FROM dl.t
----
25	3416

query II
SELECT count(*), sum(i) FROM dl.u
----
33	6765

query I
SELECT i FROM dev.t ORDER BY i
----
1
3

query II
SELECT count(*), min(i) FROM dev.u
----
21	101

statement ok
DETACH dev

statement ok
DETACH dl
