# name: test/sql/branches/branch_flush_direct_nested.test
# description: a flush of main keeps the end a branch wrote on an inlined row for that branch and for the branches nested on it whose cap reaches the end
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

# dev forks from main at 2 and holds the snapshots 3 and 5, nested forks from dev at 3 and nested_late from dev at 5
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 2), (2, 'nested', 1, 3), (3, 'nested_late', 1, 5)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 3, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 2 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 5, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 2 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 4, NOW(), schema_version, next_catalog_id, next_file_id, 2 FROM meta.ducklake_snapshot WHERE snapshot_id = 2 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 6, NOW(), schema_version, next_catalog_id, next_file_id, 3 FROM meta.ducklake_snapshot WHERE snapshot_id = 2 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (3, NULL, NULL, NULL, NULL, 1), (5, NULL, NULL, NULL, NULL, 1), (4, NULL, NULL, NULL, NULL, 2), (6, NULL, NULL, NULL, NULL, 3)

# dev ends the second row at its 5, above the cap of nested and at the cap of nested_late
statement ok
INSERT INTO meta.ducklake_inlined_data_visibility VALUES (1, 1, 0, 2, 1, 5)

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS nested (METADATA_CATALOG 'meta', BRANCH 'nested')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS nested_late (METADATA_CATALOG 'meta', BRANCH 'nested_late')

query I
SELECT i FROM dl.t ORDER BY i
----
1
2
3

query I
SELECT i FROM dev.t ORDER BY i
----
1
3

query I
SELECT i FROM nested.t ORDER BY i
----
1
2
3

query I
SELECT i FROM nested_late.t ORDER BY i
----
1
3

statement ok
CALL ducklake_flush_inlined_data('dl')

# the flush moved the rows into a file and the end of dev into one deletion row of dev on it
query I
SELECT count(*) FROM meta.ducklake_inlined_data_1_1
----
0

query I
SELECT count(*) FROM meta.ducklake_inlined_data_visibility WHERE table_id = 1 AND branch_id = 1
----
0

query I
SELECT count(*) FROM meta.ducklake_delete_file
----
0

query III
SELECT row_id, begin_snapshot, branch_id FROM meta.ducklake_inlined_delete_1
----
1	5	1

query I
SELECT i FROM dl.t ORDER BY i
----
1
2
3

query I
SELECT i FROM dev.t ORDER BY i
----
1
3

query I
SELECT i FROM dev.t AT (VERSION => 3) ORDER BY i
----
1
2
3

# the rehomed row at dev's 5 is above the cap of nested and at the cap of nested_late
query I
SELECT i FROM nested.t ORDER BY i
----
1
2
3

query I
SELECT i FROM nested_late.t ORDER BY i
----
1
3

query I
SELECT i FROM nested.t AT (VERSION => 2) ORDER BY i
----
1
2
3

statement ok
DETACH nested_late

statement ok
DETACH nested

statement ok
DETACH dev

statement ok
DETACH dl
