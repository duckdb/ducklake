# name: test/sql/branches/branch_root_without_parent.test
# description: a branch row without a parent is a root of its own, so the expiry of main inherits nothing to it
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DELETE FROM dl.t

statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'island', NULL, NULL)

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata', storage => 'memory')

statement ok
CALL ducklake_expire_snapshots('dl', versions => [1])

statement ok
CALL disable_logging()

# the guard keeps the files the events of the branch reference, there is no cap of main to inherit through
query I
SELECT count(*) > 0 FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%NOT EXISTS (SELECT 1 FROM%ducklake_branch b%'
----
true

query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%AND NOT ((f.begin_snapshot <=%'
----
0

query I
SELECT count(*) FROM ducklake_cleanup_old_files('dl', cleanup_all => true)
----
1

statement ok
DETACH dl

# the root has no snapshots of its own and inherits none
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', BRANCH 'island')

statement error
SELECT id FROM dl.current_snapshot()
----
No snapshot found in DuckLake

statement ok
DETACH dl
