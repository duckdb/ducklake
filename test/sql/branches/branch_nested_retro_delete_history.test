# name: test/sql/branches/branch_nested_retro_delete_history.test
# description: a flushed delete file of main ends on a nested branch where its parent suppressed it, so a historical read applies one delete file
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t(i INTEGER)

statement ok
INSERT INTO lake.t VALUES (1), (2), (3), (4)

# the delete of main is inlined, the flush below turns it into a delete file that starts at snapshot 3
statement ok
CALL ducklake_set_option('lake', 'data_inlining_row_limit', 10)

statement ok
DELETE FROM lake.t WHERE i = 1

query I
SELECT id FROM lake.current_snapshot()
----
3

# dev forks main at 3 and holds a cumulative delete file of its own at 4
statement ok
COPY (SELECT ''::VARCHAR AS file_path, p::BIGINT AS pos, s::BIGINT AS _ducklake_internal_snapshot_id FROM (VALUES (0, 3), (1, 4)) v(p, s)) TO '{TEST_DIR}/{BASE_TEST_NAME}_dev_delete.parquet' (FORMAT PARQUET)

statement ok
INSERT INTO meta.ducklake_delete_file (delete_file_id, table_id, data_file_id, path, path_is_relative, format, delete_count, file_size_bytes, partial_max) SELECT 1099511627776, 1, 0, '{TEST_DIR}/{BASE_TEST_NAME}_dev_delete.parquet', false, 'parquet', 2, file_size_bytes, 4 FROM parquet_file_metadata('{TEST_DIR}/{BASE_TEST_NAME}_dev_delete.parquet')

statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 3)

statement ok
INSERT INTO meta.ducklake_snapshot SELECT 4, NOW(), schema_version, 1099511627776, 1099511627777, 1 FROM meta.ducklake_snapshot WHERE branch_id = 0 AND snapshot_id = 3

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (4, NULL, NULL, NULL, NULL, 1)

statement ok
INSERT INTO meta.ducklake_delete_file_visibility VALUES (1, 1, 1099511627776, 4, false)

# feature forks dev at 4 and replaces the delete file of dev with a cumulative one of its own at 5
statement ok
COPY (SELECT ''::VARCHAR AS file_path, p::BIGINT AS pos, s::BIGINT AS _ducklake_internal_snapshot_id FROM (VALUES (0, 3), (1, 4), (2, 5)) v(p, s)) TO '{TEST_DIR}/{BASE_TEST_NAME}_feature_delete.parquet' (FORMAT PARQUET)

statement ok
INSERT INTO meta.ducklake_delete_file (delete_file_id, table_id, data_file_id, path, path_is_relative, format, delete_count, file_size_bytes, partial_max) SELECT 2199023255552, 1, 0, '{TEST_DIR}/{BASE_TEST_NAME}_feature_delete.parquet', false, 'parquet', 3, file_size_bytes, 5 FROM parquet_file_metadata('{TEST_DIR}/{BASE_TEST_NAME}_feature_delete.parquet')

statement ok
INSERT INTO meta.ducklake_branch VALUES (2, 'feature', 1, 4)

statement ok
INSERT INTO meta.ducklake_snapshot SELECT 5, NOW(), schema_version, 2199023255552, 2199023255553, 2 FROM meta.ducklake_snapshot WHERE branch_id = 1 AND snapshot_id = 4

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (5, NULL, NULL, NULL, NULL, 2)

statement ok
INSERT INTO meta.ducklake_delete_file_visibility VALUES (2, 1, 1099511627776, 5, true), (2, 1, 2199023255552, 5, false)

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS feature (METADATA_CATALOG 'meta', BRANCH 'feature')

# before the flush every snapshot of the chain reads through the delete file that was current at it
query I
SELECT i FROM dev.t ORDER BY i
----
3
4

query I
SELECT i FROM dev.t AT (VERSION => 3) ORDER BY i
----
2
3
4

query I
SELECT i FROM feature.t ORDER BY i
----
4

query I
SELECT i FROM feature.t AT (VERSION => 4) ORDER BY i
----
3
4

query I
SELECT i FROM feature.t AT (VERSION => 3) ORDER BY i
----
2
3
4

statement ok
CALL ducklake_flush_inlined_data('lake')

query I
SELECT i FROM lake.t ORDER BY i
----
2
3
4

query I
SELECT i FROM lake.t AT (VERSION => 3) ORDER BY i
----
2
3
4

# both branches suppress the flushed file from their first own delete file on
query III
SELECT branch_id, snapshot_id, is_delete::BOOLEAN FROM meta.ducklake_delete_file_visibility WHERE branch_id <> 0 AND delete_file_id NOT IN (1099511627776, 2199023255552) ORDER BY branch_id
----
1	4	true
2	5	true

query I
SELECT i FROM dev.t ORDER BY i
----
3
4

query I
SELECT i FROM dev.t AT (VERSION => 3) ORDER BY i
----
2
3
4

query I
SELECT i FROM feature.t ORDER BY i
----
4

# the suppression of dev ends the flushed file at 4 on feature too, the earlier delete of the chain wins
query I
SELECT i FROM feature.t AT (VERSION => 4) ORDER BY i
----
3
4

query I
SELECT i FROM feature.t AT (VERSION => 3) ORDER BY i
----
2
3
4

statement ok
DETACH feature

statement ok
DETACH dev

statement ok
DETACH lake
