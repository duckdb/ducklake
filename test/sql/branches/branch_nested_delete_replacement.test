# name: test/sql/branches/branch_nested_delete_replacement.test
# description: replacing a delete file on main hands the replacement to a nested branch that inherited the old file
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t(i INTEGER)

statement ok
INSERT INTO lake.t VALUES (1), (2), (3)

statement ok
DELETE FROM lake.t WHERE i = 1

query I
SELECT id FROM lake.current_snapshot()
----
3

# both branches inherit the delete file through the fork at 3 without events of their own
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 3), (2, 'feature', 1, 3)

statement ok
INSERT INTO meta.ducklake_snapshot SELECT 4, NOW(), schema_version, 2199023255552, 2199023255552, 2 FROM meta.ducklake_snapshot WHERE branch_id = 0 AND snapshot_id = 3

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (4, NULL, NULL, NULL, NULL, 2)

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS feature (METADATA_CATALOG 'meta', BRANCH 'feature')

query I
SELECT i FROM feature.t ORDER BY i
----
2
3

# the second delete of main replaces the delete file with a cumulative one
statement ok
DELETE FROM lake.t WHERE i = 2

query I
SELECT i FROM lake.t
----
3

query I
SELECT COUNT(*) FROM meta.ducklake_delete_file
----
1

# the replacement carries the add event of main alone, which both branches read through the fork
query III
SELECT branch_id, snapshot_id, is_delete::BOOLEAN FROM meta.ducklake_delete_file_visibility WHERE branch_id <> 0 ORDER BY branch_id
----

# the branches apply only the deletes dated up to their fork
query I
SELECT i FROM feature.t ORDER BY i
----
2
3

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

query I
SELECT i FROM dev.t ORDER BY i
----
2
3

statement ok
DETACH dev

statement ok
DETACH feature

statement ok
DETACH lake
