# name: test/sql/branches/branch_attach_read.test
# description: a read-only attach at a branch reads inherited data at the fork and its own visibility rows
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/branch_attach_read_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
INSERT INTO dl.t VALUES (2)

# fork dev at the snapshot of the first insert
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 2, 2, NULL)

# a delete on main after the fork
statement ok
DELETE FROM dl.t WHERE i = 1

query I
SELECT * FROM dl.t
----
2

statement ok
DETACH dl

# an unknown branch is an error
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/branch_attach_read_files', METADATA_CATALOG 'meta', BRANCH 'feature')
----
No branch with the name "feature" exists

# a branch name that is not a string is cast and looked up
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/branch_attach_read_files', METADATA_CATALOG 'meta', BRANCH 1)
----
No branch with the name "1" exists

# a branch attach cannot be read write
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/branch_attach_read_files', METADATA_CATALOG 'meta', BRANCH 'dev', READ_WRITE)
----
BRANCH can only be used in read-only mode

# main as a branch name is a plain attach and stays writable
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/branch_attach_read_files', METADATA_CATALOG 'meta', BRANCH 'main')

statement ok
INSERT INTO dl.t VALUES (3)

statement ok
DELETE FROM dl.t WHERE i = 3

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/branch_attach_read_files', METADATA_CATALOG 'meta', BRANCH 'dev')

# the branch head is the fork, the later insert and delete of main are not visible
query I
SELECT * FROM dl.t
----
1

query I
SELECT * FROM dl.t AT (VERSION => 2)
----
1

# the branch is read only
statement error
INSERT INTO dl.t VALUES (4)
----
read-only mode

statement ok
DETACH dl

# a snapshot of the branch and a visibility row that ends the inherited file on dev
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS m (DATA_PATH '{DATA_PATH}/branch_attach_read_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 100, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 2

statement ok
INSERT INTO meta.ducklake_file_visibility SELECT 1, table_id, data_file_id, begin_snapshot, 100 FROM meta.ducklake_file_visibility WHERE branch_id = 0 AND begin_snapshot = 2

statement ok
DETACH m

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/branch_attach_read_files', METADATA_CATALOG 'meta', BRANCH 'dev')

# the visibility row of the branch is authoritative, the file is gone at the branch head
query I
SELECT COUNT(*) FROM dl.t
----
0

# and still there before its end on the branch
query I
SELECT * FROM dl.t AT (VERSION => 2)
----
1

statement ok
DETACH dl

# main is unaffected by the branch rows
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/branch_attach_read_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

query I
SELECT * FROM dl.t
----
2

statement ok
DETACH dl
