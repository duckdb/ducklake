# name: test/sql/branches/branch_inlined_delete_after_fork.test
# description: inlined rows main deletes or updates after the fork keep the versions of the fork on the branch
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER, v VARCHAR)

statement ok
INSERT INTO dl.t VALUES (1, 'a'), (2, 'b'), (3, 'c')

# dev forks at the insert and holds a snapshot of its own
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 2)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 3, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 2 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (3, NULL, NULL, NULL, NULL, 1)

# main deletes, updates and inserts after the fork
statement ok
DELETE FROM dl.t WHERE i = 2

statement ok
UPDATE dl.t SET v = 'c2' WHERE i = 3

statement ok
INSERT INTO dl.t VALUES (4, 'd')

query II
SELECT i, v FROM dl.t ORDER BY i
----
1	a
3	c2
4	d

# the ends of main after the fork and the versions it re inserted are not in the view of dev
query IIIIII
FROM meta.ducklake_inlined_data_visibility ORDER BY ALL
----
1	1	0	2	0	3
1	2	0	2	0	4

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

query II
SELECT i, v FROM dev.t ORDER BY i
----
1	a
2	b
3	c

query I
SELECT count(*) FROM dev.t
----
3

query II
SELECT rowid, i FROM dev.t ORDER BY rowid
----
0	1
1	2
2	3

query II
SELECT i, v FROM dev.t AT (VERSION => 2) ORDER BY i
----
1	a
2	b
3	c

# main reads its own history at the fork and its head
query II
SELECT i, v FROM dl.t AT (VERSION => 2) ORDER BY i
----
1	a
2	b
3	c

query II
SELECT i, v FROM dl.t AT (VERSION => 3) ORDER BY i
----
1	a
3	c

query I
SELECT count(*) FROM dl.t
----
3

statement ok
DETACH dev

statement ok
DETACH dl
