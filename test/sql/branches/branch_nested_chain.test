# name: test/sql/branches/branch_nested_chain.test
# description: a branch of a branch reads its head through two caps and lists the snapshots of its lineage
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files',
    METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
INSERT INTO dl.t VALUES (2)

statement ok
INSERT INTO dl.t VALUES (3)

# dev forks from main at the first insert and has a snapshot 3 of its own
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 2)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id,
    branch_id) SELECT 3, NOW(), schema_version, next_catalog_id, next_file_id,
    1 FROM meta.ducklake_snapshot WHERE snapshot_id = 2 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (3, NULL, NULL, NULL, NULL, 1)

# feature forks from dev at its snapshot 3 and has a snapshot 4 of its own
statement ok
INSERT INTO meta.ducklake_branch VALUES (2, 'feature', 1, 3)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id,
    branch_id) SELECT 4, NOW(), schema_version, next_catalog_id, next_file_id,
    2 FROM meta.ducklake_snapshot WHERE snapshot_id = 3 AND branch_id = 1

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (4, NULL, NULL, NULL, NULL, 2)

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files',
    METADATA_CATALOG 'meta', BRANCH 'feature')

query I
SELECT id FROM dl.current_snapshot()
----
4

# main up to 2, dev up to 3 and the own snapshot of feature
query I
SELECT list(snapshot_id ORDER BY snapshot_id) FROM dl.snapshots()
----
[0, 1, 2, 3, 4]

# every version of the lineage resolves to the segment that holds it
statement ok
SELECT i FROM dl.t AT (VERSION => 2)

statement ok
SELECT i FROM dl.t AT (VERSION => 3)

statement ok
SELECT i FROM dl.t AT (VERSION => 4)

statement error
SELECT i FROM dl.t AT (VERSION => 5)
----
No snapshot found at version 5

statement ok
DETACH dl

# dev sees neither the snapshot of feature nor the third insert of main
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files',
    METADATA_CATALOG 'meta', BRANCH 'dev')

query I
SELECT id FROM dl.current_snapshot()
----
3

query I
SELECT list(snapshot_id ORDER BY snapshot_id) FROM dl.snapshots()
----
[0, 1, 2, 3]

statement error
SELECT i FROM dl.t AT (VERSION => 4)
----
No snapshot found at version 4

statement ok
DETACH dl

# main is unaffected by the rows of both branches
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files',
    METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

query I
SELECT id FROM dl.current_snapshot()
----
4

query I
SELECT i FROM dl.t ORDER BY i
----
1
2
3

query I
SELECT list(snapshot_id ORDER BY snapshot_id) FROM dl.snapshots()
----
[0, 1, 2, 3, 4]

statement ok
DETACH dl
