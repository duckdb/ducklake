# name: test/sql/branches/branchless_skips_guards.test
# description: expiry on a lake without branches runs no visibility guard and keeps it once a branch exists
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DELETE FROM dl.t

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata', storage => 'memory')

statement ok
CALL ducklake_expire_snapshots('dl', versions => [1])

statement ok
CALL disable_logging()

# without branches the unused file queries carry no branch guard
query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%NOT EXISTS (SELECT 1 FROM%ducklake_branch b%'
----
0

query I
SELECT count(*) FROM ducklake_cleanup_old_files('dl', cleanup_all => true)
----
1

statement ok
CREATE TABLE dl.u AS SELECT 7 AS i

statement ok
DELETE FROM dl.u

statement ok
INSERT INTO dl.u VALUES (8)

# the branch forks at the creation of u, so it inherits the file the delete ended
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 3)

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata', storage => 'memory')

statement ok
CALL ducklake_expire_snapshots('dl', versions => [4])

statement ok
CALL disable_logging()

# with a live branch the guard keeps the files its events reference and the files it inherits at its fork
query I
SELECT count(*) > 0 FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%NOT EXISTS (SELECT 1 FROM%ducklake_branch b%'
AND query LIKE '%f.begin_snapshot <= 3 AND (f.end_snapshot IS NULL OR 3 < f.end_snapshot)%'
----
true

query I
SELECT i FROM dl.u
----
8
