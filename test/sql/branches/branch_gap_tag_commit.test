# name: test/sql/branches/branch_gap_tag_commit.test
# description: a commit with a tag over a moved lineage with branch snapshots must conflict, not fill the id gap
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (42)

statement ok con1
BEGIN

query I con1
SELECT id FROM dl.current_snapshot()
----
2

statement ok con1
CREATE TABLE dl.u(j INTEGER)

statement ok con1
CALL ducklake_create_tag('dl', 'pin', version => 2)

statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 2, 2, NULL)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 100, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 2

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (100, NULL, NULL, NULL, NULL)

statement ok con2
CREATE TABLE dl.u(j INTEGER)

query I
SELECT id FROM dl.current_snapshot()
----
101

statement error con1
COMMIT
----
Transaction conflict

query I
SELECT count(*) FROM meta.ducklake_table WHERE table_name = 'u' AND end_snapshot IS NULL
----
1
