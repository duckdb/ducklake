# name: test/sql/branches/branch_gap_tag_commit.test
# description: a tagged commit next to a branch snapshot with the same id conflicts with the concurrent commit of main
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (42)

statement ok con1
BEGIN

query I con1
SELECT id FROM dl.current_snapshot()
----
2

statement ok con1
CREATE TABLE dl.u(j INTEGER)

statement ok con1
CALL ducklake_create_tag('dl', 'pin', version => 2)

# a branch snapshot takes the id main commits next
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 2)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 3, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 2 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (3, NULL, NULL, NULL, NULL, 1)

# main commits its own 3 next to the branch snapshot
statement ok con2
CREATE TABLE dl.u(j INTEGER)

query I
SELECT id FROM dl.current_snapshot()
----
3

query II
SELECT snapshot_id, branch_id FROM meta.ducklake_snapshot WHERE snapshot_id = 3 ORDER BY branch_id
----
3	0
3	1

# the tag routes the commit through the conflict check, which sees the table main created
statement error con1
COMMIT
----
Transaction conflict

query I
SELECT count(*) FROM meta.ducklake_table t WHERE table_name = 'u' AND NOT EXISTS (SELECT 1 FROM meta.ducklake_table_visibility e WHERE e.table_id = t.table_id AND e.row_branch_id = t.branch_id AND e.row_snapshot = t.begin_snapshot)
----
1
