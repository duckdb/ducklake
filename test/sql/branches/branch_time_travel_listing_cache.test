# name: test/sql/branches/branch_time_travel_listing_cache.test
# description: a branch attach serves a read below its head from the cache until a flush on main moves a head of the chain
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE lake.t (i INTEGER)

statement ok
INSERT INTO lake.t VALUES (1), (2)

# fork dev at the inlined insert and give it a snapshot of its own, so the fork snapshot lies below its head
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 2)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 3, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 2 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (3, NULL, NULL, NULL, NULL, 1)

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

query I
SELECT snapshot_id FROM ducklake_snapshots('dev') ORDER BY snapshot_id DESC LIMIT 1
----
3

# two reads of the fork snapshot list its files once, the second is served from the cache
statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata', storage => 'memory')

query I
SELECT i FROM dev.t AT (VERSION => 2) ORDER BY i
----
1
2

query I
SELECT i FROM dev.t AT (VERSION => 2) ORDER BY i
----
1
2

statement ok
CALL disable_logging()

query I
SELECT CASE WHEN (SELECT catalog_type FROM ducklake_settings('dev')) IN ('duckdb', 'sqlite', 'postgres') THEN
    (SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
     WHERE query LIKE '%data.partial^_max, data.mapping^_id%' ESCAPE '^')
    ELSE 1 END
----
1

query I
SELECT count(*) FROM ducklake_list_files('dev', 't', snapshot_version => 2)
----
0

statement ok
CALL ducklake_flush_inlined_data('lake', table_name => 't')

# the flush committed on main, the parent of dev, so the listing of the fork snapshot runs again
statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata', storage => 'memory')

query I
SELECT i FROM dev.t AT (VERSION => 2) ORDER BY i
----
1
2

statement ok
CALL disable_logging()

query I
SELECT CASE WHEN (SELECT catalog_type FROM ducklake_settings('dev')) IN ('duckdb', 'sqlite', 'postgres') THEN
    (SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
     WHERE query LIKE '%data.partial^_max, data.mapping^_id%' ESCAPE '^')
    ELSE 1 END
----
1

query I
SELECT count(*) FROM ducklake_list_files('dev', 't', snapshot_version => 2)
----
1
