# name: test/sql/branches/branch_nested_inlined.test
# description: a branch of a branch reads inherited inlined rows through two caps, with the ends of the middle branch below its cap
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

# dev forks from main at 2 and holds the snapshots 3 and 4
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 2)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 3, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 2 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 4, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 2 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (3, NULL, NULL, NULL, NULL, 1), (4, NULL, NULL, NULL, NULL, 1)

# dev ends the second row at 3 and the third at 4
statement ok
INSERT INTO meta.ducklake_inlined_data_1_1_visibility VALUES (1, 1, 0, 2, 3), (1, 2, 0, 2, 4)

# nested forks from dev at 3 and holds the snapshot 4
statement ok
INSERT INTO meta.ducklake_branch VALUES (2, 'nested', 1, 3)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 4, NOW(), schema_version, next_catalog_id, next_file_id, 2 FROM meta.ducklake_snapshot WHERE snapshot_id = 2 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (4, NULL, NULL, NULL, NULL, 2)

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS nested (METADATA_CATALOG 'meta', BRANCH 'nested')

query I
SELECT i FROM dev.t ORDER BY i
----
1

query I
SELECT i FROM dev.t AT (VERSION => 3) ORDER BY i
----
1
3

query I
SELECT i FROM dev.t AT (VERSION => 2) ORDER BY i
----
1
2
3

# nested inherits the end of dev at its cap, not the one above it
query I
SELECT i FROM nested.t ORDER BY i
----
1
3

query I
SELECT count(*) FROM nested.t
----
2

query I
SELECT i FROM nested.t AT (VERSION => 2) ORDER BY i
----
1
2
3

# main reads none of the ends of its branches
query I
SELECT i FROM dl.t ORDER BY i
----
1
2
3

statement ok
DETACH nested

statement ok
DETACH dev

statement ok
DETACH dl
