# name: test/sql/branches/sqlite_wal_branch_gap_moved_lineage.test
# description: a WAL SQLite catalog refreshes a moved lineage with a branch snapshot without spending a retry
# group: [branches]

require ducklake

require parquet

require sqlite_scanner

set ignore_error_messages

statement ok
ATTACH 'ducklake:sqlite:{TEST_DIR}/wal_maxima.db' AS dl (DATA_PATH '{TEST_DIR}/wal_maxima', METADATA_CATALOG 'meta', META_JOURNAL_MODE 'wal', DUCKLAKE_VERSION '2.0-dev1')

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
SET ducklake_max_retry_count = 0

statement ok con1
BEGIN

query I con1
SELECT id FROM dl.current_snapshot()
----
1

statement ok con1
CREATE TABLE dl.u(i INTEGER)

statement ok con2
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 1, 1, NULL)

statement ok con2
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 100, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 1

statement ok con2
INSERT INTO meta.ducklake_snapshot_changes VALUES (100, NULL, NULL, NULL, NULL)

statement ok con2
CREATE TABLE dl.v(i INTEGER)

query I con2
SELECT id FROM dl.current_snapshot()
----
101

statement ok con1
COMMIT

query I
SELECT id FROM dl.current_snapshot()
----
102
