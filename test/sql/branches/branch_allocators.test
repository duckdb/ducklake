# name: test/sql/branches/branch_allocators.test
# description: a branch snapshot next to the next id of main leaves the ids, schema version and allocators of main alone
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

query IIII
SELECT snapshot_id, schema_version, next_catalog_id, next_file_id FROM meta.ducklake_snapshot WHERE branch_id = 0 ORDER BY snapshot_id DESC LIMIT 1
----
2	1	2	1

statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 2)

# the first branch snapshot takes the id main commits next, with a higher schema version and allocators
statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) VALUES (3, NOW(), 7, 50, 60, 1)

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (3, NULL, NULL, NULL, NULL, 1)

statement ok
INSERT INTO dl.t VALUES (2)

# main commits its own 3 next to the branch snapshot and allocates from its own head
query IIII
SELECT snapshot_id, schema_version, next_catalog_id, next_file_id FROM meta.ducklake_snapshot WHERE branch_id = 0 ORDER BY snapshot_id DESC LIMIT 1
----
3	1	2	2

query IIII
SELECT branch_id, schema_version, next_catalog_id, next_file_id FROM meta.ducklake_snapshot WHERE snapshot_id = 3 ORDER BY branch_id
----
0	1	2	2
1	7	50	60

query I
SELECT id FROM dl.current_snapshot()
----
3

query I
SELECT i FROM dl.t ORDER BY i
----
1
2

statement ok con1
BEGIN

query I con1
SELECT count(*) FROM dl.t
----
2

statement ok con1
INSERT INTO dl.t VALUES (3)

# another branch snapshot appears while con1 holds its read
statement ok con2
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) VALUES (4, NOW(), 9, 70, 80, 1)

statement ok con2
INSERT INTO meta.ducklake_snapshot_changes VALUES (4, NULL, NULL, NULL, NULL, 1)

statement ok con1
COMMIT

query IIII
SELECT snapshot_id, schema_version, next_catalog_id, next_file_id FROM meta.ducklake_snapshot WHERE branch_id = 0 ORDER BY snapshot_id DESC LIMIT 1
----
4	1	2	3

query I
SELECT sum(i) FROM dl.t
----
6

# the listing of main holds its own snapshots only
query I
SELECT list(snapshot_id ORDER BY snapshot_id) FROM dl.snapshots()
----
[0, 1, 2, 3, 4]
