# name: test/sql/branches/branch_listing_overlapping_flush.test
# description: a branch transaction that read before a flush of main does not repopulate the shared listing a later reader dropped
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE lake.t (i BIGINT)

statement ok
INSERT INTO lake.t SELECT range FROM range(20)

statement ok
DELETE FROM lake.t WHERE i = 0

query I
SELECT count(*) FROM meta.ducklake_inlined_delete_1
----
1

statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 3, 3, NULL)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 100, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 3

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

statement ok con1
BEGIN

query I con1
SELECT id FROM dev.current_snapshot()
----
100

statement ok con2
CALL ducklake_flush_inlined_data('lake', table_name => 't')

query I con2
SELECT id FROM dev.current_snapshot()
----
100

query I con1
SELECT i FROM dev.t WHERE i < 2 ORDER BY i
----
1

statement ok con1
COMMIT

query I con2
SELECT i FROM dev.t WHERE i < 2 ORDER BY i
----
1
