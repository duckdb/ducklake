# name: test/sql/branches/branch_nested_retro_delete.test
# description: flushing the inlined deletes of main keeps the cumulative delete file of a nested branch
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t(i INTEGER)

statement ok
INSERT INTO lake.t VALUES (1), (2), (3), (4)

# the delete of main is inlined, the flush below turns it into a delete file that starts at snapshot 3
statement ok
CALL ducklake_set_option('lake', 'data_inlining_row_limit', 10)

statement ok
DELETE FROM lake.t WHERE i = 1

query I
SELECT id FROM lake.current_snapshot()
----
3

# the nested branch feature forks dev, which forks main at 3, and holds a cumulative delete file of its own
statement ok
COPY (SELECT ''::VARCHAR AS file_path, p::BIGINT AS pos, s::BIGINT AS _ducklake_internal_snapshot_id FROM (VALUES (0, 3), (1, 4)) v(p, s)) TO '{TEST_DIR}/{BASE_TEST_NAME}_delete.parquet' (FORMAT PARQUET)

statement ok
INSERT INTO meta.ducklake_delete_file (delete_file_id, table_id, data_file_id, path, path_is_relative, format, delete_count, file_size_bytes, partial_max) SELECT 2199023255552, 1, 0, '{TEST_DIR}/{BASE_TEST_NAME}_delete.parquet', false, 'parquet', 2, file_size_bytes, 4 FROM parquet_file_metadata('{TEST_DIR}/{BASE_TEST_NAME}_delete.parquet')

statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 3), (2, 'feature', 1, 3)

statement ok
INSERT INTO meta.ducklake_snapshot SELECT 4, NOW(), schema_version, 2199023255552, 2199023255553, 2 FROM meta.ducklake_snapshot WHERE branch_id = 0 AND snapshot_id = 3

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (4, NULL, NULL, NULL, NULL, 2)

statement ok
INSERT INTO meta.ducklake_delete_file_visibility VALUES (2, 1, 2199023255552, 4, false)

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS feature (METADATA_CATALOG 'meta', BRANCH 'feature')

query I
SELECT i FROM feature.t ORDER BY i
----
3
4

statement ok
CALL ducklake_flush_inlined_data('lake')

query I
SELECT i FROM lake.t ORDER BY i
----
2
3
4

# the flush writes no event of a branch, feature chooses its own delete file over the flushed one and dev inherits it
query III
SELECT branch_id, snapshot_id, is_delete::BOOLEAN FROM meta.ducklake_delete_file_visibility WHERE branch_id <> 0 AND delete_file_id <> 2199023255552
----

query I
SELECT i FROM feature.t ORDER BY i
----
3
4

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

query I
SELECT i FROM dev.t ORDER BY i
----
2
3
4

statement ok
DETACH dev

statement ok
DETACH feature

statement ok
DETACH lake
