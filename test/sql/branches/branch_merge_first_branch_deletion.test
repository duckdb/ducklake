# name: test/sql/branches/branch_merge_first_branch_deletion.test
# description: a merge of main sees the first inlined file deletion of a branch although main probed the table before
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

statement ok
INSERT INTO dl.t VALUES (4), (5), (6)

# the scan of main records that t has no inlined deletion table
query I
SELECT list(i ORDER BY i) FROM dl.t
----
[1, 2, 3, 4, 5, 6]

# dev forks at 3, its snapshot 4 deletes the row 2 of the first file with an inlined file deletion
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 3)

statement ok
INSERT INTO meta.ducklake_snapshot SELECT 4, NOW(), schema_version, next_catalog_id, next_file_id, 1
FROM meta.ducklake_snapshot WHERE branch_id = 0 AND snapshot_id = 3

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (4, 'deleted_from_table:1', NULL, NULL, NULL, 1)

statement ok
CREATE TABLE meta.ducklake_inlined_delete_1 (file_id BIGINT, row_id BIGINT, begin_snapshot BIGINT,
    branch_id BIGINT DEFAULT 0)

statement ok
INSERT INTO meta.ducklake_inlined_delete_1 SELECT MIN(data_file_id), 1, 4, 1 FROM meta.ducklake_data_file

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

query I
SELECT list(i ORDER BY i) FROM dev.t
----
[1, 3, 4, 5, 6]

# the merge reads the deletion table afresh, so the file the deletion of dev names keeps its identity
statement ok
CALL ducklake_merge_adjacent_files('dl', 't')

query I
SELECT list(i ORDER BY i) FROM dev.t
----
[1, 3, 4, 5, 6]

query I
SELECT list(i ORDER BY i) FROM dl.t
----
[1, 2, 3, 4, 5, 6]

query I
SELECT COUNT(*) FROM meta.ducklake_inlined_delete_1 d
WHERE EXISTS (SELECT 1 FROM meta.ducklake_data_file f WHERE f.data_file_id = d.file_id)
----
1

statement ok
DETACH dev

statement ok
DETACH dl
