# name: test/sql/branches/branch_attach_compacted.test
# description: rows of a compacted file read as the parent at the fork on a branch
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/branch_attach_compacted_files',
    METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
INSERT INTO dl.t VALUES (2)

statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 2)

# compact the two inserts into one file on main
statement ok
CALL ducklake_merge_adjacent_files('dl')

query I
SELECT COUNT(*) FROM meta.ducklake_file_visibility v WHERE v.branch_id = 0 AND v.is_delete = FALSE AND NOT EXISTS
    (SELECT 1 FROM meta.ducklake_file_visibility d WHERE d.branch_id = 0 AND d.is_delete = TRUE AND d.data_file_id =
    v.data_file_id)
----
1

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/branch_attach_compacted_files',
    METADATA_CATALOG 'meta', BRANCH 'dev')

# only the rows of the fork snapshot are visible inside the compacted file
query I
SELECT * FROM dl.t
----
1

statement ok
DETACH dl
