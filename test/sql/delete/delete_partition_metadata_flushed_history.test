# name: test/sql/delete/delete_partition_metadata_flushed_history.test
# description: Partition deletes preserve the history of files flushed in the same transaction
# group: [delete]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/partition_flushed_history', DATA_INLINING_ROW_LIMIT 500)

statement ok
CREATE TABLE lake.t(id INTEGER, p INTEGER)

statement ok
ALTER TABLE lake.t SET PARTITIONED BY (p)

statement ok
INSERT INTO lake.t VALUES (1, 1), (2, 1), (3, 2)

statement ok
BEGIN

statement ok
CALL ducklake_flush_inlined_data('lake', table_name => 't')

query I
DELETE FROM lake.t WHERE p = 1
----
2

statement ok
COMMIT

query II
SELECT * FROM lake.t ORDER BY id
----
3	2

query II
SELECT * FROM lake.t AT (VERSION => 3) ORDER BY id
----
1	1
2	1
3	2

query ITI
SELECT snapshot_id, change_type, id FROM ducklake_table_changes('lake', 'main', 't', 4, 4) ORDER BY id
----
4	delete	1
4	delete	2
