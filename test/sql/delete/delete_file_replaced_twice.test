# name: test/sql/delete/delete_file_replaced_twice.test
# description: A transaction that deletes twice from a file with a committed delete file schedules that delete file
# group: [delete]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/delete_file_replaced_twice', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t (id INTEGER)

statement ok
INSERT INTO lake.t SELECT i FROM range(10) t(i)

statement ok
DELETE FROM lake.t WHERE id = 9

statement ok
BEGIN

statement ok
DELETE FROM lake.t WHERE id = 1

statement ok
DELETE FROM lake.t WHERE id = 3

statement ok
DELETE FROM lake.t WHERE id = 5

statement ok
COMMIT

query I
SELECT count(*) FROM ducklake_delete_orphaned_files('lake', cleanup_all => true, dry_run => true)
----
0

query I
SELECT count(*) FROM ducklake_cleanup_old_files('lake', cleanup_all => true, dry_run => true)
----
1

statement ok
CALL ducklake_cleanup_old_files('lake', cleanup_all => true)

query I
SELECT count(*) FROM glob('{DATA_PATH}/delete_file_replaced_twice/main/t/*-delete.*')
----
1

query I
SELECT list(id ORDER BY id) FROM lake.t
----
[0, 2, 4, 6, 7, 8]

query I
SELECT list(id ORDER BY id) FROM lake.t AT (VERSION => 3)
----
[0, 1, 2, 3, 4, 5, 6, 7, 8]
