# name: test/sql/delete/full_file_delete_stats_exactness.test
# description: Full-file delete recomputation preserves exact and truncated string bounds
# group: [delete]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/full_file_delete_stats_exactness', METADATA_CATALOG 'md', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t(s VARCHAR)

statement ok
INSERT INTO ducklake.t VALUES ('A')

statement ok
COPY (SELECT 'B' || repeat('x', 300) AS s) TO '{DATA_PATH}/full_file_delete_stats_truncated.parquet'

statement ok
CALL ducklake_add_data_files('ducklake', 't', '{DATA_PATH}/full_file_delete_stats_truncated.parquet')

statement ok
INSERT INTO ducklake.t VALUES ('hello'), ('world')

# Dropping an exact minimum leaves a truncated minimum and an exact maximum.
query I
DELETE FROM ducklake.t WHERE s = 'A'
----
1

query II
SELECT min_is_exact::BOOLEAN, max_is_exact::BOOLEAN FROM md.ducklake_table_column_stats
----
false	true

# The cached stats must not turn the truncated bound into an actual MIN result.
query III
SELECT COUNT(*), MIN(s) = 'B' || repeat('x', 300), MAX(s) = 'world' FROM ducklake.t
----
3	true	true

# Dropping the truncated file restores exact bounds on both sides.
query I
DELETE FROM ducklake.t WHERE s = 'B' || repeat('x', 300)
----
1

query TTII
SELECT min_value, max_value, min_is_exact::BOOLEAN, max_is_exact::BOOLEAN FROM md.ducklake_table_column_stats
----
hello	world	true	true

query ITT
SELECT COUNT(*), MIN(s), MAX(s) FROM ducklake.t
----
2	hello	world
