# name: test/sql/delete/full_file_delete_stats_read_committed.test
# description: PostgreSQL reads the snapshot ID and mutable table bounds from one statement snapshot
# group: [delete]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'dbname=ducklakedb' AS pg (TYPE postgres)

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS stats_snapshot_atomicity CASCADE')

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb' AS dl
(DATA_PATH '{DATA_PATH}/stats_snapshot_atomicity', METADATA_SCHEMA 'stats_snapshot_atomicity',
 DATA_INLINING_ROW_LIMIT 0, METADATA_PARAMETERS MAP {'isolation_level': 'READ COMMITTED'})

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t SELECT range FROM range(100)

statement ok
INSERT INTO dl.t SELECT range FROM range(1000, 1100)

# Pause only the first global-statistics snapshot read. The writer commits narrowed bounds while it is paused.
# A single remote statement must still read all its tables from the snapshot taken before the writer commits.
statement ok
CALL postgres_execute('pg', 'CREATE SEQUENCE stats_snapshot_atomicity.entered;
CREATE SEQUENCE stats_snapshot_atomicity.finished;
CREATE FUNCTION stats_snapshot_atomicity.pause_snapshot() RETURNS boolean AS $$
DECLARE deadline timestamptz := clock_timestamp() + interval ''15 seconds'';
BEGIN
    IF (current_query() LIKE ''%SELECT "snapshot_id" FROM "stats_snapshot_atomicity"."ducklake_snapshot"%''
        OR current_query() LIKE ''%latest_snapshot_id%'')
       AND nextval(''stats_snapshot_atomicity.entered'') = 1 THEN
        LOOP
            EXIT WHEN (SELECT is_called FROM stats_snapshot_atomicity.finished);
            IF clock_timestamp() > deadline THEN
                RAISE EXCEPTION ''writer did not finish the full-file deletion'';
            END IF;
            PERFORM pg_sleep(0.01);
        END LOOP;
    END IF;
    RETURN TRUE;
END $$ LANGUAGE plpgsql;
ALTER TABLE stats_snapshot_atomicity.ducklake_snapshot RENAME TO original_snapshot;
CREATE VIEW stats_snapshot_atomicity.ducklake_snapshot AS
SELECT * FROM stats_snapshot_atomicity.original_snapshot WHERE stats_snapshot_atomicity.pause_snapshot();
CREATE FUNCTION stats_snapshot_atomicity.wait_for_reader() RETURNS integer AS $$
DECLARE deadline timestamptz := clock_timestamp() + interval ''15 seconds'';
BEGIN
    LOOP
        EXIT WHEN (SELECT is_called FROM stats_snapshot_atomicity.entered);
        IF clock_timestamp() > deadline THEN
            RAISE EXCEPTION ''reader did not reach the global statistics snapshot read'';
        END IF;
        PERFORM pg_sleep(0.01);
    END LOOP;
    RETURN 1;
END $$ LANGUAGE plpgsql', prepare = false)

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb' AS dl
(DATA_PATH '{DATA_PATH}/stats_snapshot_atomicity', METADATA_SCHEMA 'stats_snapshot_atomicity',
 DATA_INLINING_ROW_LIMIT 0, METADATA_PARAMETERS MAP {'isolation_level': 'READ COMMITTED'})

concurrentloop worker 0 2

onlyif worker=0
statement ok
BEGIN

onlyif worker=0
query I
SELECT count(*) FROM dl.t WHERE i = 50
----
1

onlyif worker=0
query I
SELECT min(i) FROM dl.t
----
0

onlyif worker=0
statement ok
ROLLBACK

onlyif worker=1
query I
SELECT * FROM postgres_query('pg', 'SELECT stats_snapshot_atomicity.wait_for_reader()')
----
1

onlyif worker=1
statement ok
DELETE FROM dl.t WHERE i < 100

onlyif worker=1
statement ok
CALL postgres_execute('pg', 'SELECT setval(''stats_snapshot_atomicity.finished'', 1)')

endloop

query II
SELECT count(*), min(i) FROM dl.t
----
100	1000

statement ok
DETACH dl

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA stats_snapshot_atomicity CASCADE')
