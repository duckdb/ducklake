# name: test/sql/delete/delete_file_events_main.test
# description: the file writers of main write events of branch 0 into both visibility tables and a delete commit reads no branch table
# group: [delete]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t(i INTEGER)

statement ok
INSERT INTO lake.t VALUES (1), (2), (3), (4)

statement ok
INSERT INTO lake.t VALUES (5), (6)

# the first delete is inlined and flushed into a delete file whose add event is dated at the delete
statement ok
CALL ducklake_set_option('lake', 'data_inlining_row_limit', 10)

statement ok
DELETE FROM lake.t WHERE i = 1

statement ok
CALL ducklake_set_option('lake', 'data_inlining_row_limit', 0)

statement ok
CALL ducklake_flush_inlined_data('lake')

query IIII
SELECT branch_id, data_file_id, snapshot_id, is_delete::BOOLEAN FROM meta.ducklake_file_visibility ORDER BY ALL
----
0	0	2	false
0	1	3	false

query IIII
SELECT branch_id, delete_file_id, snapshot_id, is_delete::BOOLEAN FROM meta.ducklake_delete_file_visibility ORDER BY ALL
----
0	2	4	false

# the second delete replaces the delete file without a read of the branch table
statement ok
CALL enable_logging('DuckLakeMetadata')

statement ok
DELETE FROM lake.t WHERE i = 2

statement ok
CALL disable_logging()

query I
SELECT COUNT(*) FROM duckdb_logs_parsed('DuckLakeMetadata') WHERE query LIKE '%SELECT EXISTS (SELECT 1 FROM%ducklake_branch%'
----
0

query IIII
SELECT branch_id, delete_file_id, snapshot_id, is_delete::BOOLEAN FROM meta.ducklake_delete_file_visibility ORDER BY ALL
----
0	3	4	false

# the rewrite ends the data file with its delete file and adds the rewritten file
statement ok
CALL ducklake_rewrite_data_files('lake', 't', delete_threshold => 0.4)

query IIII
SELECT branch_id, data_file_id, snapshot_id, is_delete::BOOLEAN FROM meta.ducklake_file_visibility ORDER BY ALL
----
0	0	2	false
0	0	7	true
0	1	3	false
0	4	7	false

query IIII
SELECT branch_id, delete_file_id, snapshot_id, is_delete::BOOLEAN FROM meta.ducklake_delete_file_visibility ORDER BY ALL
----
0	3	4	false
0	3	7	true

# the merge of the two live files adds the merged file at the begin of the earlier source
statement ok
CALL ducklake_merge_adjacent_files('lake', 't')

query IIII
SELECT branch_id, data_file_id, snapshot_id, is_delete::BOOLEAN FROM meta.ducklake_file_visibility ORDER BY ALL
----
0	0	2	false
0	0	7	true
0	5	3	false

query IIII
SELECT branch_id, delete_file_id, snapshot_id, is_delete::BOOLEAN FROM meta.ducklake_delete_file_visibility ORDER BY ALL
----
0	3	4	false
0	3	7	true

query I
SELECT i FROM lake.t ORDER BY i
----
3
4
5
6

statement ok
DETACH lake
