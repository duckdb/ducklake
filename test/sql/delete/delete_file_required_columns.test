# name: test/sql/delete/delete_file_required_columns.test
# description: the columns of a delete file are written as required, as the Iceberg position delete spec asks
# group: [delete]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl
(DATA_PATH '{DATA_PATH}/delete_file_required_columns', DATA_INLINING_ROW_LIMIT 0)

statement ok
CALL dl.set_option('write_deletion_vectors', 'false')

statement ok
CREATE TABLE dl.t AS SELECT range AS id FROM range(100)

statement ok
DELETE FROM dl.t WHERE id = 42

query II
SELECT name, repetition_type FROM parquet_schema('{DATA_PATH}/delete_file_required_columns/main/t/*-delete.parquet')
WHERE name IN ('file_path', 'pos') ORDER BY ALL
----
file_path	REQUIRED
pos	REQUIRED

# no column of a delete file is optional
query I
SELECT count(*) FROM parquet_schema('{DATA_PATH}/delete_file_required_columns/main/t/*-delete.parquet')
WHERE repetition_type <> 'REQUIRED'
----
0

query I
SELECT count(*) FROM dl.t
----
99

# a delete file written by a flush of inlined deletes has the snapshot column
statement ok
CALL dl.set_option('data_inlining_row_limit', 10)

statement ok
DELETE FROM dl.t WHERE id = 43

statement ok
FROM ducklake_flush_inlined_data('dl')

query II
SELECT DISTINCT name, repetition_type
FROM parquet_schema('{DATA_PATH}/delete_file_required_columns/main/t/*-delete.parquet')
WHERE name = '_ducklake_internal_snapshot_id' ORDER BY ALL
----
_ducklake_internal_snapshot_id	REQUIRED

query I
SELECT count(*) FROM parquet_schema('{DATA_PATH}/delete_file_required_columns/main/t/*-delete.parquet')
WHERE repetition_type <> 'REQUIRED'
----
0

query I
SELECT count(*) FROM dl.t
----
98
