# name: test/sql/delete/partial_file_metadata_delete_expired.test
# description: A metadata delete must not remove unseen rows when the conflicting snapshots were expired
# group: [delete]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/partial_file_metadata_delete_expired', DATA_INLINING_ROW_LIMIT 0)

# CREATE TABLE -> 1, ALTER -> 2, INSERT -> 3
statement ok
CREATE TABLE ducklake.t(id INTEGER, p INTEGER)

statement ok
ALTER TABLE ducklake.t SET PARTITIONED BY (p)

statement ok
INSERT INTO ducklake.t VALUES (1, 1)

statement ok con1
BEGIN

query I con1
SELECT id FROM ducklake.t
----
1

# INSERT -> 4, merge -> 5, CREATE TABLE -> 6
statement ok
INSERT INTO ducklake.t VALUES (2, 1)

statement ok
CALL ducklake_merge_adjacent_files('ducklake')

statement ok
CREATE TABLE ducklake.unrelated(i INTEGER)

# Expired snapshots retain their conflict history.
statement ok
CALL ducklake_expire_snapshots('ducklake', versions := [4, 5])

query I con1
DELETE FROM ducklake.t WHERE p = 1
----
1

statement error con1
COMMIT
----
Transaction conflict

query I
SELECT id FROM ducklake.t ORDER BY id
----
1
2
