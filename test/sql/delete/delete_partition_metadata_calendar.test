# name: test/sql/delete/delete_partition_metadata_calendar.test
# description: Metadata deletes for combined identity and calendar partition keys
# group: [delete]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/delete_partition_metadata_calendar', METADATA_CATALOG 'md', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.calendar_t(id INTEGER, source VARCHAR, date DATE, value INTEGER)

statement ok
ALTER TABLE ducklake.calendar_t SET PARTITIONED BY (source, year(date), month(date))

statement ok
INSERT INTO ducklake.calendar_t VALUES (1, 'audio', '2026-12-01', 10), (2, 'audio', '2026-12-31', 20), (3, 'streaming', '2026-12-15', 30), (4, 'audio', '2027-01-01', 40), (5, 'display', '2026-12-15', 50), (6, 'audio', NULL, 60), (7, 'audio', '2025-12-01', 70)

# Null-safe equality retains the exact partition transform through optimizer rewrites.
query II
EXPLAIN DELETE FROM ducklake.calendar_t WHERE source IN ('audio', 'streaming') AND year(date) IS NOT DISTINCT FROM 2026 AND month(date) IS NOT DISTINCT FROM 12
----
physical_plan	<REGEX>:.*Ducklake Metadata Delete.*

statement ok
BEGIN

query I
DELETE FROM ducklake.calendar_t WHERE source IN ('audio', 'streaming') AND year(date) IS NOT DISTINCT FROM 2026 AND month(date) IS NOT DISTINCT FROM 12
----
3

query I rowsort
SELECT id FROM ducklake.calendar_t
----
4
5
6
7

statement ok
ROLLBACK

query I
SELECT COUNT(*) FROM ducklake.calendar_t
----
7

query II
EXPLAIN DELETE FROM ducklake.calendar_t WHERE source = 'audio' AND year(date) IS NULL AND month(date) IS NULL
----
physical_plan	<REGEX>:.*Ducklake Metadata Delete.*

query I
DELETE FROM ducklake.calendar_t WHERE source = 'audio' AND year(date) IS NULL AND month(date) IS NULL
----
1

query I
DELETE FROM ducklake.calendar_t WHERE source IN ('audio', 'streaming') AND year(date) IS NOT DISTINCT FROM 2026 AND month(date) IS NOT DISTINCT FROM 12
----
3

query III
SELECT COUNT(*), MIN(value), MAX(value) FROM ducklake.calendar_t
----
3	40	70

query I
SELECT COUNT(*) FROM md.ducklake_delete_file WHERE table_id = (SELECT table_id FROM md.ducklake_table WHERE table_name = 'calendar_t') AND end_snapshot IS NULL
----
0

# A whole-partition delete followed by external-file registration remains atomic.
statement ok
COPY (SELECT 8 AS id, 'audio' AS source, DATE '2027-01-15' AS date, 80 AS value, 2027 AS year, 1 AS month) TO '{TEST_DIR}/calendar_replacement' (FORMAT PARQUET, PARTITION_BY (source, year, month))

statement ok
BEGIN

query I
DELETE FROM ducklake.calendar_t WHERE source = 'audio' AND year(date) IS NOT DISTINCT FROM 2027 AND month(date) IS NOT DISTINCT FROM 1
----
1

statement ok
CALL ducklake_add_data_files('ducklake', 'calendar_t', '{TEST_DIR}/calendar_replacement/**/*.parquet', hive_partitioning => true)

statement ok
ROLLBACK

query I rowsort
SELECT id FROM ducklake.calendar_t
----
4
5
7

# Cross-column OR must evaluate the full expression for each file, preserving id=4.
statement ok
CREATE TABLE ducklake.cross_t(id INTEGER, a VARCHAR, b VARCHAR)

statement ok
ALTER TABLE ducklake.cross_t SET PARTITIONED BY (a, b)

statement ok
INSERT INTO ducklake.cross_t VALUES (1, 'x', 'p'), (2, 'x', 'q'), (3, 'y', 'p'), (4, 'y', 'q')

query I
DELETE FROM ducklake.cross_t WHERE a = 'x' OR b = 'p'
----
3

query I
SELECT id FROM ducklake.cross_t
----
4

# Filtering the untransformed date inside a month cannot prove a whole-file match.
statement ok
CREATE TABLE ducklake.partial_t(id INTEGER, source VARCHAR, date DATE)

statement ok
ALTER TABLE ducklake.partial_t SET PARTITIONED BY (source, year(date), month(date))

statement ok
INSERT INTO ducklake.partial_t VALUES (1, 'audio', '2026-05-01'), (2, 'audio', '2026-05-31')

query II
EXPLAIN DELETE FROM ducklake.partial_t WHERE source = 'audio' AND date < DATE '2026-05-15'
----
physical_plan	<!REGEX>:.*Ducklake Metadata Delete.*

query I
DELETE FROM ducklake.partial_t WHERE source = 'audio' AND date < DATE '2026-05-15'
----
1

query I
SELECT id FROM ducklake.partial_t
----
2

# A reused partition-key index in an old specification is never authoritative.
statement ok
CREATE TABLE ducklake.repartition_t(id INTEGER, a VARCHAR, b VARCHAR)

statement ok
ALTER TABLE ducklake.repartition_t SET PARTITIONED BY (a)

statement ok
INSERT INTO ducklake.repartition_t VALUES (1, 'x', 'aaa'), (2, 'x', 'zzz')

statement ok
ALTER TABLE ducklake.repartition_t SET PARTITIONED BY (b)

statement ok
INSERT INTO ducklake.repartition_t VALUES (3, 'q', 'x')

query I
DELETE FROM ducklake.repartition_t WHERE b = 'x'
----
1

query I rowsort
SELECT id FROM ducklake.repartition_t
----
1
2
