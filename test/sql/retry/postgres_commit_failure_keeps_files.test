# name: test/sql/retry/postgres_commit_failure_keeps_files.test
# description: a failed COMMIT of a Postgres catalog keeps the files only while it is unknown whether it committed
# group: [retry]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'dbname=ducklakedb' AS pg (TYPE postgres)

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS commit_failure_keeps_files CASCADE')

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb' AS lake
(DATA_PATH '{DATA_PATH}/commit_failure_keeps_files', METADATA_SCHEMA 'commit_failure_keeps_files',
DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t (i INTEGER)

# a deferred trigger makes Postgres fail the COMMIT of the next data file
statement ok
CALL postgres_execute('pg', 'CREATE FUNCTION commit_failure_keeps_files.refuse_commit() RETURNS trigger
LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION ''commit refused''; END $$')

statement ok
CALL postgres_execute('pg', 'CREATE CONSTRAINT TRIGGER refuse_commit AFTER INSERT
ON commit_failure_keeps_files.ducklake_data_file DEFERRABLE INITIALLY DEFERRED
FOR EACH ROW EXECUTE FUNCTION commit_failure_keeps_files.refuse_commit()')

statement ok
BEGIN

statement ok
INSERT INTO lake.t VALUES (1)

# Postgres reports the transaction as aborted, so its file is removed
statement error
COMMIT
----
<REGEX>:.*Failed to commit DuckLake transaction\.\n.*commit refused.*

query I
SELECT count(*) FROM glob('{DATA_PATH}/commit_failure_keeps_files/**/*.parquet')
----
0

# the same holds when the COMMIT loses its connection before Postgres commits
statement ok
CALL postgres_execute('pg', 'CREATE OR REPLACE FUNCTION commit_failure_keeps_files.refuse_commit() RETURNS trigger
LANGUAGE plpgsql AS $$ BEGIN PERFORM pg_terminate_backend(pg_backend_pid()); PERFORM pg_sleep(1); RETURN NULL; END $$')

statement ok
BEGIN

statement ok
INSERT INTO lake.t VALUES (1)

statement error
COMMIT
----
<REGEX>:.*Failed to commit DuckLake transaction\.\n.*connection.*

query I
SELECT count(*) FROM glob('{DATA_PATH}/commit_failure_keeps_files/**/*.parquet')
----
0

# a txid_status that always answers in progress leaves the outcome unknown after the wait
statement ok
DETACH lake

statement ok
CALL postgres_execute('pg', 'CREATE OR REPLACE FUNCTION commit_failure_keeps_files.refuse_commit() RETURNS trigger
LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION ''commit refused''; END $$')

statement ok
CALL postgres_execute('pg', 'CREATE FUNCTION commit_failure_keeps_files.txid_status(BIGINT) RETURNS TEXT
LANGUAGE sql AS $$ SELECT ''in progress''::TEXT $$')

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb options=-csearch_path=commit_failure_keeps_files,pg_catalog' AS lake
(DATA_PATH '{DATA_PATH}/commit_failure_keeps_files', METADATA_SCHEMA 'commit_failure_keeps_files',
DATA_INLINING_ROW_LIMIT 0)

statement ok
SET ducklake_retry_wait_ms = 1

statement ok
BEGIN

statement ok
INSERT INTO lake.t VALUES (1)

statement error
COMMIT
----
<REGEX>:.*it may have been committed and its files are kept.*commit refused.*

# the file stays, a lost reply to a COMMIT that did commit must not delete the files of the snapshot
query I
SELECT count(*) FROM glob('{DATA_PATH}/commit_failure_keeps_files/**/*.parquet')
----
1

# orphan cleanup keeps the file while the catalog is attached, the snapshot can still become visible
query I
SELECT count(*) FROM ducklake_delete_orphaned_files('lake', cleanup_all => true)
----
0

statement ok
CALL postgres_execute('pg', 'DROP TRIGGER refuse_commit ON commit_failure_keeps_files.ducklake_data_file')

query I
SELECT count(*) FROM lake.t
----
0

statement ok
INSERT INTO lake.t VALUES (2)

query I
SELECT * FROM lake.t
----
2

# after attaching again the file of the commit that did not happen is an orphan
statement ok
DETACH lake

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb' AS lake
(DATA_PATH '{DATA_PATH}/commit_failure_keeps_files', METADATA_SCHEMA 'commit_failure_keeps_files')

query I
SELECT count(*) FROM ducklake_delete_orphaned_files('lake', cleanup_all => true)
----
1

statement ok
DETACH lake

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA commit_failure_keeps_files CASCADE')
