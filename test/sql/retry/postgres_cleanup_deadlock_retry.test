# name: test/sql/retry/postgres_cleanup_deadlock_retry.test
# description: Postgres deadlocks retry the metadata commit without losing compaction output
# group: [retry]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'dbname=ducklakedb' AS pg (TYPE postgres)

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS cleanup_retry CASCADE')

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb' AS dl
(DATA_PATH '{DATA_PATH}/cleanup_retry', METADATA_SCHEMA 'cleanup_retry', DATA_INLINING_ROW_LIMIT 0)

statement ok
SET ducklake_retry_wait_ms = 1

statement ok
CREATE TABLE dl.t (i INT)

statement ok
INSERT INTO dl.t VALUES (1), (2)

statement ok
INSERT INTO dl.t VALUES (3), (4)

statement ok
DELETE FROM dl.t WHERE i = 1

# A sequence survives rollback, so only the first commit attempt reports a deadlock.
statement ok
CALL postgres_execute('pg', 'CREATE SEQUENCE cleanup_retry.attempts;
CREATE FUNCTION cleanup_retry.fail_once() RETURNS trigger AS $$
BEGIN
	IF nextval(''cleanup_retry.attempts'') = 1 THEN
		RAISE deadlock_detected USING MESSAGE = ''deadlock detected'';
	END IF;
	RETURN NEW;
END $$ LANGUAGE plpgsql;
CREATE TRIGGER fail_once BEFORE INSERT ON cleanup_retry.ducklake_snapshot
FOR EACH ROW EXECUTE FUNCTION cleanup_retry.fail_once()', prepare = false)

statement ok
CALL ducklake_rewrite_data_files('dl', 't', delete_threshold => 0)

query I
SELECT last_value FROM postgres_query('pg', 'SELECT last_value FROM cleanup_retry.attempts')
----
2

query II
SELECT record_count, next_row_id FROM __ducklake_metadata_dl.cleanup_retry.ducklake_table_stats
----
3	4

query III
SELECT count(DISTINCT rowid), min(i), max(i) FROM dl.t
----
3	2	4

statement ok
DETACH dl

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA cleanup_retry CASCADE')
