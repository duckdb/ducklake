# name: test/sql/retry/max_retry_count_zero_conflict.test
# description: A commit that is not retried reports the conflict and suggests a higher retry count
# group: [retry]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/max_retry_count_zero_conflict')

statement ok
CREATE TABLE lake.t (i INTEGER)

statement ok
CREATE TABLE lake.dropped (i INTEGER)

statement ok
SET ducklake_max_retry_count = 0

# an insert into a table that another transaction dropped is a conflict
statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
DROP TABLE lake.dropped

statement ok con2
INSERT INTO lake.dropped VALUES (1)

statement ok con1
COMMIT

statement error con2
COMMIT
----
<REGEX>:.*Failed to commit DuckLake transaction\.\nTransaction conflict - attempting to insert into table.*but another transaction has dropped it.*

# two inserts do not conflict, so the second one would succeed with a retry
statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
INSERT INTO lake.t VALUES (1)

statement ok con2
INSERT INTO lake.t VALUES (2)

statement ok con1
COMMIT

statement error con2
COMMIT
----
<REGEX>:.*Exceeded the maximum retry count of 0 set by the ducklake_max_retry_count setting\.\nConsider increasing the value with: e\.g\., "SET ducklake_max_retry_count = 10;"\n.*

query I
SELECT * FROM lake.t
----
1

# a table that another transaction created and dropped in the meantime is no conflict
statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
CREATE TABLE lake.tmp_a AS SELECT 1 AS x

statement ok con2
CREATE TABLE lake.tmp_b AS SELECT 2 AS x

statement ok con1
COMMIT

statement ok con1
DROP TABLE lake.tmp_a

statement error con2
COMMIT
----
<REGEX>:.*Exceeded the maximum retry count of 0 set by the ducklake_max_retry_count setting.*
