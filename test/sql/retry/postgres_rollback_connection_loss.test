# name: test/sql/retry/postgres_rollback_connection_loss.test
# description: a rollback that loses its Postgres connection still removes the files the transaction wrote
# group: [retry]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

require-env DUCKLAKE_CONNECTION

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS pg

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS rollback_connection_loss CASCADE')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION} application_name=rollback_connection_loss' AS dl
(DATA_PATH '{DATA_PATH}/rollback_connection_loss', METADATA_SCHEMA 'rollback_connection_loss',
DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
BEGIN

statement ok
INSERT INTO dl.t SELECT range FROM range(1000)

statement ok
INSERT INTO dl.t SELECT range FROM range(1000)

query I
SELECT count(*) FROM glob('{DATA_PATH}/rollback_connection_loss/**/*.parquet')
----
3

query I
SELECT count(*) > 0 AND bool_and(terminated) FROM postgres_query('pg',
'SELECT pg_terminate_backend(pid, 5000) AS terminated FROM pg_stat_activity
WHERE datname = current_database() AND application_name = ''rollback_connection_loss''')
----
true

statement error
ROLLBACK
----
<REGEX>:.*(connection|server closed).*

query I
SELECT count(*) FROM glob('{DATA_PATH}/rollback_connection_loss/**/*.parquet')
----
1

query II
SELECT count(*), sum(i) FROM dl.t
----
1	1

statement ok
DETACH dl

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS rollback_connection_loss CASCADE')
