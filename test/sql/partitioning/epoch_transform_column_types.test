# name: test/sql/partitioning/epoch_transform_column_types.test
# description: an epoch partition key on a column type it cannot compute is rejected, TIMESTAMPTZ_NS is supported
# group: [partitioning]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/epoch_transform_column_types')

statement ok
CREATE TABLE dl.t(c TIMESTAMPTZ_NS, i INTEGER, s VARCHAR)

statement error
ALTER TABLE dl.t SET PARTITIONED BY (epoch_day(i))
----
Cannot partition by epoch_day(i) - the transform does not support columns of type INTEGER

statement error
ALTER TABLE dl.t SET PARTITIONED BY (epoch_hour(s))
----
Cannot partition by epoch_hour(s)

statement ok
ALTER TABLE dl.t SET PARTITIONED BY (epoch_day(c))

statement ok
INSERT INTO dl.t VALUES (TIMESTAMPTZ_NS '2024-01-15 12:30:00+00', 1, 'a')

query I
SELECT count(*) FROM dl.t
----
1

# a VARIANT column casts to a date, but not every value does
statement ok
CREATE TABLE dl.v(c VARIANT, k INTEGER)

statement error
ALTER TABLE dl.v SET PARTITIONED BY (epoch_day(c))
----
Cannot partition by epoch_day(c) - the transform does not support columns of type VARIANT

statement error
CREATE TABLE dl.v2(c VARIANT, k INTEGER) PARTITIONED BY (epoch_year(c))
----
Cannot partition by epoch_year(c) - the transform does not support columns of type VARIANT

statement ok
CREATE TABLE dl.d(dt DATE, ts TIMESTAMP_S, k INTEGER) PARTITIONED BY (epoch_month(dt), epoch_hour(ts))

statement ok
INSERT INTO dl.d VALUES (DATE '2024-01-15', TIMESTAMP_S '2024-01-15 12:00:00', 1)

statement ok
CALL ducklake_flush_inlined_data('dl')
