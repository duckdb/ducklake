# name: test/sql/partitioning/epoch_transform_column_types.test
# description: an epoch partition key on a column type it cannot compute is rejected, TIMESTAMPTZ_NS is supported
# group: [partitioning]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/epoch_transform_column_types')

statement ok
CREATE TABLE dl.t(c TIMESTAMPTZ_NS, i INTEGER, s VARCHAR)

statement error
ALTER TABLE dl.t SET PARTITIONED BY (epoch_day(i))
----
Cannot partition by epoch_day(i) - the transform does not support columns of type INTEGER

statement error
ALTER TABLE dl.t SET PARTITIONED BY (epoch_hour(s))
----
Cannot partition by epoch_hour(s)

statement ok
ALTER TABLE dl.t SET PARTITIONED BY (epoch_day(c))

statement ok
INSERT INTO dl.t VALUES (TIMESTAMPTZ_NS '2024-01-15 12:30:00+00', 1, 'a')

query I
SELECT count(*) FROM dl.t
----
1
