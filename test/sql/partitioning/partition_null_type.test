# name: test/sql/partitioning/partition_null_type.test
# description: NULL-typed columns as partition and sort keys
# group: [partitioning]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_partition_null')

statement ok
USE ducklake

statement ok
CREATE TABLE t(id INTEGER, n "NULL")

statement error
ALTER TABLE t SET PARTITIONED BY (n)
----
Column "n" has type NULL and cannot be used as a partition key

statement error
ALTER TABLE t SET PARTITIONED BY (year(n))
----
Column "n" has type NULL and cannot be used as a partition key

statement error
ALTER TABLE t SET PARTITIONED BY (id, bucket(4, n))
----
Column "n" has type NULL and cannot be used as a partition key

statement ok
ALTER TABLE t SET PARTITIONED BY (id)

# sorting by it is harmless
statement ok
ALTER TABLE t SET SORTED BY (n)

statement ok
INSERT INTO t VALUES (2, NULL), (1, NULL), (1, NULL)

query II
SELECT id, n FROM t ORDER BY id
----
1	NULL
1	NULL
2	NULL

# once promoted the column is a regular partition key
statement ok
ALTER TABLE t ALTER n TYPE INTEGER

statement ok
ALTER TABLE t SET PARTITIONED BY (n)

statement ok
INSERT INTO t VALUES (3, 30), (4, 40)

query II
SELECT id, n FROM t WHERE n = 40
----
4	40

query I
SELECT COUNT(*) FROM t WHERE n IS NULL
----
3
