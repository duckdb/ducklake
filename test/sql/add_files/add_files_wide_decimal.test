# name: test/sql/add_files/add_files_wide_decimal.test
# description: a Parquet DECIMAL wider than 38 digits is added as DOUBLE, the type DuckDB reads it as
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/add_files_wide_decimal')

foreach file fixed_length_decimal_gt38 byte_array_decimal_gt38 fixed_length_decimal_gt38_len21

statement ok
COPY (SELECT content FROM read_blob('duckdb/data/parquet-testing/decimal/{file}.parquet')) TO '{DATA_PATH}/add_files_wide_decimal_{file}.parquet' (FORMAT BLOB)

statement ok
CREATE TABLE ducklake.{file} (x DOUBLE)

statement ok
CALL ducklake_add_data_files('ducklake', '{file}', '{DATA_PATH}/add_files_wide_decimal_{file}.parquet')

query II
SELECT
  (SELECT count(*) FROM (SELECT x FROM ducklake.{file} EXCEPT ALL SELECT x FROM '{DATA_PATH}/add_files_wide_decimal_{file}.parquet')),
  (SELECT count(*) FROM (SELECT x FROM '{DATA_PATH}/add_files_wide_decimal_{file}.parquet' EXCEPT ALL SELECT x FROM ducklake.{file}))
----
0	0

query I
SELECT count(*) = (SELECT count(*) FROM '{DATA_PATH}/add_files_wide_decimal_{file}.parquet' WHERE x > 1) FROM ducklake.{file} WHERE x > 1
----
true

endloop

# a DECIMAL column cannot take the file, and the database stays usable
statement ok
CREATE TABLE ducklake.dec (x DECIMAL(38, 2))

statement error
CALL ducklake_add_data_files('ducklake', 'dec', '{DATA_PATH}/add_files_wide_decimal_fixed_length_decimal_gt38.parquet')
----
<REGEX>:.*DOUBLE.*

query I
SELECT count(*) FROM ducklake.fixed_length_decimal_gt38
----
6
