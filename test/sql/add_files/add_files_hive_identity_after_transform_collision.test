# name: test/sql/add_files/add_files_hive_identity_after_transform_collision.test
# description: hive keys of identity partitions renamed after an earlier transform with the same name
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/add_files_hive_identity_collision/', METADATA_CATALOG 'metadata');

statement ok
USE dl;

statement ok
CALL dl.set_option('data_inlining_row_limit', 0);

statement ok
CREATE TABLE t (year INT, dt DATE, v INT);

statement ok
ALTER TABLE t SET PARTITIONED BY (year(dt), year);

statement ok
INSERT INTO t VALUES (1, DATE '2020-05-05', 10);

query I
SELECT regexp_extract(path, 'year=[0-9]+/[a-z_]+=[0-9]+') FROM metadata.ducklake_data_file
----
year=2020/year_year=1

statement ok
COPY (SELECT DATE '2021-03-03' AS dt, 20 AS v, 2021 AS year, 5 AS year_year) TO '{DATA_PATH}/add_files_hive_identity_collision/ext/' (FORMAT parquet, PARTITION_BY (year, year_year));

statement ok
CALL ducklake_add_data_files('dl', 't', '{DATA_PATH}/add_files_hive_identity_collision/ext/year=2021/year_year=5/*.parquet', hive_partitioning => true);

query II
SELECT partition_key_index, partition_value FROM metadata.ducklake_file_partition_value WHERE data_file_id = (SELECT max(data_file_id) FROM metadata.ducklake_data_file) ORDER BY ALL
----
0	2021
1	5

query III
SELECT year, dt, v FROM t ORDER BY dt
----
1	2020-05-05	10
5	2021-03-03	20

query III
SELECT year, dt, v FROM t WHERE year = 5
----
5	2021-03-03	20
