# name: test/sql/add_files/add_files_case_collisions.test
# description: Adding Parquet files whose sibling names differ only in case, which the reader renames
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/add_files_case_collisions', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.cased AS FROM 'data/parquet/case_collisions.parquet' LIMIT 0

query II
SELECT column_name, column_type FROM (DESCRIBE dl.cased)
----
a	INTEGER
A_1	INTEGER
s	STRUCT(x INTEGER, X_1 INTEGER)
l	STRUCT(x INTEGER, X_1 INTEGER)[]
m	MAP(VARCHAR, STRUCT(x INTEGER, X_1 INTEGER))

statement ok
CALL ducklake_add_data_files('dl', 'cased', 'data/parquet/case_collisions.parquet')

query IIIII
FROM dl.cased ORDER BY a
----
1	10	{'x': 1, 'X_1': 2}	[{'x': 5, 'X_1': 6}]	{k={'x': 9, 'X_1': 10}}
2	20	{'x': 3, 'X_1': 4}	[{'x': 7, 'X_1': 8}, NULL]	{}

query I
SELECT a FROM dl.cased WHERE "A_1" = 20
----
2

query I
SELECT a FROM dl.cased WHERE s.X_1 = 2
----
1
