# name: test/sql/add_files/add_files_registration_retry_words.test
# description: a registration that its commit refuses fails at once, also when its path holds a word of a retryable error
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/add_files_registration_retry_words')

statement ok
COPY (SELECT i FROM range(3) t(i)) TO '{DATA_PATH}/add_files_registration_retry_words_unique_conflict.parquet'

statement ok
CREATE TABLE dl.t(i BIGINT)

statement ok
CALL ducklake_add_data_files('dl', 't', '{DATA_PATH}/add_files_registration_retry_words_unique_conflict.parquet')

statement error
CALL ducklake_add_data_files('dl', 't', '{DATA_PATH}/add_files_registration_retry_words_unique_conflict.parquet')
----
<!REGEX>:.*Exceeded the maximum retry count.*

statement error
CALL ducklake_add_data_files('dl', 't', '{DATA_PATH}/add_files_registration_retry_words_unique_conflict.parquet')
----
is already registered in this table
