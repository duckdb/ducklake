# name: test/sql/add_files/add_files_flushed_file.test
# description: a flushed file registered again after its rows were deleted gets new row ids and versions, without its internal columns
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/add_files_flushed_file', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

statement ok
CALL ducklake_flush_inlined_data('dl')

statement ok
SET VARIABLE flushed = (SELECT data_file FROM ducklake_list_files('dl', 't'))

statement ok
DELETE FROM dl.t

# the flushed file embeds row ids 0 to 2 and the insert snapshot, the registration does not read them
statement ok
CALL ducklake_add_data_files('dl', 't', getvariable('flushed'))

query III
SELECT rowid, snapshot_id = (SELECT max(snapshot_id) FROM ducklake_snapshots('dl')), i FROM dl.t ORDER BY i
----
3	true	1
4	true	2
5	true	3

query I
SELECT count(*) FROM dl.t AT (VERSION => 2)
----
3
