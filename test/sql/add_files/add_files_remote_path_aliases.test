# name: test/sql/add_files/add_files_remote_path_aliases.test
# description: ducklake_add_data_files registers a remote file once when its paths include a scheme alias or a query string
# group: [add_files]

require ducklake

require parquet

require httpfs

require-env S3_TEST_SERVER_AVAILABLE 1

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH s3://mybucket

statement ok
DROP SECRET IF EXISTS __default_s3;

statement ok
SET s3_region='us-east-1';

statement ok
SET s3_access_key_id='admin';

statement ok
SET s3_secret_access_key='password';

statement ok
SET s3_endpoint='127.0.0.1:9000';

statement ok
SET s3_url_style='path';

statement ok
SET s3_use_ssl=false;

# a query string is part of the object key unless S3 URL parameters are enabled
statement ok
SET s3_enable_deprecated_url_parameters=true;

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/add_files_remote_path_aliases/')

statement ok
CREATE TABLE ducklake.t(i INTEGER);

statement ok
COPY (SELECT 1 AS i) TO '{DATA_PATH}/add_files_remote_path_aliases/manual/a.parquet';

statement ok
CALL ducklake_add_data_files('ducklake', 't', ['s3://mybucket/add_files_remote_path_aliases/manual/a.parquet', 'S3A://mybucket/add_files_remote_path_aliases/manual/a.parquet', 's3://mybucket/add_files_remote_path_aliases/manual/a.parquet?s3_region=us-east-1']);

query I
SELECT count(*) FROM ducklake_list_files('ducklake', 't')
----
1

query I
SELECT i FROM ducklake.t
----
1
