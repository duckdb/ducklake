# name: test/sql/add_files/add_files_hive_inexact_value.test
# description: hive values must convert exactly to the column type, since scans parse them again after a type change
# group: [add_files]

require ducklake

require parquet

require icu

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/add_files_hive_inexact_value', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t (id INTEGER, p INTEGER);

statement ok
COPY (SELECT 42 AS id, '1.1' AS p) TO '{DATA_PATH}/add_files_hive_inexact_value_src1' (FORMAT parquet, PARTITION_BY (p));

statement error
CALL ducklake_add_data_files('lake', 't', '{DATA_PATH}/add_files_hive_inexact_value_src1/**/*.parquet', hive_partitioning => true);
----
does not convert exactly to the column type "INTEGER"

# a leading zero or a zero fraction converts exactly
statement ok
COPY (SELECT * FROM (VALUES (1, '01'), (2, '2.0')) v(id, p)) TO '{DATA_PATH}/add_files_hive_inexact_value_src2' (FORMAT parquet, PARTITION_BY (p));

statement ok
CALL ducklake_add_data_files('lake', 't', '{DATA_PATH}/add_files_hive_inexact_value_src2/**/*.parquet', hive_partitioning => true);

statement ok
ALTER TABLE lake.t ALTER COLUMN p TYPE DECIMAL(18,1);

query II
SELECT id, p FROM lake.t WHERE p = 1.0 OR p = 2.0 ORDER BY id
----
1	1.0
2	2.0

statement ok
CREATE TABLE lake.d (id INTEGER, p DECIMAL(4,1));

statement ok
COPY (SELECT 1 AS id, '1.15' AS p) TO '{DATA_PATH}/add_files_hive_inexact_value_src3' (FORMAT parquet, PARTITION_BY (p));

statement error
CALL ducklake_add_data_files('lake', 'd', '{DATA_PATH}/add_files_hive_inexact_value_src3/**/*.parquet', hive_partitioning => true);
----
does not convert exactly to the column type "DECIMAL(4,1)"

statement ok
CREATE TABLE lake.dt (id INTEGER, p DATE);

statement ok
COPY (SELECT 1 AS id, '2024-01-01 12:00:00' AS p) TO '{DATA_PATH}/add_files_hive_inexact_value_src4' (FORMAT parquet, PARTITION_BY (p));

statement error
CALL ducklake_add_data_files('lake', 'dt', '{DATA_PATH}/add_files_hive_inexact_value_src4/**/*.parquet', hive_partitioning => true);
----
does not convert exactly to the column type "DATE"

query I
SELECT count(*) FROM lake.d
----
0

# exponents, hexadecimal integers and digit separators follow the number grammar of DuckDB
statement ok
CREATE TABLE lake.n (id INTEGER, p INTEGER);

statement ok
COPY (SELECT * FROM (VALUES (1, '1e2'), (2, '0x10'), (3, '1_000')) v(id, p)) TO '{DATA_PATH}/add_files_hive_inexact_value_src5' (FORMAT parquet, PARTITION_BY (p));

statement ok
CALL ducklake_add_data_files('lake', 'n', '{DATA_PATH}/add_files_hive_inexact_value_src5/**/*.parquet', hive_partitioning => true);

query II
SELECT id, p FROM lake.n ORDER BY id
----
1	100
2	16
3	1000

statement ok
COPY (SELECT 4 AS id, '1.0_1' AS p) TO '{DATA_PATH}/add_files_hive_inexact_value_src6' (FORMAT parquet, PARTITION_BY (p));

statement error
CALL ducklake_add_data_files('lake', 'n', '{DATA_PATH}/add_files_hive_inexact_value_src6/**/*.parquet', hive_partitioning => true);
----
does not convert exactly to the column type "INTEGER"

# digits a promotion keeps, beyond the precision of the column type
statement ok
CREATE TABLE lake.ms (id INTEGER, p TIMESTAMP_MS);

statement ok
COPY (SELECT 1 AS id, '2024-01-01 12:00:00.123456' AS p) TO '{DATA_PATH}/add_files_hive_inexact_value_src7' (FORMAT parquet, PARTITION_BY (p));

statement error
CALL ducklake_add_data_files('lake', 'ms', '{DATA_PATH}/add_files_hive_inexact_value_src7/**/*.parquet', hive_partitioning => true);
----
does not convert exactly to the column type "TIMESTAMP_MS"

statement ok
COPY (SELECT 5 AS id, '9.9999999999999999999999999999999999999' AS p) TO '{DATA_PATH}/add_files_hive_inexact_value_src8' (FORMAT parquet, PARTITION_BY (p));

statement error
CALL ducklake_add_data_files('lake', 'n', '{DATA_PATH}/add_files_hive_inexact_value_src8/**/*.parquet', hive_partitioning => true);
----
does not convert exactly to the column type "INTEGER"

# a midnight timestamp is an exact date, a number beyond the decimal range an exact HUGEINT
# and a time stamp beyond the nanosecond range an exact TIMESTAMPTZ
statement ok
CREATE TABLE lake.dm (id INTEGER, p DATE, h HUGEINT, tz TIMESTAMPTZ);

statement ok
COPY (SELECT 1 AS id, '2024-01-01 00:00:00' AS p, '1e38' AS h, '9999-12-31 00:00:00+00' AS tz UNION ALL SELECT 2, '2024-01-01 00:00:00', '109443000000000000000000000000000000000', '0001-01-01 00:00:00+00') TO '{DATA_PATH}/add_files_hive_inexact_value_src9' (FORMAT parquet, PARTITION_BY (p, h, tz));

statement ok
CALL ducklake_add_data_files('lake', 'dm', '{DATA_PATH}/add_files_hive_inexact_value_src9/**/*.parquet', hive_partitioning => true);

statement ok
SET TimeZone = 'UTC'

query III
SELECT p, h, tz FROM lake.dm ORDER BY h
----
2024-01-01	100000000000000000000000000000000000000	9999-12-31 00:00:00+00
2024-01-01	109443000000000000000000000000000000000	0001-01-01 00:00:00+00

# a promotion to TIMESTAMPTZ reads the offset that a TIMESTAMP ignores
statement ok
SET TimeZone = 'America/New_York'

statement ok
CREATE TABLE lake.ts (id INTEGER, p TIMESTAMP);

statement ok
COPY (SELECT * FROM (VALUES (1, '2024-01-01 00:00:00'), (2, '2024-01-01 00:00:00-05')) v(id, p)) TO '{DATA_PATH}/add_files_hive_inexact_value_src10' (FORMAT parquet, PARTITION_BY (p));

statement ok
CALL ducklake_add_data_files('lake', 'ts', '{DATA_PATH}/add_files_hive_inexact_value_src10/**/*.parquet', hive_partitioning => true);

statement ok
COPY (SELECT 3 AS id, '2024-01-01T00:00:00+02:00' AS p) TO '{DATA_PATH}/add_files_hive_inexact_value_src11' (FORMAT parquet, PARTITION_BY (p));

statement error
CALL ducklake_add_data_files('lake', 'ts', '{DATA_PATH}/add_files_hive_inexact_value_src11/**/*.parquet', hive_partitioning => true);
----
does not convert exactly to the column type "TIMESTAMP"

statement ok
ALTER TABLE lake.ts ALTER p TYPE TIMESTAMPTZ

query II
SELECT id, (p = TIMESTAMPTZ '2024-01-01 05:00:00+00')::BOOLEAN FROM lake.ts ORDER BY id
----
1	true
2	true

# without time zone casts a date still imports, while an offset cannot be checked
statement ok
SET disable_timestamptz_casts = true

statement ok
CREATE TABLE lake.dc (id INTEGER, d DATE);

statement ok
COPY (SELECT 1 AS id, '2024-01-01' AS d) TO '{DATA_PATH}/add_files_hive_inexact_value_src12' (FORMAT parquet, PARTITION_BY (d));

statement ok
CALL ducklake_add_data_files('lake', 'dc', '{DATA_PATH}/add_files_hive_inexact_value_src12/**/*.parquet', hive_partitioning => true);

statement ok
COPY (SELECT 2 AS id, '2024-01-01 00:00:00-05' AS d) TO '{DATA_PATH}/add_files_hive_inexact_value_src13' (FORMAT parquet, PARTITION_BY (d));

statement error
CALL ducklake_add_data_files('lake', 'dc', '{DATA_PATH}/add_files_hive_inexact_value_src13/**/*.parquet', hive_partitioning => true);
----
does not convert exactly to the column type "DATE"

query II
SELECT id, d FROM lake.dc
----
1	2024-01-01
