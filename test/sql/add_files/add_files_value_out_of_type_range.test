# name: test/sql/add_files/add_files_value_out_of_type_range.test
# description: A file with a value that does not fit the type of the table is not added
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/add_files_value_out_of_type_range')

statement ok
COPY (SELECT TIMESTAMP '294247-01-10 04:00:54.775806' AS t) TO '{DATA_PATH}/add_files_max_timestamp.parquet'

foreach type TIMESTAMP_MS TIMESTAMP_S

statement ok
CREATE TABLE dl.t_${type} (t ${type})

statement error
CALL ducklake_add_data_files('dl', 't_${type}', '{DATA_PATH}/add_files_max_timestamp.parquet')
----
of type TIMESTAMP in the file does not fit type TIMESTAMP_

query I
SELECT count(*) FROM dl.t_${type}
----
0

endloop

# the largest value that fits is added
statement ok
COPY (SELECT TIMESTAMP '294247-01-10 04:00:54.775' AS t) TO '{DATA_PATH}/add_files_max_timestamp_ms.parquet'

statement ok
CALL ducklake_add_data_files('dl', 't_TIMESTAMP_MS', '{DATA_PATH}/add_files_max_timestamp_ms.parquet')

query I
SELECT t FROM dl.t_TIMESTAMP_MS
----
294247-01-10 04:00:54.775

# a column whose stats are skipped is checked too, and keeps no bounds
statement ok
CREATE TABLE dl.skipped (t TIMESTAMP_MS)

statement ok
CALL dl.set_option('skip_stats_columns', ['t'], table_name => 'skipped')

statement error
CALL ducklake_add_data_files('dl', 'skipped', '{DATA_PATH}/add_files_max_timestamp.parquet')
----
of type TIMESTAMP in the file does not fit type TIMESTAMP_MS

statement ok
CALL ducklake_add_data_files('dl', 'skipped', '{DATA_PATH}/add_files_max_timestamp_ms.parquet')

query I
SELECT t FROM dl.skipped
----
294247-01-10 04:00:54.775

query II
SELECT count(*), count(min_value) FROM __ducklake_metadata_dl.ducklake_file_column_stats
WHERE table_id = (SELECT table_id FROM __ducklake_metadata_dl.ducklake_table WHERE table_name = 'skipped')
----
1	0

# a decimal with fewer integer digits holds only some values of the file
statement ok
COPY (SELECT 999.9::DECIMAL(4,1) AS x) TO '{DATA_PATH}/add_files_decimal_large.parquet'

statement ok
COPY (SELECT 99.9::DECIMAL(4,1) AS x) TO '{DATA_PATH}/add_files_decimal_small.parquet'

statement ok
CREATE TABLE dl.d (x DECIMAL(4,2))

statement error
CALL ducklake_add_data_files('dl', 'd', '{DATA_PATH}/add_files_decimal_large.parquet')
----
The value 999.9 of type DECIMAL(4,1) in the file does not fit type DECIMAL(4,2)

statement ok
CALL ducklake_add_data_files('dl', 'd', '{DATA_PATH}/add_files_decimal_small.parquet')

query I
SELECT x FROM dl.d
----
99.90

# the error names the full path of a nested column
statement ok
COPY (SELECT {'x': 999.9::DECIMAL(4,1)} AS s) TO '{DATA_PATH}/add_files_decimal_nested.parquet'

statement ok
CREATE TABLE dl.nested (s STRUCT(x DECIMAL(4,2)))

statement error
CALL ducklake_add_data_files('dl', 'nested', '{DATA_PATH}/add_files_decimal_nested.parquet')
----
Failed to map column "s.x"
