# name: test/sql/add_files/add_files_iceberg_reserved_field_ids.test
# description: ducklake_add_data_files accepts Parquet files with Iceberg reserved metadata field IDs
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}


statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (
	DATA_PATH '{DATA_PATH}/ducklake_add_files_iceberg_reserved_field_ids'
);

statement ok
COPY (
	SELECT
		1 AS "METADATA",
		'x' AS "METADATA$MT_ROW_ID",
		2 AS "ID",
		3::BIGINT AS "METADATA$RL_ROW_ID",
		4::BIGINT AS "METADATA$RL_LAST_UPDATED_SEQUENCE_NUMBER"
) TO '{DATA_PATH}/iceberg_reserved_field_ids.parquet' (
	FORMAT parquet,
	FIELD_IDS {
		METADATA: 1,
		"METADATA$MT_ROW_ID": 2,
		ID: 3,
		"METADATA$RL_ROW_ID": 2147483540,
		"METADATA$RL_LAST_UPDATED_SEQUENCE_NUMBER": 2147483539
	}
);

statement ok
CREATE TABLE ducklake.test AS
SELECT * FROM read_parquet('{DATA_PATH}/iceberg_reserved_field_ids.parquet') WITH NO DATA;

statement ok
CALL ducklake_add_data_files(
	'ducklake',
	'test',
	'{DATA_PATH}/iceberg_reserved_field_ids.parquet'
);

query ITIII
SELECT * FROM ducklake.test
----
1	x	2	3	4
