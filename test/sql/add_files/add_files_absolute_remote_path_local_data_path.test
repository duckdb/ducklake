# name: test/sql/add_files/add_files_absolute_remote_path_local_data_path.test
# description: A data file registered by an absolute remote path keeps its own separators when the data path is local
# group: [add_files]

require ducklake

require parquet

require httpfs

require-env S3_TEST_SERVER_AVAILABLE 1

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

statement ok
DROP SECRET IF EXISTS __default_s3;

statement ok
SET s3_region='us-east-1';

statement ok
SET s3_access_key_id='admin';

statement ok
SET s3_secret_access_key='password';

statement ok
SET s3_endpoint='127.0.0.1:9000';

statement ok
SET s3_url_style='path';

statement ok
SET s3_use_ssl=false;

# the data path is local (the test directory, not the DATA_PATH of the S3 configuration), the added files are remote
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{TEST_DIR}/absolute_remote_path/', METADATA_CATALOG 'metadata');

statement ok
CREATE TABLE ducklake.holdings(col1 INTEGER, col2 VARCHAR);

statement ok
COPY (SELECT 200 col1, 'world' col2) TO 's3://mybucket/absolute_remote_path/external.parquet';

statement ok
COPY (SELECT 300 col1, 'upper' col2) TO 's3://mybucket/absolute_remote_path/external_upper.parquet';

statement ok
CALL ducklake_add_data_files('ducklake', 'holdings', 's3://mybucket/absolute_remote_path/external.parquet');

# a scheme spelled in upper case is remote as well
statement ok
CALL ducklake_add_data_files('ducklake', 'holdings', 'S3A://mybucket/absolute_remote_path/external_upper.parquet');

# the paths are stored absolute, as they were given
query II
SELECT path, CAST(path_is_relative AS BOOLEAN) FROM metadata.ducklake_data_file ORDER BY path
----
S3A://mybucket/absolute_remote_path/external_upper.parquet	false
s3://mybucket/absolute_remote_path/external.parquet	false

query II
FROM ducklake.holdings ORDER BY col1
----
200	world
300	upper

# a fresh attach reads the files through the paths loaded from the catalog
statement ok
DETACH ducklake;

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{TEST_DIR}/absolute_remote_path/', METADATA_CATALOG 'metadata');

query II
FROM ducklake.holdings ORDER BY col1
----
200	world
300	upper
