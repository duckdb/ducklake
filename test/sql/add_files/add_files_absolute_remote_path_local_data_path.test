# name: test/sql/add_files/add_files_absolute_remote_path_local_data_path.test
# description: A data file registered by an absolute remote path keeps its own separators when the data path is local
# group: [add_files]

require ducklake

require parquet

require httpfs

require-env S3_TEST_SERVER_AVAILABLE 1

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
DROP SECRET IF EXISTS __default_s3;

statement ok
SET s3_region='us-east-1';

statement ok
SET s3_access_key_id='admin';

statement ok
SET s3_secret_access_key='password';

statement ok
SET s3_endpoint='127.0.0.1:9000';

statement ok
SET s3_url_style='path';

statement ok
SET s3_use_ssl=false;

# the data path is local, the added file is remote
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/absolute_remote_path/', METADATA_CATALOG 'metadata');

statement ok
CREATE TABLE ducklake.holdings(col1 INTEGER, col2 VARCHAR);

statement ok
COPY (SELECT 200 col1, 'world' col2) TO 's3://mybucket/absolute_remote_path/external.parquet';

statement ok
CALL ducklake_add_data_files('ducklake', 'holdings', 's3://mybucket/absolute_remote_path/external.parquet');

# the path is stored absolute, with its own separators
query II
SELECT path, path_is_relative FROM metadata.ducklake_data_file WHERE end_snapshot IS NULL
----
s3://mybucket/absolute_remote_path/external.parquet	false

query II
FROM ducklake.holdings
----
200	world

# a fresh attach reads the file through the path loaded from the catalog
statement ok
DETACH ducklake;

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/absolute_remote_path/', METADATA_CATALOG 'metadata');

query II
FROM ducklake.holdings
----
200	world
