# name: test/sql/add_files/add_files_null_path.test
# description: ducklake_add_data_files rejects a file list with a NULL element and adds no file
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/add_files_null_path')

statement ok
CREATE TABLE lake.t (i INTEGER)

statement ok
COPY (SELECT 1 AS i) TO '{DATA_PATH}/add_files_null_path_f1.parquet'

statement error
CALL ducklake_add_data_files('lake', 't', ['{DATA_PATH}/add_files_null_path_f1.parquet', NULL])
----
Invalid Input Error: File list cannot contain NULL

statement error
CALL ducklake_add_data_files('lake', 't', [NULL])
----
<REGEX>:Invalid Input Error: File list (cannot contain NULL|must be a string or a list of strings).*

statement error
CALL ducklake_add_data_files('lake', 't', NULL)
----
Invalid Input Error: File list cannot be NULL

query I
SELECT count(*) FROM lake.t
----
0

statement ok
CALL ducklake_add_data_files('lake', 't', ['{DATA_PATH}/add_files_null_path_f1.parquet'])

query I
SELECT count(*) FROM lake.t
----
1
