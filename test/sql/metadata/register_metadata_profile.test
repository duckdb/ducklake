# name: test/sql/metadata/register_metadata_profile.test
# description: A profile registered with ducklake_register_metadata_profile applies to the metadata databases of its catalog type
# group: [metadata]

require ducklake

require parquet

statement error
CALL ducklake_register_metadata_profile('x', '{')
----
Failed to register DuckLake metadata profile "x": invalid JSON

statement error
CALL ducklake_register_metadata_profile('x', '[]')
----
the profile must be a JSON object

statement error
CALL ducklake_register_metadata_profile('x', '{"max_columns": 5}')
----
unknown field "max_columns"

statement error
CALL ducklake_register_metadata_profile('x', '{"types": {"unsupported": []}}')
----
unknown field "types.unsupported"

statement error
CALL ducklake_register_metadata_profile('x', '{"types": {"natively_unsupported": ["NOT_A_TYPE"]}}')
----
unknown type "NOT_A_TYPE"

statement error
CALL ducklake_register_metadata_profile('x', '{"max_column_count": -1}')
----
"max_column_count" must be a non-negative integer

statement error
CALL ducklake_register_metadata_profile('x', '{"system_column_names": "rowid"}')
----
"system_column_names" must be an array of strings

statement error
CALL ducklake_register_metadata_profile('x', '{"base": "unknown"}')
----
base "unknown" is not a registered metadata profile

statement error
CALL ducklake_register_metadata_profile('x', '{"commit_errors": [{"retryable": true}]}')
----
a rule of "commit_errors" has no "pattern"

statement error
CALL ducklake_register_metadata_profile('x', '{"commit_errors": [{"pattern": "("}]}')
----
invalid pattern "("

statement error
CALL ducklake_register_metadata_profile('postgres', '{}')
----
DuckLake has a built-in metadata manager of this name

# profiles are found in any case, so built-in names are rejected in any case
foreach name POSTGRES Postgres_Scanner QUACK Quack_Scanner

statement error
CALL ducklake_register_metadata_profile('{name}', '{}')
----
DuckLake has a built-in metadata manager of this name

endloop

statement error
CALL ducklake_register_metadata_profile(NULL, '{}')
----
does not accept NULL arguments

statement ok
CALL ducklake_register_metadata_profile('duckdb', '{"system_column_names": ["reserved"]}')

statement ok
ATTACH 'ducklake:{TEST_DIR}/register_metadata_profile.db' AS dl (DATA_PATH '{TEST_DIR}/register_metadata_profile', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (reserved INTEGER)

statement ok
CREATE TABLE dl.u (other INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
INSERT INTO dl.u VALUES (1)

# a column with the name of a system column is not inlined
query II
SELECT table_name, file_count FROM ducklake_table_info('dl') ORDER BY table_name
----
t	1
u	0

statement ok
DETACH dl

# registering again replaces the profile, which a lake reads when it is attached
statement ok
CALL ducklake_register_metadata_profile('duckdb', '{}')

statement ok
ATTACH 'ducklake:{TEST_DIR}/register_metadata_profile.db' AS dl (DATA_PATH '{TEST_DIR}/register_metadata_profile', DATA_INLINING_ROW_LIMIT 10)

statement ok
INSERT INTO dl.t VALUES (2)

query II
SELECT table_name, file_count FROM ducklake_table_info('dl') ORDER BY table_name
----
t	1
u	0

query I
SELECT reserved FROM dl.t ORDER BY reserved
----
1
2

statement ok
DETACH dl

# a column created with an overridden type is read and flushed as the type of the table column
statement ok
CALL ducklake_register_metadata_profile('duckdb', '{"types": {"column_type_overrides": {"INTEGER": "BIGINT"}}}')

statement ok
ATTACH 'ducklake:{TEST_DIR}/register_metadata_profile_overrides.db' AS dl (DATA_PATH '{TEST_DIR}/register_metadata_profile_overrides', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (42)

query T
SELECT typeof(i) FROM __ducklake_metadata_dl.ducklake_inlined_data_1_1
----
BIGINT

query IT
SELECT i, typeof(i) FROM dl.t
----
42	INTEGER

statement ok
UPDATE dl.t SET i = i + 1

query IT
SELECT i, typeof(i) FROM dl.t
----
43	INTEGER

statement ok
CALL ducklake_flush_inlined_data('dl')

query II
SELECT table_name, file_count FROM ducklake_table_info('dl')
----
t	1

query IT
SELECT i, typeof(i) FROM dl.t
----
43	INTEGER
