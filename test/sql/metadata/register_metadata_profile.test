# name: test/sql/metadata/register_metadata_profile.test
# description: A profile registered with ducklake_register_metadata_profile applies to the metadata databases of its catalog type
# group: [metadata]

require ducklake

require parquet

statement error
CALL ducklake_register_metadata_profile('x', '{')
----
Failed to register DuckLake metadata profile "x": invalid JSON

statement error
CALL ducklake_register_metadata_profile('x', '[]')
----
the profile must be a JSON object

statement error
CALL ducklake_register_metadata_profile('x', '{"max_columns": 5}')
----
unknown field "max_columns"

statement error
CALL ducklake_register_metadata_profile('x', '{"types": {"unsupported": []}}')
----
unknown field "types.unsupported"

statement error
CALL ducklake_register_metadata_profile('x', '{"types": {"natively_unsupported": ["NOT_A_TYPE"]}}')
----
unknown type "NOT_A_TYPE"

statement error
CALL ducklake_register_metadata_profile('x', '{"max_column_count": -1}')
----
"max_column_count" must be a non-negative integer

statement error
CALL ducklake_register_metadata_profile('x', '{"system_column_names": "rowid"}')
----
"system_column_names" must be an array of strings

statement error
CALL ducklake_register_metadata_profile('x', '{"reset_settings": "binary_as_string"}')
----
"reset_settings" must be an array of strings

statement error
CALL ducklake_register_metadata_profile('x', '{"reported_catalog_type": 1}')
----
"reported_catalog_type" must be a string

statement error
CALL ducklake_register_metadata_profile('x', '{"base": "unknown"}')
----
base "unknown" is not a registered metadata profile

# the profile of a built-in manager would not bring the manager along
statement error
CALL ducklake_register_metadata_profile('x', '{"base": "postgres"}')
----
base "postgres" is the profile of a built-in metadata manager

statement error
CALL ducklake_register_metadata_profile('x', '{"max_identifier_length": "63"}')
----
"max_identifier_length" must be a non-negative integer

statement error
CALL ducklake_register_metadata_profile('x', '{"supports_appender": 1}')
----
"supports_appender" must be a boolean

statement error
CALL ducklake_register_metadata_profile('x', '{"max_inlined_rows_in_batch": true}')
----
"max_inlined_rows_in_batch" must be a non-negative integer

statement error
CALL ducklake_register_metadata_profile('x', '{"snapshot_time_sql": 1}')
----
"snapshot_time_sql" must be a string

statement error
CALL ducklake_register_metadata_profile('x', '{"shows_concurrent_commits_with_parameter": ["isolation_level"]}')
----
"shows_concurrent_commits_with_parameter" must be an object

statement error
CALL ducklake_register_metadata_profile('x', '{"shows_concurrent_commits_with_parameter": {"isolation_level": 1}}')
----
"isolation_level" must be a string

statement error
CALL ducklake_register_metadata_profile('x', '{"commit_errors": [{"retryable": true}]}')
----
a rule of "commit_errors" has no "pattern"

statement error
CALL ducklake_register_metadata_profile('x', '{"commit_errors": [{"pattern": "("}]}')
----
invalid pattern "("

statement error
CALL ducklake_register_metadata_profile('postgres', '{}')
----
DuckLake has a built-in metadata manager of this name

# profiles are found in any case, so built-in names are rejected in any case
foreach name POSTGRES Postgres_Scanner QUACK Quack_Scanner

statement error
CALL ducklake_register_metadata_profile('{name}', '{}')
----
DuckLake has a built-in metadata manager of this name

endloop

statement error
CALL ducklake_register_metadata_profile(NULL, '{}')
----
does not accept NULL arguments

statement error
CALL ducklake_register_metadata_profile('x', '{}', replace := NULL)
----
The replace option must be a non-null boolean

statement ok
CALL ducklake_register_metadata_profile('duckdb', '{"system_column_names": ["reserved"]}')

statement ok
ATTACH 'ducklake:{TEST_DIR}/register_metadata_profile.db' AS dl (DATA_PATH '{TEST_DIR}/register_metadata_profile', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (reserved INTEGER)

statement ok
CREATE TABLE dl.u (other INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
INSERT INTO dl.u VALUES (1)

# a column with the name of a system column is not inlined
query II
SELECT table_name, file_count FROM ducklake_table_info('dl') ORDER BY table_name
----
t	1
u	0

statement ok
DETACH dl

# registering again replaces the profile, which a lake reads when it is attached
statement ok
CALL ducklake_register_metadata_profile('duckdb', '{}')

statement ok
ATTACH 'ducklake:{TEST_DIR}/register_metadata_profile.db' AS dl (DATA_PATH '{TEST_DIR}/register_metadata_profile', DATA_INLINING_ROW_LIMIT 10)

statement ok
INSERT INTO dl.t VALUES (2)

query II
SELECT table_name, file_count FROM ducklake_table_info('dl') ORDER BY table_name
----
t	1
u	0

query I
SELECT reserved FROM dl.t ORDER BY reserved
----
1
2

statement ok
DETACH dl

# without replace, a registered profile is kept, but the JSON is still checked
statement error
CALL ducklake_register_metadata_profile('DuckDB', '{"max_columns": 5}', replace := false)
----
unknown field "max_columns"

statement ok
CALL ducklake_register_metadata_profile('DuckDB', '{"system_column_names": ["reserved"]}', replace := false)

statement ok
ATTACH 'ducklake:{TEST_DIR}/register_metadata_profile.db' AS dl (DATA_PATH '{TEST_DIR}/register_metadata_profile', DATA_INLINING_ROW_LIMIT 10)

statement ok
INSERT INTO dl.t VALUES (3)

query II
SELECT table_name, file_count FROM ducklake_table_info('dl') ORDER BY table_name
----
t	1
u	0

statement ok
DETACH dl

# ducklake_settings reports the catalog type of the profile
statement ok
CALL ducklake_register_metadata_profile('duckdb', '{"reported_catalog_type": "custom"}')

statement ok
ATTACH 'ducklake:{TEST_DIR}/register_metadata_profile.db' AS dl (DATA_PATH '{TEST_DIR}/register_metadata_profile')

query I
SELECT catalog_type FROM ducklake_settings('dl')
----
custom

statement ok
DETACH dl

# a column created with an overridden type is read and flushed as the type of the table column
statement ok
CALL ducklake_register_metadata_profile('duckdb', '{"types": {"column_type_overrides": {"INTEGER": "BIGINT"}}}')

statement ok
ATTACH 'ducklake:{TEST_DIR}/register_metadata_profile_overrides.db' AS dl (DATA_PATH '{TEST_DIR}/register_metadata_profile_overrides', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (42)

query T
SELECT typeof(i) FROM __ducklake_metadata_dl.ducklake_inlined_data_1_1
----
BIGINT

query IT
SELECT i, typeof(i) FROM dl.t
----
42	INTEGER

statement ok
UPDATE dl.t SET i = i + 1

query IT
SELECT i, typeof(i) FROM dl.t
----
43	INTEGER

statement ok
CALL ducklake_flush_inlined_data('dl')

query II
SELECT table_name, file_count FROM ducklake_table_info('dl')
----
t	1

query IT
SELECT i, typeof(i) FROM dl.t
----
43	INTEGER

statement ok
DETACH dl

# a VARIANT column is stored as BLOB, so an override of BLOB applies to it
statement ok
CALL ducklake_register_metadata_profile('duckdb', '{"types": {"natively_unsupported": ["VARIANT"], "column_type_overrides": {"BLOB": "VARCHAR"}}}')

statement ok
ATTACH 'ducklake:{TEST_DIR}/register_metadata_profile_variant.db' AS dl (DATA_PATH '{TEST_DIR}/register_metadata_profile_variant', DATA_INLINING_ROW_LIMIT 10, DUCKLAKE_VERSION '1.1')

statement ok
CREATE TABLE dl.t (v VARIANT)

statement ok
INSERT INTO dl.t VALUES (42::VARIANT)

query T
SELECT typeof(v) FROM __ducklake_metadata_dl.ducklake_inlined_data_1_1
----
VARCHAR

query IT
SELECT v::INTEGER, typeof(v) FROM dl.t
----
42	VARIANT

statement ok
CALL ducklake_flush_inlined_data('dl')

query II
SELECT table_name, file_count FROM ducklake_table_info('dl')
----
t	1

query IT
SELECT v::INTEGER, typeof(v) FROM dl.t
----
42	VARIANT

statement ok
DETACH dl

# a metadata schema longer than the names of the metadata database is refused
statement ok
CALL ducklake_register_metadata_profile('duckdb', '{"max_identifier_length": 5}')

statement error
ATTACH 'ducklake:{TEST_DIR}/register_metadata_profile_names.db' AS dl (DATA_PATH '{TEST_DIR}/register_metadata_profile_names', METADATA_SCHEMA 'too_long')
----
METADATA_SCHEMA "too_long" is longer than the 5 bytes

statement ok
ATTACH 'ducklake:{TEST_DIR}/register_metadata_profile_names.db' AS dl (DATA_PATH '{TEST_DIR}/register_metadata_profile_names', METADATA_SCHEMA 'short')

statement ok
DETACH dl

# commits take the snapshot time from the SQL of the profile
statement ok
CALL ducklake_register_metadata_profile('duckdb', '{"snapshot_time_sql": "TIMESTAMPTZ ''2001-02-03 04:05:06+00''"}')

statement ok
ATTACH 'ducklake:{TEST_DIR}/register_metadata_profile_time.db' AS dl (DATA_PATH '{TEST_DIR}/register_metadata_profile_time')

statement ok
CREATE TABLE dl.t (i INTEGER)

query I
SELECT snapshot_time = TIMESTAMPTZ '2001-02-03 04:05:06+00' FROM ducklake_snapshots('dl') ORDER BY snapshot_id DESC LIMIT 1
----
true

statement ok
DETACH dl

# a commit that changes options runs the lock SQL of the profile, other commits do not
statement ok
CALL ducklake_register_metadata_profile('duckdb', '{"config_option_lock_sql": "INSERT INTO {METADATA_CATALOG}.option_locks VALUES (1);"}')

statement ok
ATTACH 'ducklake:{TEST_DIR}/register_metadata_profile_lock.db' AS dl (DATA_PATH '{TEST_DIR}/register_metadata_profile_lock')

statement ok
CREATE TABLE __ducklake_metadata_dl.option_locks (i INTEGER)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
CALL dl.set_option('parquet_compression', 'zstd')

statement ok
INSERT INTO dl.t VALUES (1)

query I
SELECT count(*) FROM __ducklake_metadata_dl.option_locks
----
1

statement ok
DETACH dl

# without the appender, with materialized stats CTEs and with small inlined inserts in the commit batch
statement ok
CALL ducklake_register_metadata_profile('duckdb', '{"supports_appender": false, "new_tables_require_cache_clear": false, "materialize_stats_ctes": true, "max_inlined_rows_in_batch": 5}')

statement ok
ATTACH 'ducklake:{TEST_DIR}/register_metadata_profile_batch.db' AS dl (DATA_PATH '{TEST_DIR}/register_metadata_profile_batch', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER, s VARCHAR)

statement ok
INSERT INTO dl.t VALUES (1, 'it''s'), (2, NULL), (3, 'c')

statement ok
INSERT INTO dl.t SELECT i, 'r' || i FROM range(4, 12) t(i)

statement ok
INSERT INTO dl.t SELECT i, 'f' || i FROM range(12, 1000) t(i)

query II
SELECT table_name, file_count FROM ducklake_table_info('dl')
----
t	1

query III
SELECT count(*), sum(i), count(s) FROM dl.t
----
999	499500	998

query II
SELECT i, s FROM dl.t WHERE i BETWEEN 500 AND 502 AND s >= 'f' ORDER BY i
----
500	f500
501	f501
502	f502

query II
SELECT i, s FROM dl.t WHERE i < 4 ORDER BY i
----
1	it's
2	NULL
3	c

