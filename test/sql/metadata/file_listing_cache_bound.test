# name: test/sql/metadata/file_listing_cache_bound.test
# description: a transaction that lists more than the cache keeps reads a repeated listing again
# group: [metadata]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t SELECT range FROM range(1000)

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata', storage => 'memory')

statement ok
BEGIN

# the repeated listing is served from the cache
query I
SELECT count(*) FROM dl.t WHERE i < 50
----
50

query I
SELECT count(*) FROM dl.t WHERE i < 50
----
50

# as many distinct listings as the cache keeps make it start over, the bounds stay inside the data so none folds away
loop k 300 556

query I
SELECT count(*) = {k} FROM dl.t WHERE i < {k}
----
true

endloop

# the first listing is read again
query I
SELECT count(*) FROM dl.t WHERE i < 50
----
50

statement ok
COMMIT

statement ok
CALL disable_logging()

query I
SELECT CASE WHEN (SELECT catalog_type FROM ducklake_settings('dl')) IN ('duckdb', 'sqlite', 'postgres') THEN
    (SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
     WHERE query LIKE '%data.partial^_max, data.mapping^_id%' ESCAPE '^')
    ELSE 258 END
----
258

# the rows of the cached listings are bounded as well, 310 files per listing reach the bound within 218 listings
statement ok
CREATE TABLE dl.t2 (i INTEGER)

statement ok
CALL dl.set_option('parquet_row_group_size', 2048, table_name => 't2')

statement ok
SET ducklake_target_file_size = '4KB'

statement ok
INSERT INTO dl.t2 SELECT range FROM range(310 * 2048)

statement ok
RESET ducklake_target_file_size

query I
SELECT file_count >= 300 FROM ducklake_table_info('dl') WHERE table_name = 't2'
----
true

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata', storage => 'memory')

statement ok
BEGIN

query I
SELECT sum(i) FROM dl.t2
----
201535989760

query I
SELECT sum(i) FROM dl.t2
----
201535989760

# every bound keeps all the files of the table in its listing
loop k 1 219

query I
SELECT count(*) + {k} = 634880 FROM dl.t2 WHERE i >= {k}
----
true

endloop

# the first listing is read again
query I
SELECT sum(i) FROM dl.t2
----
201535989760

statement ok
COMMIT

statement ok
CALL disable_logging()

query I
SELECT CASE WHEN (SELECT catalog_type FROM ducklake_settings('dl')) IN ('duckdb', 'sqlite', 'postgres') THEN
    (SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
     WHERE query LIKE '%data.partial^_max, data.mapping^_id%' ESCAPE '^')
    ELSE 220 END
----
220
