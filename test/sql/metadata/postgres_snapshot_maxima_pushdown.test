# name: test/sql/metadata/postgres_snapshot_maxima_pushdown.test
# description: The commit reads the snapshot maxima through a server side aggregate on Postgres
# group: [metadata]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

require-env DUCKLAKE_CONNECTION

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/postgres_snapshot_maxima_pushdown', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t (i INTEGER)

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('QueryLog', storage = 'memory')

statement ok
INSERT INTO lake.t VALUES (1)

statement ok
CALL disable_logging()

# Postgres would otherwise download the whole snapshot table to aggregate it on the client
query I
SELECT CASE WHEN (SELECT catalog_type FROM ducklake_settings('lake')) = 'postgres' THEN
    (SELECT count(*) > 0 FROM duckdb_logs
     WHERE type = 'QueryLog' AND message LIKE '%postgres_query%'
       AND message LIKE '%MAX(CASE WHEN branch_id <> 0%')
    ELSE true END
----
true

query I
SELECT i FROM lake.t
----
1
