# name: test/sql/metadata/sqlite_all_varchar.test
# description: sqlite_all_varchar applies to the user's SQLite reads but not to the reads of a SQLite catalog
# group: [metadata]

require ducklake

require parquet

require sqlite_scanner

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:sqlite:{TEST_DIR}/sqlite_all_varchar.db' AS lake (DATA_PATH '{DATA_PATH}/sqlite_all_varchar')

statement ok
CREATE TABLE lake.t AS SELECT 1 AS i

statement ok
SET GLOBAL sqlite_all_varchar = true

query I
SELECT i FROM lake.t
----
1

query I
SELECT DISTINCT typeof(snapshot_id) FROM __ducklake_metadata_lake.ducklake_snapshot
----
VARCHAR

statement ok
SET GLOBAL sqlite_all_varchar = false

statement ok
SET sqlite_all_varchar = true

query I
SELECT i FROM lake.t
----
1

statement ok
INSERT INTO lake.t VALUES (2)

statement ok
DETACH lake

statement ok
ATTACH 'ducklake:sqlite:{TEST_DIR}/sqlite_all_varchar.db' AS lake

query II
SELECT i, typeof(i) FROM lake.t ORDER BY i
----
1	INTEGER
2	INTEGER

query I
SELECT DISTINCT typeof(snapshot_id) FROM __ducklake_metadata_lake.ducklake_snapshot
----
VARCHAR

# CHECKPOINT runs on a connection with the user's settings and flushes the inlined data from the SQLite catalog

statement ok
SET sqlite_all_varchar = false

statement ok
ATTACH 'ducklake:sqlite:{TEST_DIR}/sqlite_all_varchar_inlined.db' AS inlined_lake (DATA_PATH '{DATA_PATH}/sqlite_all_varchar_inlined', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE inlined_lake.t (i INTEGER, d DOUBLE, ts TIMESTAMP)

statement ok
INSERT INTO inlined_lake.t VALUES (1, 1.5, TIMESTAMP '2026-01-02 03:04:05'), (2, NULL, NULL)

query I
SELECT count(*) FROM ducklake_list_files('inlined_lake', 't')
----
0

statement ok
SET sqlite_all_varchar = true

statement ok
CHECKPOINT inlined_lake

query I
SELECT count(*) FROM ducklake_list_files('inlined_lake', 't')
----
1

query IIIIII
SELECT i, typeof(i), d, typeof(d), ts, typeof(ts) FROM inlined_lake.t ORDER BY i
----
1	INTEGER	1.5	DOUBLE	2026-01-02 03:04:05	TIMESTAMP
2	INTEGER	NULL	DOUBLE	NULL	TIMESTAMP
