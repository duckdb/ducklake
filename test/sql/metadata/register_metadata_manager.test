# name: test/sql/metadata/register_metadata_manager.test
# description: A profile registered with ducklake_register_metadata_manager applies to the metadata databases of its catalog type
# group: [metadata]

require ducklake

require parquet

statement error
CALL ducklake_register_metadata_manager('x', '{')
----
Failed to register DuckLake metadata manager "x": invalid JSON

statement error
CALL ducklake_register_metadata_manager('x', '[]')
----
the profile must be a JSON object

statement error
CALL ducklake_register_metadata_manager('x', '{"max_columns": 5}')
----
unknown field "max_columns"

statement error
CALL ducklake_register_metadata_manager('x', '{"types": {"unsupported": []}}')
----
unknown field "types.unsupported"

statement error
CALL ducklake_register_metadata_manager('x', '{"types": {"natively_unsupported": ["NOT_A_TYPE"]}}')
----
unknown type "NOT_A_TYPE"

statement error
CALL ducklake_register_metadata_manager('x', '{"max_column_count": -1}')
----
"max_column_count" must be a non-negative integer

statement error
CALL ducklake_register_metadata_manager('x', '{"system_column_names": "rowid"}')
----
"system_column_names" must be an array of strings

statement error
CALL ducklake_register_metadata_manager('x', '{"base": "unknown"}')
----
base "unknown" is not a registered metadata manager

statement error
CALL ducklake_register_metadata_manager('x', '{"commit_errors": [{"retryable": true}]}')
----
a rule of "commit_errors" has no "pattern"

statement error
CALL ducklake_register_metadata_manager('x', '{"commit_errors": [{"pattern": "("}]}')
----
invalid pattern "("

statement error
CALL ducklake_register_metadata_manager('postgres', '{}')
----
DuckLake has a built-in metadata manager of this name

statement error
CALL ducklake_register_metadata_manager(NULL, '{}')
----
does not accept NULL arguments

statement ok
CALL ducklake_register_metadata_manager('duckdb', '{"system_column_names": ["reserved"]}')

statement ok
ATTACH 'ducklake:{TEST_DIR}/register_metadata_manager.db' AS dl (DATA_PATH '{TEST_DIR}/register_metadata_manager', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (reserved INTEGER)

statement ok
CREATE TABLE dl.u (other INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
INSERT INTO dl.u VALUES (1)

# a column with the name of a system column is not inlined
query II
SELECT table_name, file_count FROM ducklake_table_info('dl') ORDER BY table_name
----
t	1
u	0

statement ok
DETACH dl

# registering again replaces the profile, which a lake reads when it is attached
statement ok
CALL ducklake_register_metadata_manager('duckdb', '{}')

statement ok
ATTACH 'ducklake:{TEST_DIR}/register_metadata_manager.db' AS dl (DATA_PATH '{TEST_DIR}/register_metadata_manager', DATA_INLINING_ROW_LIMIT 10)

statement ok
INSERT INTO dl.t VALUES (2)

query II
SELECT table_name, file_count FROM ducklake_table_info('dl') ORDER BY table_name
----
t	1
u	0

query I
SELECT reserved FROM dl.t ORDER BY reserved
----
1
2
