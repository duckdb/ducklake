the metadata has no version

# a missing data path
statement ok
ATTACH 'ducklake:{TEST_DIR}/metadata_table_validation_7.db' AS dl (DATA_PATH '{TEST_DIR}/metadata_table_validation')

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DETACH dl

statement ok
