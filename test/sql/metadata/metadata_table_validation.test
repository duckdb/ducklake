metadata table "ducklake_snapshot_changes" has no column "commit_extra_info"

# a missing table
statement ok
ATTACH 'ducklake:{TEST_DIR}/metadata_table_validation_5.db' AS dl (DATA_PATH '{TEST_DIR}/metadata_table_validation')

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DETACH dl

statement ok
ATTACH '{TEST_DIR}/metadata_table_validation_5.db' AS meta

statement ok
DROP TABLE meta.ducklake_schema_versions

statement ok
DETACH meta

statement error
ATTACH 'ducklake:{TEST_DIR}/metadata_table_validation_5.db' AS dl (DATA_PATH '{TEST_DIR}/metadata_table_validation')
----
the metadata catalog has no table "ducklake_schema_versions"

# a missing version
statement ok
ATTACH 'ducklake:{TEST_DIR}/metadata_table_validation_6.db' AS dl (DATA_PATH '{TEST_DIR}/metadata_table_validation')

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DETACH dl

statement ok
ATTACH '{TEST_DIR}/metadata_table_validation_6.db' AS meta

statement ok
DELETE FROM meta.ducklake_metadata WHERE key = 'version'

statement ok
DETACH meta

statement error
ATTACH 'ducklake:{TEST_DIR}/metadata_table_validation_6.db' AS dl (DATA_PATH '{TEST_DIR}/metadata_table_validation')
