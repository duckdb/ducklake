ATTACH 'ducklake:{TEST_DIR}/metadata_table_validation_3.db' AS dl (DATA_PATH '{TEST_DIR}/metadata_table_validation')

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DETACH dl

statement ok
ATTACH '{TEST_DIR}/metadata_table_validation_3.db' AS meta

statement ok
ALTER TABLE meta.ducklake_data_file DROP COLUMN footer_size

statement ok
DETACH meta

statement error
ATTACH 'ducklake:{TEST_DIR}/metadata_table_validation_3.db' AS dl (DATA_PATH '{TEST_DIR}/metadata_table_validation')
----
expected "footer_size" of type BIGINT

# a missing last column
statement ok
ATTACH 'ducklake:{TEST_DIR}/metadata_table_validation_4.db' AS dl (DATA_PATH '{TEST_DIR}/metadata_table_validation')

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DETACH dl

statement ok
ATTACH '{TEST_DIR}/metadata_table_validation_4.db' AS meta

statement ok
ALTER TABLE meta.ducklake_snapshot_changes DROP COLUMN commit_extra_info

statement ok
DETACH meta

statement error
ATTACH 'ducklake:{TEST_DIR}/metadata_table_validation_4.db' AS dl (DATA_PATH '{TEST_DIR}/metadata_table_validation')
