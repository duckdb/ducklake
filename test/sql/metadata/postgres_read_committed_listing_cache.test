# name: test/sql/metadata/postgres_read_committed_listing_cache.test
# description: a READ COMMITTED transaction keeps seeing the rows a concurrent flush moved into a file
# group: [metadata]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

require-env DUCKLAKE_CONNECTION

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/postgres_read_committed_listing_cache', METADATA_CATALOG 'meta', META_ISOLATION_LEVEL 'READ COMMITTED', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (42)

statement ok con1
BEGIN

query I con1
SELECT i FROM dl.t
----
42

statement ok con2
CALL ducklake_flush_inlined_data('dl', table_name => 't')

query I con1
SELECT i FROM dl.t
----
42

statement ok con1
ROLLBACK

query I
SELECT i FROM dl.t
----
42
