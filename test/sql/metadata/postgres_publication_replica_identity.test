# name: test/sql/metadata/postgres_publication_replica_identity.test
# description: metadata tables on Postgres can be updated and deleted under a publication
# group: [metadata]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'dbname=ducklakedb' AS pg (TYPE postgres)

statement ok
CALL postgres_execute('pg', 'DROP PUBLICATION IF EXISTS pub_replica_identity')

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS pub_replica_identity CASCADE')

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS pub_replica_identity_v10 CASCADE')

statement ok
CALL postgres_execute('pg', 'CREATE SCHEMA pub_replica_identity')

statement ok
CALL postgres_execute('pg', 'CREATE SCHEMA pub_replica_identity_v10')

# a publication that publishes updates and deletes of every table in the metadata schemas
statement ok
CALL postgres_execute('pg', 'CREATE PUBLICATION pub_replica_identity
FOR TABLES IN SCHEMA pub_replica_identity, pub_replica_identity_v10')

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb' AS dl
(DATA_PATH '{DATA_PATH}/pub_replica_identity', METADATA_SCHEMA 'pub_replica_identity', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (x INT)

statement ok
INSERT INTO dl.t VALUES (1), (2)

statement ok
INSERT INTO dl.t VALUES (3)

statement ok
DELETE FROM dl.t WHERE x = 1

statement ok
INSERT INTO dl.t SELECT range FROM range(100, 200)

statement ok
DELETE FROM dl.t WHERE x = 100

statement ok
ALTER TABLE dl.t ADD COLUMN y INT

statement ok
INSERT INTO dl.t VALUES (4, 4)

statement ok
UPDATE dl.t SET y = 5 WHERE x = 4

# inlined tables created by commits get a full replica identity too
query II
SELECT * FROM postgres_query('pg', 'SELECT c.relname::VARCHAR, c.relreplident::VARCHAR FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname = ''pub_replica_identity'' AND c.relname LIKE ''ducklake\_inlined\_%''') ORDER BY ALL
----
ducklake_inlined_data_1_1	f
ducklake_inlined_data_1_2	f
ducklake_inlined_data_tables	f
ducklake_inlined_delete_1	f

statement ok
FROM ducklake_flush_inlined_data('dl')

statement ok
FROM ducklake_rewrite_data_files('dl', 't', delete_threshold => 0)

query III
SELECT count(*), min(x), max(y) FROM dl.t
----
102	2	5

statement ok
DROP TABLE dl.t

statement ok
CALL ducklake_expire_snapshots('dl', older_than => now())

statement ok
CALL ducklake_cleanup_old_files('dl', cleanup_all => true)

# every metadata table without a primary key has a full replica identity
query I
SELECT count(*) FROM postgres_query('pg', 'SELECT c.relname FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname = ''pub_replica_identity'' AND c.relkind = ''r'' AND c.relreplident = ''d''
AND NOT EXISTS (SELECT 1 FROM pg_index i WHERE i.indrelid = c.oid AND i.indisprimary)')
----
0

statement ok
DETACH dl

# a catalog migrated from an older version to v1.1 gets new metadata tables
statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb' AS dl10
(DATA_PATH '{DATA_PATH}/pub_replica_identity_v10', METADATA_SCHEMA 'pub_replica_identity_v10', DUCKLAKE_VERSION '1.0')

statement ok
CREATE VIEW dl10.v AS SELECT 1 AS a

statement ok
DETACH dl10

# make it look like a v0.4 catalog created by an older DuckLake, without replica identities
statement ok
CALL postgres_execute('pg', 'UPDATE pub_replica_identity_v10.ducklake_metadata SET value = ''0.4'' WHERE key = ''version''')

statement ok
CALL postgres_execute('pg', 'DO $$DECLARE tbl regclass; BEGIN
FOR tbl IN SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname = ''pub_replica_identity_v10'' AND c.relkind = ''r'' LOOP
EXECUTE format(''ALTER TABLE %s REPLICA IDENTITY DEFAULT'', tbl); END LOOP; END$$')

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb' AS dl10
(DATA_PATH '{DATA_PATH}/pub_replica_identity_v10', METADATA_SCHEMA 'pub_replica_identity_v10', DUCKLAKE_VERSION '1.1-dev1',
AUTOMATIC_MIGRATION TRUE)

statement ok
COMMENT ON COLUMN dl10.v.a IS 'first'

statement ok
COMMENT ON COLUMN dl10.v.a IS 'second'

statement ok
DROP VIEW dl10.v

query I
SELECT count(*) FROM postgres_query('pg', 'SELECT c.relname FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname = ''pub_replica_identity_v10'' AND c.relkind = ''r'' AND c.relreplident = ''d''
AND NOT EXISTS (SELECT 1 FROM pg_index i WHERE i.indrelid = c.oid AND i.indisprimary)')
----
0

statement ok
DETACH dl10

# Migrate tables created by an earlier step in the chain
unzip data/old_ducklake/v02.db.gz {TEST_DIR}/replica_v02.db

statement ok
ATTACH '{TEST_DIR}/replica_v02.db' AS old_metadata

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS pub_replica_identity_v02 CASCADE')

statement ok
CALL postgres_execute('pg', 'CREATE SCHEMA pub_replica_identity_v02')

foreach table column column_mapping column_tag data_file delete_file file_column_statistics file_partition_value files_scheduled_for_deletion inlined_data_tables metadata name_mapping partition_column partition_info schema snapshot snapshot_changes table table_column_stats table_stats tag view

statement ok
CREATE TABLE pg.pub_replica_identity_v02.ducklake_{table} AS FROM old_metadata.ducklake_{table}

endloop

statement ok
DETACH old_metadata

statement ok
CALL postgres_execute('pg', 'ALTER PUBLICATION pub_replica_identity ADD TABLES IN SCHEMA pub_replica_identity_v02')

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb' AS dl02
(DATA_PATH '{DATA_PATH}/pub_replica_identity_v02', METADATA_SCHEMA 'pub_replica_identity_v02',
OVERRIDE_DATA_PATH TRUE, DUCKLAKE_VERSION '1.1-dev1', AUTOMATIC_MIGRATION TRUE)

statement ok
INSERT INTO dl02.test VALUES (42)

query I
FROM dl02.test
----
42

statement ok
DETACH dl02

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA pub_replica_identity_v02 CASCADE')

# Dev catalogs can migrate without changing their version
foreach automatic false true

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS pub_replica_identity_dev CASCADE')

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb' AS dev
(DATA_PATH '{DATA_PATH}/pub_replica_identity_dev_{automatic}', METADATA_SCHEMA 'pub_replica_identity_dev',
DUCKLAKE_VERSION '1.0')

statement ok
CREATE VIEW dev.v AS SELECT 1 AS a

statement ok
DETACH dev

statement ok
CALL postgres_execute('pg', 'UPDATE pub_replica_identity_dev.ducklake_metadata SET value = ''1.1-dev1'' WHERE key = ''version''')

statement ok
CALL postgres_execute('pg', 'ALTER TABLE pub_replica_identity_dev.ducklake_metadata REPLICA IDENTITY DEFAULT')

statement ok
CALL postgres_execute('pg', 'ALTER PUBLICATION pub_replica_identity ADD TABLES IN SCHEMA pub_replica_identity_dev')

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb' AS dev
(METADATA_SCHEMA 'pub_replica_identity_dev', DUCKLAKE_VERSION '1.1-dev1', AUTOMATIC_MIGRATION {automatic})

statement ok
COMMENT ON COLUMN dev.v.a IS 'first'

statement ok
COMMENT ON COLUMN dev.v.a IS 'second'

statement ok
DROP VIEW dev.v

statement ok
DETACH dev

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA pub_replica_identity_dev CASCADE')

endloop

statement ok
CALL postgres_execute('pg', 'DROP PUBLICATION pub_replica_identity')

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA pub_replica_identity CASCADE')

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA pub_replica_identity_v10 CASCADE')

# Quoted names and existing identity settings survive initialization

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS "pub_replica_identity''$$" CASCADE')

statement ok
CALL postgres_execute('pg', 'CREATE SCHEMA "pub_replica_identity''$$"')

statement ok
CALL postgres_execute('pg', 'CREATE TABLE "pub_replica_identity''$$".ducklake_identity_pk (id INT PRIMARY KEY)')

statement ok
CALL postgres_execute('pg', 'CREATE TABLE "pub_replica_identity''$$".ducklake_identity_index (id INT NOT NULL UNIQUE)')

statement ok
CALL postgres_execute('pg', 'ALTER TABLE "pub_replica_identity''$$".ducklake_identity_index REPLICA IDENTITY USING INDEX ducklake_identity_index_id_key')

statement ok
CALL postgres_execute('pg', 'CREATE TABLE "pub_replica_identity''$$".ducklake_identity_nothing (id INT)')

statement ok
CALL postgres_execute('pg', 'ALTER TABLE "pub_replica_identity''$$".ducklake_identity_nothing REPLICA IDENTITY NOTHING')

statement ok
CALL postgres_execute('pg', 'CREATE TABLE "pub_replica_identity''$$".ducklakeXunrelated (id INT)')

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb' AS quoted
(DATA_PATH '{DATA_PATH}/pub_replica_identity_quoted', METADATA_SCHEMA 'pub_replica_identity''$$', DUCKLAKE_VERSION '1.0')

query TT
SELECT * FROM postgres_query('pg', 'SELECT c.relname::VARCHAR, c.relreplident::VARCHAR FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname = ''pub_replica_identity''''$$'' AND c.relkind = ''r''
AND (c.relname LIKE ''ducklake_identity_%'' OR c.relname = ''ducklakexunrelated'')') ORDER BY ALL
----
ducklake_identity_index	i
ducklake_identity_nothing	n
ducklake_identity_pk	d
ducklakexunrelated	d

statement ok
DETACH quoted

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA "pub_replica_identity''$$" CASCADE')
