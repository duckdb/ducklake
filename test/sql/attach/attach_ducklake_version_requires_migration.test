# name: test/sql/attach/attach_ducklake_version_requires_migration.test
# description: Requesting a newer DUCKLAKE_VERSION than the catalog requires AUTOMATIC_MIGRATION
# group: [attach]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_version_requires_migration', DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE ducklake.t AS SELECT 42 AS i

statement ok
DETACH ducklake

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_version_requires_migration', DUCKLAKE_VERSION '1.1')
----
DuckLake catalog version mismatch: catalog version is 1.0, but the extension requires version 1.1.

# dev versions cannot be requested
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_version_requires_migration', DUCKLAKE_VERSION '1.1-dev1', AUTOMATIC_MIGRATION TRUE)
----
ducklake_version must be '1.0' or '1.1', got '1.1-dev1'

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_version_requires_migration', DUCKLAKE_VERSION '1.1', AUTOMATIC_MIGRATION TRUE)

query I
FROM ducklake.t
----
42

query I
SELECT value FROM ducklake.options() WHERE option_name = 'version'
----
1.1
