# name: test/sql/attach/detach_evicts_object_cache.test
# description: DETACH removes the entries a DuckLake put in the object cache, so attaching in a loop does not grow it
# group: [attach]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/detach_evicts_object_cache.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/detach_evicts_object_cache')

loop i 0 50

statement ok
CREATE TABLE lake.t{i}(c0 BIGINT, c1 BIGINT, c2 BIGINT, c3 BIGINT, c4 BIGINT, c5 BIGINT, c6 BIGINT, c7 BIGINT)

endloop

statement ok
INSERT INTO lake.t0 VALUES (1, 2, 3, 4, 5, 6, 7, 8)

statement ok
DETACH lake

statement ok
SET VARIABLE cache_before = (SELECT coalesce(sum(memory_usage_bytes), 0) FROM duckdb_memory() WHERE tag = 'OBJECT_CACHE')

loop i 0 5

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/detach_evicts_object_cache')

query I
SELECT count(*) FROM lake.t0
----
1

query I
SELECT estimated_size FROM duckdb_tables() WHERE database_name = 'lake' AND table_name = 't0'
----
1

statement ok
DETACH lake

endloop

query I
SELECT coalesce(sum(memory_usage_bytes), 0) <= getvariable('cache_before') FROM duckdb_memory() WHERE tag = 'OBJECT_CACHE'
----
true

# a DuckLake replaced by ATTACH OR REPLACE also removes its entries
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/detach_evicts_object_cache')

query I
SELECT count(*) FROM lake.t0
----
1

statement ok
ATTACH OR REPLACE 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/detach_evicts_object_cache')

statement ok
DETACH lake

query I
SELECT coalesce(sum(memory_usage_bytes), 0) <= getvariable('cache_before') FROM duckdb_memory() WHERE tag = 'OBJECT_CACHE'
----
true

# entries of many snapshots, also after the evicted ones are forgotten
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/detach_evicts_object_cache')

loop i 0 15

statement ok
INSERT INTO lake.t{i} VALUES ({i}, 2, 3, 4, 5, 6, 7, 8)

query I
SELECT count(*) > 0 FROM lake.t0
----
true

endloop

statement ok
DETACH lake

query I
SELECT coalesce(sum(memory_usage_bytes), 0) <= getvariable('cache_before') FROM duckdb_memory() WHERE tag = 'OBJECT_CACHE'
----
true

# a DuckLake whose name changed
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/detach_evicts_object_cache')

query I
SELECT count(*) FROM lake.t0
----
2

query I
SELECT count(*) FROM lake.current_snapshot()
----
1

statement ok
ALTER DATABASE lake SET ALIAS TO renamed_lake

# the schema is loaded again under the new name
query I
SELECT count(*) FROM renamed_lake.current_snapshot()
----
1

statement ok
DETACH renamed_lake

query I
SELECT coalesce(sum(memory_usage_bytes), 0) <= getvariable('cache_before') FROM duckdb_memory() WHERE tag = 'OBJECT_CACHE'
----
true

# an ATTACH that is rolled back
statement ok
BEGIN

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/detach_evicts_object_cache')

query I
SELECT count(*) FROM lake.t0
----
2

statement ok
ROLLBACK

query I
SELECT coalesce(sum(memory_usage_bytes), 0) <= getvariable('cache_before') FROM duckdb_memory() WHERE tag = 'OBJECT_CACHE'
----
true
