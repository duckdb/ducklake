# name: test/sql/geo/ducklake_geometry.test
# group: [geo]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_files', METADATA_CATALOG 'ducklake_meta')

statement ok
USE ducklake;

statement ok
create table t1 (g GEOMETRY);

statement ok
insert into t1 VALUES ('POINT (1 2)'::GEOMETRY);

query I
select * from t1;
----
POINT (1 2)

# Inspect file stats
query I
select extra_stats from ducklake_meta.ducklake_file_column_stats;
----
{"bbox":{"xmin":1.0,"xmax":1.0,"ymin":2.0,"ymax":2.0,"zmin":null,"zmax":null,"mmin":null,"mmax":null},"types":["point"]}

query I
select extra_stats from ducklake_meta.ducklake_table_column_stats;
----
{"bbox":{"xmin":1.0,"xmax":1.0,"ymin":2.0,"ymax":2.0,"zmin":null,"zmax":null,"mmin":null,"mmax":null},"types":["point"]}

statement ok
insert into t1 VALUES ('LINESTRING Z (5 5 5, 10 10 10)'::GEOMETRY);

query I
select * from t1;
----
POINT (1 2)
LINESTRING Z (5 5 5, 10 10 10)

# Inspect file stats - should be separate for each file
query I
select extra_stats from ducklake_meta.ducklake_file_column_stats order by all;
----
{"bbox":{"xmin":1.0,"xmax":1.0,"ymin":2.0,"ymax":2.0,"zmin":null,"zmax":null,"mmin":null,"mmax":null},"types":["point"]}
{"bbox":{"xmin":5.0,"xmax":10.0,"ymin":5.0,"ymax":10.0,"zmin":5.0,"zmax":10.0,"mmin":null,"mmax":null},"types":["linestring_z"]}

# Check table stats are a union of the two files
query I
select extra_stats from ducklake_meta.ducklake_table_column_stats order by all;
----
{"bbox":{"xmin":1.0,"xmax":10.0,"ymin":2.0,"ymax":10.0,"zmin":5.0,"zmax":10.0,"mmin":null,"mmax":null},"types":["linestring_z","point"]}

# Merge files into a single file and check stats remain the same
query III
SELECT table_name, files_processed, files_created FROM ducklake_merge_adjacent_files('ducklake')
----
t1	2	1

query I
select extra_stats from ducklake_meta.ducklake_file_column_stats order by all;
----
{"bbox":{"xmin":1.0,"xmax":10.0,"ymin":2.0,"ymax":10.0,"zmin":5.0,"zmax":10.0,"mmin":null,"mmax":null},"types":["linestring_z","point"]}

# Insert a geometry with M dimension
statement ok
insert into t1 VALUES ('POINT M (20 20 5)'::GEOMETRY);

# Insert a geometry with a ZM dimension
statement ok
insert into t1 VALUES ('POINT ZM (-30 -30 -30 -30)'::GEOMETRY);

query I
select * from t1 ORDER BY ALL;
----
POINT (1 2)
POINT ZM (-30 -30 -30 -30)
POINT M (20 20 5)
LINESTRING Z (5 5 5, 10 10 10)

# Check stats
query I
select extra_stats from ducklake_meta.ducklake_file_column_stats order by all;
----
{"bbox":{"xmin":-30.0,"xmax":-30.0,"ymin":-30.0,"ymax":-30.0,"zmin":-30.0,"zmax":-30.0,"mmin":-30.0,"mmax":-30.0},"types":["point_zm"]}
{"bbox":{"xmin":1.0,"xmax":10.0,"ymin":2.0,"ymax":10.0,"zmin":5.0,"zmax":10.0,"mmin":null,"mmax":null},"types":["linestring_z","point"]}
{"bbox":{"xmin":20.0,"xmax":20.0,"ymin":20.0,"ymax":20.0,"zmin":null,"zmax":null,"mmin":5.0,"mmax":5.0},"types":["point_m"]}

# Now merge all again
query III
SELECT table_name, files_processed, files_created FROM ducklake_merge_adjacent_files('ducklake')
----
t1	3	1

# Check merged stats
query I
select extra_stats from ducklake_meta.ducklake_file_column_stats order by all;
----
{"bbox":{"xmin":-30.0,"xmax":20.0,"ymin":-30.0,"ymax":20.0,"zmin":-30.0,"zmax":10.0,"mmin":-30.0,"mmax":5.0},"types":["linestring_z","point","point_m","point_zm"]}
