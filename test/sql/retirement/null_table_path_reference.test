# name: test/sql/retirement/null_table_path_reference.test
# description: a dropped table without a path of its own keeps the file it registered, which a later commit discards
# group: [retirement]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/null_table_path_reference', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok con1
BEGIN

statement ok con1
INSERT INTO dl.t VALUES (1)

# a table row without a path takes the path of its schema
statement ok
CREATE TABLE dl.u(i INTEGER)

statement ok
UPDATE meta.ducklake_table SET path = NULL, path_is_relative = NULL WHERE table_name = 'u'

statement ok
SET VARIABLE written = (SELECT file FROM glob('{DATA_PATH}/null_table_path_reference/main/t/*.parquet'))

statement ok
CALL ducklake_add_data_files('dl', 'u', getvariable('written'))

statement ok
DROP TABLE dl.u

statement ok con1
DELETE FROM dl.t

statement ok con1
CREATE TABLE dl.v(i INTEGER)

statement ok con1
COMMIT

query I
SELECT count(*) FROM glob('{DATA_PATH}/null_table_path_reference/main/t/*.parquet')
----
1
