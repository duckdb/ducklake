# name: test/sql/retirement/discarded_remote_alias_published.test
# description: a remote file that a transaction drops and registers again under a scheme alias stays published
# group: [retirement]

require ducklake

require parquet

require httpfs

require-env S3_TEST_SERVER_AVAILABLE 1

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env ALIAS_PATH s3://mybucket/discarded_remote_alias_published

statement ok
DROP SECRET IF EXISTS __default_s3;

statement ok
CREATE SECRET discarded_alias (TYPE S3, KEY_ID 'admin', SECRET 'password', REGION 'us-east-1', ENDPOINT '127.0.0.1:9000', URL_STYLE 'path', USE_SSL false);

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{ALIAS_PATH}/', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER);

statement ok
CREATE TABLE dl.u(i INTEGER);

statement ok
BEGIN

statement ok
INSERT INTO dl.t VALUES (42)

statement ok
SET VARIABLE written = (SELECT filename FROM read_blob('{ALIAS_PATH}/main/t/*.parquet') ORDER BY last_modified DESC LIMIT 1)

statement ok
DELETE FROM dl.t

statement ok
CALL ducklake_add_data_files('dl', 'u', replace(getvariable('written'), 's3://', 's3a://'))

statement ok
COMMIT

query I
SELECT i FROM dl.u
----
42
