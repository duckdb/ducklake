# name: test/sql/retirement/retired_remote_path_alias.test
# description: a remote file at a path that a cleanup retired cannot be registered under a scheme alias or with a query string
# group: [retirement]

require ducklake

require parquet

require httpfs

require-env S3_TEST_SERVER_AVAILABLE 1

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH s3://mybucket

statement ok
DROP SECRET IF EXISTS __default_s3;

statement ok
SET s3_region='us-east-1';

statement ok
SET s3_access_key_id='admin';

statement ok
SET s3_secret_access_key='password';

statement ok
SET s3_endpoint='127.0.0.1:9000';

statement ok
SET s3_url_style='path';

statement ok
SET s3_use_ssl=false;

# a query string is part of the object key unless S3 URL parameters are enabled
statement ok
SET s3_enable_deprecated_url_parameters=true;

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/retired_remote_path_alias/')

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
COPY (SELECT 1 AS i) TO '{DATA_PATH}/retired_remote_path_alias/manual/orphan.parquet'

statement ok
CALL ducklake_delete_orphaned_files('dl', cleanup_all => true)

statement ok
COPY (SELECT 2 AS i) TO '{DATA_PATH}/retired_remote_path_alias/manual/orphan.parquet'

statement error
CALL ducklake_add_data_files('dl', 't', 'S3A://mybucket/retired_remote_path_alias/manual/orphan.parquet')
----
was retired by cleanup

statement error
CALL ducklake_add_data_files('dl', 't', 's3://mybucket/retired_remote_path_alias/manual/orphan.parquet?s3_region=us-east-1')
----
was retired by cleanup

query I
SELECT count(*) FROM dl.t
----
0
