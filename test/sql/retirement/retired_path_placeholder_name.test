# name: test/sql/retirement/retired_path_placeholder_name.test
# description: a retired path that contains the name of a metadata placeholder cannot be registered again
# group: [retirement]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/retired_path_placeholder_name', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT 1 AS i

statement ok
COPY (SELECT 42 AS i) TO '{DATA_PATH}/retired_path_placeholder_name/retired_{METADATA_CATALOG}.parquet'

query I
SELECT count(*) FROM ducklake_delete_orphaned_files('dl', cleanup_all => true)
----
1

# a file written at the retired path again is refused
statement ok
COPY (SELECT 42 AS i) TO '{DATA_PATH}/retired_path_placeholder_name/retired_{METADATA_CATALOG}.parquet'

statement error
CALL ducklake_add_data_files('dl', 't', '{DATA_PATH}/retired_path_placeholder_name/retired_{METADATA_CATALOG}.parquet')
----
was retired by cleanup
