# name: test/sql/retirement/discarded_alias_published.test
# description: a file that a transaction drops and registers again under another spelling stays published
# group: [retirement]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{TEST_DIR}/discarded_alias_published', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
CREATE TABLE dl.u(i INTEGER)

statement ok
BEGIN

statement ok
INSERT INTO dl.t VALUES (42)

statement ok
SET VARIABLE written = (SELECT file FROM glob('{TEST_DIR}/discarded_alias_published/main/t/*.parquet'))

statement ok
DELETE FROM dl.t

statement ok
CALL ducklake_add_data_files('dl', 'u', replace(getvariable('written'), '/main/t/', '/main/./t/'))

statement ok
COMMIT

query I
SELECT i FROM dl.u
----
42

# a transaction that inserts and deletes its rows again leaves nothing, its retirement is labelled
statement ok
BEGIN

statement ok
INSERT INTO dl.t VALUES (7)

statement ok
DELETE FROM dl.t

statement ok
COMMIT

query I
SELECT commit_message FROM dl.snapshots() ORDER BY snapshot_id DESC LIMIT 1
----
rollback
