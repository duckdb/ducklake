# name: test/sql/sorted_table/data_inlining_flush_sorted_parallel.test
# description: A parallel sorted flush writes its rows in the order used for the delete positions
# group: [sorted_table]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/flush_sorted_parallel', DATA_INLINING_ROW_LIMIT 20000)

# parallel execution must not reorder the flushed rows
statement ok
PRAGMA verify_parallelism

statement ok
SET threads = 8

statement ok
CREATE TABLE ducklake.t (id INTEGER, k BIGINT)

statement ok
ALTER TABLE ducklake.t SET SORTED BY (k)

statement ok
INSERT INTO ducklake.t SELECT i, (i * 7919) % 10007 FROM range(20000) t(i)

statement ok
DELETE FROM ducklake.t WHERE id % 10 = 3

statement ok
CALL ducklake_flush_inlined_data('ducklake', table_name => 't')

query II
SELECT count(*), count(*) FILTER (WHERE id % 10 = 3) FROM ducklake.t
----
18000	0
