# name: test/sql/sorted_table/data_inlining_flush_sorted_parallel.test_slow
# description: Flushing many inlined rows of a sorted table with several threads keeps the sort order and the deletes
# group: [sorted_table]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/flush_sorted_parallel.db

test-env DATA_PATH {TEST_DIR}

# keep the metadata in the WAL like a regular session, instead of checkpointing every commit
statement ok
SET checkpoint_threshold = '10GB'

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/flush_sorted_parallel',
DATA_INLINING_ROW_LIMIT 1000000)

statement ok
CREATE TABLE ducklake.t (p INTEGER, k BIGINT, x DOUBLE)

statement ok
ALTER TABLE ducklake.t SET SORTED BY (k)

statement ok
CREATE TABLE ducklake.partitioned (p INTEGER, k BIGINT, x DOUBLE)

statement ok
ALTER TABLE ducklake.partitioned SET SORTED BY (k)

statement ok
ALTER TABLE ducklake.partitioned SET PARTITIONED BY (p)

# enough rows for the sort to hand out several partitions to the writer threads
loop i 0 2

statement ok
INSERT INTO ducklake.t SELECT r % 2, hash(r) % 100000000, r * 0.5 FROM range({i} * 150000, {i} * 150000 + 150000) t(r)

statement ok
INSERT INTO ducklake.partitioned SELECT r % 2, hash(r) % 100000000, r * 0.5
FROM range({i} * 150000, {i} * 150000 + 150000) t(r)

endloop

# the deleted rows stay in the flushed files, marked by delete files at the positions the flush computes
statement ok
DELETE FROM ducklake.t WHERE x::BIGINT % 10 = 0

statement ok
DELETE FROM ducklake.partitioned WHERE x::BIGINT % 10 = 0

query II
SELECT (SELECT count(*) FROM ducklake_list_files('ducklake', 't')),
(SELECT count(*) FROM ducklake_list_files('ducklake', 'partitioned'))
----
0	0

statement ok
SET threads = 2

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake

query I
SELECT sum(rows_flushed) FROM ducklake_flush_inlined_data('ducklake', table_name => 'partitioned')
----
300000

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake

query II
SELECT count(*), sum(x) FROM ducklake.partitioned
----
255000	19125000000.0

# the flushed file of the unpartitioned table must come out in sort order
loop attempt 0 5

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake

statement ok
BEGIN

query I
SELECT sum(rows_flushed) FROM ducklake_flush_inlined_data('ducklake', table_name => 't')
----
300000

query II
SELECT count(*), count(*) FILTER (WHERE k < prev) FROM (
SELECT k, lag(k) OVER (PARTITION BY filename ORDER BY file_row_number) AS prev FROM ducklake.t)
----
255000	0

statement ok
ROLLBACK

endloop

query I
SELECT sum(rows_flushed) FROM ducklake_flush_inlined_data('ducklake', table_name => 't')
----
300000

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake

query II
SELECT count(*), sum(x) FROM ducklake.t
----
255000	19125000000.0
