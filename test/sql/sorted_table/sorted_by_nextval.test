# name: test/sql/sorted_table/sorted_by_nextval.test
# description: sort keys that use another database are rejected when inserting, without invalidating the database
# group: [sorted_table]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/sorted_by_nextval', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE SEQUENCE seq

statement ok
CREATE TEMP SEQUENCE temp_seq

statement ok
CREATE TABLE ducklake.t (id INTEGER)

statement ok
INSERT INTO ducklake.t VALUES (1)

statement ok
ALTER TABLE ducklake.t SET SORTED BY (nextval('seq'))

statement error
INSERT INTO ducklake.t VALUES (2)
----
The sort keys of table t use database

statement error
CREATE TABLE ducklake.t2 SORTED BY (nextval('seq')) AS SELECT 1 AS id
----
The sort keys of table t2 use database

# the flush registers the sequence of its sort keys with its statement and works
statement ok
CALL ducklake_flush_inlined_data('ducklake')

statement ok
ALTER TABLE ducklake.t SET SORTED BY (nextval('temp.temp_seq'))

statement error
INSERT INTO ducklake.t VALUES (2)
----
The sort keys of table t use database

statement ok
SELECT nextval('seq')

statement ok
ALTER TABLE ducklake.t SET SORTED BY (currval('seq'))

statement error
INSERT INTO ducklake.t VALUES (2)
----
The sort keys of table t use database

statement ok
ALTER TABLE ducklake.t SET SORTED BY (id + setval('seq', 5))

statement error
INSERT INTO ducklake.t VALUES (2)
----
The sort keys of table t use database

statement ok
ALTER TABLE ducklake.t SET SORTED BY (list_transform([id], lambda id: nextval('seq')))

statement error
INSERT INTO ducklake.t VALUES (2)
----
The sort keys of table t use database

statement ok
CREATE MACRO next_id(i) AS list_transform([i], lambda id: nextval('seq'))

statement ok
ALTER TABLE ducklake.t SET SORTED BY (next_id(id))

statement error
INSERT INTO ducklake.t VALUES (2)
----
The sort keys of table t use database

# a prepared insert is bound again when the sort changes
statement ok
ALTER TABLE ducklake.t RESET SORTED BY

statement ok
PREPARE insert_t AS INSERT INTO ducklake.t VALUES ($1)

statement ok
ALTER TABLE ducklake.t SET SORTED BY (nextval('seq'))

statement error
EXECUTE insert_t(2)
----
The sort keys of table t use database

# other volatile functions are fine
statement ok
ALTER TABLE ducklake.t SET SORTED BY (random())

statement ok
INSERT INTO ducklake.t VALUES (2)

statement ok
ALTER TABLE ducklake.t RESET SORTED BY

statement ok
INSERT INTO ducklake.t VALUES (3)

query I
SELECT id FROM ducklake.t ORDER BY id
----
1
2
3
