# name: test/sql/deletion_inlining/inlined_deletion_table_branch.test
# description: the inlined deletion table of a data table names the branch of its rows, main until branches write
# group: [deletion_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.f AS SELECT range AS i FROM range(100)

statement ok
DELETE FROM dl.f WHERE i IN (5, 6)

# the branch column comes last with a default, like the one a migration adds
query I
SELECT column_name FROM (SELECT DISTINCT column_index, column_name FROM duckdb_columns()
    WHERE database_name = 'meta' AND schema_name IN ('main', 'public') AND table_name = 'ducklake_inlined_delete_1')
ORDER BY column_index
----
file_id
row_id
begin_snapshot
branch_id

query IIII
FROM meta.ducklake_inlined_delete_1 ORDER BY ALL
----
0	5	2	0
0	6	2	0

query I
SELECT COUNT(*) FROM dl.f
----
98

# the flush writes the deletions to a delete file and drops the rows
statement ok
CALL ducklake_flush_inlined_data('dl')

query I
SELECT COUNT(*) FROM meta.ducklake_inlined_delete_1
----
0

query I
SELECT COUNT(*) FROM dl.f
----
98

query I
SELECT COUNT(*) FROM dl.f AT (VERSION => 1)
----
100

statement ok
DETACH dl
