# name: test/sql/deletion_inlining/test_deletion_inlining_transaction.test
# description: test ducklake deletion inlining with transactions
# group: [deletion_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/test_deletion_inlining_transaction',DATA_INLINING_ROW_LIMIT 10,  METADATA_CATALOG 'ducklake_meta')

statement ok
use ducklake

statement ok
CREATE TABLE t AS SELECT range a FROM range(50);

statement ok
BEGIN

# This creates an inlined file deletion (5 rows deleted, which is within the inlining threshold of 10)
statement ok
DELETE FROM T where a < 5

# Verify the count reflects the delete within the transaction
query I
SELECT COUNT(*) FROM t;
----
45

statement ok
ROLLBACK

query I
SELECT COUNT(*) FROM t;
----
50

# Verify inserting a new file and deleting from it in a transaction

statement ok
BEGIN

statement ok
insert into t values (56),(57),(58),(59),(60),(61),(62),(63),(64),(65),(66),(67),(68),(69),(70);

query I
SELECT COUNT(*) FROM t;
----
65

# This creates inlined file deletions from multiple files (6 rows deleted, which is within the inlining threshold of 10)
statement ok
DELETE FROM T where a < 5 OR a = 65

# Verify the count reflects the delete within the transaction
query I
SELECT COUNT(*) FROM t;
----
59

statement ok
ROLLBACK


query I
SELECT COUNT(*) FROM t;
----
50

# Multiple deletions on the same file
statement ok
BEGIN

statement ok
DELETE FROM T where a < 5

statement ok
DELETE FROM T where a < 10

statement ok
DELETE FROM T where a < 15

query I
SELECT COUNT(*) FROM t;
----
35

statement ok
ROLLBACK

query I
SELECT COUNT(*) FROM t;
----
50

statement ok
BEGIN

statement ok
DELETE FROM T where a < 5

statement ok
DELETE FROM T where a < 10

statement ok
DELETE FROM T where a < 15

query I
SELECT COUNT(*) FROM t;
----
35

statement ok
COMMIT

# the deletions are dated to the snapshot of the commit
statement ok
SET VARIABLE delete_snapshot = (SELECT max(snapshot_id) FROM ducklake_meta.ducklake_snapshot)

query I
SELECT COUNT(*) FROM t;
----
35

query III
SELECT file_id, row_id, begin_snapshot = getvariable('delete_snapshot') FROM ducklake_meta.ducklake_inlined_delete_1 ORDER BY row_id
----
0	0	true
0	1	true
0	2	true
0	3	true
0	4	true
0	5	true
0	6	true
0	7	true
0	8	true
0	9	true
0	10	true
0	11	true
0	12	true
0	13	true
0	14	true

statement ok
BEGIN

# Test flush within transaction
statement ok
CALL ducklake_flush_inlined_data('ducklake')

# Data should still be correct after flush (verified through DuckLake scan)
query I
SELECT COUNT(*) FROM t
----
35

statement ok
ROLLBACK

# After rollback, the inlined deletions should still be there (flush was rolled back)
query III
SELECT file_id, row_id, begin_snapshot = getvariable('delete_snapshot') FROM ducklake_meta.ducklake_inlined_delete_1 ORDER BY row_id
----
0	0	true
0	1	true
0	2	true
0	3	true
0	4	true
0	5	true
0	6	true
0	7	true
0	8	true
0	9	true
0	10	true
0	11	true
0	12	true
0	13	true
0	14	true

statement ok
BEGIN

# Test flush with commit
statement ok
CALL ducklake_flush_inlined_data('ducklake')

statement ok
COMMIT

# After flush + commit, the inlined deletions should be removed
query III
SELECT file_id, row_id, begin_snapshot FROM ducklake_meta.ducklake_inlined_delete_1 ORDER BY row_id
----

# Data should still be correct after flush
query I
SELECT COUNT(*) FROM t
----
35