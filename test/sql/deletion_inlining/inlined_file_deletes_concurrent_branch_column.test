# name: test/sql/deletion_inlining/inlined_file_deletes_concurrent_branch_column.test
# description: concurrent inlined deletes are checked against the later deletions of the committing branch, they conflict on the same file and commit on different files
# group: [deletion_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t AS SELECT range AS i FROM range(100)

statement ok
INSERT INTO dl.t SELECT range FROM range(100, 200)

statement ok
CALL enable_logging('DuckLakeMetadata')

# inlined deletes of different files commit
statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
DELETE FROM dl.t WHERE i = 5

statement ok con2
DELETE FROM dl.t WHERE i = 150

statement ok con1
COMMIT

statement ok con2
COMMIT

# the second commit looked up the deletions main wrote after its snapshot
query I
SELECT count(*) > 0 FROM duckdb_logs_parsed('DuckLakeMetadata') WHERE query ILIKE '%ducklake_inlined_delete_1%WHERE branch_id = 0 AND begin_snapshot > 2%'
----
true

# inlined deletes of the same file conflict
statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
DELETE FROM dl.t WHERE i = 6

statement ok con2
DELETE FROM dl.t WHERE i = 7

statement ok con1
COMMIT

statement error con2
COMMIT
----
<REGEX>:.*Transaction conflict.*

statement ok
CALL disable_logging()

# the committed deletions carry the branch they were deleted on
query IIII
SELECT file_id, row_id, begin_snapshot, branch_id FROM meta.ducklake_inlined_delete_1 ORDER BY begin_snapshot
----
0	5	3	0
1	50	4	0
0	6	5	0

query II
SELECT count(*), sum(i) FROM dl.t
----
197	19739

statement ok
DETACH dl
