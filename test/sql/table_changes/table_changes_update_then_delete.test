# name: test/sql/table_changes/table_changes_update_then_delete.test
# description: a row updated and then deleted in one transaction is one delete in the change feed
# group: [table_changes]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/update_then_delete', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t (id INTEGER, v INTEGER)

statement ok
INSERT INTO lake.t SELECT i, 0 FROM range(3) r(i)

statement ok
BEGIN

statement ok
UPDATE lake.t SET v = 1

statement ok
DELETE FROM lake.t WHERE id = 0

statement ok
COMMIT

query IIII
SELECT rowid, change_type, id, v FROM ducklake_table_changes('lake', 'main', 't', 3, 3) ORDER BY ALL
----
0	delete	0	0
1	update_postimage	1	1
1	update_preimage	1	0
2	update_postimage	2	1
2	update_preimage	2	0

# later deletes from the file the update wrote
statement ok
DELETE FROM lake.t WHERE id = 1

query IIII
SELECT rowid, change_type, id, v FROM ducklake_table_changes('lake', 'main', 't', 3, 3) ORDER BY ALL
----
0	delete	0	0
1	update_postimage	1	1
1	update_preimage	1	0
2	update_postimage	2	1
2	update_preimage	2	0

query IIII
SELECT rowid, change_type, id, v FROM ducklake_table_changes('lake', 'main', 't', 4, 4) ORDER BY ALL
----
1	delete	1	1

statement ok
DELETE FROM lake.t WHERE id = 2

query IIIII
SELECT snapshot_id, rowid, change_type, id, v FROM ducklake_table_changes('lake', 'main', 't', 3, 5) ORDER BY ALL
----
3	0	delete	0	0
3	1	update_postimage	1	1
3	1	update_preimage	1	0
3	2	update_postimage	2	1
3	2	update_preimage	2	0
4	1	delete	1	1
5	2	delete	2	1

query IIII
SELECT snapshot_id, rowid, id, v FROM ducklake_table_insertions('lake', 'main', 't', 3, 5) ORDER BY ALL
----
3	1	1	1
3	2	2	1

query IIII
SELECT snapshot_id, rowid, id, v FROM ducklake_table_deletions('lake', 'main', 't', 3, 5) ORDER BY ALL
----
3	0	0	0
3	1	1	0
3	2	2	0
4	1	1	1
5	2	2	1

# the later deletes are inlined file deletions
statement ok
CREATE TABLE lake.u (id INTEGER, v INTEGER)

statement ok
CALL lake.set_option('data_inlining_row_limit', 2, table_name => 'u')

statement ok
INSERT INTO lake.u SELECT i, 0 FROM range(3) r(i)

statement ok
BEGIN

statement ok
UPDATE lake.u SET v = 1

statement ok
DELETE FROM lake.u WHERE id = 0

statement ok
COMMIT

statement ok
DELETE FROM lake.u WHERE id = 1

query IIIII
SELECT snapshot_id - 7, rowid, change_type, id, v FROM ducklake_table_changes('lake', 'main', 'u', 8, 9) ORDER BY ALL
----
1	0	delete	0	0
1	1	update_postimage	1	1
1	1	update_preimage	1	0
1	2	update_postimage	2	1
1	2	update_preimage	2	0
2	1	delete	1	1

# a row inserted and deleted in one transaction never existed
statement ok
CREATE TABLE lake.w (id INTEGER, v INTEGER)

statement ok
BEGIN

statement ok
INSERT INTO lake.w SELECT i, 0 FROM range(3) r(i)

statement ok
DELETE FROM lake.w WHERE id = 0

statement ok
COMMIT

query IIII
SELECT rowid, change_type, id, v FROM ducklake_table_changes('lake', 'main', 'w', 11, 11) ORDER BY ALL
----
1	insert	1	0
2	insert	2	0
