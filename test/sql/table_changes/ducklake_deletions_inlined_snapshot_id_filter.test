# name: test/sql/table_changes/ducklake_deletions_inlined_snapshot_id_filter.test
# description: filtering ducklake_table_deletions on rowid/snapshot_id must keep per-row snapshots when deletes are inlined (DATA_INLINING_ROW_LIMIT 10); delete-file-path variant: ducklake_deletions_snapshot_id_filter.test
# group: [table_changes]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

# DATA_INLINING_ROW_LIMIT 10 routes single-row deletes onto the inlined-delete path
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/ducklake_inlined_snapshot_id_filter', DATA_INLINING_ROW_LIMIT 10)

statement ok
USE dl

# snapshot 1 - create table
statement ok
CREATE TABLE d (k INTEGER, v INTEGER)

# snapshot 2 - one parquet file with 100 rows (rowids 0..99 for k=1..100)
statement ok
INSERT INTO d SELECT i, i*10 FROM range(1, 101) t(i)

# snapshot 3 - inlined delete of k=2 (rowid 1)
statement ok
DELETE FROM d WHERE k = 2

# snapshot 4 - inlined delete of k=4 (rowid 3)
statement ok
DELETE FROM d WHERE k = 4

# snapshot 5 - inlined delete of k=6 (rowid 5)
statement ok
DELETE FROM d WHERE k = 6

# control: per-row snapshots are correct when nothing filters on rowid
query III
SELECT rowid, snapshot_id, k FROM ducklake_table_deletions('dl','main','d',1,5) ORDER BY rowid
----
1	3	2
3	4	4
5	5	6

# rowid filter projected together with the snapshot_id filter: correct
query II
SELECT rowid, k FROM ducklake_table_deletions('dl','main','d',1,5) WHERE snapshot_id = 5 AND rowid = 5
----
5	6

# rowid filter-only must not expose the file-level snapshot constant instead of the row's snapshot
query II
SELECT snapshot_id, k FROM ducklake_table_deletions('dl','main','d',1,5) WHERE rowid = 5
----
5	6

# rowid filter combined with the snapshot_id filter must not lose the row
query I
SELECT k FROM ducklake_table_deletions('dl','main','d',1,5) WHERE snapshot_id = 5 AND rowid = 5
----
6
