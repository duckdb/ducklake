# name: test/sql/table_changes/table_changes_rewrite_merged_twice.test
# description: The rows of two rewrites merged into one file are not changes
# group: [table_changes]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/table_changes_rewrite_merged_twice', DATA_INLINING_ROW_LIMIT 0)

statement ok
USE ducklake

statement ok
CREATE TABLE t (id INTEGER)

statement ok
INSERT INTO t SELECT range FROM range(10)

statement ok
INSERT INTO t SELECT range FROM range(10, 20)

statement ok
DELETE FROM t WHERE id = 0

statement ok
CALL ducklake_rewrite_data_files('ducklake', 't', delete_threshold => 0)

statement ok
DELETE FROM t WHERE id = 10

statement ok
CALL ducklake_rewrite_data_files('ducklake', 't', delete_threshold => 0)

statement ok
CALL ducklake_merge_adjacent_files('ducklake')

query I
SELECT COUNT(*) FROM ducklake_list_files('ducklake', 't')
----
1

query III
SELECT snapshot_id, change_type, COUNT(*) FROM table_changes('t', 0, 8) GROUP BY ALL ORDER BY ALL
----
2	insert	10
3	insert	10
4	delete	1
6	delete	1

query I
SELECT COUNT(*) FROM table_insertions('t', 5, 8)
----
0
