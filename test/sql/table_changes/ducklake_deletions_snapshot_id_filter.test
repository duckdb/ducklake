# name: test/sql/table_changes/ducklake_deletions_snapshot_id_filter.test
# description: filtering ducklake_table_deletions/ducklake_table_changes on the virtual snapshot_id column must apply the filter after gather
# group: [table_changes]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

# DATA_INLINING_ROW_LIMIT 0 forces deletes onto the real delete-file path
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/ducklake_snapshot_id_filter', DATA_INLINING_ROW_LIMIT 0)

statement ok
USE dl

statement ok
CREATE TABLE d (k INTEGER, v INTEGER)

statement ok
INSERT INTO d VALUES (1,10),(2,20),(3,30),(4,40),(5,50)

statement ok
DELETE FROM d WHERE k = 2

statement ok
DELETE FROM d WHERE k = 4

# control: all deletions in the range
query III
SELECT rowid, snapshot_id, k FROM ducklake_table_deletions('dl', 'main', 'd', 2, 4) ORDER BY rowid
----
1	3	2
3	4	4

# equality filter on the virtual snapshot_id column - must keep only the snapshot-3 deletion
query III
SELECT rowid, snapshot_id, k FROM ducklake_table_deletions('dl', 'main', 'd', 2, 4) WHERE snapshot_id = 3 ORDER BY rowid
----
1	3	2

# range filter on the virtual snapshot_id column
query III
SELECT rowid, snapshot_id, k FROM ducklake_table_deletions('dl', 'main', 'd', 2, 4) WHERE snapshot_id >= 4 ORDER BY rowid
----
3	4	4

# the same filter must work through ducklake_table_changes
query III
SELECT rowid, snapshot_id, change_type FROM ducklake_table_changes('dl', 'main', 'd', 2, 4) WHERE snapshot_id = 3 AND change_type = 'delete' ORDER BY rowid
----
1	3	delete

# filter on snapshot_id without projecting it (the column is internally projected)
query II
SELECT rowid, k FROM ducklake_table_deletions('dl', 'main', 'd', 2, 4) WHERE snapshot_id = 3 ORDER BY rowid
----
1	2

# multiple data files: per-file row_id_start and snapshots under a snapshot_id filter
statement ok
CREATE TABLE m (k INTEGER, v INTEGER)

statement ok
INSERT INTO m VALUES (1,10),(2,20),(3,30)

statement ok
INSERT INTO m VALUES (4,40),(5,50),(6,60)

statement ok
DELETE FROM m WHERE k = 2

statement ok
DELETE FROM m WHERE k = 5

query III
SELECT rowid, snapshot_id, k FROM ducklake_table_deletions('dl', 'main', 'm', 2, 9) WHERE snapshot_id = 8 ORDER BY rowid
----
1	8	2

query II
SELECT rowid, k FROM ducklake_table_deletions('dl', 'main', 'm', 2, 9) WHERE snapshot_id = 8 ORDER BY rowid
----
1	2
