# name: test/sql/settings/create_table_with_options.test
# description: Test CREATE TABLE ... WITH (option = value)
# group: [settings]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:{TEST_DIR}/ducklake_create_with.db' AS ducklake (DATA_PATH '{TEST_DIR}/ducklake_create_with_files');

statement ok
CALL ducklake.set_option('parquet_compression', 'uncompressed')

statement ok
CREATE TABLE ducklake.t1(str VARCHAR) WITH (parquet_compression = 'zstd', data_inlining_row_limit = 0)

query IIII
SELECT option_name, value, scope, scope_entry FROM ducklake.options() WHERE scope = 'TABLE' ORDER BY ALL
----
data_inlining_row_limit	0	TABLE	main.t1
parquet_compression	zstd	TABLE	main.t1

query II
SELECT key, value FROM __ducklake_metadata_ducklake.ducklake_metadata WHERE scope = 'table' ORDER BY ALL
----
data_inlining_row_limit	0
parquet_compression	zstd

# Inlining is off, so even one row writes a file
query I
INSERT INTO ducklake.t1 VALUES ('hello')
----
1

query I
SELECT DISTINCT compression FROM parquet_metadata('{TEST_DIR}/ducklake_create_with_files/main/t1/**') ORDER BY ALL
----
ZSTD

# CTAS writes its own rows with the options
statement ok
CREATE TABLE ducklake.t2 WITH (parquet_compression = 'gzip', data_inlining_row_limit = 0) AS SELECT 'hello world' || i str FROM range(5) t(i)

query I
SELECT DISTINCT compression FROM parquet_metadata('{TEST_DIR}/ducklake_create_with_files/main/t2/**') ORDER BY ALL
----
GZIP

query II
SELECT option_name, value FROM ducklake.options() WHERE scope_entry = 'main.t2' ORDER BY ALL
----
data_inlining_row_limit	0
parquet_compression	gzip

# Inserts in the creating transaction use the options
statement ok
BEGIN

statement ok
CREATE TABLE ducklake.t3(str VARCHAR) WITH (parquet_compression = 'snappy', data_inlining_row_limit = 0)

query I
INSERT INTO ducklake.t3 SELECT 'hello world' || i FROM range(100) t(i)
----
100

statement ok
COMMIT

query I
SELECT DISTINCT compression FROM parquet_metadata('{TEST_DIR}/ducklake_create_with_files/main/t3/**') ORDER BY ALL
----
SNAPPY

# Later alters and a rename in the creating transaction keep the options
statement ok
BEGIN

statement ok
CREATE TABLE ducklake.t4(str VARCHAR) WITH (parquet_compression = 'brotli')

statement ok
ALTER TABLE ducklake.t4 ADD COLUMN i INTEGER

statement ok
ALTER TABLE ducklake.t4 RENAME TO t4_renamed

statement ok
COMMIT

query I
SELECT value FROM ducklake.options() WHERE option_name = 'parquet_compression' AND scope_entry = 'main.t4_renamed'
----
brotli

# Rollback leaves nothing behind
statement ok
BEGIN

statement ok
CREATE TABLE ducklake.t5(str VARCHAR) WITH (parquet_compression = 'lz4')

statement ok
ROLLBACK

query I
SELECT count(*) FROM __ducklake_metadata_ducklake.ducklake_metadata WHERE key = 'parquet_compression' AND value = 'lz4'
----
0

# Options persist across attachments
statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{TEST_DIR}/ducklake_create_with.db' AS ducklake (DATA_PATH '{TEST_DIR}/ducklake_create_with_files');

query I
INSERT INTO ducklake.t2 VALUES ('again')
----
1

query I
SELECT DISTINCT compression FROM parquet_metadata('{TEST_DIR}/ducklake_create_with_files/main/t2/**') ORDER BY ALL
----
GZIP

# skip_stats_columns resolves against the new columns
statement ok
CREATE TABLE ducklake.t6(id INTEGER, s VARCHAR) WITH (skip_stats_columns = ['s'], data_inlining_row_limit = 0)

query I
SELECT value FROM ducklake.options() WHERE option_name = 'skip_stats_columns' AND scope_entry = 'main.t6'
----
2

statement ok
INSERT INTO ducklake.t6 VALUES (1, 'aaa'), (2, 'zzz')

query III
SELECT column_id, min_value, max_value FROM __ducklake_metadata_ducklake.ducklake_file_column_stats WHERE table_id = (SELECT table_id FROM __ducklake_metadata_ducklake.ducklake_table WHERE table_name = 't6' AND end_snapshot IS NULL) ORDER BY column_id
----
1	1	2
2	NULL	NULL

statement ok
CREATE TABLE ducklake.t6_ctas WITH (skip_stats_columns = ['S'], data_inlining_row_limit = 0) AS SELECT 1 AS id, 'aaa' AS s

query III
SELECT column_id, min_value, max_value FROM __ducklake_metadata_ducklake.ducklake_file_column_stats WHERE table_id = (SELECT table_id FROM __ducklake_metadata_ducklake.ducklake_table WHERE table_name = 't6_ctas' AND end_snapshot IS NULL) ORDER BY column_id
----
1	1	1
2	NULL	NULL

# sort_on_insert applies to the CTAS rows and later inserts
statement ok
CREATE TABLE ducklake.t7 SORTED BY (i) WITH (sort_on_insert = false, data_inlining_row_limit = 0) AS SELECT * FROM (VALUES (3), (1), (2)) t(i)

query I
SELECT i FROM ducklake.t7
----
3
1
2

statement ok
CREATE TABLE ducklake.t8(i INTEGER) SORTED BY (i) WITH (data_inlining_row_limit = 0)

statement ok
INSERT INTO ducklake.t8 VALUES (3), (1), (2)

query I
SELECT i FROM ducklake.t8
----
1
2
3

# Errors
statement error
CREATE TABLE ducklake.bad(i INTEGER) WITH (nonexistent_option = 1)
----
Unsupported option nonexistent_option

statement error
CREATE TABLE ducklake.bad(i INTEGER) WITH (parquet_compression = 'nope')
----
Unsupported codec

statement error
CREATE TABLE ducklake.bad(i INTEGER) WITH (expire_older_than = '1 day')
----
can only be set globally

statement error
CREATE TABLE ducklake.bad(i INTEGER) WITH (parquet_compression = NULL)
----
requires a value

statement error
CREATE TABLE ducklake.bad(i INTEGER) WITH (parquet_compression)
----
requires a value

statement error
CREATE TABLE ducklake.bad(i INTEGER) WITH (parquet_compression = i)
----
cannot contain column names

statement error
CREATE TABLE ducklake.bad(i INTEGER) WITH (skip_stats_columns = 'nonexistent')
----
does not exist

statement error
CREATE TABLE ducklake.bad WITH (parquet_compression = 'nope') AS SELECT 1 AS i
----
Unsupported codec

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'ducklake' AND table_name = 'bad'
----
0

# IF NOT EXISTS on an existing table changes nothing
statement ok
CREATE TABLE IF NOT EXISTS ducklake.t1(str VARCHAR) WITH (parquet_compression = 'gzip')

query I
SELECT value FROM ducklake.options() WHERE option_name = 'parquet_compression' AND scope_entry = 'main.t1'
----
zstd

statement ok
DETACH ducklake

# Enabling inlining checks for reserved column names
statement ok
ATTACH 'ducklake:{TEST_DIR}/ducklake_create_with_v10.db' AS dl10 (DATA_PATH '{TEST_DIR}/ducklake_create_with_v10_files', DUCKLAKE_VERSION '1.0')

statement ok
CALL dl10.set_option('data_inlining_row_limit', 0)

statement error
CREATE TABLE dl10.t_reserved(row_id INTEGER) WITH (data_inlining_row_limit = 10)
----
Cannot enable data inlining

statement ok
CREATE TABLE dl10.t_plain(i INTEGER) WITH (data_inlining_row_limit = 10)

statement ok
INSERT INTO dl10.t_plain VALUES (1), (2)

query I
SELECT count(*) FROM __ducklake_metadata_dl10.ducklake_data_file
----
0
