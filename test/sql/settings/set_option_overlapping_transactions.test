# name: test/sql/settings/set_option_overlapping_transactions.test
# description: once overlapping transactions that change an option end, inserts use the value they committed
# group: [settings]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/set_option_overlapping_transactions.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/option_overlap', DATA_INLINING_ROW_LIMIT 0)

statement ok
CALL dl.set_option('parquet_compression', 'snappy')

foreach tbl a b c

statement ok
CREATE TABLE dl.{tbl} (i INTEGER)

statement ok
CALL dl.set_option('parquet_compression', 'zstd', table_name => '{tbl}')

endloop

# the transaction that set its value first commits last
statement ok con1
BEGIN

statement ok con1
CALL dl.set_option('parquet_compression', 'gzip', table_name => 'a')

statement ok con2
BEGIN

statement ok con2
CALL dl.set_option('parquet_compression', 'lz4', table_name => 'a')

statement ok con2
COMMIT

statement ok con1
COMMIT

# a transaction that set the value another one committed rolls back
statement ok con1
BEGIN

statement ok con1
CALL dl.set_option('parquet_compression', 'gzip', table_name => 'b')

statement ok con2
CALL dl.set_option('parquet_compression', 'gzip', table_name => 'b')

statement ok con1
ROLLBACK

# a transaction that reset the option another one reset rolls back
statement ok con1
BEGIN

statement ok con1
ALTER TABLE dl.c RESET (parquet_compression)

statement ok con2
ALTER TABLE dl.c RESET (parquet_compression)

statement ok con1
ROLLBACK

query II
SELECT scope_entry, value FROM dl.options() WHERE option_name = 'parquet_compression' AND scope = 'TABLE' ORDER BY ALL
----
main.a	gzip
main.b	gzip

foreach tbl a b c

statement ok
INSERT INTO dl.{tbl} VALUES (1)

endloop

query II
SELECT DISTINCT 'a', compression FROM parquet_metadata('{DATA_PATH}/option_overlap/main/a/**')
UNION ALL
SELECT DISTINCT 'b', compression FROM parquet_metadata('{DATA_PATH}/option_overlap/main/b/**')
UNION ALL
SELECT DISTINCT 'c', compression FROM parquet_metadata('{DATA_PATH}/option_overlap/main/c/**')
ORDER BY ALL
----
a	GZIP
b	GZIP
c	SNAPPY
