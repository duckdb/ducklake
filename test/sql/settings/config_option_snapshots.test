# name: test/sql/settings/config_option_snapshots.test
# description: Setting a config option commits a snapshot, which records the option it set
# group: [settings]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/config_option_snapshots.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/config_option_snapshots', METADATA_CATALOG 'ducklake_meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t(id INTEGER)

statement ok
SET VARIABLE before_option = (SELECT max(snapshot_id) FROM ducklake.snapshots())

statement ok
CALL ducklake.set_option('parquet_compression', 'gzip')

query II
SELECT snapshot_id - getvariable('before_option'), changes FROM ducklake.snapshots() WHERE snapshot_id > getvariable('before_option')
----
1	{options_set=[global.0.parquet_compression]}

# an option set together with other changes lands in the same snapshot
statement ok
BEGIN

statement ok
CALL ducklake.set_option('parquet_compression', 'zstd', table_name => 't')

statement ok
INSERT INTO ducklake.t VALUES (1)

statement ok
COMMIT

query I
SELECT changes['options_set'] FROM ducklake.snapshots() ORDER BY snapshot_id DESC LIMIT 1
----
[table.1.parquet_compression]

# changing options needs no commit message, so a catalog that requires one can turn that off
statement ok
CALL ducklake.set_option('require_commit_message', true)

statement ok
CALL ducklake.set_option('parquet_compression', 'snappy')

statement ok
CALL ducklake.set_option('require_commit_message', false)

query I
SELECT value FROM ducklake.options() WHERE option_name = 'require_commit_message'
----
false

# a refused commit keeps none of its options
statement ok
CALL ducklake.set_option('require_commit_message', true)

statement ok
BEGIN

statement ok
CALL ducklake.set_option('parquet_compression', 'snappy', table_name => 't')

statement ok
INSERT INTO ducklake.t VALUES (2)

statement error
COMMIT
----
Commit Information for the snapshot is required

query I
SELECT value FROM ducklake.options() WHERE option_name = 'parquet_compression' AND scope_entry = 'main.t'
----
zstd

statement ok
CALL ducklake.set_option('require_commit_message', false)

# other changes are held to the requirement as it stood when their transaction started
statement ok
CALL ducklake.set_option('require_commit_message', true)

statement ok
BEGIN

statement ok
CALL ducklake.set_option('require_commit_message', false)

statement ok
INSERT INTO ducklake.t VALUES (3)

statement error
COMMIT
----
Commit Information for the snapshot is required

statement ok
CALL ducklake.set_option('require_commit_message', false)

# and turning it on applies from the next commit
statement ok
BEGIN

statement ok
CALL ducklake.set_option('require_commit_message', true)

statement ok
INSERT INTO ducklake.t VALUES (4)

statement ok
COMMIT

statement ok
CALL ducklake.set_option('require_commit_message', false)

# a data commit retried after another one changed the options records that one
statement ok con1
BEGIN

statement ok con1
INSERT INTO ducklake.t VALUES (42)

statement ok con2
CALL ducklake.set_option('parquet_row_group_size', 5000, table_name => 't')

statement ok con1
COMMIT

query I
SELECT (SELECT options_version FROM ducklake_meta.ducklake_snapshot ORDER BY snapshot_id DESC LIMIT 1)
     = (SELECT max(snapshot_id) FROM ducklake_meta.ducklake_snapshot_changes WHERE changes_made LIKE '%set_option%')
----
true

query I
SELECT changes_made FROM ducklake_meta.ducklake_snapshot_changes ORDER BY snapshot_id DESC LIMIT 1
----
inserted_into_table:1

# each snapshot records the last one that changed the options, also when concurrent commits are retried
statement ok
SET ducklake_max_retry_count = 100

loop i 0 4

statement ok
CREATE TABLE ducklake.c${i}(id INTEGER)

endloop

# each its own table, as concurrent sets of one option conflict
concurrentloop i 0 4

statement ok
INSERT INTO ducklake.c${i} VALUES (${i})

statement ok
CALL ducklake.set_option('parquet_row_group_size', 1000 + ${i}, table_name => 'c${i}')

endloop

query I
SELECT count(*) FROM (
	SELECT snapshot_id, options_version, changes_made,
	       lag(options_version) OVER (ORDER BY snapshot_id) AS previous_version
	FROM ducklake_meta.ducklake_snapshot JOIN ducklake_meta.ducklake_snapshot_changes USING (snapshot_id)
)
WHERE snapshot_id > 0
  AND options_version <> CASE WHEN changes_made LIKE '%set_option%' THEN snapshot_id ELSE previous_version END
----
0

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/config_option_snapshots', METADATA_CATALOG 'ducklake_meta', SNAPSHOT_VERSION 1, READ_ONLY)

statement error
CALL ducklake.set_option('parquet_compression', 'gzip')
----
attached at a snapshot

# and it reads the options of that snapshot, before any was set
query I
SELECT count(*) FROM ducklake.options() WHERE option_name IN ('parquet_compression', 'require_commit_message')
----
0
