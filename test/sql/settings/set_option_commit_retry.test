# name: test/sql/settings/set_option_commit_retry.test
# description: the options that a transaction sets and resets are kept when its commit retries
# group: [settings]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/set_option_commit_retry.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/option_commit_retry', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
CREATE TABLE dl.u (i INTEGER)

statement ok
CALL dl.set_option('target_file_size', '1MB', table_name => 'u')

statement ok con2
BEGIN

statement ok con2
CALL dl.set_option('parquet_compression', 'gzip', table_name => 'u')

statement ok con2
ALTER TABLE dl.u RESET (target_file_size)

query II con2
SELECT option_name, value FROM dl.options() WHERE scope = 'TABLE' ORDER BY ALL
----
parquet_compression	gzip

statement ok con2
INSERT INTO dl.u VALUES (1)

# con1 commits the next snapshot first, so the commit of con2 retries
statement ok con1
INSERT INTO dl.t VALUES (1)

statement ok con2
COMMIT

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl

query II
SELECT option_name, value FROM dl.options() WHERE scope = 'TABLE' ORDER BY ALL
----
parquet_compression	gzip
