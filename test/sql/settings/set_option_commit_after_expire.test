# name: test/sql/settings/set_option_commit_after_expire.test
# description: a commit that only writes options fails instead of retrying without the snapshots its transaction expired
# group: [settings]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/set_option_commit_after_expire.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/option_after_expire')

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
CALL dl.set_option('target_file_size', '1MB', table_name => 't')

statement ok con1
BEGIN

statement ok con1
CALL ducklake_expire_snapshots('dl', versions => [1])

statement ok con1
CALL dl.set_option('target_file_size', '2MB', table_name => 't')

statement ok con2
CALL dl.set_option('target_file_size', '3MB', table_name => 't')

statement error con1
COMMIT
----
Failed to commit DuckLake transaction

query I
SELECT count(*) FROM dl.snapshots() WHERE snapshot_id = 1
----
1

query I
SELECT value FROM dl.options() WHERE option_name = 'target_file_size'
----
3000000
