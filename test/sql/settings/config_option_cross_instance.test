# name: test/sql/settings/config_option_cross_instance.test
# description: A config option committed through one attach of a catalog is read through another without re-attaching
# group: [settings]

require ducklake

require parquet

require sqlite_scanner

statement ok
ATTACH 'ducklake:sqlite:{TEST_DIR}/config_option_cross_instance.sqlite' AS dl1 (DATA_PATH '{TEST_DIR}/config_option_cross_instance', METADATA_CATALOG 'meta1')

statement ok
ATTACH 'ducklake:sqlite:{TEST_DIR}/config_option_cross_instance.sqlite' AS dl2 (METADATA_CATALOG 'meta2', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl1.t(id INTEGER)

query I
SELECT count(*) FROM dl2.options() WHERE option_name = 'parquet_compression'
----
0

statement ok
CALL dl1.set_option('parquet_compression', 'gzip', table_name => 't')

query I
SELECT value FROM dl2.options() WHERE option_name = 'parquet_compression'
----
gzip

# and dl2 writes with it
statement ok
INSERT INTO dl2.t VALUES (1)

query I
SELECT DISTINCT compression FROM parquet_metadata('{TEST_DIR}/config_option_cross_instance/**/*.parquet')
----
GZIP

# a reset only closes the option's row, and dl2 must still notice the options changed
statement ok
ALTER TABLE dl1.t RESET (parquet_compression)

statement ok
INSERT INTO dl2.t VALUES (2)

query I
SELECT count(DISTINCT file_name) FROM parquet_metadata('{TEST_DIR}/config_option_cross_instance/**/*.parquet') WHERE compression = 'GZIP'
----
1

# expiring the snapshots of a reset must not take the options version back to one dl2 already read
statement ok
CREATE TABLE dl1.u(id INTEGER)

statement ok
BEGIN

statement ok
CALL dl1.set_option('parquet_compression', 'gzip', table_name => 'u')

statement ok
CALL dl1.set_option('parquet_row_group_size', 1000, table_name => 'u')

statement ok
COMMIT

statement ok
INSERT INTO dl2.u VALUES (1)

statement ok
SET VARIABLE before_reset = (SELECT max(snapshot_id) FROM dl1.snapshots())

statement ok
ALTER TABLE dl1.u RESET (parquet_compression)

statement ok
SET VARIABLE expired = (SELECT list(snapshot_id) FROM dl1.snapshots() WHERE snapshot_id BETWEEN 1 AND getvariable('before_reset'))

statement ok
CALL ducklake_expire_snapshots('dl1', versions => getvariable('expired'))

statement ok
INSERT INTO dl2.u VALUES (2)

query I
SELECT count(DISTINCT file_name) FROM parquet_metadata('{TEST_DIR}/config_option_cross_instance/**/*.parquet') WHERE compression = 'GZIP'
----
2

# before v1.1 a reset deletes what the metadata holds, including another attach's option
statement ok
ATTACH 'ducklake:sqlite:{TEST_DIR}/config_option_cross_instance_v10.sqlite' AS dl3 (DATA_PATH '{TEST_DIR}/config_option_cross_instance_v10', METADATA_CATALOG 'meta3', DUCKLAKE_VERSION '1.0')

statement ok
ATTACH 'ducklake:sqlite:{TEST_DIR}/config_option_cross_instance_v10.sqlite' AS dl4 (METADATA_CATALOG 'meta4')

statement ok
CREATE TABLE dl3.t(id INTEGER)

statement ok
ALTER TABLE dl3.t SET (parquet_compression = 'gzip')

statement ok
ALTER TABLE dl4.t RESET (parquet_compression)

query I
SELECT count(*) FROM meta3.ducklake_metadata WHERE key = 'parquet_compression'
----
0
