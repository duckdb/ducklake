# name: test/sql/macros/test_macro_param_legacy_nested_default.test
# description: nested default values written by older DuckLake versions are rejected with a clear error
# group: [macros]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/macro_legacy_nested_default.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/macro_legacy_nested_default', METADATA_CATALOG 'ducklake_meta')

statement ok
USE ducklake

statement ok
CREATE MACRO m(l := ['x', 'y']) AS (len(l))

# rewrite the row the way older versions stored it - the default's child type is gone
statement ok
UPDATE ducklake_meta.ducklake_macro_parameters SET default_value = '[x, y]', default_value_type = 'list'

statement ok
USE memory

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/macro_legacy_nested_default', METADATA_CATALOG 'ducklake_meta')

# the catalog refuses to load rather than casting to a type with no children
statement error
USE ducklake
----
carries no field information

# the metadata catalog is still reachable, so the row can be repaired in place
statement ok
UPDATE ducklake_meta.ducklake_macro_parameters SET default_value = '[''x'', ''y'']', default_value_type = 'expression'

statement ok
USE ducklake

query I
SELECT m()
----
2
