# name: test/sql/macros/test_roundtrip_default_date_null.test
# description: macro default NULL::DATE must round-trip as SQL NULL
# group: [macros]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/macro_default_null_date.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/macro_default_null_date', METADATA_CATALOG 'ducklake_meta')

statement ok
USE ducklake

statement ok
CREATE MACRO m(d DATE := NULL::DATE) AS (d IS NULL)

query I
SELECT m()
----
true

# the default must survive a fresh attach
statement ok
USE memory

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/macro_default_null_date', METADATA_CATALOG 'ducklake_meta')

statement ok
USE ducklake

query I
SELECT m()
----
true
