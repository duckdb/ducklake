# name: test/sql/macros/test_roundtrip_default_list_literal.test
# description: macro default with a list literal must round-trip
# group: [macros]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/macro_default_list_literal.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/macro_default_list_literal', METADATA_CATALOG 'ducklake_meta')

statement ok
USE ducklake

statement ok
CREATE MACRO m(l VARCHAR[] := ['x', 'y']) AS (len(l))

query I
SELECT m()
----
2

# the default must survive a fresh attach
statement ok
USE memory

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/macro_default_list_literal', METADATA_CATALOG 'ducklake_meta')

statement ok
USE ducklake

query I
SELECT m()
----
2
