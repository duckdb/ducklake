# name: test/sql/macros/test_roundtrip_param_list.test
# description: a macro parameter with a nested (LIST) type must round-trip, even without a default
# group: [macros]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/macro_default_list_param.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/macro_default_list_param', METADATA_CATALOG 'ducklake_meta')

statement ok
USE ducklake

statement ok
CREATE MACRO m(l VARCHAR[]) AS (len(l))

# the parameter type is stored as dialect SQL, so the child type survives
query IIII
SELECT parameter_name, parameter_type, default_value, default_value_type FROM ducklake_meta.ducklake_macro_parameters
----
l	VARCHAR[]	NULL	unknown

query I
SELECT m(['x', 'y'])
----
2

statement ok
USE memory

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/macro_default_list_param', METADATA_CATALOG 'ducklake_meta')

statement ok
USE ducklake

query I
SELECT m(['x', 'y'])
----
2
