# name: test/sql/macros/time_zone_macro_default.test
# description: a macro parameter default of a time zone type keeps the instant of the session that created the macro
# group: [macros]

require ducklake

require parquet

require icu

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS l (DATA_PATH '{DATA_PATH}/time_zone_macro_default')

statement ok
SET TimeZone = 'Asia/Tokyo'

# a macro parameter default is folded when the macro is created, as in DuckDB, so it keeps that instant
statement ok
CREATE MACRO l.at_time(x := TIMESTAMPTZ '2024-01-01 00:00:00') AS x

statement ok
DETACH l

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS l (DATA_PATH '{DATA_PATH}/time_zone_macro_default')

query I
SELECT l.at_time() = TIMESTAMPTZ '2023-12-31 15:00:00+00'
----
true

statement ok
SET TimeZone = 'America/Los_Angeles'

query I
SELECT l.at_time() = TIMESTAMPTZ '2023-12-31 15:00:00+00'
----
true
