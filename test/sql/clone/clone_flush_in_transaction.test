# name: test/sql/clone/clone_flush_in_transaction.test
# description: a flush of the source after a clone in the same transaction fails the commit instead of joining the copy
# group: [clone]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/clone_flush_in_transaction', DATA_INLINING_ROW_LIMIT 10, METADATA_CATALOG 'meta')

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
COPY (SELECT 1 AS i) TO '{DATA_PATH}/clone_flush_in_transaction_registered.parquet'

statement ok
CALL ducklake_add_data_files('dl', 't', '{DATA_PATH}/clone_flush_in_transaction_registered.parquet')

statement ok
INSERT INTO dl.t VALUES (2)

statement ok
SET VARIABLE at_two = (SELECT max(snapshot_id) FROM dl.snapshots())

statement ok
INSERT INTO dl.t VALUES (3)

statement ok
BEGIN

statement ok
CALL ducklake_clone_table('dl', 't', 'c', version => getvariable('at_two'))

statement ok
CALL ducklake_flush_inlined_data('dl', table_name => 't')

statement error
COMMIT
----
was changed by it after the clone

query I
SELECT list(i ORDER BY i) FROM dl.t
----
[1, 2, 3]

statement ok
CALL ducklake_clone_table('dl', 't', 'c', version => getvariable('at_two'))

query I
SELECT list(i ORDER BY i) FROM dl.c
----
[1, 2]

query I
SELECT count(*) - count(DISTINCT data_file_id) FROM meta.ducklake_data_file
----
0
