# name: test/sql/clone/clone_at_version.test
# description: a clone at an older snapshot has the state of the source at that snapshot
# group: [clone]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/clone_at_version', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

statement ok
SET VARIABLE at_insert = (SELECT max(snapshot_id) FROM dl.snapshots())

# a later insert and a later delete are not part of the state at the snapshot
statement ok
INSERT INTO dl.t VALUES (4)

statement ok
DELETE FROM dl.t WHERE i = 2

statement ok
CALL ducklake_clone_table('dl', 't', 'c', version => getvariable('at_insert'))

query I
SELECT list(i ORDER BY i) FROM dl.c
----
[1, 2, 3]

query I
SELECT list(i ORDER BY i) FROM dl.t
----
[1, 3, 4]

# the delete file of the later delete is not copied, the clone deletes on its own
statement ok
DELETE FROM dl.c WHERE i = 3

query I
SELECT list(i ORDER BY i) FROM dl.c
----
[1, 2]

query I
SELECT list(i ORDER BY i) FROM dl.t
----
[1, 3, 4]

# a timestamp selects the latest snapshot at or before it
statement ok
SET VARIABLE insert_time = (SELECT snapshot_time FROM dl.snapshots() WHERE snapshot_id = getvariable('at_insert'))

statement ok
CALL ducklake_clone_table('dl', 't', 'd', timestamp => getvariable('insert_time'))

query I
SELECT list(i ORDER BY i) FROM dl.d
----
[1, 2, 3]

statement error
CALL ducklake_clone_table('dl', 't', 'e', version => 1, timestamp => NOW())
----
either version or timestamp

# the clone is not visible before it was created
statement error
SELECT count(*) FROM dl.c AT (VERSION => getvariable('at_insert'))
----
does not exist at version
