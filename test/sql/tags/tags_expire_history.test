# name: test/sql/tags/tags_expire_history.test
# description: Tagged snapshots stay readable after expiry, cleanup and orphan deletion across a varied history
# group: [tags]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/tags_expire_history', DATA_INLINING_ROW_LIMIT 2)

statement ok
CREATE TABLE lake.t (id INTEGER, v VARCHAR)

statement ok
INSERT INTO lake.t SELECT range, 'a' || range FROM range(4)

statement ok
CALL ducklake_create_tag('lake', 'files')

statement ok
INSERT INTO lake.t VALUES (10, 'inl')

statement ok
DELETE FROM lake.t WHERE id = 0

statement ok
CALL ducklake_create_tag('lake', 'mixed')

statement ok
ALTER TABLE lake.t RENAME COLUMN v TO w

statement ok
CREATE TABLE lake.u AS SELECT 1 AS x

statement ok
CALL ducklake_create_tag('lake', 'renamed')

statement ok
DROP TABLE lake.u

# two files that a tagged snapshot sees, merged before expiry
statement ok
INSERT INTO lake.t VALUES (21, 'p'), (22, 'q'), (23, 'r')

statement ok
INSERT INTO lake.t VALUES (24, 's'), (25, 't'), (26, 'u')

statement ok
CALL ducklake_create_tag('lake', 'merged')

# a file that only untagged snapshots see
statement ok
INSERT INTO lake.t VALUES (30, 'x'), (31, 'y'), (32, 'z')

statement ok
DELETE FROM lake.t WHERE id >= 30

statement ok
CALL ducklake_flush_inlined_data('lake')

query II
SELECT files_processed, files_created FROM ducklake_merge_adjacent_files('lake')
----
2	1

statement ok
CALL ducklake_rewrite_data_files('lake', 't', delete_threshold => 0)

statement ok
INSERT INTO lake.t VALUES (20, 'late')

query II
SELECT files_processed, files_created FROM ducklake_merge_adjacent_files('lake')
----
2	1

query I
SELECT count(*) > 0 FROM ducklake_expire_snapshots('lake', older_than => now())
----
true

query I
SELECT count(*) FROM ducklake_cleanup_old_files('lake', cleanup_all => true)
----
5

statement ok
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true)

query II
SELECT list(id ORDER BY id), list(v ORDER BY id) FROM lake.t AT (VERSION => 'files')
----
[0, 1, 2, 3]	[a0, a1, a2, a3]

query II
SELECT list(id ORDER BY id), list(v ORDER BY id) FROM lake.t AT (VERSION => 'mixed')
----
[1, 2, 3, 10]	[a1, a2, a3, inl]

query II
SELECT list(id ORDER BY id), list(w ORDER BY id) FROM lake.t AT (VERSION => 'renamed')
----
[1, 2, 3, 10]	[a1, a2, a3, inl]

query I
SELECT list(x) FROM lake.u AT (VERSION => 'renamed')
----
[1]

query II
SELECT list(id ORDER BY id), list(w ORDER BY id) FROM lake.t AT (VERSION => 'merged')
----
[1, 2, 3, 10, 21, 22, 23, 24, 25, 26]	[a1, a2, a3, inl, p, q, r, s, t, u]

query I
SELECT list(change_type || ' ' || id ORDER BY change_type, id) FROM lake.table_changes('t', 'files', 'renamed')
----
[delete 0, insert 0, insert 1, insert 2, insert 3, insert 10]

query I
SELECT list(id ORDER BY id) FROM lake.t
----
[1, 2, 3, 10, 20, 21, 22, 23, 24, 25, 26]
