# name: test/sql/tags/tags_expire_files.test
# description: a tagged snapshot keeps the data file that only it still references through expiry and cleanup
# group: [tags]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/tags_expire_files_files', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2)

statement ok
CALL ducklake_create_tag('dl', 'before_delete', version => 2)

# deleting every row ends the file of snapshot 2
statement ok
DELETE FROM dl.t

statement ok
INSERT INTO dl.t VALUES (3)

query II
SELECT snapshot_id, changes FROM ducklake_snapshots('dl') ORDER BY snapshot_id
----
0	{schemas_created=[main]}
1	{tables_created=[main.t]}
2	{tables_inserted_into=[1]}
3	{tags_created=[before_delete]}
4	{tables_deleted_from=[1]}
5	{tables_inserted_into=[1]}

query I
SELECT COUNT(*) FROM glob('{DATA_PATH}/tags_expire_files_files/**/*.parquet')
----
2

# the tag keeps snapshot 2 out of the expiry
query I
SELECT snapshot_id FROM ducklake_expire_snapshots('dl', versions => [1, 2, 3, 4]) ORDER BY snapshot_id
----
1
3
4

statement ok
CALL ducklake_cleanup_old_files('dl', cleanup_all => true)

query I
SELECT COUNT(*) FROM glob('{DATA_PATH}/tags_expire_files_files/**/*.parquet')
----
2

query I
SELECT i FROM dl.t AT (VERSION => 'before_delete') ORDER BY i
----
1
2

# without the tag the file is expired and removed
statement ok
CALL ducklake_drop_tag('dl', 'before_delete')

statement ok
CALL ducklake_expire_snapshots('dl', versions => [2])

statement ok
CALL ducklake_cleanup_old_files('dl', cleanup_all => true)

query I
SELECT COUNT(*) FROM glob('{DATA_PATH}/tags_expire_files_files/**/*.parquet')
----
1

query I
SELECT i FROM dl.t ORDER BY i
----
3
