# name: test/sql/cleanup/expire_cleanup_concurrent_commit.test
# description: A transaction that expires snapshots fails to commit after a concurrent commit, and keeps the files
# group: [cleanup]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl
(DATA_PATH '{DATA_PATH}/expire_cleanup_concurrent_commit', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DELETE FROM dl.t

statement ok
CREATE TABLE dl.u (i INTEGER)

# with a cleanup, a retry of the commit would restore the snapshot without its files
statement ok a
BEGIN

statement ok a
CALL ducklake_expire_snapshots('dl', versions => [1])

statement ok a
CALL ducklake_cleanup_old_files('dl', cleanup_all => true)

statement ok a
INSERT INTO dl.t VALUES (10)

statement ok b
INSERT INTO dl.u VALUES (20)

statement error a
COMMIT
----
Transaction conflict

query II
SELECT (SELECT i FROM dl.t AT (VERSION => 1)), (SELECT count(*) FROM dl.snapshots() WHERE snapshot_id = 1)
----
42	1

# without a cleanup, a retry would undo the expiry
statement ok a
BEGIN

statement ok a
CALL ducklake_expire_snapshots('dl', versions => [1])

statement ok a
INSERT INTO dl.t VALUES (10)

statement ok b
INSERT INTO dl.u VALUES (30)

statement error a
COMMIT
----
Transaction conflict

query II
SELECT (SELECT sum(i) FROM dl.t), (SELECT sum(i) FROM dl.u)
----
NULL	50
