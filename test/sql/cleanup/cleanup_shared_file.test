# name: test/sql/cleanup/cleanup_shared_file.test
# description: The cleanup of old files keeps a file that another data file of the catalog still uses
# group: [cleanup]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/cleanup_shared_file', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t (i INTEGER);

statement ok
CREATE TABLE ducklake.u (i INTEGER);

statement ok
COPY (SELECT i::INTEGER AS i FROM range(10) r(i)) TO '{DATA_PATH}/cleanup_shared_file_x.parquet'

statement ok
CALL ducklake_add_data_files('ducklake', 't', '{DATA_PATH}/cleanup_shared_file_x.parquet')

statement ok
CALL ducklake_add_data_files('ducklake', 'u', '{DATA_PATH}/cleanup_shared_file_x.parquet')

statement ok
DROP TABLE ducklake.u

statement ok
CALL ducklake_expire_snapshots('ducklake', older_than => now())

statement ok
CALL ducklake_cleanup_old_files('ducklake', cleanup_all => true)

query II
SELECT count(*), sum(i) FROM ducklake.t
----
10	45

# a file that an open transaction adds to a table
statement ok
COPY (SELECT i::INTEGER AS i FROM range(3) r(i)) TO '{DATA_PATH}/cleanup_shared_file_y.parquet'

statement ok
CREATE TABLE ducklake.y_old (i INTEGER);

statement ok
CALL ducklake_add_data_files('ducklake', 'y_old', '{DATA_PATH}/cleanup_shared_file_y.parquet')

statement ok
DROP TABLE ducklake.y_old

statement ok
CALL ducklake_expire_snapshots('ducklake', older_than => now())

statement ok con1
BEGIN

statement ok con1
CALL ducklake_add_data_files('ducklake', 't', '{DATA_PATH}/cleanup_shared_file_y.parquet')

statement ok
CALL ducklake_cleanup_old_files('ducklake', cleanup_all => true)

statement ok con1
COMMIT

query II
SELECT count(*), sum(i) FROM ducklake.t
----
13	48

# a file with the same name in another directory is another file
statement ok
COPY (SELECT * FROM (VALUES (1, 'a'), (2, 'b')) v(i, d)) TO '{DATA_PATH}/cleanup_shared_file_dirs' (FORMAT PARQUET, PARTITION_BY (d))

statement ok
CALL ducklake_add_data_files('ducklake', 't', '{DATA_PATH}/cleanup_shared_file_dirs/d=a/data_0.parquet')

statement ok
CREATE TABLE ducklake.b_old (i INTEGER);

statement ok
CALL ducklake_add_data_files('ducklake', 'b_old', '{DATA_PATH}/cleanup_shared_file_dirs/d=b/data_0.parquet')

statement ok
DROP TABLE ducklake.b_old

statement ok
CALL ducklake_expire_snapshots('ducklake', older_than => now())

statement ok
CALL ducklake_cleanup_old_files('ducklake', cleanup_all => true)

# the checks glob patterns, since a remote glob returns a literal path even when no file has it
query II
SELECT count(*), bool_and(parse_path(file)[-2] = 'd=a') FROM glob('{DATA_PATH}/cleanup_shared_file_dirs/*/data_0.parquet')
----
1	true

# a data file that DuckLake wrote for one table and that another table uses
statement ok
CREATE TABLE ducklake.v (i INTEGER);

statement ok
INSERT INTO ducklake.v SELECT i::INTEGER FROM range(5) r(i)

statement ok
CREATE TABLE ducklake.w (i INTEGER);

statement ok
SET VARIABLE v_file = (SELECT data_file FROM ducklake_list_files('ducklake', 'v'))

statement ok
CALL ducklake_add_data_files('ducklake', 'w', getvariable('v_file'))

statement ok
INSERT INTO ducklake.w VALUES (100)

# the compaction of w replaces the file of v in w
statement ok
CALL ducklake_merge_adjacent_files('ducklake', 'w')

statement ok
CALL ducklake_expire_snapshots('ducklake', older_than => now())

statement ok
CALL ducklake_cleanup_old_files('ducklake', cleanup_all => true)

query II
SELECT (SELECT sum(i) FROM ducklake.v), (SELECT sum(i) FROM ducklake.w)
----
10	110

# once no table uses the files, the cleanup deletes them
statement ok
DROP TABLE ducklake.t

statement ok
DROP TABLE ducklake.v

statement ok
CALL ducklake_expire_snapshots('ducklake', older_than => now())

statement ok
CALL ducklake_cleanup_old_files('ducklake', cleanup_all => true)

query II
SELECT (SELECT count(*) FROM glob('{DATA_PATH}/cleanup_shared_file_x*.parquet')), (SELECT count(*) FROM glob('{DATA_PATH}/cleanup_shared_file/**') WHERE parse_filename(file) = parse_filename(getvariable('v_file')))
----
0	0

query I
SELECT count(*) FROM __ducklake_metadata_ducklake.ducklake_files_scheduled_for_deletion
----
0
