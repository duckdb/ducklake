# name: test/sql/cleanup/expire_cleanup_in_transaction.test
# description: A cleanup does not delete the files of snapshots that its transaction expired
# group: [cleanup]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl
(DATA_PATH '{DATA_PATH}/expire_cleanup_in_transaction', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DELETE FROM dl.t

# a rollback of the expiry would keep the snapshot without its files
statement ok
BEGIN

statement ok
CALL ducklake_expire_snapshots('dl', versions => [1])

statement error
CALL ducklake_cleanup_old_files('dl', cleanup_all => true)
----
cannot delete files in a transaction that expired snapshots

statement ok
ROLLBACK

query I
SELECT i FROM dl.t AT (VERSION => 1)
----
42

# a dry run lists the files, and a cleanup after the expiry commits deletes them
statement ok
BEGIN

statement ok
CALL ducklake_expire_snapshots('dl', versions => [1])

query I
SELECT count(*) FROM ducklake_cleanup_old_files('dl', cleanup_all => true, dry_run => true)
----
1

statement ok
COMMIT

query I
SELECT count(*) FROM ducklake_cleanup_old_files('dl', cleanup_all => true)
----
1

query II
SELECT (SELECT count(*) FROM glob('{DATA_PATH}/expire_cleanup_in_transaction/main/t/*.parquet')),
       (SELECT count(*) FROM dl.snapshots() WHERE snapshot_id = 1)
----
0	0
