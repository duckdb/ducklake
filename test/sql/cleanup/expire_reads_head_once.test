# name: test/sql/cleanup/expire_reads_head_once.test
# description: an expiry reads the head snapshot and the snapshot tags once and its commit reuses the head
# group: [cleanup]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files')

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
INSERT INTO dl.t VALUES (2)

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata', storage => 'memory')

statement ok
CALL ducklake_expire_snapshots('dl', versions => [1])

statement ok
CALL disable_logging()

# the commit reuses the head the expiry read
query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%ducklake_metadata WHERE key = %version%), branch_id%'
----
1

# the protected snapshots and the expired tags come from one read of the tags
query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%tag.tag_name, tag.snapshot_id%'
----
1

query I
SELECT snapshot_id FROM ducklake_snapshots('dl') ORDER BY snapshot_id
----
0
2
3
4
