# name: test/sql/cleanup/cleanup_shared_file_null_paths.test
# description: The cleanup of old files keeps a shared file of a table whose schema and table have no stored path
# group: [cleanup]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/cleanup_shared_file_null_paths', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t AS SELECT 42 AS i

statement ok
CREATE TABLE ducklake.u (i INTEGER)

statement ok
SET VARIABLE shared_file = (SELECT data_file FROM ducklake_list_files('ducklake', 't'))

statement ok
CALL ducklake_add_data_files('ducklake', 'u', getvariable('shared_file'))

statement ok
DROP TABLE ducklake.u

statement ok
CALL ducklake_expire_snapshots('ducklake', older_than => now())

# without stored schema and table paths, the file of t is found from the data path
statement ok
UPDATE __ducklake_metadata_ducklake.ducklake_schema SET path = NULL, path_is_relative = NULL

statement ok
UPDATE __ducklake_metadata_ducklake.ducklake_table SET path = NULL, path_is_relative = NULL

statement ok
UPDATE __ducklake_metadata_ducklake.ducklake_data_file SET path = 'main/t/' || path WHERE path_is_relative

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/cleanup_shared_file_null_paths')

query I
SELECT sum(i) FROM ducklake.t
----
42

statement ok
CALL ducklake_cleanup_old_files('ducklake', cleanup_all => true)

query I
SELECT sum(i) FROM ducklake.t
----
42

query I
SELECT count(*) FROM __ducklake_metadata_ducklake.ducklake_files_scheduled_for_deletion
----
1
