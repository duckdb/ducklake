# name: test/sql/cleanup/expire_restarted_commit_cleanup.test
# description: a commit restarted by the snapshot key of a concurrent commit reselects its expiry and cleans up after it
# group: [cleanup]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DELETE FROM dl.t

statement ok con1
BEGIN

statement ok con1
CALL ducklake_expire_snapshots('dl', versions => [1])

# a branch snapshot with the id con1 computed does not disturb it
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 2)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 3, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 2 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (3, NULL, NULL, NULL, NULL, 1)

# a commit of main takes that id, so the snapshot key restarts the commit of con1
statement ok
CREATE TABLE dl.u (j INTEGER)

query I
SELECT id FROM dl.current_snapshot()
----
3

statement ok con1
COMMIT

query I
SELECT count(*) FROM meta.ducklake_snapshot WHERE snapshot_id = 1
----
0

# the restarted commit reran the cleanup, so the expired file left no metadata behind
query II
SELECT (SELECT count(*) FROM meta.ducklake_data_file),
       (SELECT count(*) FROM meta.ducklake_files_scheduled_for_deletion)
----
0	1

query I
SELECT id FROM dl.current_snapshot()
----
4

query I
SELECT list(snapshot_id ORDER BY snapshot_id) FROM dl.snapshots()
----
[0, 2, 3, 4]
