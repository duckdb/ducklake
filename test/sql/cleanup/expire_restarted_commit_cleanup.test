# name: test/sql/cleanup/expire_restarted_commit_cleanup.test
# description: a commit restarted over a branch snapshot gap reselects its expiry and cleans up the expired metadata
# group: [cleanup]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DELETE FROM dl.t

statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 2, 2, NULL)

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 100, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 2

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (100, NULL, NULL, NULL, NULL)

statement ok con1
BEGIN

statement ok con1
CALL ducklake_expire_snapshots('dl', versions => [1])

# the tag routes the commit through the conflict check and the branch snapshot gap restarts it
statement ok con1
CALL ducklake_create_tag('dl', 'keep', version => 2)

statement ok con1
COMMIT

query I
SELECT count(*) FROM meta.ducklake_snapshot WHERE snapshot_id = 1
----
0

# the restarted commit reran the cleanup, so the expired file left no metadata behind
query II
SELECT (SELECT count(*) FROM meta.ducklake_data_file),
       (SELECT count(*) FROM meta.ducklake_files_scheduled_for_deletion)
----
0	1

query I
SELECT id FROM dl.current_snapshot()
----
101

query I
SELECT count(*) FROM ducklake_tags('dl') WHERE tag_name = 'keep'
----
1
