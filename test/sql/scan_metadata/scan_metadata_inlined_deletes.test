# name: test/sql/scan_metadata/scan_metadata_inlined_deletes.test
# description: The scan metadata of a data file lists the deletes that are inlined in the catalog
# group: [scan_metadata]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/scan_metadata_inlined_deletes', DATA_INLINING_ROW_LIMIT 10)

statement ok
CALL lake.set_option('write_deletion_vectors', 'false')

statement ok
CREATE TABLE lake.t AS SELECT range a FROM range(50)

statement ok
CREATE MACRO data_file_options() AS TABLE
SELECT file_options o FROM ducklake_scan_metadata('lake', 't') WHERE file_options['inlined_data'] IS NULL

statement ok
DELETE FROM lake.t WHERE a IN (7, 3)

statement ok
SET VARIABLE first_delete = (SELECT id FROM lake.current_snapshot())

# a file whose only deletes are inlined has deletes
query IIIII
SELECT o['required_options'].value, o['has_deletes'].value, o['inlined_file_deletions'].type,
       o['inlined_file_deletions'].value, o['delete_file']
FROM data_file_options()
----
[inlined_file_deletions]	true	UBIGINT[]	[3, 7]	NULL

statement ok
DELETE FROM lake.t WHERE a = 1

query I
SELECT o['inlined_file_deletions'].value FROM data_file_options()
----
[1, 3, 7]

# only the deletes that the snapshot of the scan sees
query I
SELECT file_options['inlined_file_deletions'].value
FROM ducklake_scan_metadata('lake', 't', snapshot_version => getvariable('first_delete'))
WHERE file_options['inlined_data'] IS NULL
----
[3, 7]

query II
SELECT file_options['required_options'].value, file_options['has_deletes']
FROM ducklake_scan_metadata('lake', 't', snapshot_version => getvariable('first_delete') - 1)
WHERE file_options['inlined_data'] IS NULL
----
[]	NULL

# the deletes of the transaction are included, unless the scan travels in time
statement ok
BEGIN

statement ok
DELETE FROM lake.t WHERE a = 40

query I
SELECT o['inlined_file_deletions'].value FROM data_file_options()
----
[1, 3, 7, 40]

query I
SELECT file_options['inlined_file_deletions'].value
FROM ducklake_scan_metadata('lake', 't', snapshot_version => getvariable('first_delete') + 1)
WHERE file_options['inlined_data'] IS NULL
----
[1, 3, 7]

statement ok
ROLLBACK

# a delete file next to the inlined deletes
statement ok
DELETE FROM lake.t WHERE a >= 20 AND a < 35

query IIIII
SELECT o['required_options'].value, o['has_deletes'].value, o['inlined_file_deletions'].value,
       o['delete_file'].value LIKE '%-delete.parquet',
       o['delete_snapshot_filter'].value::UBIGINT = (SELECT id FROM lake.current_snapshot())
FROM data_file_options()
----
[delete_file, inlined_file_deletions]	true	[1, 3, 7]	true	true

query I
SELECT count(*) FROM lake.t
----
32
