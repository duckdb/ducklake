# name: test/sql/scan_metadata/scan_metadata_deletion_vector.test
# description: The scan metadata of a data file describes its deletion vector
# group: [scan_metadata]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/scan_metadata_deletion_vector', DATA_INLINING_ROW_LIMIT 0)

statement ok
CALL lake.set_option('write_deletion_vectors', 'true')

statement ok
CREATE TABLE lake.t AS SELECT range a FROM range(50)

statement ok
DELETE FROM lake.t WHERE a < 5

query IIIIII
SELECT o['required_options'].value,
       o['has_deletes'].value,
       o['delete_file_format'].value,
       o['delete_file'].value = l.delete_file,
       o['delete_file_size'].value::UBIGINT = l.delete_file_size_bytes,
       o['delete_snapshot_filter'].value::UBIGINT = (SELECT id FROM lake.current_snapshot())
FROM (SELECT file_options o FROM ducklake_scan_metadata('lake', 't')), ducklake_list_files('lake', 't') l
----
[delete_file]	true	puffin	true	true	true
