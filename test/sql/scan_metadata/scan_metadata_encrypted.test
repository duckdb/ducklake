# name: test/sql/scan_metadata/scan_metadata_encrypted.test
# description: The scan metadata of an encrypted data file has the key of its delete file
# group: [scan_metadata]

require ducklake

require parquet

require httpfs

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/scan_metadata_encrypted', ENCRYPTED, DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t AS SELECT range a FROM range(50)

statement ok
DELETE FROM lake.t WHERE a < 5

query IIII
SELECT o['required_options'].value, o['encryption_key'].type, o['delete_file_encryption_key'].type,
       o['delete_file_encryption_key'].value != o['encryption_key'].value
FROM (SELECT file_options o FROM ducklake_scan_metadata('lake', 't'))
----
[delete_file]	BLOB	BLOB	true
