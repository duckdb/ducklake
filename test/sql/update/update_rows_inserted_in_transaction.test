# name: test/sql/update/update_rows_inserted_in_transaction.test
# description: rows updated in the transaction that inserted them get fresh row ids at commit
# group: [update]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/update_rows_inserted_in_transaction', DATA_INLINING_ROW_LIMIT 0)

# two transactions each insert and update a row
statement ok
CREATE TABLE ducklake.t (id BIGINT, v INTEGER)

statement ok
BEGIN

statement ok
INSERT INTO ducklake.t VALUES (1, 10), (2, 20)

query I
UPDATE ducklake.t SET v = v + 1 WHERE id = 1
----
1

statement ok
COMMIT

statement ok
BEGIN

statement ok
INSERT INTO ducklake.t VALUES (3, 30), (4, 40)

statement ok
UPDATE ducklake.t SET v = v + 1 WHERE id = 3

statement ok
COMMIT

query III
SELECT count(*), count(DISTINCT rowid), max(rowid) < 1000000000000000000 FROM ducklake.t
----
4	4	true

statement ok
SET VARIABLE before_update = (SELECT max(snapshot_id) FROM ducklake.snapshots())

statement ok
UPDATE ducklake.t SET v = 0 WHERE id IN (1, 3)

query II
SELECT change_type, count(*) FROM ducklake_table_changes('ducklake', 'main', 't', getvariable('before_update') + 1, getvariable('before_update') + 1) GROUP BY ALL ORDER BY ALL
----
update_postimage	2
update_preimage	2

statement ok
DELETE FROM ducklake.t WHERE rowid = (SELECT rowid FROM ducklake.t WHERE id = 3)

query II
SELECT id, v FROM ducklake.t ORDER BY id
----
1	0
2	20
4	40

# one update of committed rows and rows inserted in the same transaction, twice
statement ok
CREATE TABLE ducklake.mixed (id BIGINT, v INTEGER)

statement ok
INSERT INTO ducklake.mixed SELECT i, 0 FROM range(5) t(i)

statement ok
SET VARIABLE committed_row_ids = (SELECT list(rowid ORDER BY id) FROM ducklake.mixed)

statement ok
BEGIN

statement ok
INSERT INTO ducklake.mixed SELECT i, 0 FROM range(5, 10) t(i)

query I
UPDATE ducklake.mixed SET v = v + 1
----
10

query I
UPDATE ducklake.mixed SET v = v + 1 WHERE id % 2 = 0
----
5

statement ok
COMMIT

query IIII
SELECT count(*), count(DISTINCT rowid), max(rowid) < 1000000000000000000, sum(v) FROM ducklake.mixed
----
10	10	true	15

query I
SELECT list(rowid ORDER BY id) = getvariable('committed_row_ids') FROM ducklake.mixed WHERE id < 5
----
true

# a partitioned table
statement ok
CREATE TABLE ducklake.part (p INTEGER, id BIGINT, v INTEGER)

statement ok
ALTER TABLE ducklake.part SET PARTITIONED BY (p)

statement ok
INSERT INTO ducklake.part SELECT i % 2, i, 0 FROM range(4) t(i)

statement ok
BEGIN

statement ok
INSERT INTO ducklake.part SELECT i % 2, i, 0 FROM range(4, 8) t(i)

statement ok
UPDATE ducklake.part SET v = 1 WHERE id % 4 = 0

statement ok
COMMIT

query IIII
SELECT count(*), count(DISTINCT rowid), max(rowid) < 1000000000000000000, sum(v) FROM ducklake.part
----
8	8	true	2

# a MERGE update of rows inserted in the same transaction
statement ok
CREATE TABLE ducklake.m (id BIGINT, v INTEGER)

statement ok
BEGIN

statement ok
INSERT INTO ducklake.m VALUES (1, 10), (2, 20)

query I
MERGE INTO ducklake.m USING (VALUES (1), (3)) s(id) ON m.id = s.id
    WHEN MATCHED THEN UPDATE SET v = v + 1
    WHEN NOT MATCHED THEN INSERT VALUES (s.id, 0)
----
2

statement ok
COMMIT

query II
SELECT id, v FROM ducklake.m ORDER BY id
----
1	11
2	20
3	0
