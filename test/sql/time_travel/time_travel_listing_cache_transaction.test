# name: test/sql/time_travel/time_travel_listing_cache_transaction.test
# description: a transaction that began before a concurrent compaction lists its own view and leaves the shared cache alone
# group: [time_travel]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t SELECT range FROM range(100)

statement ok
INSERT INTO dl.t SELECT range FROM range(100, 200)

statement ok
INSERT INTO dl.t SELECT range FROM range(200, 300)

# the filtered read pins the view of con1 before the compaction of con2 moves the head
statement ok con1
BEGIN

query I con1
SELECT sum(i) FROM dl.t AT (VERSION => 3) WHERE i < 150
----
11175

statement ok con2
CALL ducklake_merge_adjacent_files('dl')

# con2 caches the merged listing under the moved heads
query I con2
SELECT count(*) FROM ducklake_list_files('dl', 't', snapshot_version => 3)
----
1

# con1 still reads under the old heads, so it lists its own files instead of taking the entry of con2
query I con1
SELECT count(*) FROM ducklake_list_files('dl', 't', snapshot_version => 3)
----
2

# a listing nobody read under the moved heads, which con1 may not store there
query I con1
SELECT count(*) FROM dl.t AT (VERSION => 2) WHERE i < 50
----
50

statement ok con1
COMMIT

query I
SELECT count(*) FROM ducklake_list_files('dl', 't', snapshot_version => 3)
----
1

# the listing con1 read under its old heads is not in the cache, so a fresh read lists again
statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata', storage => 'memory')

query I
SELECT count(*) FROM dl.t AT (VERSION => 2) WHERE i < 50
----
50

statement ok
CALL disable_logging()

query I
SELECT CASE WHEN (SELECT catalog_type FROM ducklake_settings('dl')) IN ('duckdb', 'sqlite', 'postgres') THEN
    (SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
     WHERE query LIKE '%data.partial^_max, data.mapping^_id%' ESCAPE '^')
    ELSE 1 END
----
1
