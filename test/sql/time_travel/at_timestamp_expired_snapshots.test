# name: test/sql/time_travel/at_timestamp_expired_snapshots.test
# description: Time travel by timestamp refuses times before the newest gap that expired snapshots left
# group: [time_travel]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/at_timestamp_expired_snapshots.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS l (DATA_PATH '{DATA_PATH}/at_timestamp_expired_snapshots', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE l.t(a INT)

statement ok
INSERT INTO l.t VALUES (1)

statement ok
INSERT INTO l.t VALUES (2)

statement ok
INSERT INTO l.t VALUES (3)

statement ok
SET VARIABLE t1 = (SELECT snapshot_time FROM l.snapshots() WHERE snapshot_id = 1)

statement ok
SET VARIABLE t3 = (SELECT snapshot_time FROM l.snapshots() WHERE snapshot_id = 3)

statement ok
SET VARIABLE t4 = (SELECT snapshot_time FROM l.snapshots() WHERE snapshot_id = 4)

query I
SELECT list(a ORDER BY a) FROM l.t AT (TIMESTAMP => getvariable('t3'))
----
[1, 2]

# a timestamp resolved earlier in the transaction is checked again after the transaction expires snapshots
statement ok
BEGIN

query I
SELECT count(*) FROM l.t AT (TIMESTAMP => getvariable('t1'))
----
0

statement ok
CALL ducklake_expire_snapshots('l', versions => [2, 3])

# a catalog that deletes the expired snapshots when the transaction commits does not see the gap yet
statement maybe
SELECT count(*) FROM l.t AT (TIMESTAMP => getvariable('t1'))
----
Cannot time travel to timestamp

# the rollback undoes the expiry, which took no snapshot id
statement ok
ROLLBACK

query I
SELECT list(snapshot_id) FROM l.snapshots()
----
[0, 1, 2, 3, 4]

# snapshots 2 and 3 expire, snapshot 4 is the first one after the gap
statement ok
CALL ducklake_expire_snapshots('l', versions => [2, 3])

query I
SELECT list(snapshot_id) FROM l.snapshots()
----
[0, 1, 4, 5]

# the snapshot current at the time of snapshot 3 is gone, so the time cannot be resolved
statement error
SELECT * FROM l.t AT (TIMESTAMP => getvariable('t3'))
----
snapshots 2 to 3 were expired

# a time at which the remaining snapshot 1 was current is refused as well, the commit times of the gap are gone
statement error
SELECT * FROM l.t AT (TIMESTAMP => getvariable('t1'))
----
Cannot time travel to timestamp

# from the first snapshot after the gap on, time travel by timestamp works
query I
SELECT list(a ORDER BY a) FROM l.t AT (TIMESTAMP => getvariable('t4'))
----
[1, 2, 3]

query I
SELECT list(a ORDER BY a) FROM l.t AT (TIMESTAMP => now())
----
[1, 2, 3]

# travel by version still reaches every remaining snapshot, the table was created in snapshot 1 and is empty there
query I
SELECT count(*) FROM l.t AT (VERSION => 1)
----
0

query I
SELECT list(a ORDER BY a) FROM l.t AT (VERSION => 4)
----
[1, 2, 3]

statement error
SELECT * FROM l.t AT (VERSION => 3)
----
No snapshot found at version 3

# the same for the snapshot of an attach
statement ok
DETACH l

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS l (SNAPSHOT_TIME getvariable('t3'))
----
snapshots 2 to 3 were expired

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS l (SNAPSHOT_TIME getvariable('t4'))

query I
SELECT list(a ORDER BY a) FROM l.t
----
[1, 2, 3]

statement ok
DETACH l

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS l (DATA_INLINING_ROW_LIMIT 0)

# the files of a snapshot are listed by the same rule
statement error
SELECT * FROM ducklake_list_files('l', 't', snapshot_time => getvariable('t3'))
----
snapshots 2 to 3 were expired

query I
SELECT count(*) FROM ducklake_list_files('l', 't', snapshot_time => getvariable('t4'))
----
3

# the end of a change feed keeps taking the newest remaining snapshot at or before its timestamp, snapshot 1 here
query I
SELECT count(*) FROM ducklake_table_changes('l', 'main', 't', getvariable('t1'), getvariable('t3'))
----
0

query II
SELECT snapshot_id, a FROM ducklake_table_changes('l', 'main', 't', getvariable('t1'), getvariable('t4')) ORDER BY ALL
----
2	1
3	2
4	3

# snapshots expired at the start of the history leave no gap, times before the remaining ones find no snapshot
statement ok
INSERT INTO l.t VALUES (4)

statement ok
CALL ducklake_expire_snapshots('l', versions => [0, 1])

query I
SELECT list(snapshot_id) FROM l.snapshots()
----
[4, 5, 6, 7]

statement error
SELECT * FROM l.t AT (TIMESTAMP => getvariable('t1'))
----
No snapshot found at timestamp

query I
SELECT list(a ORDER BY a) FROM l.t AT (TIMESTAMP => getvariable('t4'))
----
[1, 2, 3]
