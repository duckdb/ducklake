# name: test/sql/time_travel/time_travel_flushed_snapshot_filter.test
# description: Filtered scans of flushed files where only some files need a snapshot filter
# group: [time_travel]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
SET threads = 1

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/time_travel_flushed_snapshot_filter', DATA_INLINING_ROW_LIMIT 100)

statement ok
CREATE TABLE lake.t (id INTEGER, ts TIMESTAMP, b BOOLEAN)

statement ok
ALTER TABLE lake.t SET PARTITIONED BY (hour(ts))

statement ok
INSERT INTO lake.t VALUES (1, TIMESTAMP '2020-01-01 00:00:00', true), (2, TIMESTAMP '2020-01-01 01:00:00', true)

statement ok
INSERT INTO lake.t VALUES (3, TIMESTAMP '2021-01-01 00:00:00', true)

# the hour=0 file holds rows of snapshots 3 and 4, the hour=1 file only rows of snapshot 3
statement ok
CALL ducklake_flush_inlined_data('lake')

query I
SELECT count(*) FROM lake.t AT (VERSION => 3) WHERE b
----
2

query I
SELECT count(*) FROM lake.t AT (VERSION => 3) WHERE b AND id > 0
----
2

query II
SELECT id, snapshot_id FROM lake.t AT (VERSION => 3) WHERE b ORDER BY id
----
1	3
2	3

query I
SELECT id FROM lake.t AT (VERSION => 3) WHERE b AND snapshot_id <= 3 ORDER BY id
----
1
2

statement ok
INSERT INTO lake.t VALUES (4, TIMESTAMP '2022-01-01 00:00:00', true)

statement ok
CALL ducklake_flush_inlined_data('lake')

# only the hour=0 file needs a lower snapshot filter
query I
SELECT id FROM ducklake_table_insertions('lake', 'main', 't', 4, 7) WHERE b ORDER BY id
----
3
4
