# name: test/sql/rewrite_data_files/rewrite_inlined_after_add_column.test
# description: a rewrite between ADD COLUMN and a flush must not fail on the older inlined table
# group: [rewrite_data_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/rewrite_add_column_files', DATA_INLINING_ROW_LIMIT 100, METADATA_CATALOG 'm')

statement ok
CREATE TABLE dl.t (id INTEGER, v INTEGER);

# over the inlining limit, so there is a parquet file to rewrite
statement ok
INSERT INTO dl.t SELECT i, i*10 FROM range(1,201) tt(i);

# first inlined table: (id, v)
statement ok
INSERT INTO dl.t VALUES (1000, 10000);

statement ok
ALTER TABLE dl.t ADD COLUMN w INTEGER DEFAULT 0;

# second inlined table: (id, v, w)
statement ok
INSERT INTO dl.t VALUES (999999, 8888888, 7);

statement ok
DELETE FROM dl.t WHERE id = 5;

statement ok
CALL ducklake_rewrite_data_files('dl', 't', delete_threshold => 0);

query III
SELECT count(*), sum(v), sum(w) FROM dl.t;
----
201	9099838	7

query I
SELECT count(*) FROM dl.t WHERE id = 5;
----
0
