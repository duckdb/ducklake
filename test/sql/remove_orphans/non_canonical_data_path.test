# name: test/sql/remove_orphans/non_canonical_data_path.test
# description: ducklake_delete_orphaned_files keeps live files under a non-canonical data path
# group: [remove_orphans]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/./non_canonical_data_path', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t(i INTEGER);

statement ok
INSERT INTO ducklake.t SELECT range FROM range(3);

# the delete file is stored relative to the non-canonical data path
statement ok
DELETE FROM ducklake.t WHERE i = 1;

query I
SELECT count(*) FROM ducklake_delete_orphaned_files('ducklake', cleanup_all => true, dry_run => true);
----
0

statement ok
COPY ducklake.t TO '{DATA_PATH}/non_canonical_data_path/main/t/orphan.parquet';

query I
SELECT count(*) FROM ducklake_delete_orphaned_files('ducklake', cleanup_all => true, dry_run => true);
----
1
