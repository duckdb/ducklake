# name: test/sql/remove_orphans/orphan_cleanup_open_transaction.test
# description: orphan cleanup keeps the files written by open transactions
# group: [remove_orphans]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/orphan_cleanup_open_transaction', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t (id INTEGER)

statement ok
INSERT INTO ducklake.t VALUES (10), (20)

# cleanup in the transaction that wrote data, delete and orphan files
statement ok
BEGIN

statement ok
INSERT INTO ducklake.t VALUES (1), (2), (3)

statement ok
DELETE FROM ducklake.t WHERE id = 10 OR id = 3

statement ok
COPY (SELECT 42 AS id) TO '{DATA_PATH}/orphan_cleanup_open_transaction/main/t/orphan.parquet'

query I
SELECT parse_filename(path) FROM ducklake_delete_orphaned_files('ducklake', cleanup_all => true)
----
orphan.parquet

statement ok
COMMIT

query I
SELECT list(id ORDER BY id) FROM ducklake.t
----
[1, 2, 20]

# cleanup from another connection while a transaction is open
statement ok con1
BEGIN

statement ok con1
INSERT INTO ducklake.t VALUES (4)

query I con2
SELECT count(*) FROM ducklake_delete_orphaned_files('ducklake', cleanup_all => true)
----
0

statement ok con1
COMMIT

query I
SELECT list(id ORDER BY id) FROM ducklake.t
----
[1, 2, 4, 20]

# cleanup after a flush or a rewrite in the same transaction
statement ok
CREATE TABLE ducklake.t2 (id INTEGER)

statement ok
CALL ducklake.set_option('data_inlining_row_limit', 10, table_name => 't2')

statement ok
INSERT INTO ducklake.t2 VALUES (1), (2)

statement ok
BEGIN

statement ok
CALL ducklake_flush_inlined_data('ducklake', table_name => 't2')

query I
SELECT count(*) FROM ducklake_delete_orphaned_files('ducklake', cleanup_all => true)
----
0

statement ok
COMMIT

statement ok
BEGIN

statement ok
CALL ducklake_rewrite_data_files('ducklake', 't', delete_threshold => 0.0)

query I
SELECT count(*) FROM ducklake_delete_orphaned_files('ducklake', cleanup_all => true)
----
0

statement ok
COMMIT

query I
SELECT list(id ORDER BY id) FROM ducklake.t2
----
[1, 2]

query I
SELECT list(id ORDER BY id) FROM ducklake.t
----
[1, 2, 4, 20]

# cleanup after adding a file of the data path in the same transaction
statement ok
COPY (SELECT 30 AS id) TO '{DATA_PATH}/orphan_cleanup_open_transaction/main/t/added.parquet'

statement ok
BEGIN

statement ok
CALL ducklake_add_data_files('ducklake', 't', '{DATA_PATH}/orphan_cleanup_open_transaction/main/t/added.parquet')

query I
SELECT count(*) FROM ducklake_delete_orphaned_files('ducklake', cleanup_all => true)
----
0

statement ok
COMMIT

query I
SELECT list(id ORDER BY id) FROM ducklake.t
----
[1, 2, 4, 20, 30]

# a rollback keeps an added file
statement ok
COPY (SELECT 50 AS id) TO '{DATA_PATH}/orphan_cleanup_open_transaction/main/t/rolled_back.parquet'

statement ok
BEGIN

statement ok
CALL ducklake_add_data_files('ducklake', 't', '{DATA_PATH}/orphan_cleanup_open_transaction/main/t/rolled_back.parquet')

statement ok
ROLLBACK

query I
SELECT count(*) FROM glob('{DATA_PATH}/orphan_cleanup_open_transaction/main/t/rolled_back.parquet')
----
1
