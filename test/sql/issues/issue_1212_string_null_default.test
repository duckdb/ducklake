# name: test/sql/issues/issue_1212_string_null_default.test
# description: A column default of the string NULL is not loaded as a missing default
# group: [issues]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/issue_1212.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/issue_1212')

statement ok
CREATE TABLE dl.t (id INTEGER, s VARCHAR DEFAULT 'NULL', b BLOB DEFAULT 'NULL'::BLOB, x VARCHAR)

statement ok
ALTER TABLE dl.t ALTER x SET DEFAULT 'NULL'

statement ok
INSERT INTO dl.t (id) VALUES (1)

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/issue_1212')

statement ok
INSERT INTO dl.t (id) VALUES (2)

query IIII
SELECT id, s = 'NULL', b = 'NULL'::BLOB, x = 'NULL' FROM dl.t ORDER BY id
----
1	true	true	true
2	true	true	true
