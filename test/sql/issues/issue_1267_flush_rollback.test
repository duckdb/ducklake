# name: test/sql/issues/issue_1267_flush_rollback.test
# description: A flush of inlined data that does not commit keeps the inlined rows
# group: [issues]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/issue_1267', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t SELECT range FROM range(5)

statement ok
BEGIN

statement ok
CALL ducklake_flush_inlined_data('dl')

# the flushing transaction reads the flushed rows once and has nothing left to flush
query II
SELECT count(*), sum(i) FROM dl.t
----
5	10

statement ok
CALL ducklake_flush_inlined_data('dl')

query II
SELECT count(*), sum(i) FROM dl.t
----
5	10

statement ok
ROLLBACK

query II
SELECT count(*), sum(i) FROM dl.t
----
5	10

# a flush of inlined file deletions that does not commit keeps them
statement ok
CREATE TABLE dl.d AS SELECT range i FROM range(100)

statement ok
DELETE FROM dl.d WHERE i = 20

statement ok
BEGIN

statement ok
CALL ducklake_flush_inlined_data('dl')

query I
SELECT count(*) FROM dl.d
----
99

statement ok
ROLLBACK

query I
SELECT count(*) FROM dl.d
----
99

# a retried flush keeps the inlined file deletions committed meanwhile
statement ok con1
BEGIN

statement ok con1
CALL ducklake_flush_inlined_data('dl')

statement ok
DELETE FROM dl.d WHERE i = 25

statement ok con1
COMMIT

query I
SELECT count(*) FROM dl.d
----
98

# a flush whose commit fails keeps the inlined rows and inlined file deletions
statement ok
INSERT INTO dl.t VALUES (100)

statement ok
CALL dl.set_option('require_commit_message', true)

statement error
CALL ducklake_flush_inlined_data('dl')
----
Commit Information for the snapshot is required

query II
SELECT count(*), sum(i) FROM dl.t
----
6	110

query I
SELECT count(*) FROM dl.d
----
98
