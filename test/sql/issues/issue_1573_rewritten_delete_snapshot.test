# name: test/sql/issues/issue_1573_rewritten_delete_snapshot.test
# description: A delete that rewrites a delete file is dated to its commit snapshot after a concurrent commit
# group: [issues]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/issue_1573', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t1 (id INTEGER)

statement ok
CREATE TABLE ducklake.t2 (id INTEGER)

statement ok
INSERT INTO ducklake.t1 SELECT range FROM range(10)

# snapshot 4 writes the first delete file of the data file
statement ok
DELETE FROM ducklake.t1 WHERE id = 0

statement ok con1
BEGIN

statement ok con1
DELETE FROM ducklake.t1 WHERE id = 1

statement ok con1
DELETE FROM ducklake.t1 WHERE id = 2

# snapshot 5 lands before con1 commits
statement ok con2
INSERT INTO ducklake.t2 VALUES (42)

statement ok con1
COMMIT

query II
SELECT snapshot_id, changes FROM ducklake.snapshots() WHERE snapshot_id >= 5 ORDER BY ALL
----
5	{tables_inserted_into=[2]}
6	{tables_deleted_from=[1]}

query I
SELECT list(id ORDER BY id) FROM ducklake.t1 AT (VERSION => 5)
----
[1, 2, 3, 4, 5, 6, 7, 8, 9]

query I
SELECT list(id ORDER BY id) FROM ducklake.t1 AT (VERSION => 4)
----
[1, 2, 3, 4, 5, 6, 7, 8, 9]

query I
SELECT list(id ORDER BY id) FROM ducklake.t1
----
[3, 4, 5, 6, 7, 8, 9]

query III
SELECT snapshot_id, change_type, id FROM ducklake_table_changes('ducklake', 'main', 't1', 4, 6) ORDER BY ALL
----
4	delete	0
6	delete	1
6	delete	2

query III
SELECT begin_snapshot, delete_count, partial_max FROM __ducklake_metadata_ducklake.ducklake_delete_file
WHERE end_snapshot IS NULL
----
4	3	6

# the delete file written before the commit is replaced, so only the committed ones are left
query I
SELECT count(*) FROM glob('{DATA_PATH}/issue_1573/**/*-delete.*')
----
2

# an update is dated to its commit snapshot as well
statement ok con1
BEGIN

statement ok con1
UPDATE ducklake.t1 SET id = id + 100 WHERE id = 3

statement ok con2
INSERT INTO ducklake.t2 VALUES (43)

statement ok con1
COMMIT

query III
SELECT snapshot_id, change_type, id FROM ducklake_table_changes('ducklake', 'main', 't1', 7, 8) ORDER BY ALL
----
8	update_postimage	103
8	update_preimage	3

query I
SELECT list(id ORDER BY id) FROM ducklake.t1 AT (VERSION => 7)
----
[3, 4, 5, 6, 7, 8, 9]
