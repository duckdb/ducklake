# name: test/sql/issues/issue_1329_overlapping_deletes_count.test
# description: count(*) subtracts a row deleted both in a delete file and in the inlined deletes once
# group: [issues]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

# written by DuckDB 1.5.6, where two concurrent deletes of the same rows both commit
unzip data/old_ducklake/overlapping_deletes.db.gz {TEST_DIR}/issue_1329.db

statement ok
ATTACH 'ducklake:{TEST_DIR}/issue_1329.db' AS overlap (DATA_PATH 'data/old_ducklake/overlapping_deletes/', OVERRIDE_DATA_PATH TRUE, READ_ONLY)

query II
SELECT count(*), count(i) FROM overlap.t
----
70	70

query II
SELECT count(*), count(i) FROM overlap.n
----
5	5

query II
SELECT count(*), count(i) FROM overlap.s
----
50	50

query III
SELECT (SELECT count(*) FROM overlap.t), (SELECT count(*) FROM overlap.n), (SELECT count(*) FROM overlap.s)
----
70	5	50

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/issue_1329', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t AS FROM range(100) s(i)

statement ok
DELETE FROM dl.t WHERE i = 5

statement ok
DELETE FROM dl.t WHERE i >= 50 AND i < 80

query I
SELECT count(*) FROM dl.t WHERE i < 60
----
49

# a filtered count does not read the delete files of the files its scan skips
statement ok
CREATE TABLE dl.p (p INT, i INT)

statement ok
ALTER TABLE dl.p SET PARTITIONED BY (p)

statement ok
INSERT INTO dl.p SELECT i % 2, i FROM range(200) s(i)

statement ok
DELETE FROM dl.p WHERE p = 1 AND i < 100

statement ok
DELETE FROM dl.p WHERE i = 151

statement ok
CALL enable_logging('FileSystem', storage => 'memory')

query I
SELECT count(*) FROM dl.p WHERE p = 0
----
100

statement ok
CALL disable_logging()

query II
SELECT count(*) FILTER (message LIKE '%-delete.%'), count(*) FILTER (message LIKE '%.parquet%') > 0 FROM duckdb_logs WHERE type = 'FileSystem'
----
0	true

query I
SELECT count(*) FROM dl.p
----
149

query I
SELECT count(*) FROM dl.t
----
69

statement ok
DELETE FROM dl.t WHERE i = 90

query II
SELECT count(*), count(i) FROM dl.t
----
68	68
