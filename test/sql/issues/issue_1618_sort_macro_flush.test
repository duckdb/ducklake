# name: test/sql/issues/issue_1618_sort_macro_flush.test
# description: Sort keys that call a DuckLake macro flush, compact and insert outside the schema of the table
# group: [issues]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/issue_1618', DATA_INLINING_ROW_LIMIT 10)

statement ok
USE dl

statement ok
CREATE TABLE t (i INTEGER)

statement ok
INSERT INTO t VALUES (1), (3), (2), (NULL), (4)

statement ok
DELETE FROM t WHERE i = 2

# the macro exists only in the transaction of the flush
statement ok
BEGIN

statement ok
CREATE MACRO sort_key(x) AS -x

statement ok
ALTER TABLE t SET SORTED BY (sort_key(i))

query I
SELECT rows_flushed FROM ducklake_flush_inlined_data('dl', table_name => 't')
----
5

query I
SELECT i FROM t
----
4
3
1
NULL

statement ok
COMMIT

query I
SELECT i FROM t
----
4
3
1
NULL

query I
SELECT i FROM t AT (VERSION => 2)
----
4
3
2
1
NULL

statement ok
INSERT INTO t VALUES (6), (5)

statement ok
USE memory

# the committed macro resolves in the schema of the table
query I
SELECT rows_flushed FROM ducklake_flush_inlined_data('dl', table_name => 't')
----
2

statement ok
INSERT INTO dl.t SELECT range FROM range(7, 19)

query II
SELECT count(*), max(i) FROM dl.t
----
18	18

query I
SELECT files_created FROM ducklake_merge_adjacent_files('dl')
----
1

query I
SELECT i FROM dl.t WHERE i >= 13
----
18
17
16
15
14
13

statement ok
INSERT INTO dl.t VALUES (20), (19)

statement ok
CHECKPOINT dl

query I
SELECT i FROM dl.t WHERE i >= 19
----
20
19

statement ok
USE dl

# a lambda parameter named like the inlined column, next to a column added after the rows were inlined
statement ok
CREATE TABLE r (i INTEGER)

statement ok
INSERT INTO r VALUES (1), (3), (2)

statement ok
ALTER TABLE r RENAME COLUMN i TO v

statement ok
ALTER TABLE r ADD COLUMN k INTEGER DEFAULT 10

statement ok
CREATE MACRO lambda_key(x, y) AS list_transform([y], lambda i: i - x)[1]

statement ok
ALTER TABLE r SET SORTED BY (lambda_key(v, k))

statement ok
CALL ducklake_flush_inlined_data('dl', table_name => 'r')

query II
SELECT v, k FROM r
----
3	10
2	10
1	10
