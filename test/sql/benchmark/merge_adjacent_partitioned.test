# name: test/sql/benchmark/merge_adjacent_partitioned.test
# description: Partitioned merge benchmark layout, historical reads and metadata restore
# group: [benchmark]

require ducklake

require parquet

# The benchmark restores a copied DuckDB metadata file
statement ok
ATTACH 'ducklake:{TEST_DIR}/partitioned_merge_pristine.db' AS lake (DATA_PATH '{TEST_DIR}/partitioned_merge_files')

statement ok
CALL lake.set_option('data_inlining_row_limit', 0)

statement ok
CREATE TABLE lake.events (part INTEGER, id BIGINT, v BIGINT)

statement ok
ALTER TABLE lake.events SET PARTITIONED BY (part)

statement ok
INSERT INTO lake.events SELECT p, p * 12 + r AS id, id * 3 + 7 FROM range(3) parts(p), range(4) rows(r)

statement ok
SET VARIABLE historical_snapshot = (SELECT max(snapshot_id) FROM lake.snapshots())

statement ok
INSERT INTO lake.events SELECT p, p * 12 + r AS id, id * 3 + 7 FROM range(3) parts(p), range(4, 8) rows(r)

statement ok
INSERT INTO lake.events SELECT p, p * 12 + r AS id, id * 3 + 7 FROM range(3) parts(p), range(8, 12) rows(r)

statement ok
DETACH lake

# Each iteration leaves its commits in the work WAL, which the next restore must discard
statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET checkpoint_threshold = '10GB'

loop iteration 0 2

statement ok
COPY (SELECT content FROM read_blob('{TEST_DIR}/partitioned_merge_pristine.db'))
TO '{TEST_DIR}/partitioned_merge_work.db' (FORMAT blob)

statement ok
COPY (SELECT ''::BLOB AS content) TO '{TEST_DIR}/partitioned_merge_work.db.wal' (FORMAT blob)

statement ok
ATTACH 'ducklake:{TEST_DIR}/partitioned_merge_work.db' AS lake

statement ok
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true)

query I
SELECT count(*) FROM glob('{TEST_DIR}/partitioned_merge_files/**')
----
9

query I
SELECT count(*) FROM ducklake_list_files('lake', 'events')
----
9

query III rowsort
SELECT part, count(*), sum(id) FROM lake.events GROUP BY part
----
0	12	66
1	12	210
2	12	354

statement ok
CREATE OR REPLACE TEMP TABLE premerge AS SELECT rowid, id, v FROM lake.events

query II
SELECT sum(files_processed), sum(files_created) FROM ducklake_merge_adjacent_files('lake', 'events')
----
9	3

# Non-adjacent files in a partition need their row ids written explicitly
query I
SELECT count(*) FROM (SELECT rowid, id, v FROM lake.events EXCEPT ALL FROM premerge)
----
0

query II
SELECT count(*), max(snapshot_id) FROM lake.snapshots()
----
7	6

query IIII rowsort
SELECT part, count(*), sum(id), sum(v) FROM lake.events GROUP BY part
----
0	12	66	282
1	12	210	714
2	12	354	1146

query IIII rowsort
SELECT part, count(*), sum(id), sum(v)
FROM lake.events AT (VERSION => getvariable('historical_snapshot')) GROUP BY part
----
0	4	6	46
1	4	54	190
2	4	102	334

query II rowsort
SELECT partition_value, count(*) FROM __ducklake_metadata_lake.ducklake_data_file
JOIN __ducklake_metadata_lake.ducklake_file_partition_value USING (table_id, data_file_id)
WHERE end_snapshot IS NULL GROUP BY partition_value
----
0	1
1	1
2	1

statement ok
DETACH lake

endloop
