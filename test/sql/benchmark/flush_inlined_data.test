# name: test/sql/benchmark/flush_inlined_data.test
# description: Productive flush preserves history and can be repeated from a copied DuckDB metadata fixture
# group: [benchmark]

require ducklake

require parquet

# The benchmark restores a copied DuckDB metadata file
statement ok
ATTACH 'ducklake:{TEST_DIR}/flush_fixture_pristine.db' AS lake (DATA_PATH '{TEST_DIR}/flush_fixture_files')

statement ok
CALL lake.set_option('data_inlining_row_limit', 100)

statement ok
BEGIN

statement ok
CREATE TABLE lake.i AS SELECT r AS id, r * 3 AS v FROM range(100) t(r)

statement ok
CREATE TABLE lake.f AS SELECT r AS id, r * 3 AS v FROM range(1000) t(r)

statement ok
COMMIT

statement ok
DELETE FROM lake.f WHERE id >= 850

statement ok
DELETE FROM lake.f WHERE id < 5

statement ok
DETACH lake

# Each iteration leaves its commits in the work WAL, which the next restore must discard
statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET checkpoint_threshold = '10GB'

loop iteration 0 2

statement ok
COPY (SELECT content FROM read_blob('{TEST_DIR}/flush_fixture_pristine.db'))
TO '{TEST_DIR}/flush_fixture_work.db' (FORMAT blob)

statement ok
COPY (SELECT ''::BLOB AS content) TO '{TEST_DIR}/flush_fixture_work.db.wal' (FORMAT blob)

statement ok
ATTACH 'ducklake:{TEST_DIR}/flush_fixture_work.db' AS lake

statement ok
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true)

statement ok
SET VARIABLE flush_delete_table = (SELECT '__ducklake_metadata_lake.ducklake_inlined_delete_' || table_id
FROM __ducklake_metadata_lake.ducklake_table WHERE table_name = 'f')

query I
SELECT count(*) FROM glob('{TEST_DIR}/flush_fixture_files/**')
----
2

query I
SELECT count(*) FROM query_table(getvariable('flush_delete_table'))
----
5

query II
SELECT count(*), sum(rows_flushed) FROM ducklake_flush_inlined_data('lake')
----
1	100

query I
SELECT count(*) FROM query_table(getvariable('flush_delete_table'))
----
0

query II
SELECT count(*), sum(delete_count) FROM __ducklake_metadata_lake.ducklake_delete_file WHERE end_snapshot IS NULL
----
1	155

query II
SELECT count(*), sum(record_count) FROM __ducklake_metadata_lake.ducklake_data_file WHERE end_snapshot IS NULL
----
2	1100

query III
SELECT count(*), sum(id), sum(v) FROM lake.i
----
100	4950	14850

query III
SELECT count(*), sum(id), sum(v) FROM lake.f
----
845	360815	1082445

query III
SELECT count(*), sum(id), sum(v) FROM lake.i AT (VERSION => 1)
----
100	4950	14850

query III
SELECT count(*), sum(id), sum(v) FROM lake.f AT (VERSION => 3)
----
845	360815	1082445

query III
SELECT count(*), sum(id), sum(v) FROM lake.f AT (VERSION => 2)
----
850	360825	1082475

query III
SELECT count(*), sum(id), sum(v) FROM lake.f AT (VERSION => 1)
----
1000	499500	1498500

query II
SELECT count(*), max(snapshot_id) FROM lake.snapshots()
----
5	4

statement ok
DETACH lake

endloop
