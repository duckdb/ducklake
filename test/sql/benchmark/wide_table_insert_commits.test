# name: test/sql/benchmark/wide_table_insert_commits.test
# description: Wide Parquet commit fixture preserves its schema, commit boundaries and reset invariants
# group: [benchmark]

require ducklake

require parquet

statement ok
SET VARIABLE wide_source_sql = (SELECT 'SELECT ' || string_agg('CAST(i + ' || j || ' AS ' ||
['BIGINT', 'DOUBLE', 'VARCHAR'][j % 3 + 1] || ') AS c' || j, ', ' ORDER BY j) || ' FROM range(8) t(i)'
FROM range(120) t(j))

statement ok
CREATE TEMP TABLE wide_source AS FROM query(getvariable('wide_source_sql'))

# The benchmark restores a copied DuckDB metadata file
statement ok
ATTACH 'ducklake:{TEST_DIR}/wide_commit_pristine.db' AS lake (DATA_PATH '{TEST_DIR}/wide_commit_files')

statement ok
CALL lake.set_option('data_inlining_row_limit', 0)

statement ok
CREATE TABLE lake.wide AS SELECT * FROM wide_source WHERE false

statement ok
DETACH lake

# Each iteration leaves its commits in the work WAL, which the next restore must discard
statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET checkpoint_threshold = '10GB'

loop iteration 0 2

statement ok
COPY (SELECT content FROM read_blob('{TEST_DIR}/wide_commit_pristine.db'))
TO '{TEST_DIR}/wide_commit_work.db' (FORMAT blob)

statement ok
COPY (SELECT ''::BLOB AS content) TO '{TEST_DIR}/wide_commit_work.db.wal' (FORMAT blob)

statement ok
ATTACH 'ducklake:{TEST_DIR}/wide_commit_work.db' AS lake

statement ok
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true)

query IIIIII
SELECT (SELECT count(*) FROM lake.wide),
(SELECT count(*) FROM duckdb_columns() WHERE database_name = 'lake' AND table_name = 'wide'),
(SELECT string_agg(data_type, ',' ORDER BY column_index) FROM duckdb_columns()
WHERE database_name = 'lake' AND table_name = 'wide') = (SELECT string_agg(['BIGINT', 'DOUBLE', 'VARCHAR'][j % 3 + 1],
',' ORDER BY j) FROM range(120) t(j)),
(SELECT count(*) FROM glob('{TEST_DIR}/wide_commit_files/**')),
(SELECT max(snapshot_id) FROM lake.snapshots()),
(SELECT value FROM lake.options() WHERE option_name = 'data_inlining_row_limit' AND scope = 'GLOBAL')
----
0	120	true	0	1	0

loop row_id 0 8

statement ok
INSERT INTO lake.wide SELECT * FROM wide_source WHERE c0 = {row_id}

endloop

query IIIII
SELECT (SELECT count(*) FROM lake.wide),
(SELECT count(*) FROM (FROM lake.wide EXCEPT ALL FROM wide_source)),
(SELECT count(*) FROM ducklake_list_files('lake', 'wide')),
(SELECT count(*) FROM lake.snapshots()), (SELECT max(snapshot_id) FROM lake.snapshots())
----
8	0	8	10	9

statement ok
DETACH lake

endloop
