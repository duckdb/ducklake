# name: test/sql/benchmark/merge_into_upsert.test
# description: A committed MERGE benchmark updates and inserts distinct keys after every metadata restore
# group: [benchmark]

require ducklake

require parquet

# The benchmark restores a copied DuckDB metadata file
statement ok
ATTACH 'ducklake:{TEST_DIR}/merge_upsert_pristine.db' AS lake (DATA_PATH '{TEST_DIR}/merge_upsert_files')

statement ok
CALL lake.set_option('data_inlining_row_limit', 0)

statement ok
CREATE TABLE lake.target AS SELECT i AS id, i * 2 AS v, 'base_' || i AS payload FROM range(10) t(i)

statement ok
CREATE TABLE merge_source AS
SELECT i AS id, i * 3 + 1 AS v, 'upsert_' || i AS payload
FROM (SELECT range AS i FROM range(3) UNION ALL SELECT range FROM range(10, 13))

statement ok
DETACH lake

# Each iteration leaves its commits in the work WAL, which the next restore must discard
statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET checkpoint_threshold = '10GB'

loop iteration 0 2

statement ok
COPY (SELECT content FROM read_blob('{TEST_DIR}/merge_upsert_pristine.db'))
TO '{TEST_DIR}/merge_upsert_work.db' (FORMAT blob)

statement ok
COPY (SELECT ''::BLOB AS content) TO '{TEST_DIR}/merge_upsert_work.db.wal' (FORMAT blob)

statement ok
ATTACH 'ducklake:{TEST_DIR}/merge_upsert_work.db' AS lake

statement ok
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true)

query III
SELECT (SELECT count(*) FROM lake.target),
(SELECT count(*) FROM ducklake_list_files('lake', 'target')),
(SELECT count(*) FROM glob('{TEST_DIR}/merge_upsert_files/**'))
----
10	1	1

query I
MERGE INTO lake.target AS t USING merge_source AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET v = s.v, payload = s.payload
WHEN NOT MATCHED THEN INSERT (id, v, payload) VALUES (s.id, s.v, s.payload)
----
6

query IIIII
SELECT count(*), count(DISTINCT id), sum(id), sum(v),
count(*) FILTER (WHERE CASE WHEN id < 3 OR id >= 10
THEN v IS DISTINCT FROM id * 3 + 1 OR payload IS DISTINCT FROM 'upsert_' || id
ELSE v IS DISTINCT FROM id * 2 OR payload IS DISTINCT FROM 'base_' || id END)
FROM lake.target
----
13	13	78	198	0

# The MERGE writes new data and delete files, which the next restore must sweep
query III
SELECT (SELECT count(*) FROM glob('{TEST_DIR}/merge_upsert_files/**')),
(SELECT count(*) FROM ducklake_list_files('lake', 'target')),
(SELECT count(delete_file) FROM ducklake_list_files('lake', 'target'))
----
4	3	1

query II
SELECT count(*), sum(v) FROM lake.target AT (VERSION => 1)
----
10	90

query II
SELECT count(*), max(snapshot_id) FROM lake.snapshots()
----
3	2

statement ok
DETACH lake

endloop
