# name: test/sql/stats/nan_column_stats.test
# description: FLOAT and DOUBLE columns with NaN keep their min/max statistics, with NaN as the max
# group: [stats]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/nan_column_stats')

foreach type FLOAT DOUBLE

foreach inlining 10 0

statement ok
CREATE OR REPLACE TABLE dl.t (x {type}) WITH (data_inlining_row_limit = {inlining})

statement ok
INSERT INTO dl.t VALUES ('nan'), (42), (-42), (NULL)

query II
SELECT ((stats(x)).min)::{type} = -42, isnan(((stats(x)).max)::{type}) FROM dl.t LIMIT 1
----
true	true

# NaN is greater than every other value, so the max must not prune it
query III
SELECT count(*) FILTER (x > 100), count(*) FILTER (x < -100), count(*) FILTER (x >= -42) FROM dl.t
----
1	0	3

query III
SELECT (stats(x)).has_null, (stats(x)).has_no_null, count(x) OVER () FROM dl.t LIMIT 1
----
true	true	3

query I
SELECT count(*) FROM dl.t WHERE x > 100
----
1

statement ok
CREATE OR REPLACE TABLE dl.t (x {type}) WITH (data_inlining_row_limit = {inlining})

statement ok
INSERT INTO dl.t VALUES ('nan')

query II
SELECT count(*) FILTER (x > 100), count(*) FILTER (x < 100) FROM dl.t
----
1	0

query I
SELECT (stats(x)).has_null FROM dl.t LIMIT 1
----
false

statement ok
INSERT INTO dl.t VALUES (NULL)

query III
SELECT (stats(x)).has_null, count(x) OVER (), count(*) OVER () FROM dl.t LIMIT 1
----
true	1	2

statement ok
CREATE OR REPLACE TABLE dl.t (x {type}) WITH (data_inlining_row_limit = {inlining})

statement ok
INSERT INTO dl.t VALUES (1), (2)

query II
SELECT ((stats(x)).min)::{type}, ((stats(x)).max)::{type} FROM dl.t LIMIT 1
----
1.0	2.0

endloop

# added files and added columns do not say whether they hold NaN, so no bound is taken from them
statement ok
COPY (SELECT x::{type} AS x FROM (VALUES (1), (2)) v(x)) TO '{DATA_PATH}/nan_column_stats_{type}.parquet'

statement ok
CREATE OR REPLACE TABLE dl.t (x {type})

statement ok
CALL ducklake_add_data_files('dl', 't', '{DATA_PATH}/nan_column_stats_{type}.parquet')

query II
SELECT min(x), max(x) FROM dl.t
----
1.0	2.0

query II
SELECT (stats(x)).min IS NULL, (stats(x)).max IS NULL FROM dl.t LIMIT 1
----
true	true

query I
SELECT count(*) FROM dl.t WHERE x > 1
----
1

statement ok
ALTER TABLE dl.t ADD COLUMN y {type} DEFAULT 7.5

query II
SELECT min(y), max(y) FROM dl.t
----
7.5	7.5

query II
SELECT (stats(y)).min IS NULL, (stats(y)).max IS NULL FROM dl.t LIMIT 1
----
true	true

query I
SELECT count(*) FROM dl.t WHERE y = 7.5
----
2

# inlined data keeps NaN as both bounds of a column with only NaN
statement ok
CREATE OR REPLACE TABLE dl.t (x {type}) WITH (data_inlining_row_limit = 10)

statement ok
INSERT INTO dl.t VALUES ('nan')

query II
SELECT isnan(((stats(x)).min)::{type}), isnan(((stats(x)).max)::{type}) FROM dl.t LIMIT 1
----
true	true

endloop
