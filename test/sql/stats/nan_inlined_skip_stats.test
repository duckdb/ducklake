# name: test/sql/stats/nan_inlined_skip_stats.test
# description: Inlined rows without column stats give unknown bounds, so a comparison over a derived value is not folded
# group: [stats]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/nan_inlined_skip_stats')

foreach type FLOAT DOUBLE

statement ok
CREATE OR REPLACE TABLE dl.t (x {type}) WITH (data_inlining_row_limit = 10)

statement ok
CALL dl.set_option('skip_stats_columns', ['x'], table_name => 't')

statement ok
INSERT INTO dl.t VALUES (1), (2), (NULL)

query I
SELECT sum(CASE WHEN v > 1 THEN 1 ELSE 0 END) FROM (SELECT COALESCE(x, 0) AS v FROM dl.t)
----
1

endloop
