# name: test/sql/stats/numeric_stats_one_bound.test
# description: a numeric column with a missing bound gives unknown statistics instead of an empty range
# group: [stats]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/numeric_stats_one_bound.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/numeric_stats_one_bound',
    DATA_INLINING_ROW_LIMIT 10)

foreach type INTEGER HUGEINT UHUGEINT

foreach bound min_value max_value

statement ok
CREATE TABLE dl.one_bound (v {type})

statement ok
INSERT INTO dl.one_bound VALUES (0), (20)

statement ok
UPDATE __ducklake_metadata_dl.ducklake_table_column_stats SET {bound} = NULL
WHERE table_id = (SELECT table_id FROM ducklake_table_info('dl') WHERE table_name = 'one_bound')

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/numeric_stats_one_bound',
    DATA_INLINING_ROW_LIMIT 10)

query II
SELECT (stats(v)).min IS NULL, (stats(v)).max IS NULL FROM dl.one_bound LIMIT 1
----
true	true

query I
SELECT count(*) FROM dl.one_bound WHERE v > 10
----
1

query I
SELECT count(*) FROM dl.one_bound WHERE v < 10
----
1

statement ok
DROP TABLE dl.one_bound

endloop

endloop
