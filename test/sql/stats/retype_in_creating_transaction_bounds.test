# name: test/sql/stats/retype_in_creating_transaction_bounds.test
# description: a column retyped in the transaction that creates its table keeps its values after a later widening
# group: [stats]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/retype_in_creating_transaction_bounds',
    DATA_INLINING_ROW_LIMIT 0)

# the file holds an INTEGER that the column type FLOAT rounds
statement ok
BEGIN

statement ok
CREATE TABLE dl.t (v INTEGER)

statement ok
INSERT INTO dl.t VALUES (16777219)

statement ok
ALTER TABLE dl.t ALTER COLUMN v TYPE FLOAT

statement ok
COMMIT

query I
SELECT v FROM dl.t
----
16777220.0

# the widening to DOUBLE reads the file value exactly, so no rounded bound may exclude it
statement ok
ALTER TABLE dl.t ALTER COLUMN v TYPE DOUBLE

query I
SELECT v FROM dl.t WHERE v < 16777219.5
----
16777219.0

query II
SELECT min(v), max(v) FROM dl.t
----
16777219.0	16777219.0

query II
SELECT s.min_value, s.max_value FROM __ducklake_metadata_dl.ducklake_table_column_stats s
JOIN __ducklake_metadata_dl.ducklake_table t USING (table_id) WHERE t.table_name = 't'
----
NULL	NULL
