# name: test/sql/types/nested_field_pushdown_added_struct.test
# description: a field of a struct field added after the files were written reads as NULL from those files
# group: [types]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/nested_field_pushdown_added_struct', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(s STRUCT(x INTEGER))

statement ok
INSERT INTO dl.t VALUES ({'x': 1})

statement ok
ALTER TABLE dl.t ADD COLUMN s.a STRUCT(b INTEGER)

query I
SELECT s.a.b FROM dl.t
----
NULL

query I
SELECT count(*) FROM dl.t WHERE s.a.b IS NULL
----
1

query I
SELECT count(*) FROM dl.t WHERE s.a.b = 1
----
0
