# name: test/sql/types/nested_field_pushdown_cast_rename.test
# description: a cast of a struct with a renamed field reads files written before the rename with the new name
# group: [types]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/nested_field_pushdown_cast_rename', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(s STRUCT(n STRUCT(a INTEGER)))

statement ok
INSERT INTO dl.t VALUES ({'n': {'a': 7}}), ({'n': {'a': 8}})

statement ok
ALTER TABLE dl.t RENAME s.n.a TO b

query I
SELECT s.n::VARCHAR FROM dl.t ORDER BY s.n.b
----
{'b': 7}
{'b': 8}

query I
SELECT count(*) FROM dl.t WHERE s.n::VARCHAR = '{''b'': 7}'
----
1
