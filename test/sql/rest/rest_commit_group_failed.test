# name: test/sql/rest/rest_commit_group_failed.test
# description: The files of the appends of a group commit survive a group that fails on another of its commits
# group: [rest]

require json

include test/template/rest_setup.test_template

statement ok
ATTACH 'ducklake:rest:{rest_server}' AS dl (DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.good(i INTEGER)

statement ok
CREATE TABLE dl.bad(i INTEGER)

# the requests are based on the snapshot before a direct writer drops one of the tables
statement ok
CREATE TABLE requests AS SELECT response->>'$.snapshot.snapshot_id' AS old_snapshot FROM ducklake_rest_request('{rest_server}', 'GET', '/v1/snapshots/latest', '')

statement ok
CREATE TABLE ids AS SELECT j->>'$.table_name' AS name, (j->>'$.table_id')::BIGINT AS id FROM (SELECT unnest(from_json(response->'$.catalog.tables', '["JSON"]')) AS j FROM ducklake_rest_request('{rest_server}', 'GET', '/v1/snapshots/latest?include_catalog=true', ''))

statement ok rest_db:rest_server_con
DROP TABLE rest_lake.bad

loop i 0 6

statement ok
COPY (SELECT {i}::INTEGER AS i) TO '{TEST_DIR}/{BASE_TEST_NAME}_member_{i}.parquet' (FORMAT PARQUET, FIELD_IDS {i: 1})

endloop

statement ok
CREATE TABLE outcomes(i INTEGER, status INTEGER, response VARCHAR)

# the server holds the commits back until all of them wait: a regular commit and one group of five
# two of the group commits append to the dropped table
statement ok rest_db:rest_server_con
SET VARIABLE snapshots_before = (SELECT count(*) FROM ducklake_snapshots('rest_lake'))

statement ok rest_db:rest_server_con
SET ducklake_debug_rest_commit_hold=6

concurrentloop i 0 6

statement ok
SET VARIABLE file_size = (SELECT size FROM read_blob('{TEST_DIR}/{BASE_TEST_NAME}_member_{i}.parquet'))

statement ok
SET VARIABLE body = json_object('snapshot_id', (SELECT old_snapshot::UBIGINT FROM requests), 'requests', [json_object('insert_files', json_object('table_id', (SELECT id FROM ids WHERE name = CASE WHEN {i}%3=1 THEN 'bad' ELSE 'good' END), 'files', [json_object('path', '{TEST_DIR}/{BASE_TEST_NAME}_member_{i}.parquet', 'record_count', 1, 'file_size_bytes', getvariable('file_size'))]))])

statement ok
INSERT INTO outcomes SELECT {i}, status, response FROM ducklake_rest_request('{rest_server}', 'POST', CASE WHEN {i}=0 THEN '/v1/transactions/commit' ELSE '/v1/transactions/group-commit' END, getvariable('body'))

endloop

statement ok rest_db:rest_server_con
SET ducklake_debug_rest_commit_hold=0

query II
SELECT count(*) FILTER (WHERE status=200), count(*) FILTER (WHERE status=409) FROM outcomes
----
4	2

# the group failed on its stale commits, so each of the others committed a snapshot of its own
query I rest_db:rest_server_con
SELECT count(*) - getvariable('snapshots_before') FROM ducklake_snapshots('rest_lake')
----
4

# the appends that committed still have their files
query I
SELECT count(*) FROM outcomes o WHERE status=200 AND NOT EXISTS (SELECT 1 FROM glob('{TEST_DIR}/{BASE_TEST_NAME}_member_*.parquet') g WHERE ends_with(g.file, '_member_' || o.i || '.parquet'))
----
0

# the rows of the appends that committed are in the table once
query II
SELECT count(*), count(DISTINCT i) FROM dl.good
----
4	4

statement ok
DETACH dl

include test/template/rest_teardown.test_template
