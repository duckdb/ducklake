# name: test/sql/rest/rest_paging.test
# description: Lists and large scans are returned in pages through the DuckLake REST API
# group: [rest]

require json

include test/template/rest_setup.test_template

# the server splits scans into pages of 2 files and returns pages of 2 entries
statement ok rest_db:rest_server_con
SELECT * FROM ducklake_rest_serve('rest_lake', port := regexp_extract(getvariable('rest_listen_uri'), ':([0-9]+)/', 1)::UBIGINT, files_per_page := 2, page_size := 2)

statement ok
ATTACH 'ducklake:rest:{rest_server}' AS dl (DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER)

loop i 0 7

statement ok
INSERT INTO dl.t VALUES ({i})

endloop

# the client reads all the files of the scan
query II
SELECT count(*), sum(i) FROM dl.t
----
7	21

query I
SELECT count(*) FROM ducklake_list_files('dl', 't')
----
7

# the first response of a scan has the first page, and there is a page token for each other one
query III
SELECT status, json_array_length(response->'$.files'), json_array_length(response->'$.page_tokens')
FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/scan', '{}')
----
200	2	3

statement ok
SET VARIABLE first_page = (SELECT response->>'$.page_tokens[0]' FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/scan', '{}'))

statement ok
SET VARIABLE last_page = (SELECT response->>'$.page_tokens[2]' FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/scan', '{}'))

query II
SELECT status, json_array_length(response->'$.files') FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/scan', '{"page_token": "' || getvariable('first_page') || '"}')
----
200	2

query II
SELECT status, json_array_length(response->'$.files') FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/scan', '{"page_token": "' || getvariable('last_page') || '"}')
----
200	1

# a page token is for the table of the scan
query II
SELECT status, response->>'$.error.type' FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/2/scan', '{"page_token": "' || getvariable('first_page') || '"}')
----
404	Catalog

query II
SELECT status, response->>'$.error.type' FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/scan', '{"page_token": "unknown.1"}')
----
404	Catalog

query II
SELECT status, response->>'$.error.type' FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/scan', '{"page_token": "nonsense"}')
----
404	Catalog

# a request is either the request for the files or a page token, not both
query II
SELECT status, response->>'$.error.type' FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/scan', '{"page_token": "' || getvariable('first_page') || '", "extended": true}')
----
400	Invalid Input

query II
SELECT status, response->>'$.error.type' FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/scan', '{"page_token": "' || getvariable('first_page') || '", "snapshot_id": 1}')
----
400	Invalid Input

# the files of the changes are split as well
query III
SELECT status, json_array_length(response->'$.insertions'), json_array_length(response->'$.page_tokens')
FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/changes', '{"start_snapshot_id": 0, "changes": "insertions"}')
----
200	2	3

statement ok
SET VARIABLE last_snapshot = (SELECT max(snapshot_id) FROM dl.snapshots())

statement ok
SET VARIABLE change_page = (SELECT response->>'$.page_tokens[0]' FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/changes', '{"start_snapshot_id": 0, "changes": "insertions"}'))

query II
SELECT status, json_array_length(response->'$.insertions') FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/changes', '{"page_token": "' || getvariable('change_page') || '"}')
----
200	2

query II
SELECT status, response->>'$.error.type' FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/changes', '{"page_token": "' || getvariable('change_page') || '", "changes": "insertions"}')
----
400	Invalid Input

query II
SELECT status, response->>'$.error.type' FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/changes', '{"start_snapshot_id": 0}')
----
400	Invalid Input

query II
SELECT count(*), sum(i) FROM ducklake_table_insertions('dl', 'main', 't', 0, getvariable('last_snapshot'))
----
7	21

# lists of snapshots come in pages
query III
SELECT status, json_array_length(response->'$.snapshots'), response->>'$.next_page_token' IS NOT NULL
FROM ducklake_rest_request('{rest_server}', 'GET', '/v1/snapshots', '')
----
200	2	true

query II
SELECT json_array_length(response->'$.snapshots'), response->>'$.next_page_token'
FROM ducklake_rest_request('{rest_server}', 'GET', '/v1/snapshots?page_size=1', '')
----
1	0

query II
SELECT json_array_length(response->'$.snapshots'), response->>'$.snapshots[0].snapshot_id'
FROM ducklake_rest_request('{rest_server}', 'GET', '/v1/snapshots?page_size=1&page_token=0', '')
----
1	1

# the snapshots of the client are all of them
query I
SELECT count(*) FROM dl.snapshots()
----
9

query I
SELECT status FROM ducklake_rest_request('{rest_server}', 'GET', '/v1/snapshots?page_token=x', '')
----
400

query I
SELECT status FROM ducklake_rest_request('{rest_server}', 'GET', '/v1/snapshots?page_size=0', '')
----
400

# the last page has no token
query II
SELECT json_array_length(response->'$.snapshots'), response->>'$.next_page_token' IS NULL
FROM ducklake_rest_request('{rest_server}', 'GET', '/v1/snapshots?page_size=100', '')
----
9	true

# the storage of the tables is the storage of their files
loop i 0 4

statement ok
CREATE TABLE dl.t{i}(i INTEGER)

statement ok
INSERT INTO dl.t{i} VALUES (1)

endloop

query I
SELECT count(*) FROM ducklake_table_info('dl')
----
5

query II
SELECT count(*), count(*) FILTER (WHERE file_size_bytes > 0 OR file_count = 0) FROM ducklake_table_info('dl')
----
5	5

statement ok
DETACH dl

include test/template/rest_teardown.test_template
