# name: test/sql/rest/rest_commit_group_relay_published.test
# description: A server that relays a group does not pass its commits on again when the other server may have published it
# group: [rest]

require json

include test/template/rest_setup.test_template

# the lake of the relay is a client of the first server
statement ok relay_db:relay_con
ATTACH 'ducklake:rest:{rest_server}' AS relay

statement ok relay_db:relay_con
SET VARIABLE relay_uri = (SELECT listen_uri FROM ducklake_rest_serve('relay'))

set variable relay_server <variable:relay_con:relay_uri>

statement ok rest_db:rest_server_con
CREATE TABLE rest_lake.grouped(i INTEGER)

statement ok
SET VARIABLE table_id = (SELECT (j->>'$.table_id')::BIGINT FROM (SELECT unnest(from_json(response->'$.catalog.tables', '["JSON"]')) AS j FROM ducklake_rest_request('{rest_server}', 'GET', '/v1/snapshots/latest?include_catalog=true', '')) WHERE j->>'$.table_name' = 'grouped')

loop i 0 2

statement ok
COPY (SELECT (43 + {i})::INTEGER AS i) TO '{TEST_DIR}/{BASE_TEST_NAME}_member_{i}.parquet' (FORMAT PARQUET, FIELD_IDS {i: 1})

endloop

# a commit of each file
statement ok
CREATE TABLE bodies AS SELECT regexp_extract(filename, '_member_([0-9]+)\.parquet$', 1)::INTEGER AS member, json_object('requests', [json_object('insert_files', json_object('table_id', getvariable('table_id'), 'files', [json_object('path', filename, 'record_count', 1, 'file_size_bytes', size)]))]) AS body FROM read_blob('{TEST_DIR}/{BASE_TEST_NAME}_member_*.parquet')

statement ok
CREATE TABLE outcomes(status INTEGER, error_type VARCHAR, message VARCHAR)

# two group commits that share a snapshot: the relay holds them back until both wait
statement ok relay_db:relay_con
SET ducklake_debug_rest_commit_hold = 2

# the commit of the metadata of the first server is durable, the checkpoint that follows it fails
statement ok rest_db:rest_server_con
SET auto_checkpoint_skip_wal_threshold = 9999999999

statement ok rest_db:rest_server_con
SET wal_autocheckpoint_entries = 1

statement ok rest_db:rest_server_con
PRAGMA debug_checkpoint_abort = 'before_header_non_fatal'

concurrentloop i 0 2

statement ok
SET VARIABLE body = (SELECT body FROM bodies WHERE member = {i})

statement ok
INSERT INTO outcomes SELECT status, response->>'$.error.type', response->>'$.error.message' FROM ducklake_rest_request('{relay_server}', 'POST', '/v1/transactions/group-commit', getvariable('body'))

endloop

statement ok rest_db:rest_server_con
PRAGMA debug_checkpoint_abort = 'none'

statement ok rest_db:rest_server_con
SET wal_autocheckpoint_entries = 0

statement ok relay_db:relay_con
SET ducklake_debug_rest_commit_hold = 0

# both commits of the group get the IO error of the group, with the error of the first server
query ITII
SELECT status, error_type, contains(message, 'It is unknown whether the transaction was committed')::INTEGER, contains(message, 'Transaction COMMIT succeeded')::INTEGER FROM outcomes
----
500	IO	1	1
500	IO	1	1

# the relay did not remove the files of its clients
query I
SELECT count(*) FROM glob('{TEST_DIR}/{BASE_TEST_NAME}_member_*.parquet')
----
2

statement ok relay_db:relay_con
SELECT * FROM ducklake_rest_stop(regexp_extract(getvariable('relay_uri'), '^(.*://[^/]+)', 1))

statement ok relay_db:relay_con
DETACH relay

include test/template/rest_teardown.test_template

# the failed checkpoint invalidated the metadata database, it is attached again
statement ok rest_db:rest_server_con
DETACH rest_lake

statement ok rest_db:rest_server_con
ATTACH 'ducklake:{TEST_DIR}/{BASE_TEST_NAME}_rest_server.db' AS reopened (DATA_PATH '{TEST_DIR}/{BASE_TEST_NAME}_rest_files')

# the group is published once, as one snapshot: the relay did not pass its commits on again one by one
query I rest_db:rest_server_con
SELECT count(*) FROM ducklake_list_files('reopened', 'grouped')
----
2

query III rest_db:rest_server_con
SELECT count(*), count(DISTINCT i), sum(i) FROM reopened.grouped
----
2	2	87

query I rest_db:rest_server_con
SELECT count(DISTINCT snapshot_id) FROM reopened.grouped
----
1
