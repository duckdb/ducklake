# name: test/sql/rest/rest_commit_published_options.test
# description: A client reads the options of a commit from the metadata when it does not know whether it was published
# group: [rest]

include test/template/rest_setup.test_template

statement ok
ATTACH 'ducklake:rest:{rest_server}' AS dl

statement ok
CREATE TABLE dl.t(i INTEGER)

# the lake inlines small inserts
statement ok
CALL dl.set_option('data_inlining_row_limit', 10)

statement ok
INSERT INTO dl.t VALUES (1)

query I
SELECT count(*) FROM glob('{TEST_DIR}/{BASE_TEST_NAME}_rest_files/**/*.parquet')
----
0

statement ok rest_db:rest_server_con
SET auto_checkpoint_skip_wal_threshold = 9999999999

# the client switches the inlining off: the server publishes the commit and fails in the checkpoint after it
statement ok
BEGIN

statement ok
CALL dl.set_option('data_inlining_row_limit', 0)

statement ok rest_db:rest_server_con
SET wal_autocheckpoint_entries = 1

statement ok rest_db:rest_server_con
PRAGMA debug_checkpoint_abort = 'before_header_non_fatal'

statement error
COMMIT
----
Transaction COMMIT succeeded

statement ok rest_db:rest_server_con
PRAGMA debug_checkpoint_abort = 'none'

statement ok rest_db:rest_server_con
SET wal_autocheckpoint_entries = 0

# the failed checkpoint invalidated the metadata database: the lake is attached again and served on the same port
include test/template/rest_teardown.test_template

statement ok rest_db:rest_server_con
DETACH rest_lake

statement ok rest_db:rest_server_con
ATTACH 'ducklake:{TEST_DIR}/{BASE_TEST_NAME}_rest_server.db' AS rest_lake (DATA_PATH '{TEST_DIR}/{BASE_TEST_NAME}_rest_files')

statement ok rest_db:rest_server_con
SELECT * FROM ducklake_rest_serve('rest_lake', port := regexp_extract(getvariable('rest_listen_uri'), ':([0-9]+)', 1)::UBIGINT)

# the option is published
query I
SELECT value FROM ducklake_options('dl') WHERE option_name = 'data_inlining_row_limit' AND scope = 'GLOBAL'
----
0

# the client does not inline anymore: the insert writes a file
statement ok
INSERT INTO dl.t VALUES (42)

query I
SELECT count(*) FROM glob('{TEST_DIR}/{BASE_TEST_NAME}_rest_files/**/*.parquet')
----
1

query II
SELECT count(*), sum(i) FROM dl.t
----
2	43

# a commit that does not reach the server: its options on the schema and on the table are not published
statement ok
BEGIN

statement ok
CALL dl.set_option('data_inlining_row_limit', 10, schema => 'main')

statement ok
CALL dl.set_option('data_inlining_row_limit', 20, table_name => 't')

statement ok
CALL dl.set_option('data_inlining_row_limit', 30, table_name => 't')

include test/template/rest_teardown.test_template

statement error
COMMIT
----
Failed to send

# the options stay in doubt while the metadata cannot be read
statement error
SELECT count(*) FROM dl.t
----
Failed to send

statement ok rest_db:rest_server_con
SELECT * FROM ducklake_rest_serve('rest_lake', port := regexp_extract(getvariable('rest_listen_uri'), ':([0-9]+)', 1)::UBIGINT)

# the table still follows the option of the lake: the insert writes a file
statement ok
INSERT INTO dl.t VALUES (43)

query I
SELECT count(*) FROM glob('{TEST_DIR}/{BASE_TEST_NAME}_rest_files/**/*.parquet')
----
2

# the schema and the table inline again
statement ok
CALL dl.set_option('data_inlining_row_limit', 10, schema => 'main')

statement ok
CALL dl.set_option('data_inlining_row_limit', 10, table_name => 't')

statement ok
INSERT INTO dl.t VALUES (44)

query I
SELECT count(*) FROM glob('{TEST_DIR}/{BASE_TEST_NAME}_rest_files/**/*.parquet')
----
2

# a commit that does not reach the server changes both options: they stay as they are published
statement ok
BEGIN

statement ok
CALL dl.set_option('data_inlining_row_limit', 0, schema => 'main')

statement ok
ALTER TABLE dl.t RESET (data_inlining_row_limit)

include test/template/rest_teardown.test_template

statement error
COMMIT
----
Failed to send

statement ok rest_db:rest_server_con
SELECT * FROM ducklake_rest_serve('rest_lake', port := regexp_extract(getvariable('rest_listen_uri'), ':([0-9]+)', 1)::UBIGINT)

statement ok
INSERT INTO dl.t VALUES (45)

query I
SELECT count(*) FROM glob('{TEST_DIR}/{BASE_TEST_NAME}_rest_files/**/*.parquet')
----
2

# the option of the schema is the published one as well: a table without an option of its own inlines
statement ok
CREATE TABLE dl.other(i INTEGER)

statement ok
INSERT INTO dl.other VALUES (1)

query I
SELECT count(*) FROM glob('{TEST_DIR}/{BASE_TEST_NAME}_rest_files/**/*.parquet')
----
2

query II
SELECT count(*), sum(i) FROM dl.t
----
5	175

statement ok
DETACH dl

include test/template/rest_teardown.test_template
