# name: test/sql/rest/rest_paged_file_lists.test
# description: Deletes over pages of files, counts at a snapshot that a merge made inexact, column mappings of two tables
# group: [rest]

include test/template/rest_setup.test_template

statement ok rest_db:rest_server_con
SELECT * FROM ducklake_rest_serve('rest_lake', port := regexp_extract(getvariable('rest_listen_uri'), ':([0-9]+)/', 1)::UBIGINT, files_per_page := 2, page_size := 2)

statement ok
ATTACH 'ducklake:rest:{rest_server}' AS dl (DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER)

loop i 0 5

statement ok
INSERT INTO dl.t VALUES ({i})

endloop

# the delete reads all pages of the extended file list
statement ok
DELETE FROM dl.t WHERE i % 4 = 3

query II
SELECT count(*), sum(i) FROM dl.t
----
4	7

statement ok
UPDATE dl.t SET i = i + 10 WHERE i = 4

query II
SELECT count(*), sum(i) FROM dl.t
----
4	17

# a transaction that reads at a snapshot before the server merged files of later snapshots
statement ok
CREATE TABLE dl.u(i INTEGER)

statement ok
INSERT INTO dl.u VALUES (1)

statement ok
INSERT INTO dl.u VALUES (2)

statement ok
BEGIN

query I
SELECT count(*) FROM dl.t
----
4

statement ok rest_db:rest_server_con
CALL rest_lake.set_option('data_inlining_row_limit', 0)

statement ok rest_db:rest_server_con
INSERT INTO rest_lake.u VALUES (3)

statement ok rest_db:rest_server_con
CALL ducklake_merge_adjacent_files('rest_lake')

query I
SELECT count(*) FROM dl.u
----
2

statement ok
COMMIT

query I
SELECT count(*) FROM dl.u
----
3

# files added to two tables in one transaction, each with the column mapping of its own table
statement ok
CREATE TABLE dl.m1(a INTEGER, b VARCHAR)

statement ok
CREATE TABLE dl.m2(c INTEGER)

statement ok
COPY (SELECT 'one' AS b, 1 AS a) TO '{TEST_DIR}/{BASE_TEST_NAME}_m1.parquet'

statement ok
COPY (SELECT 2 AS c) TO '{TEST_DIR}/{BASE_TEST_NAME}_m2.parquet'

statement ok
BEGIN

statement ok
CALL ducklake_add_data_files('dl', 'm1', '{TEST_DIR}/{BASE_TEST_NAME}_m1.parquet')

statement ok
CALL ducklake_add_data_files('dl', 'm2', '{TEST_DIR}/{BASE_TEST_NAME}_m2.parquet')

statement ok
COMMIT

query II
FROM dl.m1
----
1	one

query I
FROM dl.m2
----
2
