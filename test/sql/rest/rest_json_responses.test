# name: test/sql/rest/rest_json_responses.test
# description: Clients that only accept JSON get the lists of files, the change feed and the metadata as JSON
# group: [rest]

require json

include test/template/rest_setup.test_template

statement ok
ATTACH 'ducklake:rest:{rest_server}' AS dl (DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER, s VARCHAR)

statement ok
INSERT INTO dl.t SELECT range, 'v' || range FROM range(100)

statement ok
INSERT INTO dl.t SELECT range, 'w' || range FROM range(100, 200)

statement ok
DELETE FROM dl.t WHERE i % 10 = 0

statement ok
DELETE FROM dl.t WHERE i >= 100

# the extended file list of a scan
query II
SELECT status, json_array_length(response->'$.extended_files') FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/scan', '{"extended": true}')
----
200	1

# the deletions and insertions of the change feed
query III
SELECT status, json_array_length(response->'$.deletions'), (response->'$.deletions[0].delete_file') IS NOT NULL
FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/changes', '{"start_snapshot_id": 4, "changes": "deletions"}')
----
200	3	true

query II
SELECT status, json_array_length(response->'$.insertions') FROM ducklake_rest_request('{rest_server}', 'POST', '/v1/tables/1/changes', '{"start_snapshot_id": 0, "changes": "insertions"}')
----
200	2

# the options of the lake, of a schema and of a table
statement ok
CALL dl.set_option('parquet_compression', 'zstd', schema => 'main')

statement ok
CALL dl.set_option('parquet_row_group_size', '1000', table_name => 't')

statement ok
ALTER TABLE dl.t SET (data_inlining_row_limit = 5)

query III
SELECT status, json_array_length(response->'$.schema_settings') >= 1, json_array_length(response->'$.table_settings') >= 2
FROM ducklake_rest_request('{rest_server}', 'GET', '/v1/metadata', '')
----
200	true	true

statement ok
ALTER TABLE dl.t RESET (data_inlining_row_limit)

query I
SELECT count(*) FROM dl.options() WHERE option_name = 'data_inlining_row_limit' AND scope = 'TABLE'
----
0

# a sorted table and the comments of the columns of a view
statement ok
CREATE TABLE dl.sorted(i INTEGER, j INTEGER)

statement ok
ALTER TABLE dl.sorted SET SORTED BY (i DESC NULLS FIRST, j ASC NULLS LAST)

statement ok
INSERT INTO dl.sorted VALUES (1, 2), (NULL, 3), (5, NULL)

query II
FROM dl.sorted ORDER BY ALL
----
1	2
5	NULL
NULL	3

statement ok
DETACH dl

include test/template/rest_teardown.test_template
