# name: test/sql/quack/server_side_commit_cache_clear.test
# description: A server-side commit only reloads the Quack catalog when it can have created a table
# group: [quack]

require ducklake

require parquet

require-env DUCKLAKE_CONNECTION

require quack

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/quack_commit_cache_clear', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
CREATE TABLE dl.f AS SELECT range AS i FROM range(100)

statement ok
CALL enable_logging('QueryLog')

# inlined rows go into the existing inlined table
statement ok
INSERT INTO dl.t VALUES (2)

statement ok
DELETE FROM dl.t WHERE i = 1

query I
SELECT count(*) FROM duckdb_logs WHERE type = 'QueryLog' AND trim(message) = 'CALL quack_clear_cache();'
----
0

query I
SELECT i FROM dl.t
----
2

# the first inlined deletion of a data file creates its deletion table
statement ok
DELETE FROM dl.f WHERE i = 5

query I
SELECT count(*) > 0 FROM duckdb_logs WHERE type = 'QueryLog' AND trim(message) = 'CALL quack_clear_cache();'
----
true

query II
SELECT count(*), sum(i) FROM dl.f
----
99	4945

statement ok
DELETE FROM dl.f WHERE i = 6

query II
SELECT count(*), sum(i) FROM dl.f
----
98	4939
