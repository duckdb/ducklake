# name: test/sql/quack/option_commit_order.test
# description: The commit of a transaction that set an option first does not publish it over the value set later
# group: [quack]

require ducklake

require parquet

require quack

require-env DUCKLAKE_CONNECTION quack:localhost:19999

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{TEST_DIR}/option_commit_order', DATA_INLINING_ROW_LIMIT 0)

statement ok con1
BEGIN

statement ok con1
CALL ducklake.set_option('require_commit_message', true)

statement ok con1
CREATE TABLE ducklake.a(i INTEGER)

# Quack writes an option when it is set, so the server holds the value of the later set
statement ok con2
BEGIN

statement ok con2
CALL ducklake.set_commit_message('review', 'other')

statement ok con2
CALL ducklake.set_option('require_commit_message', false)

statement ok con2
CREATE TABLE ducklake.b(i INTEGER)

statement ok con2
COMMIT

statement ok con1
COMMIT

# the cache follows the server, so a commit needs no message
statement ok
CREATE TABLE ducklake.c(i INTEGER)

query I
SELECT count(*) FROM ducklake.c
----
0

# the same with the first transaction writing another option after the commit of the second
statement ok con1
BEGIN

statement ok con1
CALL ducklake.set_option('require_commit_message', true)

statement ok con1
CREATE TABLE ducklake.d(i INTEGER)

statement ok con2
BEGIN

statement ok con2
CALL ducklake.set_commit_message('review', 'other')

statement ok con2
CALL ducklake.set_option('require_commit_message', false)

statement ok con2
CREATE TABLE ducklake.e(i INTEGER)

statement ok con2
COMMIT

statement ok con1
CALL ducklake.set_option('data_inlining_row_limit', 5)

statement ok con1
COMMIT

statement ok
CREATE TABLE ducklake.f(i INTEGER)

# the option written last is published, so the row is inlined
statement ok
INSERT INTO ducklake.f VALUES (1)

query I
SELECT count(*) FROM glob('{TEST_DIR}/option_commit_order/main/f/*.parquet')
----
0

# the same with the later set lost at its commit and reloaded while the first transaction is open
statement ok con1
BEGIN

statement ok con1
CALL ducklake.set_option('data_inlining_row_limit', 20)

statement ok con1
CREATE TABLE ducklake.g(i INTEGER)

statement ok con2
BEGIN

statement ok con2
CALL ducklake.set_option('data_inlining_row_limit', 0)

statement ok con2
CREATE TABLE ducklake.h(i INTEGER)

statement ok con2
SET ducklake_debug_lose_commit_reply = 'after'

statement error con2
COMMIT
----
whether it carried the commit out is unknown

statement ok con2
RESET ducklake_debug_lose_commit_reply

# a transaction open across the commit of the first one sees the cache without a reload
statement ok con3
BEGIN

query I con3
SELECT count(*) FROM ducklake.f
----
1

statement ok con1
COMMIT

# the server holds the later set, which the commit of the earlier set does not publish over
statement ok con3
INSERT INTO ducklake.f VALUES (2)

statement ok con3
COMMIT

query I
SELECT count(*) FROM glob('{TEST_DIR}/option_commit_order/main/f/*.parquet')
----
1
