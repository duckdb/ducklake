# name: test/sql/quack/quack_commit_maxima_no_restart.test
# description: a client-side commit on Quack reads the snapshot maxima without a failing query and a restart
# group: [quack]

require ducklake

require parquet

require-env DUCKLAKE_CONNECTION quack:localhost:19999

require quack

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS l (DATA_PATH '{DATA_PATH}/quack_commit_maxima_no_restart', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE l.t(a INT)

statement ok
INSERT INTO l.t VALUES (1)

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata', storage => 'memory')

statement ok
CALL ducklake_create_tag('l', 'v2', version => 2)

statement ok
CALL disable_logging()

# the maxima query names the server schema, so no query fails and the metadata transaction is not reset
query II
SELECT count(*) FILTER (WHERE query LIKE '%FROM "__ducklake_metadata_l"."main".ducklake_snapshot%'),
	count(*) FILTER (WHERE query LIKE 'ROLLBACK; BEGIN TRANSACTION;%')
FROM duckdb_logs_parsed('DuckLakeMetadata')
----
0	0
