# name: test/sql/quack/branch_read_across_main_flush.test
# description: A branch transaction on a Quack catalog keeps hiding the inlined row it ended when main flushes the row into a file between its reads
# group: [quack]

require ducklake

require parquet

require-env DUCKLAKE_CONNECTION quack:localhost:19999

require quack

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

query I
SELECT table_id FROM meta.ducklake_table WHERE table_name = 't'
----
1

# dev forks from main after the inlined insert and holds a snapshot of its own
statement ok
SET VARIABLE fork = (SELECT MAX(snapshot_id) FROM meta.ducklake_snapshot WHERE branch_id = 0)

statement ok
INSERT INTO meta.ducklake_branch SELECT 1, 'dev', 0, getvariable('fork')

statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT getvariable('fork') + 1, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = getvariable('fork') AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes SELECT getvariable('fork') + 1, NULL, NULL, NULL, NULL, 1

# dev ends the inlined row 2 of main at its own snapshot
statement ok
INSERT INTO meta.ducklake_inlined_data_visibility SELECT 1, _ducklake_row_id, 0, _ducklake_begin_snapshot, 1, getvariable('fork') + 1 FROM meta.ducklake_inlined_data_1_1 WHERE i = 2

# the branch transaction reads before the flush and finds no deletion table
statement ok con1
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (METADATA_CATALOG 'meta', BRANCH 'dev')

statement ok con1
BEGIN

query I con1
SELECT i FROM dev.t ORDER BY i
----
1
3

# main flushes the inlined rows of t, the end of dev on the moved row becomes a deletion row of dev on the written file
statement ok con2
CALL ducklake_flush_inlined_data('dl', table_name => 't')

query III
SELECT count(*), branch_id, begin_snapshot = getvariable('fork') + 1 FROM meta.ducklake_inlined_delete_1 GROUP BY ALL
----
1	1	true

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('QueryLog', storage = 'memory')

# the later statement of the transaction reads the flushed file and the rehomed deletion row of dev on it
query I con1
SELECT i FROM dev.t ORDER BY i
----
1
3

statement ok
CALL disable_logging()

# the statement listed the deletion tables again instead of trusting the probe before the flush
query I
SELECT count(*) > 0 FROM duckdb_logs WHERE type = 'QueryLog' AND message LIKE '%duckdb_tables()%ducklake_inlined_delete%'
----
true

statement ok con1
COMMIT

query I con1
SELECT i FROM dev.t ORDER BY i
----
1
3

# main reads every row
query I
SELECT i FROM dl.t ORDER BY i
----
1
2
3

query I
SELECT count(*) FROM meta.ducklake_inlined_data_1_1
----
0

query I
SELECT count(*) FROM meta.ducklake_inlined_data_visibility
----
0

statement ok
DETACH dev

statement ok
DETACH dl
