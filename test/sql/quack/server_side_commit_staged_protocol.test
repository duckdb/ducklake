# name: test/sql/quack/server_side_commit_staged_protocol.test
# description: The server-side commit of hand-staged commits: no transaction snapshot, flushed inlined tables, stray inlined rows
# group: [quack]

require ducklake

require parquet

require-env DUCKLAKE_CONNECTION quack:localhost:19999

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/server_side_commit_staged_protocol', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE lake.t(i INTEGER)

statement ok
INSERT INTO lake.t VALUES (1), (2)

# stage the commits by hand in the staging tables of the session, like the client does before it calls ducklake_commit
statement ok
CALL quack_query_by_name('__ducklake_metadata_lake', '
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_commit(commit_author VARCHAR, commit_message VARCHAR, commit_extra_info VARCHAR, transaction_snapshot_id BIGINT, data_path VARCHAR, path_separator VARCHAR, transaction_next_catalog_id UBIGINT, transaction_next_file_id UBIGINT);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_data_file(data_file_id BIGINT, table_id BIGINT, file_order BIGINT, path VARCHAR, path_is_relative BOOLEAN, file_format VARCHAR, record_count BIGINT, file_size_bytes BIGINT, footer_size BIGINT, row_id_start BIGINT, partition_id BIGINT, encryption_key VARCHAR, mapping_id UBIGINT, partial_max BIGINT, begin_snapshot BIGINT, compaction_id BIGINT, row_group_count BIGINT);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_data_file_column_stats(data_file_id BIGINT, table_id BIGINT, column_id BIGINT, column_size_bytes BIGINT, has_num_values BOOLEAN, num_values BIGINT, has_null_count BOOLEAN, null_count BIGINT, has_min BOOLEAN, min_value VARCHAR, has_max BOOLEAN, max_value VARCHAR, has_contains_nan BOOLEAN, contains_nan BOOLEAN, any_valid BOOLEAN, extra_stats VARCHAR, min_is_exact BOOLEAN, max_is_exact BOOLEAN);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_data_file_partition(local_file_id BIGINT, partition_column_idx BIGINT, partition_value VARCHAR);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_delete_file(table_id BIGINT, data_file_path VARCHAR, data_file_id BIGINT, file_name VARCHAR, format VARCHAR, delete_count BIGINT, file_size_bytes BIGINT, footer_size BIGINT, encryption_key VARCHAR, begin_snapshot BIGINT, max_snapshot BIGINT, source VARCHAR, overwrites_existing_delete BOOLEAN, overwrite_delete_file_id BIGINT, overwrite_delete_file_path VARCHAR, attached_local_file_id BIGINT, row_group_count BIGINT);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_inlined_data(table_id BIGINT, has_preserved_row_ids BOOLEAN);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_inlined_row(table_id BIGINT, row_order BIGINT, preserved_row_id BIGINT, value_literals VARCHAR);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_inlined_column_stats(table_id BIGINT, column_id BIGINT, column_size_bytes BIGINT, has_num_values BOOLEAN, num_values BIGINT, has_null_count BOOLEAN, null_count BIGINT, has_min BOOLEAN, min_value VARCHAR, has_max BOOLEAN, max_value VARCHAR, has_contains_nan BOOLEAN, contains_nan BOOLEAN, any_valid BOOLEAN, extra_stats VARCHAR, min_is_exact BOOLEAN, max_is_exact BOOLEAN);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_inlined_delete(table_id BIGINT, inlined_table_name VARCHAR, deleted_row_id BIGINT);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_inlined_file_delete(table_id BIGINT, file_id BIGINT, deleted_row_id BIGINT);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_dropped_file(path VARCHAR, data_file_id BIGINT);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_tables_deleted_from(table_id BIGINT);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_tables_delete_attempted(table_id BIGINT);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_flushed_inlined(inlined_table_name VARCHAR, schema_version BIGINT, flush_snapshot_id BIGINT);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_compaction(compaction_id BIGINT, table_id BIGINT, compaction_type VARCHAR, row_id_start BIGINT);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_compaction_source(compaction_id BIGINT, source_order BIGINT, source_data_file_id BIGINT, source_path VARCHAR, source_row_count BIGINT, source_begin_snapshot BIGINT, source_max_partial_file_snapshot BIGINT, source_inlined_delete_count BIGINT, last_delete_file_id BIGINT, last_delete_path VARCHAR, last_delete_row_count BIGINT, last_delete_end_snapshot BIGINT);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_name_map(map_id UBIGINT, table_id BIGINT);
CREATE TEMPORARY TABLE IF NOT EXISTS ducklake_staged_name_map_entry(map_id UBIGINT, entry_id BIGINT, parent_entry_id BIGINT, source_name VARCHAR, target_field_id BIGINT, hive_partition BOOLEAN);
TRUNCATE ducklake_staged_commit;
TRUNCATE ducklake_staged_data_file;
TRUNCATE ducklake_staged_data_file_column_stats;
TRUNCATE ducklake_staged_data_file_partition;
TRUNCATE ducklake_staged_delete_file;
TRUNCATE ducklake_staged_inlined_data;
TRUNCATE ducklake_staged_inlined_row;
TRUNCATE ducklake_staged_inlined_column_stats;
TRUNCATE ducklake_staged_inlined_delete;
TRUNCATE ducklake_staged_inlined_file_delete;
TRUNCATE ducklake_staged_dropped_file;
TRUNCATE ducklake_staged_tables_deleted_from;
TRUNCATE ducklake_staged_tables_delete_attempted;
TRUNCATE ducklake_staged_flushed_inlined;
TRUNCATE ducklake_staged_compaction;
TRUNCATE ducklake_staged_compaction_source;
TRUNCATE ducklake_staged_name_map;
TRUNCATE ducklake_staged_name_map_entry;
')

# a staged commit without a transaction snapshot starts from the latest snapshot
query III
CALL quack_query_by_name('__ducklake_metadata_lake', '
INSERT INTO ducklake_staged_commit VALUES (NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
SELECT * FROM ducklake_commit(''main'', -1, catalog_version => ''2.0-dev2'')')
----
3	1	false

statement ok
COPY (SELECT 42 AS i) TO '{DATA_PATH}/server_side_commit_staged_protocol_refused.parquet'

# a client that does not pass its version cannot have attached a 2.0-dev2 catalog, its files are left to the orphan cleanup
statement error
CALL quack_query_by_name('__ducklake_metadata_lake', '
INSERT INTO ducklake_staged_data_file SELECT 0, table_id, 0, ''{DATA_PATH}/server_side_commit_staged_protocol_refused.parquet'',
       false, ''parquet'', 1, 1000, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, true, NULL
FROM main.ducklake_table WHERE table_name = ''t'' AND end_snapshot IS NULL;
SELECT * FROM ducklake_commit(''main'', -1)')
----
The catalog was migrated by another connection to version 2.0-dev2

query I
SELECT count(*) FROM glob('{DATA_PATH}/server_side_commit_staged_protocol_refused*.parquet')
----
1

statement ok
CALL quack_query_by_name('__ducklake_metadata_lake', 'TRUNCATE ducklake_staged_data_file')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS legacy (DATA_PATH '{DATA_PATH}/server_side_commit_staged_protocol_legacy', METADATA_SCHEMA 'legacy', DUCKLAKE_VERSION '1.1')

# it commits to a 1.1 catalog, at the version of the catalog
query III
CALL quack_query_by_name('__ducklake_metadata_lake', 'SELECT * FROM ducklake_commit(''legacy'', -1)')
----
1	0	false

statement ok
DETACH legacy

# a staged flush deletes the flushed inlined rows, none of them were inserted at snapshot 0
query III
CALL quack_query_by_name('__ducklake_metadata_lake', '
TRUNCATE ducklake_staged_commit;
INSERT INTO ducklake_staged_commit SELECT NULL, NULL, NULL, snapshot_id, NULL, NULL, next_catalog_id, next_file_id
FROM main.ducklake_snapshot ORDER BY snapshot_id DESC LIMIT 1;
INSERT INTO ducklake_staged_flushed_inlined VALUES (''ducklake_inlined_data_1_1'', 1, 0);
SELECT * FROM ducklake_commit(''main'', 1, catalog_version => ''2.0-dev2'')')
----
4	1	true

statement ok
CREATE TABLE lake.u(i INTEGER)

# staged inlined rows of a table without staged inlined data are ignored
query III
CALL quack_query_by_name('__ducklake_metadata_lake', '
TRUNCATE ducklake_staged_commit;
TRUNCATE ducklake_staged_flushed_inlined;
INSERT INTO ducklake_staged_commit SELECT NULL, NULL, NULL, snapshot_id, NULL, NULL, next_catalog_id, next_file_id
FROM main.ducklake_snapshot ORDER BY snapshot_id DESC LIMIT 1;
INSERT INTO ducklake_staged_inlined_data VALUES (1, false);
INSERT INTO ducklake_staged_inlined_row VALUES (2, 0, NULL, ''(42)'');
SELECT * FROM ducklake_commit(''main'', 2, catalog_version => ''2.0-dev2'')')
----
6	2	false

query I
SELECT snapshot_id FROM ducklake_snapshots('lake') WHERE snapshot_id >= 2 ORDER BY ALL
----
2
3
4
5
6

query II
SELECT (SELECT list(i ORDER BY i) FROM lake.t), (SELECT count(*) FROM lake.u)
----
[1, 2]	0

statement ok
INSERT INTO lake.t VALUES (3)

statement ok
INSERT INTO lake.u VALUES (4)

query II
SELECT (SELECT list(i ORDER BY i) FROM lake.t), (SELECT list(i) FROM lake.u)
----
[1, 2, 3]	[4]

# a staged delete file that replaces an existing one is committed in its place, after emptying the staging tables of
# the client's last commit
statement ok
CREATE TABLE lake.d(i INTEGER)

# one thread writes one data file, so the delete writes one delete file
statement ok
SET threads = 1

statement ok
INSERT INTO lake.d SELECT i FROM range(20) r(i)

statement ok
DELETE FROM lake.d WHERE i < 15

# the delete file of d is the newest one
statement ok
SET VARIABLE replaced_delete_file = (SELECT max(delete_file_id) FROM __ducklake_metadata_lake.ducklake_delete_file)

query I
CALL quack_query_by_name('__ducklake_metadata_lake', '
TRUNCATE ducklake_staged_commit;
TRUNCATE ducklake_staged_data_file;
TRUNCATE ducklake_staged_data_file_column_stats;
TRUNCATE ducklake_staged_data_file_partition;
TRUNCATE ducklake_staged_delete_file;
TRUNCATE ducklake_staged_inlined_data;
TRUNCATE ducklake_staged_inlined_row;
TRUNCATE ducklake_staged_inlined_column_stats;
TRUNCATE ducklake_staged_inlined_delete;
TRUNCATE ducklake_staged_inlined_file_delete;
TRUNCATE ducklake_staged_dropped_file;
TRUNCATE ducklake_staged_tables_deleted_from;
TRUNCATE ducklake_staged_tables_delete_attempted;
TRUNCATE ducklake_staged_flushed_inlined;
TRUNCATE ducklake_staged_compaction;
TRUNCATE ducklake_staged_compaction_source;
TRUNCATE ducklake_staged_name_map;
TRUNCATE ducklake_staged_name_map_entry;
INSERT INTO ducklake_staged_commit SELECT NULL, NULL, NULL, snapshot_id, NULL, NULL, next_catalog_id, next_file_id
FROM main.ducklake_snapshot ORDER BY snapshot_id DESC LIMIT 1;
INSERT INTO ducklake_staged_delete_file
SELECT del.table_id, data.path, del.data_file_id, del.path, del.format, del.delete_count, del.file_size_bytes,
       del.footer_size, del.encryption_key, NULL, NULL, ''REGULAR'', true, del.delete_file_id, del.path, NULL, NULL,
       NULL
FROM main.ducklake_delete_file del JOIN main.ducklake_data_file data USING (data_file_id)
JOIN main.ducklake_table tbl ON tbl.table_id = del.table_id AND tbl.end_snapshot IS NULL
WHERE del.end_snapshot IS NULL AND tbl.table_name = ''d'';
SELECT count(*) FROM ducklake_staged_delete_file')
----
1

statement ok
CALL quack_query_by_name('__ducklake_metadata_lake', 'SELECT * FROM ducklake_commit(''main'', 3, catalog_version => ''2.0-dev2'')')

query II
SELECT count(*) FILTER (delete_file_id = getvariable('replaced_delete_file')),
       count(*) FILTER (delete_file_id > getvariable('replaced_delete_file'))
FROM __ducklake_metadata_lake.ducklake_delete_file WHERE end_snapshot IS NULL
----
0	1

query I
SELECT count(*) FROM lake.d
----
5
