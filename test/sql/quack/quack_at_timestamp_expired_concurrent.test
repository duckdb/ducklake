# name: test/sql/quack/quack_at_timestamp_expired_concurrent.test
# description: Time travel by timestamp in a transaction that sees a concurrent expiry of snapshots
# group: [quack]

require ducklake

require parquet

require-env DUCKLAKE_CONNECTION quack:localhost:19999

require quack

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS l (DATA_PATH '{DATA_PATH}/quack_at_timestamp_expired_concurrent', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE l.t(a INT)

statement ok
INSERT INTO l.t VALUES (1)

# a transaction whose newest snapshot is 2
statement ok con2
BEGIN

statement ok con2
SET VARIABLE t1 = (SELECT snapshot_time FROM l.snapshots() WHERE snapshot_id = 1)

statement ok con2
SET VARIABLE t2 = (SELECT snapshot_time FROM l.snapshots() WHERE snapshot_id = 2)

query I con2
SELECT count(*) FROM l.t
----
1

# meanwhile snapshots 3 and 4 are committed and snapshot 3 expired: that gap is above the transaction's snapshot
statement ok
INSERT INTO l.t VALUES (2)

statement ok
INSERT INTO l.t VALUES (3)

statement ok
CALL ducklake_expire_snapshots('l', versions => [3])

query I
SELECT list(snapshot_id) FROM l.snapshots()
----
[0, 1, 2, 4, 5]

# the Quack catalog commits each statement, so the transaction sees the expiry, and its own snapshots are complete
query I con2
SELECT count(*) FROM l.t AT (TIMESTAMP => getvariable('t1'))
----
0

query I con2
SELECT list(a) FROM l.t AT (TIMESTAMP => getvariable('t2'))
----
[1]

# the transaction's own snapshot 2 expires as well: the gap now reaches it, and the survivors are newer than it
statement ok
CALL ducklake_expire_snapshots('l', versions => [2])

query I
SELECT list(snapshot_id) FROM l.snapshots()
----
[0, 1, 4, 5, 6]

# the same instant as before the expiry, answered from the snapshot cache of the transaction
statement error con2
SELECT count(*) FROM l.t AT (TIMESTAMP => getvariable('t1'))
----
Cannot time travel to timestamp

# the cached snapshot 2 itself is expired
statement error con2
SELECT list(a) FROM l.t AT (TIMESTAMP => getvariable('t2'))
----
snapshots 2 to 3 were expired

statement error con2
SELECT * FROM l.t AT (TIMESTAMP => getvariable('t2') + INTERVAL 1 MICROSECOND)
----
are newer than the snapshot of this transaction

# once every snapshot before the gap is expired as well, no remaining older snapshot is named
statement ok
CALL ducklake_expire_snapshots('l', versions => [0, 1])

query I
SELECT list(snapshot_id) FROM l.snapshots()
----
[4, 5, 6, 7]

statement error con2
SELECT list(a) FROM l.t AT (TIMESTAMP => getvariable('t2'))
----
snapshots 0 to 3 were expired

statement ok con2
ROLLBACK
