# name: test/sql/quack/staged_commit_value_lists.test
# description: A staged Quack commit sends its inlined rows and deleted rows in a few multi-row statements
# group: [quack]

require ducklake

require parquet

require-env DUCKLAKE_CONNECTION quack:localhost:19999

require quack

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/quack_staged_value_lists', DATA_INLINING_ROW_LIMIT 100000)

statement ok
CREATE TABLE dl.t (a BIGINT, b VARCHAR)

statement ok
CREATE TABLE dl.f (a BIGINT)

statement ok
CALL dl.set_option('data_inlining_row_limit', 0, table_name => 'f')

statement ok
INSERT INTO dl.f SELECT range FROM range(10000)

statement ok
CALL dl.set_option('data_inlining_row_limit', 100000, table_name => 'f')

# the first delete creates the inlined deletion table in a commit of the client
statement ok
DELETE FROM dl.f WHERE a = 0

statement ok
CALL enable_logging('DuckLakeMetadata')

statement ok
INSERT INTO dl.t SELECT range, concat('value_', range) FROM range(20000)

statement ok
SET VARIABLE insert_snapshot = (SELECT max(snapshot_id) FROM dl.snapshots())

statement ok
DELETE FROM dl.t WHERE a % 2 = 0

statement ok
DELETE FROM dl.f WHERE a % 2 = 0

statement ok
CALL disable_logging()

# each staged table gets a few statements instead of one per row
query III
SELECT sum(len(string_split(query, 'ducklake_staged_inlined_row VALUES')) - 1) BETWEEN 1 AND 99,
    sum(len(string_split(query, 'ducklake_staged_inlined_delete VALUES')) - 1) BETWEEN 1 AND 99,
    sum(len(string_split(query, 'ducklake_staged_inlined_file_delete VALUES')) - 1) BETWEEN 1 AND 99
FROM duckdb_logs_parsed('DuckLakeMetadata')
----
true	true	true

query III
SELECT count(*), sum(a), count(DISTINCT b) FROM dl.t
----
10000	100000000	10000

query II
SELECT count(*), sum(a) FROM dl.f
----
5000	25000000

query I
SELECT count(*) FROM dl.t AT (VERSION => getvariable('insert_snapshot'))
----
20000

query II
SELECT a, b FROM dl.t WHERE a = 19999
----
19999	value_19999
