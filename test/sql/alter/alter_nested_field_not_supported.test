# name: test/sql/alter/alter_nested_field_not_supported.test
# description: ALTER on a nested struct field must not silently target the top-level column
# group: [alter]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_alter_nested_field_files')

statement ok
CREATE TABLE ducklake.test(s STRUCT(a INTEGER, b INTEGER))

statement ok
INSERT INTO ducklake.test VALUES ({'a': NULL, 'b': 1})

statement error
ALTER TABLE ducklake.test ALTER s.a SET NOT NULL
----
Setting a NOT NULL constraint on a nested field is not yet supported

statement error
ALTER TABLE ducklake.test ALTER s.a DROP NOT NULL
----
Dropping a NOT NULL constraint on a nested field is not yet supported

statement error
ALTER TABLE ducklake.test ALTER s.a SET DEFAULT 5
----
Setting a default value on a nested field is not yet supported

statement error
ALTER TABLE ducklake.test ALTER s.a TYPE BIGINT
----
Changing the type of a nested field is not yet supported

# "s" itself did not get a NOT NULL constraint
statement ok
INSERT INTO ducklake.test VALUES (NULL)

query I
SELECT * FROM ducklake.test ORDER BY s.b NULLS LAST
----
{'a': NULL, 'b': 1}
NULL

# top-level columns are unaffected
statement ok
CREATE TABLE ducklake.simple(a INTEGER, b INTEGER)

statement ok
INSERT INTO ducklake.simple VALUES (1, 1)

statement ok
ALTER TABLE ducklake.simple ALTER a SET NOT NULL

statement ok
ALTER TABLE ducklake.simple ALTER a DROP NOT NULL

statement ok
ALTER TABLE ducklake.simple ALTER a SET DEFAULT 42

statement ok
ALTER TABLE ducklake.simple ALTER a TYPE BIGINT
