# name: test/sql/alter/float_widening_live_rows_shape.test
# description: the FLOAT widening reads the live column rows through the anti join of the readers, a drop, a retype and a tag change write one end per ended row version
# group: [alter]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER, f FLOAT, k VARCHAR)

statement ok
INSERT INTO dl.t VALUES (1, 1.5, 'a')

statement ok
COMMENT ON COLUMN dl.t.k IS 'col k'

# dev forks here, every row so far is born on main
statement ok
INSERT INTO meta.ducklake_branch VALUES (1, 'dev', 0, 3)

# the end inserts of the catalog kinds, each probing the companion for an end with NOT EXISTS
statement ok
CREATE MACRO end_inserts() AS TABLE
SELECT sum(len(regexp_extract_all(query, 'INSERT INTO [^;]*ducklake_(table|column|column_tag|tag|partition|sort)_visibility[^;]*NOT EXISTS'))) AS probed
FROM duckdb_logs_parsed('DuckLakeMetadata')

statement ok
CALL enable_logging('DuckLakeMetadata')

# a drop ends the live version row of the column and the row of its tag
statement ok
ALTER TABLE dl.t DROP COLUMN k

query I
SELECT probed FROM end_inserts()
----
2

statement ok
CALL truncate_duckdb_logs()

# the FLOAT widening reads the column types through the anti join and ends the retyped version row
statement ok
ALTER TABLE dl.t ALTER COLUMN f TYPE DOUBLE

query II
SELECT count(*) FILTER (WHERE query LIKE '%LEFT JOIN%ducklake_column_visibility%'), count(*) FILTER (WHERE query LIKE '%NOT EXISTS%')
FROM duckdb_logs_parsed('DuckLakeMetadata') WHERE query LIKE '%SELECT c.table_id, c.column_id, c.column_type,%'
----
1	0

query I
SELECT probed FROM end_inserts()
----
1

statement ok
CALL truncate_duckdb_logs()

# a comment writes its end insert whether a previous value exists or not, the second ends the first
statement ok
COMMENT ON TABLE dl.t IS 'first'

query I
SELECT probed FROM end_inserts()
----
1

statement ok
CALL truncate_duckdb_logs()

statement ok
COMMENT ON TABLE dl.t IS 'second'

query I
SELECT probed FROM end_inserts()
----
1

statement ok
CALL truncate_duckdb_logs()

# a drop of the table ends its row and the rows it owns, one end insert per kind
statement ok
DROP TABLE dl.t

query I
SELECT probed FROM end_inserts()
----
6

statement ok
CALL disable_logging()

# every ended row version has one end of main, named by its birth, at the snapshot that ended it
query IIIIII
FROM meta.ducklake_column_visibility ORDER BY ALL
----
0	1	1	0	1	8
0	1	2	0	1	5
0	1	2	0	5	8
0	1	3	0	1	4

query IIIIIII
FROM meta.ducklake_column_tag_visibility ORDER BY ALL
----
0	1	3	comment	0	3	4

query IIIIII
FROM meta.ducklake_tag_visibility ORDER BY ALL
----
0	1	comment	0	6	7
0	1	comment	0	7	8

query IIIII
FROM meta.ducklake_table_visibility ORDER BY ALL
----
0	1	0	1	8

query II
SELECT (SELECT count(*) FROM meta.ducklake_partition_visibility), (SELECT count(*) FROM meta.ducklake_sort_visibility)
----
0	0

# main reads the states before each change through time travel
statement error
SELECT * FROM dl.t
----
does not exist

query II
SELECT column_name, column_type FROM (DESCRIBE FROM dl.t AT (VERSION => 7))
----
i	INTEGER
f	DOUBLE

query II
SELECT column_name, column_type FROM (DESCRIBE FROM dl.t AT (VERSION => 4))
----
i	INTEGER
f	FLOAT

query III
SELECT i, f, k FROM dl.t AT (VERSION => 3)
----
1	1.5	a

statement ok
DETACH dl

# the ends of main carry its branch id, so the branch forked before the changes reads none of them
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', BRANCH 'dev')

query II
SELECT column_name, column_type FROM (DESCRIBE dl.t)
----
i	INTEGER
f	FLOAT
k	VARCHAR

query I
SELECT comment FROM duckdb_columns() WHERE database_name = 'dl' AND table_name = 't' AND column_name = 'k'
----
col k

query III
SELECT i, f, k FROM dl.t
----
1	1.5	a

statement ok
DETACH dl
