# name: test/sql/alter/drop_last_struct_field.test
# description: dropping the last field of a struct gives the catalog error of DuckDB
# group: [alter]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/drop_last_struct_field')

statement ok
CREATE TABLE dl.t (s STRUCT(j INTEGER, n STRUCT(a INTEGER)))

statement error
ALTER TABLE dl.t DROP COLUMN s.n.a
----
Catalog Error: Cannot drop field a from column s - it is the last field of the struct

statement ok
ALTER TABLE dl.t DROP COLUMN s.n

statement error
ALTER TABLE dl.t DROP COLUMN s.j
----
Catalog Error: Cannot drop field j from column s - it is the last field of the struct

statement error
ALTER TABLE dl.t DROP COLUMN s.j.a
----
Catalog Error: Cannot drop field from column "s" - not a nested type

statement error
ALTER TABLE dl.t DROP COLUMN IF EXISTS s.j.a
----
not a nested type

statement ok
ALTER TABLE dl.t DROP COLUMN IF EXISTS s.v

query I
SELECT data_type FROM information_schema.columns WHERE table_catalog = 'dl' AND table_name = 't'
----
STRUCT(j INTEGER)

# the names are given as written in the statement
statement ok
CREATE TABLE dl.c (S STRUCT(J INTEGER))

statement error
ALTER TABLE dl.c DROP COLUMN s.j
----
Catalog Error: Cannot drop field j from column s - it is the last field of the struct
