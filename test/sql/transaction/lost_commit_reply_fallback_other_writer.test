# name: test/sql/transaction/lost_commit_reply_fallback_other_writer.test
# description: The reload fallback of a lost commit does not restore the uncommitted value of another transaction
# group: [transaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/lost_commit_reply_fallback_other_writer', METADATA_CATALOG 'metadata', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t(i INTEGER)

statement ok con1
BEGIN

statement ok con1
ALTER TABLE ducklake.t SET (data_inlining_row_limit = 20)

# the second transaction replaces the value of the first in the cache
statement ok con2
BEGIN

statement ok con2
ALTER TABLE ducklake.t SET (data_inlining_row_limit = 30)

statement ok con2
CREATE TABLE ducklake.a(i INTEGER)

statement ok con1
ROLLBACK

# the catalog never carries the commit of the second transaction out
statement ok con2
SET ducklake_debug_lose_commit_reply = 'before'

statement error con2
COMMIT
----
whether it carried the commit out is unknown

statement ok con2
RESET ducklake_debug_lose_commit_reply

query I
SELECT count(*) FROM metadata.ducklake_metadata WHERE key = 'data_inlining_row_limit'
----
0

# both transactions are gone, so the limit of the ATTACH holds and the row goes to a file
statement ok
INSERT INTO ducklake.t VALUES (1)

query I
SELECT count(*) FROM glob('{DATA_PATH}/lost_commit_reply_fallback_other_writer/main/t/*.parquet')
----
1
