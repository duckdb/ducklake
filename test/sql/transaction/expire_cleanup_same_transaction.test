# name: test/sql/transaction/expire_cleanup_same_transaction.test
# description: The files of snapshots expired in a transaction can be cleaned up in the same transaction
# group: [transaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/expire_cleanup_same_transaction', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT range i FROM range(10)

statement ok
DELETE FROM dl.t

statement ok
BEGIN

statement ok
CALL ducklake_expire_snapshots('dl', older_than => now())

query I
SELECT count(*) FROM ducklake_cleanup_old_files('dl', cleanup_all => true, dry_run => true)
----
1

statement ok
COMMIT
