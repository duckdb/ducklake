# name: test/sql/transaction/lost_commit_reply_unreadable_catalog_order.test
# description: The options of two commits whose outcome could not be read are reloaded from the newest to the oldest
# group: [transaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/lost_commit_reply_unreadable_catalog_order', METADATA_CATALOG 'metadata', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t(i INTEGER)

statement ok con1
BEGIN

statement ok con1
CALL ducklake.set_option('data_inlining_row_limit', 20)

statement ok con1
CREATE TABLE ducklake.a(i INTEGER)

# the second transaction replaces the value of the first in the cache
statement ok con2
BEGIN

statement ok con2
CALL ducklake.set_option('data_inlining_row_limit', 30)

statement ok con2
CREATE TABLE ducklake.b(i INTEGER)

# the catalog never carries the commits out and cannot be read while their outcome is checked
statement ok
SET ducklake_debug_lose_commit_reply = 'before_unreadable'

statement error con1
COMMIT
----
whether it carried the commit out is unknown

statement error con2
COMMIT
----
whether it carried the commit out is unknown

statement ok
RESET ducklake_debug_lose_commit_reply

query I
SELECT count(*) FROM metadata.ducklake_metadata WHERE key = 'data_inlining_row_limit'
----
0

# the limit of the ATTACH holds again, so the row goes to a file
statement ok
INSERT INTO ducklake.t VALUES (1)

query I
SELECT count(*) FROM glob('{DATA_PATH}/lost_commit_reply_unreadable_catalog_order/main/t/*.parquet')
----
1
