# name: test/sql/transaction/lost_commit_reply_option_cache.test
# description: An option committed by a transaction whose COMMIT reply was lost is applied afterwards
# group: [transaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/lost_commit_reply_option_cache', METADATA_CATALOG 'metadata', DATA_INLINING_ROW_LIMIT 0)

# the catalog carries the COMMIT out, only its reply is lost
statement ok
SET ducklake_debug_lose_commit_reply = 'after'

statement ok
BEGIN

statement ok
CALL ducklake.set_option('require_commit_message', true)

statement ok
CREATE TABLE ducklake.t(i INTEGER)

statement ok
CALL ducklake.set_commit_message('review', 'test')

# a commit without files cannot be recognized in the catalog, so its outcome stays unknown
statement error
COMMIT
----
whether it carried the commit out is unknown

statement ok
RESET ducklake_debug_lose_commit_reply

query I
SELECT value FROM metadata.ducklake_metadata WHERE key = 'require_commit_message'
----
true

# the cached option follows the catalog, so the next commit needs a message
statement error
CREATE TABLE ducklake.t2(i INTEGER)
----
required

query I
SELECT count(*) FROM ducklake.t
----
0
