# name: test/sql/transaction/lost_commit_reply_compaction_registration.test
# description: A compaction output of a rolled back commit registered in the same table does not make the commit look carried out
# group: [transaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/lost_commit_reply_compaction_registration', METADATA_CATALOG 'metadata', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t(i INTEGER)

statement ok
INSERT INTO ducklake.t VALUES (1)

statement ok
INSERT INTO ducklake.t VALUES (2)

statement ok con1
BEGIN

statement ok con1
CALL ducklake_merge_adjacent_files('ducklake', 't')

# the merged file of the open transaction is on disk, another connection registers it in t
statement ok con2
SET VARIABLE f = (SELECT file FROM glob('{DATA_PATH}/lost_commit_reply_compaction_registration/main/t/*.parquet') WHERE NOT EXISTS (SELECT 1 FROM metadata.ducklake_data_file d WHERE ends_with(file, d.path)) LIMIT 1)

statement ok con2
CALL ducklake_add_data_files('ducklake', 't', getvariable('f'), ignore_extra_columns => true)

query I con2
SELECT count(*) FROM ducklake.t
----
4

# the catalog never carries con1's COMMIT out
statement ok con1
SET ducklake_debug_lose_commit_reply = 'before'

statement error con1
COMMIT
----
whether it carried the commit out is unknown

statement ok con1
RESET ducklake_debug_lose_commit_reply

# the merge never happened, the two files and the registered copy stay live
query I
SELECT count(*) FROM metadata.ducklake_data_file WHERE end_snapshot IS NULL
----
3

query I
SELECT i FROM ducklake.t ORDER BY i
----
1
1
2
2
