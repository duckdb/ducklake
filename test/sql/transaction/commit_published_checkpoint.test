# name: test/sql/transaction/commit_published_checkpoint.test
# description: A commit that is in the metadata keeps its files when the checkpoint after it fails
# group: [transaction]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:{TEST_DIR}/commit_published_checkpoint.db' AS dl (DATA_PATH '{TEST_DIR}/commit_published_checkpoint_files', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
SET auto_checkpoint_skip_wal_threshold = 9999999999

statement ok
BEGIN

statement ok
INSERT INTO dl.t VALUES (42)

# the commit of the metadata is durable, the checkpoint that follows it fails
statement ok
SET wal_autocheckpoint_entries = 1

statement ok
PRAGMA debug_checkpoint_abort = 'before_header_non_fatal'

statement error
COMMIT
----
Transaction COMMIT succeeded

statement ok
PRAGMA debug_checkpoint_abort = 'none'

statement ok
SET wal_autocheckpoint_entries = 0

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{TEST_DIR}/commit_published_checkpoint.db' AS dl (DATA_PATH '{TEST_DIR}/commit_published_checkpoint_files')

query I
SELECT count(*) FROM ducklake_list_files('dl', 't')
----
1

query I
SELECT count(*) FROM glob('{TEST_DIR}/commit_published_checkpoint_files/**/*.parquet')
----
1

query I
SELECT sum(i) FROM dl.t
----
42

# a commit that only sets an option writes no snapshot, it is durable in the same way
statement ok
BEGIN

statement ok
CALL dl.set_option('target_file_size', '10MB')

statement ok
SET wal_autocheckpoint_entries = 1

statement ok
PRAGMA debug_checkpoint_abort = 'before_header_non_fatal'

statement error
COMMIT
----
Transaction COMMIT succeeded

statement ok
PRAGMA debug_checkpoint_abort = 'none'

statement ok
SET wal_autocheckpoint_entries = 0

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{TEST_DIR}/commit_published_checkpoint.db' AS dl (DATA_PATH '{TEST_DIR}/commit_published_checkpoint_files', DATA_INLINING_ROW_LIMIT 0)

query I
SELECT value FROM ducklake_options('dl') WHERE option_name = 'target_file_size' AND scope = 'GLOBAL'
----
10000000

# when the metadata commit is not durable, its publication is unknown and the data file is kept as well
statement ok
SET auto_checkpoint_skip_wal_threshold = 0

statement ok
BEGIN

statement ok
INSERT INTO dl.t VALUES (99)

statement ok
SET wal_autocheckpoint_entries = 1

statement ok
PRAGMA debug_checkpoint_abort = 'before_header_non_fatal'

statement error
COMMIT
----
The commit may have taken effect, so the files it wrote are kept

statement ok
PRAGMA debug_checkpoint_abort = 'none'

statement ok
SET wal_autocheckpoint_entries = 0

query I
SELECT count(*) FROM glob('{TEST_DIR}/commit_published_checkpoint_files/**/*.parquet')
----
2
