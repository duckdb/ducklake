# name: test/sql/transaction/transaction_conflicts_drop_renamed.test
# description: a drop or replace that commits after a concurrent rename of the table or view conflicts
# group: [transaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/transaction_conflicts_drop_renamed')

statement ok
CREATE TABLE lake.t(x INT)

statement ok
INSERT INTO lake.t VALUES (1)

# a drop that commits after a rename conflicts, as the rename would after the drop
statement ok con1
BEGIN

statement ok con1
DROP TABLE lake.t

statement ok
ALTER TABLE lake.t RENAME TO u

statement error con1
COMMIT
----
<REGEX>:.*attempting to drop table.*another transaction has renamed it.*

query I
SELECT list(table_name ORDER BY table_name) FROM duckdb_tables() WHERE database_name = 'lake'
----
[u]

query I
SELECT x FROM lake.u
----
1

# a replace drops the table too
statement ok con1
BEGIN

statement ok con1
CREATE OR REPLACE TABLE lake.u(x INT)

statement ok
ALTER TABLE lake.u RENAME TO t

statement error con1
COMMIT
----
<REGEX>:.*attempting to drop table.*another transaction has renamed it.*

query I
SELECT list(table_name ORDER BY table_name) FROM duckdb_tables() WHERE database_name = 'lake'
----
[t]

query I
SELECT x FROM lake.t
----
1

# the same for a view
statement ok
CREATE VIEW lake.v AS SELECT 42 AS i

statement ok con1
BEGIN

statement ok con1
DROP VIEW lake.v

statement ok
ALTER VIEW lake.v RENAME TO w

statement error con1
COMMIT
----
<REGEX>:.*attempting to drop view.*another transaction has renamed it.*

query I
SELECT i FROM lake.w
----
42

# a drop of a table that another transaction only wrote to still commits
statement ok con1
BEGIN

statement ok con1
DROP TABLE lake.t

statement ok
INSERT INTO lake.t VALUES (2)

statement ok con1
COMMIT

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'lake' AND table_name = 't'
----
0
