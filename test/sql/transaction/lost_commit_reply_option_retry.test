# name: test/sql/transaction/lost_commit_reply_option_retry.test
# description: An option written last by a retried commit whose COMMIT reply was lost is applied afterwards
# group: [transaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/lost_commit_reply_option_retry', METADATA_CATALOG 'metadata', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t(i INTEGER)

statement ok con1
BEGIN

statement ok con1
CALL ducklake.set_option('require_commit_message', true)

statement ok con1
ALTER TABLE ducklake.t ADD COLUMN j INTEGER

# another connection writes the option and commits first, so the commit of con1 is retried and writes it last
statement ok con2
BEGIN

statement ok con2
CALL ducklake.set_commit_message('review', 'other')

statement ok con2
CALL ducklake.set_option('require_commit_message', false)

statement ok con2
CREATE TABLE ducklake.u(i INTEGER)

statement ok con2
COMMIT

# the catalog carries the retried COMMIT out, only its reply is lost
statement ok con1
SET ducklake_debug_lose_commit_reply = 'after'

statement error con1
COMMIT
----
whether it carried the commit out is unknown

statement ok con1
RESET ducklake_debug_lose_commit_reply

query I
SELECT value FROM metadata.ducklake_metadata WHERE key = 'require_commit_message'
----
true

query I
SELECT count(*) FROM (DESCRIBE ducklake.t)
----
2

# the cached option follows the catalog, so the next commit needs a message
statement error
CREATE TABLE ducklake.v(i INTEGER)
----
required
