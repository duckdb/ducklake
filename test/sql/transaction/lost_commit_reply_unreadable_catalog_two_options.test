# name: test/sql/transaction/lost_commit_reply_unreadable_catalog_two_options.test
# description: The options of a commit whose outcome could not be read are reloaded one by one, and read no more once reloaded
# group: [transaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/lost_commit_reply_unreadable_catalog_two_options', METADATA_CATALOG 'metadata', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t(i INTEGER)

# a second transaction is open before the commit of the first is lost
statement ok con2
BEGIN

query I con2
SELECT count(*) FROM ducklake.t
----
0

statement ok con1
BEGIN

statement ok con1
CALL ducklake.set_option('data_inlining_row_limit', 20)

statement ok con1
ALTER TABLE ducklake.t SET (data_inlining_row_limit = 40)

statement ok con1
CREATE TABLE ducklake.a(i INTEGER)

# the catalog never carries the commit out and cannot be read while its outcome is checked
statement ok
SET ducklake_debug_lose_commit_reply = 'before_unreadable'

statement error con1
COMMIT
----
whether it carried the commit out is unknown

statement ok
RESET ducklake_debug_lose_commit_reply

# the open transaction sets the table option while the changes of the lost commit wait
statement ok con2
ALTER TABLE ducklake.t SET (data_inlining_row_limit = 50)

# a new transaction restores the limit of the ATTACH and leaves the table option to the open transaction
query I
SELECT count(*) FROM ducklake.t
----
0

statement ok con2
ROLLBACK

statement ok
CALL enable_logging('DuckLakeMetadata')

# the next transaction restores the table option, the one after it reads no option
query I
SELECT count(*) FROM ducklake.t
----
0

query I
SELECT count(*) FROM ducklake.t
----
0

query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata') WHERE query LIKE '%SELECT value%ducklake_metadata%WHERE key = ''data_inlining_row_limit''%'
----
1

statement ok
CALL disable_logging()

query I
SELECT count(*) FROM metadata.ducklake_metadata WHERE key = 'data_inlining_row_limit'
----
0

# both limits are gone, so the row goes to a file
statement ok
INSERT INTO ducklake.t VALUES (1)

query I
SELECT count(*) FROM glob('{DATA_PATH}/lost_commit_reply_unreadable_catalog_two_options/main/t/*.parquet')
----
1
