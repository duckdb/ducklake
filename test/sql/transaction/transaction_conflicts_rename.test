# name: test/sql/transaction/transaction_conflicts_rename.test
# description: renaming a table or view conflicts with a concurrent alter or drop of it
# group: [transaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_conflicts_rename_files')

statement ok
SET immediate_transaction_mode=true

statement ok
CREATE TABLE ducklake.t(a INTEGER, b INTEGER);

statement ok
INSERT INTO ducklake.t VALUES (1, 10), (2, 20);

statement ok
CREATE VIEW ducklake.v AS SELECT 42;

# rename a table while another transaction drops one of its columns: conflict
statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
ALTER TABLE ducklake.t RENAME TO t2

statement ok con2
ALTER TABLE ducklake.t DROP COLUMN a

statement ok con2
COMMIT

statement error con1
COMMIT
----
attempting to rename table

# the table keeps the schema without the dropped column
statement ok
INSERT INTO ducklake.t VALUES (30);

query I
SELECT * FROM ducklake.t ORDER BY ALL
----
10
20
30

# rename a table while another transaction drops it: conflict
statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
ALTER TABLE ducklake.t RENAME TO t2

statement ok con2
DROP TABLE ducklake.t

statement ok con2
COMMIT

statement error con1
COMMIT
----
attempting to rename table

# rename a view while another transaction drops it: conflict
statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
ALTER VIEW ducklake.v RENAME TO v2

statement ok con2
DROP VIEW ducklake.v

statement ok con2
COMMIT

statement error con1
COMMIT
----
attempting to rename view
