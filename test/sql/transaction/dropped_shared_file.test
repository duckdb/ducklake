# name: test/sql/transaction/dropped_shared_file.test
# description: a transaction that deletes every row of a file of one table still reads the same file in another table
# group: [transaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/dropped_shared_file', DATA_INLINING_ROW_LIMIT 0)

statement ok
COPY (SELECT i FROM range(3) t(i)) TO '{DATA_PATH}/dropped_shared_file.parquet'

statement ok
CREATE TABLE dl.a(i BIGINT)

statement ok
CREATE TABLE dl.b(i BIGINT)

statement ok
CALL ducklake_add_data_files('dl', 'a', '{DATA_PATH}/dropped_shared_file.parquet')

statement ok
CALL ducklake_add_data_files('dl', 'b', '{DATA_PATH}/dropped_shared_file.parquet')

statement ok
BEGIN

statement ok
DELETE FROM dl.a

query I
SELECT list(i ORDER BY i) FROM dl.b
----
[0, 1, 2]

query I
SELECT count(*) FROM dl.a
----
0

statement ok
COMMIT

query II
SELECT (SELECT list(i) FROM dl.a), (SELECT list(i ORDER BY i) FROM dl.b)
----
NULL	[0, 1, 2]
