# name: test/sql/comments/drop_view_expires_tags.test
# description: Verify DROP VIEW expires ducklake_tag (view comment).
# group: [comments]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{TEST_DIR}/drop_view_expires_tags/')

statement ok
CREATE VIEW ducklake.v AS SELECT 1 AS c

statement ok
COMMENT ON VIEW ducklake.v IS 'my view comment'

# verify view tag row is active, no end row names it
query II
SELECT key, value FROM __ducklake_metadata_ducklake.ducklake_tag t WHERE NOT EXISTS (SELECT 1 FROM __ducklake_metadata_ducklake.ducklake_tag_visibility e WHERE e.object_id = t.object_id AND e.key = t.key AND e.row_branch_id = t.branch_id AND e.row_snapshot = t.begin_snapshot);
----
comment	my view comment

statement ok
DROP VIEW ducklake.v

# after DROP VIEW, the row of the tag has an end at the snapshot of the drop (DropViews ends ducklake_tag)
query I
SELECT count(*) FROM __ducklake_metadata_ducklake.ducklake_tag t WHERE NOT EXISTS (SELECT 1 FROM __ducklake_metadata_ducklake.ducklake_tag_visibility e WHERE e.object_id = t.object_id AND e.key = t.key AND e.row_branch_id = t.branch_id AND e.row_snapshot = t.begin_snapshot);
----
0

query IIII
SELECT e.branch_id, t.value, e.row_snapshot, e.snapshot_id FROM __ducklake_metadata_ducklake.ducklake_tag_visibility e JOIN __ducklake_metadata_ducklake.ducklake_tag t ON t.object_id = e.object_id AND t.key = e.key AND t.branch_id = e.row_branch_id AND t.begin_snapshot = e.row_snapshot;
----
0	my view comment	2	3
