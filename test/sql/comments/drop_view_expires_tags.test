# name: test/sql/comments/drop_view_expires_tags.test
# description: Verify DROP VIEW expires ducklake_tag (view comment).
# group: [comments]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{TEST_DIR}/drop_view_expires_tags/')

statement ok
CREATE VIEW ducklake.v AS SELECT 1 AS c

statement ok
COMMENT ON VIEW ducklake.v IS 'my view comment'

# the comment of the view is live and has one version row
query I
SELECT comment FROM duckdb_views() WHERE database_name = 'ducklake' AND view_name = 'v'
----
my view comment

query IITT
SELECT object_id, begin_snapshot, key, value FROM __ducklake_metadata_ducklake.ducklake_tag;
----
1	2	comment	my view comment

statement ok
DROP VIEW ducklake.v

# after DROP VIEW the view is gone and the tag row stays as history
query I
SELECT count(*) FROM duckdb_views() WHERE database_name = 'ducklake';
----
0

query IITT
SELECT object_id, begin_snapshot, key, value FROM __ducklake_metadata_ducklake.ducklake_tag;
----
1	2	comment	my view comment

# the drop ended the tag, so expiring the snapshots it was live in removes its row (a live row would stay)
statement ok
CALL ducklake_expire_snapshots('ducklake', versions => [1, 2])

query I
SELECT count(*) FROM __ducklake_metadata_ducklake.ducklake_tag;
----
0
