# name: test/sql/comments/comment_on_view_column_update.test
# description: Updating a view column comment expires the prior ducklake_view_column_tag row
# group: [comments]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}


statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_view_col_comment_upd/')

statement ok
CREATE VIEW ducklake.vw AS SELECT 42 AS x

statement ok
COMMENT ON COLUMN ducklake.vw.x IS 'first'

statement ok
COMMENT ON COLUMN ducklake.vw.x IS 'second'

query III
SELECT column_name, key, value FROM __ducklake_metadata_ducklake.ducklake_view_column_tag t WHERE NOT EXISTS (SELECT 1 FROM __ducklake_metadata_ducklake.ducklake_view_column_tag_visibility e WHERE e.view_id = t.view_id AND e.column_name = t.column_name AND e.key = t.key AND e.row_branch_id = t.branch_id AND e.row_snapshot = t.begin_snapshot) ORDER BY key
----
x	comment	second

# the first row ends at the snapshot that wrote the second
query IIIII
SELECT t.column_name, t.key, t.value, t.begin_snapshot, e.snapshot_id FROM __ducklake_metadata_ducklake.ducklake_view_column_tag t LEFT JOIN __ducklake_metadata_ducklake.ducklake_view_column_tag_visibility e ON e.view_id = t.view_id AND e.column_name = t.column_name AND e.key = t.key AND e.row_branch_id = t.branch_id AND e.row_snapshot = t.begin_snapshot ORDER BY t.begin_snapshot
----
x	comment	first	2	3
x	comment	second	3	NULL
