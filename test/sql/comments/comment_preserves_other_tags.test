# name: test/sql/comments/comment_preserves_other_tags.test
# description: Setting a table or column comment only expires the 'comment' tag, not other tags on the same object
# group: [comments]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{TEST_DIR}/comment_unrelated_tags/')

statement ok
CREATE TABLE ducklake.tbl (i INT);

# manually insert a tag with a different key ('owner') for the table
statement ok
INSERT INTO __ducklake_metadata_ducklake.ducklake_tag (object_id, begin_snapshot, key, value, branch_id) VALUES (1, 2, 'owner', 'alice', 0);

# now set a comment on the table
statement ok
COMMENT ON TABLE ducklake.tbl IS 'my comment';

# the 'owner' tag should still be active, no end row names it
query III
SELECT t.key, t.value, e.snapshot_id FROM __ducklake_metadata_ducklake.ducklake_tag t LEFT JOIN __ducklake_metadata_ducklake.ducklake_tag_visibility e ON e.object_id = t.object_id AND e.key = t.key AND e.row_branch_id = t.branch_id AND e.row_snapshot = t.begin_snapshot ORDER BY t.key;
----
comment	my comment	NULL
owner	alice	NULL

# update the comment
statement ok
COMMENT ON TABLE ducklake.tbl IS 'updated comment';

query III
SELECT t.key, t.value, e.snapshot_id IS NULL FROM __ducklake_metadata_ducklake.ducklake_tag t LEFT JOIN __ducklake_metadata_ducklake.ducklake_tag_visibility e ON e.object_id = t.object_id AND e.key = t.key AND e.row_branch_id = t.branch_id AND e.row_snapshot = t.begin_snapshot ORDER BY t.key, e.snapshot_id IS NULL;
----
comment	my comment	false
comment	updated comment	true
owner	alice	true

# verify the same for column-level tags
statement ok
INSERT INTO __ducklake_metadata_ducklake.ducklake_column_tag (table_id, column_id, begin_snapshot, key, value, branch_id) VALUES (1, 0, 4, 'pii', 'true', 0);

statement ok
COMMENT ON COLUMN ducklake.tbl.i IS 'col comment';

# the 'pii' column tag should still be active
query III
SELECT t.key, t.value, e.snapshot_id IS NULL FROM __ducklake_metadata_ducklake.ducklake_column_tag t LEFT JOIN __ducklake_metadata_ducklake.ducklake_column_tag_visibility e ON e.table_id = t.table_id AND e.column_id = t.column_id AND e.key = t.key AND e.row_branch_id = t.branch_id AND e.row_snapshot = t.begin_snapshot ORDER BY t.key;
----
comment	col comment	true
pii	true	true
