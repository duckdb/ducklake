# name: test/sql/comments/comment_preserves_other_tags.test
# description: Setting a table or column comment only expires the 'comment' tag, not other tags on the same object
# group: [comments]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{TEST_DIR}/comment_unrelated_tags/')

statement ok
CREATE TABLE ducklake.tbl (i INT);

statement ok
COMMENT ON TABLE ducklake.tbl IS 'my comment';

# a tag under another key, copied from the comment row so it has the row layout of the catalog
statement ok
INSERT INTO __ducklake_metadata_ducklake.ducklake_tag
SELECT * REPLACE ('owner' AS key, 'alice' AS value) FROM __ducklake_metadata_ducklake.ducklake_tag
WHERE value = 'my comment';

# both tags are live
query TT
SELECT comment, tags FROM duckdb_tables() WHERE database_name = 'ducklake' AND table_name = 'tbl';
----
my comment	{owner=alice}

# update the comment
statement ok
COMMENT ON TABLE ducklake.tbl IS 'updated comment';

# the new comment replaces the old one, the owner tag stays live
query TT
SELECT comment, tags FROM duckdb_tables() WHERE database_name = 'ducklake' AND table_name = 'tbl';
----
updated comment	{owner=alice}

# the replaced comment keeps its version row, the owner tag has its single row
query TTI
SELECT key, value, begin_snapshot FROM __ducklake_metadata_ducklake.ducklake_tag ORDER BY begin_snapshot, key;
----
comment	my comment	2
owner	alice	2
comment	updated comment	3

# verify the same for column-level tags
statement ok
COMMENT ON COLUMN ducklake.tbl.i IS 'col comment';

statement ok
INSERT INTO __ducklake_metadata_ducklake.ducklake_column_tag
SELECT * REPLACE ('pii' AS key, 'true' AS value) FROM __ducklake_metadata_ducklake.ducklake_column_tag
WHERE value = 'col comment';

statement ok
COMMENT ON COLUMN ducklake.tbl.i IS 'updated col comment';

# the pii column tag is still live
query TT
SELECT comment, tags FROM duckdb_columns() WHERE database_name = 'ducklake' AND table_name = 'tbl';
----
updated col comment	{pii=true}

query TTI
SELECT key, value, begin_snapshot FROM __ducklake_metadata_ducklake.ducklake_column_tag
ORDER BY begin_snapshot, key;
----
comment	col comment	4
pii	true	4
comment	updated col comment	5
