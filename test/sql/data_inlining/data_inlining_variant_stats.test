# name: test/sql/data_inlining/data_inlining_variant_stats.test
# description: An inlined VARIANT column has no bounds in the table stats, only its NULL values are counted
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_inlining_variant_stats', METADATA_CATALOG 'ducklake_meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE ducklake.t(i INTEGER, v VARIANT)

statement ok
INSERT INTO ducklake.t VALUES (1, 5), (2, {'k': [1, 2]}), (3, 'hello')

query I
SELECT COUNT(*) FROM ducklake_list_files('ducklake', 't')
----
0

# the bounds of a VARIANT are not the smallest and largest text rendering of its values (5 and {'k': [1, 2]}),
# the INTEGER column next to it keeps its bounds
query IIII
SELECT c.column_name, s.contains_null::BOOLEAN, s.min_value, s.max_value FROM ducklake_meta.ducklake_table_column_stats s
JOIN ducklake_meta.ducklake_column c USING (table_id, column_id)
JOIN ducklake_meta.ducklake_table t USING (table_id)
WHERE t.table_name = 't' AND c.end_snapshot IS NULL ORDER BY c.column_name
----
i	false	1	3
v	false	NULL	NULL

query II
SELECT (SELECT count(*) FROM ducklake.t WHERE v IS NULL), (SELECT count(*) FROM ducklake.t WHERE v IS NOT NULL)
----
0	3

# a NULL and a value nested a few levels deep
statement ok
INSERT INTO ducklake.t VALUES (4, NULL), (5, {'a': [{'b': [1, 2], 'c': {'d': 'x'}}]})

query II
SELECT (SELECT count(*) FROM ducklake.t WHERE v IS NULL), (SELECT count(*) FROM ducklake.t WHERE v IS NOT NULL)
----
1	4

# the table stats do not keep the null count of a nested column across commits, with or without the NULL
query IIII
SELECT c.column_name, s.contains_null::BOOLEAN, s.min_value, s.max_value FROM ducklake_meta.ducklake_table_column_stats s
JOIN ducklake_meta.ducklake_column c USING (table_id, column_id)
JOIN ducklake_meta.ducklake_table t USING (table_id)
WHERE t.table_name = 't' AND c.end_snapshot IS NULL ORDER BY c.column_name
----
i	false	1	5
v	NULL	NULL	NULL

# a delete of committed inlined rows
statement ok
DELETE FROM ducklake.t WHERE i = 4

query II
SELECT (SELECT count(*) FROM ducklake.t WHERE v IS NULL), (SELECT count(*) FROM ducklake.t WHERE v IS NOT NULL)
----
0	4

statement ok
DELETE FROM ducklake.t WHERE i = 1

statement ok
INSERT INTO ducklake.t VALUES (6, NULL)

query II
SELECT (SELECT count(*) FROM ducklake.t WHERE v IS NULL), (SELECT count(*) FROM ducklake.t WHERE v IS NOT NULL)
----
1	3

query II
SELECT min_value, max_value FROM ducklake_meta.ducklake_table_column_stats s
JOIN ducklake_meta.ducklake_column c USING (table_id, column_id)
JOIN ducklake_meta.ducklake_table t USING (table_id)
WHERE t.table_name = 't' AND c.end_snapshot IS NULL AND c.column_name = 'v'
----
NULL	NULL

query III
SELECT i, v, variant_typeof(v) FROM ducklake.t ORDER BY i
----
2	{'k': [1, 2]}	OBJECT(k)
3	hello	VARCHAR
5	{'a': [{'b': [1, 2], 'c': {'d': x}}]}	OBJECT(a)
6	NULL	VARIANT_NULL

# the NULL values of the first commit are counted
statement ok
CREATE TABLE ducklake.with_null(i INTEGER, v VARIANT)

statement ok
INSERT INTO ducklake.with_null VALUES (1, 5), (2, NULL)

query IIII
SELECT c.column_name, s.contains_null::BOOLEAN, s.min_value, s.max_value FROM ducklake_meta.ducklake_table_column_stats s
JOIN ducklake_meta.ducklake_column c USING (table_id, column_id)
JOIN ducklake_meta.ducklake_table t USING (table_id)
WHERE t.table_name = 'with_null' AND c.end_snapshot IS NULL ORDER BY c.column_name
----
i	false	1	2
v	true	NULL	NULL

# a delete of rows that the transaction inlined computes the stats of the remaining rows again
statement ok
CREATE TABLE ducklake.local_delete(i INTEGER, v VARIANT)

statement ok
BEGIN

statement ok
INSERT INTO ducklake.local_delete VALUES (1, 5), (2, {'k': [1, 2]}), (3, 'hello'), (4, NULL)

statement ok
DELETE FROM ducklake.local_delete WHERE i IN (2, 4)

query II
SELECT (SELECT count(*) FROM ducklake.local_delete WHERE v IS NULL), (SELECT count(*) FROM ducklake.local_delete WHERE v IS NOT NULL)
----
0	2

statement ok
COMMIT

query IIII
SELECT c.column_name, s.contains_null::BOOLEAN, s.min_value, s.max_value FROM ducklake_meta.ducklake_table_column_stats s
JOIN ducklake_meta.ducklake_column c USING (table_id, column_id)
JOIN ducklake_meta.ducklake_table t USING (table_id)
WHERE t.table_name = 'local_delete' AND c.end_snapshot IS NULL ORDER BY c.column_name
----
i	false	1	3
v	false	NULL	NULL

query II
SELECT i, v FROM ducklake.local_delete ORDER BY i
----
1	5
3	hello

# the null count of an inlined VARIANT still enforces NOT NULL
statement ok
CREATE TABLE ducklake.not_null(i INTEGER, v VARIANT NOT NULL)

statement error
INSERT INTO ducklake.not_null VALUES (1, 42), (2, NULL)
----
NOT NULL constraint failed

statement ok
INSERT INTO ducklake.not_null VALUES (1, 42), (2, [1, 2])

query I
SELECT COUNT(*) FROM ducklake_list_files('ducklake', 'not_null')
----
0

query II
SELECT i, v FROM ducklake.not_null ORDER BY i
----
1	42
2	[1, 2]

query IIII
SELECT c.column_name, s.contains_null::BOOLEAN, s.min_value, s.max_value FROM ducklake_meta.ducklake_table_column_stats s
JOIN ducklake_meta.ducklake_column c USING (table_id, column_id)
JOIN ducklake_meta.ducklake_table t USING (table_id)
WHERE t.table_name = 'not_null' AND c.end_snapshot IS NULL ORDER BY c.column_name
----
i	false	1	2
v	false	NULL	NULL

# the same rows written to a data file
statement ok
CREATE TABLE ducklake.file_written(i INTEGER, v VARIANT)

statement ok
CALL ducklake.set_option('data_inlining_row_limit', 0, table_name => 'file_written')

statement ok
INSERT INTO ducklake.file_written VALUES (2, {'k': [1, 2]}), (3, 'hello'), (5, {'a': [{'b': [1, 2], 'c': {'d': 'x'}}]}), (6, NULL)

query I
SELECT COUNT(*) FROM ducklake_list_files('ducklake', 'file_written')
----
1

statement ok
CALL ducklake_flush_inlined_data('ducklake', table_name => 't')

query I
SELECT COUNT(*) FROM ducklake_list_files('ducklake', 't')
----
1

# the flushed VARIANT has the table stats and the file stats of the VARIANT that was written to a file
query IIII
SELECT t.table_name, s.contains_null::BOOLEAN, s.min_value, s.max_value FROM ducklake_meta.ducklake_table_column_stats s
JOIN ducklake_meta.ducklake_column c USING (table_id, column_id)
JOIN ducklake_meta.ducklake_table t USING (table_id)
WHERE t.table_name IN ('t', 'file_written') AND c.end_snapshot IS NULL AND c.column_name = 'v' ORDER BY t.table_name
----
file_written	NULL	NULL	NULL
t	NULL	NULL	NULL

query IIIII
SELECT t.table_name, s.value_count, s.null_count, s.min_value, s.max_value FROM ducklake_meta.ducklake_file_column_stats s
JOIN ducklake_meta.ducklake_column c USING (table_id, column_id)
JOIN ducklake_meta.ducklake_table t USING (table_id)
WHERE t.table_name IN ('t', 'file_written') AND c.end_snapshot IS NULL AND c.column_name = 'v' ORDER BY t.table_name
----
file_written	NULL	NULL	NULL	NULL
t	NULL	NULL	NULL	NULL

query II
SELECT (SELECT count(*) FROM ducklake.t WHERE v IS NULL), (SELECT count(*) FROM ducklake.t WHERE v IS NOT NULL)
----
1	3

query III
SELECT i, v, variant_typeof(v) FROM ducklake.t ORDER BY i
----
2	{'k': [1, 2]}	OBJECT(k)
3	hello	VARCHAR
5	{'a': [{'b': [1, 2], 'c': {'d': x}}]}	OBJECT(a)
6	NULL	VARIANT_NULL

query III
SELECT i, v, variant_typeof(v) FROM ducklake.file_written ORDER BY i
----
2	{'k': [1, 2]}	OBJECT(k)
3	hello	VARCHAR
5	{'a': [{'b': [1, 2], 'c': {'d': x}}]}	OBJECT(a)
6	NULL	VARIANT_NULL
