# name: test/sql/data_inlining/data_inlining_flush_partition_collation.test
# description: The flush partition filter ignores the default collation
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/flush_partition_collation', DATA_INLINING_ROW_LIMIT 10)

statement ok
USE ducklake

statement ok
SET default_collation = 'nocase'

statement ok
CREATE TABLE pc (id INTEGER, v VARCHAR)

statement ok
ALTER TABLE pc SET PARTITIONED BY (v)

statement ok
INSERT INTO pc VALUES (1, 'A'), (2, 'a')

statement ok
DELETE FROM pc WHERE id = 2

statement ok
CALL ducklake_flush_inlined_data('ducklake', table_name => 'pc')

query I
SELECT id FROM pc
----
1
