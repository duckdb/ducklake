# name: test/sql/data_inlining/data_inlining_variant_deep_nesting.test
# description: Inlining a deeply nested VARIANT does not convert it to compute bounds
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_inlining_variant_deep_nesting', METADATA_CATALOG 'ducklake_meta', DATA_INLINING_ROW_LIMIT 10)

# 40000 levels, arrays and objects with a single key alternating, built from the binary encoding as in
# duckdb's test/sql/copy/parquet/variant_deep_nesting.test
statement ok
CREATE TEMP TABLE levels AS
WITH RECURSIVE levels(depth, child_length, width) AS (
    SELECT 1, 1, 1
    UNION ALL
    SELECT depth + 1, child_length + 2 + depth % 2 + 2 * width,
           CASE WHEN child_length + 2 + depth % 2 + 2 * width < 256 THEN 1
                WHEN child_length + 2 + depth % 2 + 2 * width < 65536 THEN 2 ELSE 3 END
    FROM levels WHERE depth < 40000
)
SELECT depth,
       CASE WHEN depth % 2 = 1 THEN printf('%02x0100', 2 + 4 * (width - 1))
            ELSE printf('%02x01', 3 + 4 * (width - 1)) END ||
       repeat('00', width) ||
       left(printf('%02x%02x%02x', child_length % 256, child_length // 256 % 256, child_length // 65536), 2 * width) AS header
FROM levels;

statement ok
CREATE TABLE ducklake.deep AS
SELECT variant_bytes_to_variant(unhex('1101000161' || string_agg(header, '' ORDER BY depth DESC) || '04')) AS v
FROM levels;

query I
SELECT COUNT(*) FROM ducklake_list_files('ducklake', 'deep')
----
0

query I
SELECT variant_typeof(v) FROM ducklake.deep
----
ARRAY(1)

# rows inlined next to it, and a delete, which computes the stats of the remaining rows again
statement ok
INSERT INTO ducklake.deep VALUES (NULL), (42), ({'a': 'hello'})

statement ok
DELETE FROM ducklake.deep WHERE variant_typeof(v) = 'INT32'

query II
SELECT variant_typeof(v), count(*) FROM ducklake.deep GROUP BY ALL ORDER BY ALL
----
ARRAY(1)	1
OBJECT(a)	1
VARIANT_NULL	1

# a VARIANT has no bounds, as in a data file
query II
SELECT min_value, max_value
FROM ducklake_meta.ducklake_table_column_stats
WHERE table_id = (SELECT table_id FROM ducklake_meta.ducklake_table WHERE table_name = 'deep')
----
NULL	NULL

query II
SELECT (SELECT count(*) FROM ducklake.deep WHERE v IS NULL), (SELECT count(*) FROM ducklake.deep WHERE v IS NOT NULL)
----
1	2

statement ok
CALL ducklake_flush_inlined_data('ducklake', table_name => 'deep')

query I
SELECT COUNT(*) FROM ducklake_list_files('ducklake', 'deep')
----
1

query II
SELECT variant_typeof(v), count(*) FROM ducklake.deep GROUP BY ALL ORDER BY ALL
----
ARRAY(1)	1
OBJECT(a)	1
VARIANT_NULL	1

# the null count of an inlined VARIANT still enforces NOT NULL
statement ok
CREATE TABLE ducklake.deep_not_null(i INTEGER, v VARIANT NOT NULL)

statement error
INSERT INTO ducklake.deep_not_null VALUES (1, 42), (2, NULL)
----
NOT NULL constraint failed

statement ok
INSERT INTO ducklake.deep_not_null SELECT 1, v FROM ducklake.deep WHERE v IS NOT NULL

query I
SELECT COUNT(*) FROM ducklake_list_files('ducklake', 'deep_not_null')
----
0

query II
SELECT variant_typeof(v), count(*) FROM ducklake.deep_not_null GROUP BY ALL ORDER BY ALL
----
ARRAY(1)	1
OBJECT(a)	1
