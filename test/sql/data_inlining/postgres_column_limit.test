# name: test/sql/data_inlining/postgres_column_limit.test
# description: Tables wider than an inlined data table can be on postgres are not inlined
# group: [data_inlining]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'dbname=ducklakedb' AS pg (TYPE postgres)

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS postgres_column_limit CASCADE')

statement ok
DETACH pg

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb' AS dl
(DATA_PATH '{DATA_PATH}/pg_column_limit', METADATA_SCHEMA 'postgres_column_limit', DATA_INLINING_ROW_LIMIT 10)

# 1597 columns and the three inlining columns fill the 1600 columns postgres allows
statement ok
CREATE TABLE dl.fits AS
SELECT * FROM (PIVOT (SELECT 'c' || i AS k, 1 AS v FROM range(1597) r(i)) ON k USING first(v)) LIMIT 0

statement ok
INSERT INTO dl.fits (c0) VALUES (1)

query II
SELECT (SELECT count(*) FROM dl.fits), (SELECT count(*) FROM ducklake_list_files('dl', 'fits'))
----
1	0

# one more column does not fit, so the rows go to a data file
statement ok
CREATE TABLE dl.too_wide AS
SELECT * FROM (PIVOT (SELECT 'c' || i AS k, 1 AS v FROM range(1598) r(i)) ON k USING first(v)) LIMIT 0

statement ok
INSERT INTO dl.too_wide (c0) VALUES (1)

query II
SELECT (SELECT count(*) FROM dl.too_wide), (SELECT count(*) FROM ducklake_list_files('dl', 'too_wide'))
----
1	1

# a column added past the limit keeps the rows inlined before
statement ok
ALTER TABLE dl.fits ADD COLUMN extra INTEGER

statement ok
INSERT INTO dl.fits (extra) VALUES (2)

query IIII
SELECT count(*), sum(c0), sum(extra), (SELECT count(*) FROM ducklake_list_files('dl', 'fits')) FROM dl.fits
----
2	1	2	1

statement ok
CALL ducklake_flush_inlined_data('dl')

query IIII
SELECT count(*), sum(c0), sum(extra), (SELECT count(*) FROM ducklake_list_files('dl', 'fits')) FROM dl.fits
----
2	1	2	2

# rows inlined in this transaction cannot follow the table past the limit
statement ok
CREATE TABLE dl.local AS
SELECT * FROM (PIVOT (SELECT 'c' || i AS k, 1 AS v FROM range(1597) r(i)) ON k USING first(v)) LIMIT 0

statement ok
BEGIN

statement ok
INSERT INTO dl.local (c0) VALUES (1)

statement error
ALTER TABLE dl.local ADD COLUMN extra INTEGER
----
would exceed the column limit of the metadata catalog

statement ok
ROLLBACK

query II
SELECT count(*), (SELECT count(*) FROM duckdb_columns() WHERE table_name = 'local' AND database_name = 'dl')
FROM dl.local
----
0	1597
