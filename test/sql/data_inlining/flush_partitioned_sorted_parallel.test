# name: test/sql/data_inlining/flush_partitioned_sorted_parallel.test
# description: A partitioned sorted flush must preserve inlined deletes with multiple threads
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
SET threads = 4;

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/parallel_flush_{UUID}', DATA_INLINING_ROW_LIMIT 1000000);

statement ok
CREATE TABLE lake.t(part INTEGER, i BIGINT);

statement ok
ALTER TABLE lake.t SET PARTITIONED BY (part);

statement ok
ALTER TABLE lake.t SET SORTED BY (i);

# Keep fixture loading within remote catalog RPC timeouts; flush all rows together.
loop batch 0 15

statement ok
INSERT INTO lake.t SELECT i % 4, i FROM range({batch} * 10000, ({batch} + 1) * 10000) r(i);

endloop

statement ok
DELETE FROM lake.t WHERE i % 5 = 0;

query III
SELECT count(*), sum(i), count(*) FILTER (WHERE i % 5 = 0) FROM lake.t;
----
120000	9000000000	0

statement ok
CREATE TEMP TABLE expected AS SELECT * FROM lake.t;

statement ok
CALL ducklake_flush_inlined_data('lake');

query III
SELECT count(*), sum(i), count(*) FILTER (WHERE i % 5 = 0) FROM lake.t;
----
120000	9000000000	0

# Compare the complete row multiset, including duplicates.
query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM lake.t) UNION ALL (SELECT * FROM lake.t EXCEPT ALL SELECT * FROM expected));
----
0
