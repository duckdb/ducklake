# name: test/sql/data_inlining/inlined_data_paged_reads_memory.test
# description: reads and flushes of large inlined values work below a memory limit that does not hold all of them
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/inlined_data_paged_reads_memory', DATA_INLINING_ROW_LIMIT 10)

# 24 single row inserts of 4 MiB values, 96 MiB in total
statement ok
CREATE TABLE dl.large (id INTEGER, c VARCHAR);

loop i 0 24

statement ok
INSERT INTO dl.large SELECT ${i}, repeat('A', 4194304);

endloop

# a row updated with large values keeps them as older versions, a read of its live version skips them
statement ok
CREATE TABLE dl.versions (id INTEGER, c VARCHAR);

statement ok
INSERT INTO dl.versions VALUES (1, 'first');

loop i 0 20

statement ok
UPDATE dl.versions SET c = repeat('B', 4194304);

endloop

statement ok
UPDATE dl.versions SET c = 'last';

# a small row between large ones does not let the next page hold every remaining large row
statement ok
CREATE TABLE dl.mixed (id INTEGER, c VARCHAR);

statement ok
INSERT INTO dl.mixed SELECT 0, repeat('A', 4194304);

statement ok
INSERT INTO dl.mixed VALUES (1, 'small');

loop i 2 17

statement ok
INSERT INTO dl.mixed SELECT ${i}, repeat('A', 4194304);

endloop

statement ok
SET memory_limit = '64MB'

statement ok
SET threads = 1

query I
SELECT length(c) FROM dl.large LIMIT 1
----
4194304

query III
SELECT count(*), sum(id), sum(length(c)) FROM dl.mixed
----
17	136	67108869

statement ok
DELETE FROM dl.large WHERE id = 5;

query III
SELECT count(*), sum(id), min(length(c)) FROM dl.large
----
23	271	4194304

statement ok
CALL ducklake_flush_inlined_data('dl', table_name => 'large');

query I
SELECT count(*) FROM ducklake_list_files('dl', 'large')
----
1

query III
SELECT count(*), sum(id), min(length(c)) FROM dl.large
----
23	271	4194304

query II
SELECT id, c FROM dl.versions
----
1	last
