# name: test/sql/data_inlining/postgres_inlined_visibility_rows.test
# description: the shared companion of the inlined data tables and the end writer run natively on Postgres with the key named like the other companions
# group: [data_inlining]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

require-env DUCKLAKE_CONNECTION

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS pg

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS pgvis CASCADE')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl
(DATA_PATH '{DATA_PATH}/pgvis', METADATA_SCHEMA 'pgvis', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

statement ok
DELETE FROM dl.t WHERE i = 2

statement ok
UPDATE dl.t SET i = 30 WHERE i = 3

query IIIIII
SELECT * FROM postgres_query('pg', 'SELECT table_id, row_id, row_branch_id, row_snapshot, branch_id, snapshot_id FROM pgvis.ducklake_inlined_data_visibility ORDER BY row_id, row_snapshot')
----
1	1	0	2	0	3
1	2	0	2	0	4

query IIII
SELECT * FROM postgres_query('pg', 'SELECT _ducklake_row_id, _ducklake_begin_snapshot, i, _ducklake_branch_id FROM pgvis.ducklake_inlined_data_1_1 ORDER BY _ducklake_row_id, _ducklake_begin_snapshot')
----
0	2	1	0
1	2	2	0
2	2	3	0
2	4	30	0

# the key carries the name every retried constraint violation is recognized by
query I
SELECT * FROM postgres_query('pg', 'SELECT conname FROM pg_constraint WHERE conrelid = ''pgvis.ducklake_inlined_data_visibility''::regclass')
----
ducklake_inlined_data_visibility_pkey

statement error
CALL postgres_execute('pg', 'INSERT INTO pgvis.ducklake_inlined_data_visibility VALUES (1, 1, 0, 2, 0, 9)')
----
ducklake_inlined_data_visibility_pkey

query I
SELECT i FROM dl.t ORDER BY i
----
1
30

query I
SELECT i FROM dl.t AT (VERSION => 2) ORDER BY i
----
1
2
3

query IIII
FROM dl.table_changes('t', 3, 4) ORDER BY ALL
----
3	1	delete	2
4	2	update_postimage	30
4	2	update_preimage	3

statement ok
CALL ducklake_flush_inlined_data('dl')

query I
SELECT * FROM postgres_query('pg', 'SELECT count(*) FROM pgvis.ducklake_inlined_data_visibility')
----
0

query I
SELECT i FROM dl.t ORDER BY i
----
1
30

query I
SELECT i FROM dl.t AT (VERSION => 3) ORDER BY i
----
1
3

statement ok
DETACH dl
