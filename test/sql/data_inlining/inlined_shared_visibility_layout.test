# name: test/sql/data_inlining/inlined_shared_visibility_layout.test
# description: one companion holds the ends of the inlined rows of every table, keyed by the table and the birth of the version
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

# the shared companion is created with the catalog, the table id leads its key
query I
SELECT column_name FROM (DESCRIBE SELECT * FROM meta.ducklake_inlined_data_visibility)
----
table_id
row_id
row_branch_id
row_snapshot
branch_id
snapshot_id

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
CREATE TABLE dl.u (i INTEGER)

# the first rows of both tables share their row id and their birth
statement ok
BEGIN

statement ok
INSERT INTO dl.t VALUES (1), (2)

statement ok
INSERT INTO dl.u VALUES (1), (2)

statement ok
COMMIT

statement ok
DELETE FROM dl.u WHERE i = 1

# the end of the first row of u does not stand for the first row of t
statement ok
DELETE FROM dl.t WHERE i = 1

# the ends of both tables sit side by side, told apart by the table id
query IIIIII
FROM meta.ducklake_inlined_data_visibility ORDER BY ALL
----
1	0	0	3	0	5
2	0	0	3	0	4

query I
SELECT i FROM dl.t
----
2

query I
SELECT i FROM dl.u
----
2

# the key names the version by its table and birth, one end per version per branch
statement error
INSERT INTO meta.ducklake_inlined_data_visibility VALUES (1, 0, 0, 3, 0, 9)
----

statement ok
INSERT INTO meta.ducklake_inlined_data_visibility VALUES (1, 1, 0, 3, 0, 9)

statement ok
INSERT INTO meta.ducklake_inlined_data_visibility VALUES (1, 0, 0, 3, 1, 9)

statement ok
DELETE FROM meta.ducklake_inlined_data_visibility WHERE snapshot_id = 9

# a flush of one table takes the ends of that table alone
statement ok
CALL ducklake_flush_inlined_data('dl', table_name => 't')

query IIIIII
FROM meta.ducklake_inlined_data_visibility ORDER BY ALL
----
2	0	0	3	0	4

query I
SELECT i FROM dl.t ORDER BY i
----
2

query I
SELECT i FROM dl.t AT (VERSION => 4) ORDER BY i
----
1
2

query I
SELECT i FROM dl.u ORDER BY i
----
2

query I
SELECT i FROM dl.u AT (VERSION => 3) ORDER BY i
----
1
2

statement ok
DETACH dl
