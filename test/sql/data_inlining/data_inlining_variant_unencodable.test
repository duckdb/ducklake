# name: test/sql/data_inlining/data_inlining_variant_unencodable.test
# description: VARIANT values that a data file cannot store are refused when inlined, so inlined rows can always be flushed
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/data_inlining_variant_unencodable', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE ducklake.t (i INTEGER, v VARIANT)

statement error
INSERT INTO ducklake.t VALUES (1, INTERVAL 1 DAY::VARIANT)
----
Can't convert VARIANT of type 'INTERVAL' to Parquet VARIANT

statement error
INSERT INTO ducklake.t VALUES (2, {'a': [INTERVAL 1 DAY]}::VARIANT)
----
Can't convert VARIANT of type 'INTERVAL' to Parquet VARIANT

statement ok
CREATE TABLE ducklake.nested (s STRUCT(v VARIANT), l VARIANT[], m MAP(VARCHAR, VARIANT))

statement error
INSERT INTO ducklake.nested VALUES ({'v': INTERVAL 1 DAY::VARIANT}, NULL, NULL)
----
Can't convert VARIANT of type 'INTERVAL' to Parquet VARIANT

statement error
INSERT INTO ducklake.nested VALUES (NULL, [42::VARIANT, INTERVAL 1 DAY::VARIANT], NULL)
----
Can't convert VARIANT of type 'INTERVAL' to Parquet VARIANT

statement error
INSERT INTO ducklake.nested VALUES (NULL, NULL, MAP {'k': INTERVAL 1 DAY::VARIANT})
----
Can't convert VARIANT of type 'INTERVAL' to Parquet VARIANT

statement ok
INSERT INTO ducklake.nested VALUES ({'v': 1::VARIANT}, [2::VARIANT], MAP {'k': 3::VARIANT})

statement ok
INSERT INTO ducklake.t VALUES (3, 42::VARIANT), (4, {'a': 1, 'b': 'x'}::VARIANT), (5, NULL)

query II
SELECT (SELECT count(*) FROM ducklake_list_files('ducklake', 't')), (SELECT count(*) FROM ducklake_list_files('ducklake', 'nested'))
----
0	0

statement ok
CALL ducklake_flush_inlined_data('ducklake', table_name => 't')

query I
SELECT count(*) FROM ducklake_list_files('ducklake', 't')
----
1

query II
SELECT i, v::VARCHAR FROM ducklake.t ORDER BY i
----
3	42
4	{'a': 1, 'b': x}
5	NULL

query III
SELECT s::VARCHAR, l::VARCHAR, m::VARCHAR FROM ducklake.nested
----
{'v': 1}	[2]	{k=3}
