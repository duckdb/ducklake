# name: test/sql/data_inlining/inlined_shared_expire.test
# description: the expiry removes the unreachable inlined versions of every table with their ends from the shared companion and keeps the ends a snapshot still reads
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
CREATE TABLE dl.u (i INTEGER)

# the rows of both tables share their row ids and their birth
statement ok
BEGIN

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

statement ok
INSERT INTO dl.u VALUES (1), (2), (3)

statement ok
COMMIT

statement ok
DELETE FROM dl.t WHERE i = 2

statement ok
DELETE FROM dl.u WHERE i = 3

query IIIIII
FROM meta.ducklake_inlined_data_visibility ORDER BY ALL
----
1	1	0	3	0	4
2	2	0	3	0	5

# the version of t ended at 4 is read by no snapshot left, the version of u ended at 5 is still read by 4
statement ok
CALL ducklake_expire_snapshots('dl', versions => [1, 2, 3])

query I
SELECT count(*) FROM meta.ducklake_inlined_data_1_1
----
2

# the end of t names no row of u born alike
query I
SELECT count(*) FROM meta.ducklake_inlined_data_2_2
----
3

query IIIIII
FROM meta.ducklake_inlined_data_visibility ORDER BY ALL
----
2	2	0	3	0	5

query I
SELECT i FROM dl.u ORDER BY i
----
1
2

query I
SELECT i FROM dl.u AT (VERSION => 4) ORDER BY i
----
1
2
3

query I
SELECT i FROM dl.t ORDER BY i
----
1
3

# once no snapshot reads it, the version of u goes with its end as well
statement ok
CALL ducklake_expire_snapshots('dl', older_than => now())

query I
SELECT count(*) FROM meta.ducklake_inlined_data_2_2
----
2

query I
SELECT count(*) FROM meta.ducklake_inlined_data_visibility
----
0

query I
SELECT i FROM dl.t ORDER BY i
----
1
3

query I
SELECT i FROM dl.u ORDER BY i
----
1
2

# a second payload of t after the two snapshots of the expiries, the ends of both payloads share the companion
statement ok
ALTER TABLE dl.t ADD COLUMN j INTEGER

statement ok
INSERT INTO dl.t VALUES (4, 40), (5, 50)

statement ok
DELETE FROM dl.t WHERE i = 4

statement ok
DELETE FROM dl.t WHERE i = 1

query IIIIII
FROM meta.ducklake_inlined_data_visibility ORDER BY ALL
----
1	0	0	3	0	11
1	3	0	9	0	10

# the newer payload's version ended at 10 is read by no snapshot left, the older payload's version is still read by 10
statement ok
CALL ducklake_expire_snapshots('dl', versions => [7, 8, 9])

query I
SELECT count(*) FROM meta.ducklake_inlined_data_1_1
----
2

query I
SELECT count(*) FROM meta.ducklake_inlined_data_1_3
----
1

# the sweep of the table keeps the end of a version living in its other payload
query IIIIII
FROM meta.ducklake_inlined_data_visibility ORDER BY ALL
----
1	0	0	3	0	11

query II
SELECT i, j FROM dl.t ORDER BY i
----
3	NULL
5	50

query II
SELECT i, j FROM dl.t AT (VERSION => 10) ORDER BY i
----
1	NULL
3	NULL
5	50

statement ok
DETACH dl
