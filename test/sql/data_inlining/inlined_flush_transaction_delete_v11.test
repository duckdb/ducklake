# name: test/sql/data_inlining/inlined_flush_transaction_delete_v11.test
# description: a flush in a transaction that deleted inlined rows of a 1.1 catalog leaves the deleted rows out of the file
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

statement ok
DELETE FROM dl.t WHERE i = 3

statement ok
BEGIN

statement ok
DELETE FROM dl.t WHERE i = 2

statement ok
CALL ducklake_flush_inlined_data('dl')

statement ok
COMMIT

query I
SELECT i FROM dl.t ORDER BY i
----
1

query I
SELECT i FROM dl.t AT (VERSION => 2) ORDER BY i
----
1
2
3

query I
SELECT i FROM dl.t AT (VERSION => 3) ORDER BY i
----
1
2

statement ok
DETACH dl
