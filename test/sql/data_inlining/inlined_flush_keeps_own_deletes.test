# name: test/sql/data_inlining/inlined_flush_keeps_own_deletes.test
# description: a transaction that deletes inlined rows and flushes keeps the deleted versions and ends them at its commit snapshot
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

statement ok
BEGIN

statement ok
DELETE FROM dl.t WHERE i = 2

statement ok
CALL ducklake_flush_inlined_data('dl')

statement ok
COMMIT

# the flushed versions are gone, the version deleted by the transaction stays with its end at the commit snapshot
query IIII
FROM meta.ducklake_inlined_data_1_1
----
1	2	2	0

query IIIII
FROM meta.ducklake_inlined_data_1_1_visibility
----
0	1	0	2	3

query I
SELECT record_count FROM meta.ducklake_data_file
----
2

query I
SELECT i FROM dl.t ORDER BY i
----
1
3

query I
SELECT i FROM dl.t AT (VERSION => 2) ORDER BY i
----
1
2
3

# the next flush moves the dead version into a file with a delete dated by its end
statement ok
CALL ducklake_flush_inlined_data('dl')

query I
SELECT count(*) FROM meta.ducklake_inlined_data_1_1
----
0

query I
SELECT count(*) FROM meta.ducklake_inlined_data_1_1_visibility
----
0

query I
SELECT delete_count FROM meta.ducklake_delete_file
----
1

query I
SELECT i FROM dl.t ORDER BY i
----
1
3

query I
SELECT i FROM dl.t AT (VERSION => 2) ORDER BY i
----
1
2
3

query IIII
FROM dl.table_changes('t', 3, 3)
----
3	1	delete	2

statement ok
DETACH dl
