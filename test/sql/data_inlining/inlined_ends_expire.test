# name: test/sql/data_inlining/inlined_ends_expire.test
# description: expiring snapshots reclaims the inlined versions no snapshot reads together with their ends
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DATA_INLINING_ROW_LIMIT 100)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

statement ok
DELETE FROM dl.t WHERE i = 2

# an older snapshot still reads the deleted version, whose end is in the companion
query I
SELECT COUNT(*) FROM meta.ducklake_inlined_data_1_1
----
3

query IIIIII
FROM meta.ducklake_inlined_data_visibility
----
1	1	0	2	0	3

statement ok
CALL ducklake_expire_snapshots('dl', older_than => now())

# no snapshot reads the version any more, its end went with it
query I
SELECT COUNT(*) FROM meta.ducklake_inlined_data_1_1
----
2

query I
SELECT COUNT(*) FROM meta.ducklake_inlined_data_visibility
----
0

query I
SELECT i FROM dl.t ORDER BY i
----
1
3

# the expiry wrote snapshot 4, the insert is 5 and the delete 6, the end of a version snapshot 5 still reads stays
statement ok
INSERT INTO dl.t VALUES (4)

statement ok
DELETE FROM dl.t WHERE i = 4

statement ok
CALL ducklake_expire_snapshots('dl', versions => [6])

query IIIIII
FROM meta.ducklake_inlined_data_visibility
----
1	3	0	5	0	6

query I
SELECT i FROM dl.t AT (VERSION => 5) ORDER BY i
----
1
3
4

statement ok
CALL ducklake_expire_snapshots('dl', older_than => now())

query I
SELECT COUNT(*) FROM meta.ducklake_inlined_data_visibility
----
0

query I
SELECT i FROM dl.t ORDER BY i
----
1
3

statement ok
DETACH dl
