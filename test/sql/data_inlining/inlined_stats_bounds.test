# name: test/sql/data_inlining/inlined_stats_bounds.test
# description: the bounds of inlined rows are ordered like the values of their type, BLOB bounds are hexadecimal and INTERVAL columns have none
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/inlined_stats_bounds', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 1000)

statement ok
CREATE TABLE lake.g (bl BLOB, iv INTERVAL, i INTEGER, d DECIMAL(4,2), dt DATE, st STRUCT(b BLOB));

statement ok
INSERT INTO lake.g VALUES ('a'::BLOB, INTERVAL 1 DAY, -10, -1.5, DATE '-0044-03-15', {'b': '\xFF'::BLOB}), ('\xFF'::BLOB, INTERVAL 10 HOUR, 9, 10.25, DATE 'infinity', {'b': 'a'::BLOB}), (NULL, NULL, NULL, NULL, NULL, NULL);

query III
SELECT c.column_name, s.min_value, s.max_value FROM meta.ducklake_table_column_stats s JOIN meta.ducklake_column c USING (table_id, column_id) ORDER BY c.column_id
----
bl	61	FF
iv	NULL	NULL
i	-10	9
d	-1.50	10.25
dt	0045-03-15 (BC)	infinity
b	61	FF

statement ok
CALL ducklake_flush_inlined_data('lake')

# the flushed file has the same bounds for the BLOB columns
query III
SELECT c.column_name, s.min_value, s.max_value FROM meta.ducklake_file_column_stats s JOIN meta.ducklake_column c USING (table_id, column_id) WHERE c.column_name IN ('bl', 'b') ORDER BY c.column_id
----
bl	61	FF
b	61	FF

query I
SELECT count(*) FROM lake.g WHERE bl = '\xFF'::BLOB AND iv < INTERVAL 1 DAY
----
1
