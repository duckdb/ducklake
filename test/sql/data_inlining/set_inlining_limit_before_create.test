# name: test/sql/data_inlining/set_inlining_limit_before_create.test
# description: Test that SET ducklake_default_data_inlining_row_limit = 0 before CREATE TABLE does not create empty inlined backing tables (issue #1184)
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__

statement ok
SET ducklake_default_data_inlining_row_limit = 0;

statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/set_inlining_limit_before_create', METADATA_CATALOG 'ducklake_meta')

statement ok
USE ducklake

statement ok
CREATE TABLE t1(pk INTEGER, val VARCHAR);

query I
SELECT COUNT(*) FROM ducklake_meta.ducklake_inlined_data_tables
----
0

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE database_name='ducklake_meta' AND table_name LIKE 'ducklake_inlined_data_1_%'
----
0

statement ok
SET ducklake_default_data_inlining_row_limit = 10;

statement ok
CREATE TABLE t2(pk INTEGER, val VARCHAR);

query I
SELECT COUNT(*) FROM ducklake_meta.ducklake_inlined_data_tables
----
1

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE database_name='ducklake_meta' AND table_name LIKE 'ducklake_inlined_data_2_%'
----
1
