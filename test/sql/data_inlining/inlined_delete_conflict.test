# name: test/sql/data_inlining/inlined_delete_conflict.test
# description: two transactions deleting the same inlined row conflict, the committed one leaves one end
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
SET immediate_transaction_mode=true

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
DELETE FROM dl.t WHERE i = 2

statement ok con2
DELETE FROM dl.t WHERE i = 2

statement ok con1
COMMIT

statement error con2
COMMIT
----
conflict

query IIIII
FROM meta.ducklake_inlined_data_1_1_visibility
----
0	1	0	2	3

query I
SELECT i FROM dl.t ORDER BY i
----
1
3

# the transaction that lost retries its delete against the committed state
statement ok con2
DELETE FROM dl.t WHERE i = 3

query IIIII
FROM meta.ducklake_inlined_data_1_1_visibility ORDER BY ALL
----
0	1	0	2	3
0	2	0	2	4

query I
SELECT i FROM dl.t
----
1

statement ok
DETACH dl
