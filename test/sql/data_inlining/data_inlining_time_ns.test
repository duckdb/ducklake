# name: test/sql/data_inlining/data_inlining_time_ns.test
# description: TIME_NS columns are inlined and flushed on every catalog
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/data_inlining_time_ns', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (v TIME_NS)

statement ok
INSERT INTO dl.t VALUES ('12:00:00.123456789'), ('00:00:00'), ('23:59:59.999999999'), (NULL)

query I
SELECT v FROM dl.t ORDER BY v NULLS LAST
----
00:00:00
12:00:00.123456789
23:59:59.999999999
NULL

query I
SELECT count(*) FROM dl.t WHERE v > TIME_NS '12:00:00.123456788'
----
2

statement ok
CALL ducklake_flush_inlined_data('dl')

query I
SELECT v FROM dl.t ORDER BY v NULLS LAST
----
00:00:00
12:00:00.123456789
23:59:59.999999999
NULL
