# name: test/sql/data_inlining/data_inlining_size_limit.test
# description: Rows whose data exceeds 16 KiB per row of the inlining limit are written to a data file
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/data_inlining_size_limit', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE ducklake.big AS SELECT list(i ORDER BY i) AS l FROM range(100000) t(i)

statement ok
CREATE TABLE ducklake.small AS SELECT list(i ORDER BY i) AS l FROM range(1000) t(i)

query II
SELECT (SELECT count(*) FROM ducklake_list_files('ducklake', 'big')), (SELECT count(*) FROM ducklake_list_files('ducklake', 'small'))
----
1	0

query II
SELECT len(l), l[100000] FROM ducklake.big
----
100000	99999

# Strings inside lists count, and so does every row of a list, not the buffer behind them
statement ok
CREATE TABLE ducklake.nested_string AS SELECT [repeat('x', 1000000)] AS l

statement ok
CREATE TABLE ducklake.repeated AS SELECT range(3000) AS l FROM range(10)

statement ok
CREATE TABLE memory.source AS SELECT 1 AS id, range(100000) AS l UNION ALL SELECT 2, [1, 2, 3]

statement ok
CREATE TABLE ducklake.filtered AS SELECT l FROM memory.source WHERE id = 2

query III
SELECT (SELECT count(*) FROM ducklake_list_files('ducklake', 'nested_string')),
	(SELECT count(*) FROM ducklake_list_files('ducklake', 'repeated')),
	(SELECT count(*) FROM ducklake_list_files('ducklake', 'filtered'))
----
1	1	0

# Strings in structs and in any column count
statement ok
CREATE TABLE ducklake.big_struct AS SELECT {'s': repeat('x', 200000)} AS st

statement ok
CREATE TABLE ducklake.second_column AS SELECT 1 AS i, repeat('x', 200000) AS s

query II
SELECT (SELECT count(*) FROM ducklake_list_files('ducklake', 'big_struct')),
	(SELECT count(*) FROM ducklake_list_files('ducklake', 'second_column'))
----
1	1

# The columns of a wide row do not count against the bound
statement ok
CREATE TABLE ducklake.wide AS
SELECT * FROM (PIVOT (SELECT 'c' || i AS k, [NULL]::BIGINT[] AS v FROM range(1000) r(i)) ON k USING first(v))

query II
SELECT (SELECT count(*) FROM ducklake.wide), (SELECT count(*) FROM ducklake_list_files('ducklake', 'wide'))
----
1	0

# Data of exactly 16 KiB per row of the limit is still inlined
statement ok
CREATE TABLE ducklake.at_bound AS SELECT repeat('x', 163840) AS s

statement ok
CREATE TABLE ducklake.over_bound AS SELECT repeat('x', 163841) AS s

query II
SELECT (SELECT count(*) FROM ducklake_list_files('ducklake', 'at_bound')),
	(SELECT count(*) FROM ducklake_list_files('ducklake', 'over_bound'))
----
0	1

# A higher inlining limit raises the bound as well
statement ok
CALL ducklake.set_option('data_inlining_row_limit', 1000)

statement ok
CREATE TABLE ducklake.raised AS SELECT list(i ORDER BY i) AS l FROM range(100000) t(i)

query II
SELECT (SELECT count(*) FROM ducklake_list_files('ducklake', 'raised')), (SELECT len(l) FROM ducklake.raised)
----
0	100000
