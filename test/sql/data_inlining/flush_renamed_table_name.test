# name: test/sql/data_inlining/flush_renamed_table_name.test
# description: Flushing the inlined rows of a renamed table reports and sorts by the current table
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/flush_renamed_table_name', DATA_INLINING_ROW_LIMIT 5)

statement ok
CREATE TABLE lake.t (i INTEGER)

statement ok
INSERT INTO lake.t VALUES (1), (2)

statement ok
ALTER TABLE lake.t RENAME TO t2

query III
CALL ducklake_flush_inlined_data('lake')
----
main	t2	2

# the old name is taken by a new table in the flushing transaction
statement ok
CREATE TABLE lake.v (i INTEGER)

statement ok
ALTER TABLE lake.v SET SORTED BY (i DESC)

statement ok
INSERT INTO lake.v VALUES (1), (3), (2)

statement ok
ALTER TABLE lake.v RENAME TO v2

statement ok
BEGIN

statement ok
CREATE TABLE lake.v (j INTEGER)

query III
CALL ducklake_flush_inlined_data('lake')
----
main	v2	3

statement ok
COMMIT

query I
SELECT list(i ORDER BY file_row_number) FROM lake.v2
----
[3, 2, 1]
