# name: test/sql/data_inlining/inlined_table_changes_versions.test
# description: the change feeds of inlined rows read the deletions with the snapshot of their end in the companion
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER, v VARCHAR)

statement ok
INSERT INTO dl.t VALUES (1, 'a'), (2, 'b')

statement ok
UPDATE dl.t SET v = 'b2' WHERE i = 2

statement ok
DELETE FROM dl.t WHERE i = 1

query I
SELECT snapshot_id FROM meta.ducklake_inlined_data_1_1_visibility ORDER BY ALL
----
3
4

query IIIII
FROM dl.table_changes('t', 2, 2) ORDER BY ALL
----
2	0	insert	1	a
2	1	insert	2	b

# the update ends one version and its feed reads the end through the companion
query IIIII
FROM dl.table_changes('t', 3, 3) ORDER BY ALL
----
3	1	update_postimage	2	b2
3	1	update_preimage	2	b

# a feed starting after the end of the updated version reads the later delete alone
query IIIII
FROM dl.table_changes('t', 4, 4) ORDER BY ALL
----
4	0	delete	1	a

query IIIII
FROM dl.table_changes('t', 2, 4) ORDER BY ALL
----
2	0	insert	1	a
2	1	insert	2	b
3	1	update_postimage	2	b2
3	1	update_preimage	2	b
4	0	delete	1	a

query III
SELECT snapshot_id, rowid, i FROM ducklake_table_deletions('dl', 'main', 't', 3, 4) ORDER BY ALL
----
3	1	2
4	0	1

query III
SELECT snapshot_id, rowid, i FROM ducklake_table_insertions('dl', 'main', 't', 3, 4) ORDER BY ALL
----
3	1	2

statement ok
DETACH dl
