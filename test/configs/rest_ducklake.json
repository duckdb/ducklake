{
  "description": "Run DuckLake tests with every DuckLake served by a DuckLake REST server that the test starts.",
  "on_init": "SELECT * FROM ducklake_rest_serve('ducklake:{TEST_DIR}/{BASE_TEST_NAME}__ducklake.db', port := 19878, attach_options := 'DATA_PATH ''{TEST_DIR}/{BASE_TEST_NAME}__ducklake.db.files''');",
  "autoloading": "none",
  "statically_loaded_extensions": [
    "core_functions",
    "parquet",
    "ducklake",
    "icu",
    "httpfs"
  ],
  "test_env": [
    {
      "env_name": "DUCKLAKE_CONNECTION",
      "env_value": "rest:http://localhost:19878"
    }
  ],
  "skip_tests": [
    {
      "reason": "Reads inlined timestamps of a column retyped to TIMESTAMPTZ in the time zone of the session, the REST server reads them in UTC",
      "paths": [
        "test/sql/stats/timestamptz_retype_committed_stats.test"
      ]
    },
    {
      "reason": "Tests the migration of metadata that the test writes to the metadata catalog directly",
      "paths": [
        "test/sql/migration/stale_version_after_migration.test",
        "test/sql/migration/v01_partitioned.test"
      ]
