{
  "description": "Run on DuckLake database as storage with ducklake_default_version set to 1.0.",
  "on_init": "SET ducklake_default_version = '1.0';",
  "statically_loaded_extensions": [
    "core_functions",
    "parquet",
    "ducklake",
    "icu"
  ],
  "skip_tests": [
    {
      "reason": "Parquet is statically loaded in this config, test requires missing parquet",
      "paths": [
        "test/sql/general/missing_parquet.test"
      ]
    },
    {
      "reason": "This test exercises the ducklake_version feature directly and assumes no global default is set",
      "paths": [
        "test/sql/add_files/add_files_stats_exactness.test",
        "test/sql/attach/attach_ducklake_version.test",
        "test/sql/migration/v11_dev1_to_v11.test",
        "test/sql/migration/v20_dev2_new_catalog.test",
        "test/sql/metadata/row_group_count.test",
        "test/sql/metadata/sqlite_large_commit.test",
        "test/sql/migration/v10_row_group_count.test",
        "test/sql/migration/v11_stats_exactness.test",
        "test/sql/partitioning/epoch_version_gate.test",
        "test/sql/stats/stats_exactness_inlined.test",
        "test/sql/types/null_type_version_gate.test",
        "test/sql/macros/null_default_version_gate.test"
      ]
    },
    {
      "reason": "Snapshot tags need DuckLake 2.0 and are not available when ducklake_default_version is pinned to 1.0",
      "paths": [
        "test/sql/tags/tags_basic.test",
        "test/sql/tags/tags_conflict.test",
        "test/sql/tags/tags_expire.test",
        "test/sql/tags/tags_expire_conflict.test",
        "test/sql/tags/tags_expire_dropped.test",
        "test/sql/tags/tags_expire_files.test",
        "test/sql/tags/tags_expire_open_conflict.test",
        "test/sql/tags/tags_parallel.test",
        "test/sql/tags/tags_time_travel.test",
        "test/sql/tags/tags_transaction.test"
      ]
    },
    {
      "reason": "File origins need DuckLake 2.0 and are not written when ducklake_default_version is pinned to 1.0",
      "paths": [
        "test/sql/origins/rewrite_origins.test",
        "test/sql/origins/registered_file_origins.test"
      ]
    },
    {
      "reason": "File retirement needs DuckLake 2.0 and is not active when ducklake_default_version is pinned to 1.0",
      "paths": [
        "test/sql/retirement/cleanup_keeps_referenced_file.test",
        "test/sql/retirement/cleanup_retires_before_unlink.test",
        "test/sql/retirement/insert_open_across_orphan_cleanup.test",
        "test/sql/retirement/registration_after_retirement.test",
        "test/sql/retirement/retired_path_alias.test",
        "test/sql/retirement/retired_remote_path_alias.test",
        "test/sql/retirement/sqlite_wal_retirement.test",
        "test/sql/retirement/rollback_keeps_registered_file.test",
        "test/sql/retirement/cleanup_unlinks_retired_files.test",
        "test/sql/retirement/rollback_retires_before_unlink.test",
        "test/sql/retirement/drop_keeps_registered_output.test",
        "test/sql/retirement/rollback_keeps_registered_remote_alias.test",
        "test/sql/retirement/discarded_files_retirement.test",
        "test/sql/retirement/discarded_alias_published.test",
        "test/sql/retirement/discarded_remote_alias_published.test",
        "test/sql/retirement/redated_delete_retirement.test",
        "test/sql/retirement/retired_path_placeholder_name.test"
      ]
    },
    {
      "reason": "Table clones need DuckLake 2.0 and are not available when ducklake_default_version is pinned to 1.0",
      "paths": [
        "test/sql/clone/clone_at_version.test",
        "test/sql/clone/clone_basic.test",
        "test/sql/clone/clone_column_ids.test",
        "test/sql/clone/clone_compaction_schema.test",
        "test/sql/clone/clone_concurrent.test",
        "test/sql/clone/clone_encrypted.test",
        "test/sql/clone/clone_flush_in_transaction.test",
        "test/sql/clone/clone_inlined.test",
        "test/sql/clone/clone_maintenance.test",
        "test/sql/clone/clone_refusals.test",
        "test/sql/clone/clone_specs.test",
        "test/sql/clone/clone_stats.test",
        "test/sql/clone/clone_transactions.test"
      ]
    },
    {
      "reason": "The registration rules need DuckLake 2.0 and are not applied when ducklake_default_version is pinned to 1.0",
      "paths": [
        "test/sql/add_files/add_files_registration_rules.test",
        "test/sql/add_files/add_files_flushed_file.test",
        "test/sql/add_files/add_files_registration_one_transaction.test",
        "test/sql/add_files/add_files_remote_query_keys.test"
      ]
    },
    {
      "reason": "Inlining VARIANT values into a SQLite or Postgres catalog needs 1.1 and is disabled when ducklake_default_version is pinned to 1.0",
      "paths": [
        "test/sql/data_inlining/data_inlining_variant_sql_rollback.test"
      ]
    },
    {
      "reason": "The NULL column type was added in 1.1 and is not available when ducklake_default_version is pinned to 1.0",
      "paths": [
        "test/sql/types/null_type.test",
        "test/sql/alter/promote_null_type.test",
        "test/sql/partitioning/partition_null_type.test",
        "test/sql/data_inlining/data_inlining_null_type.test",
        "test/sql/add_files/add_files_null_type.test",
        "test/sql/macros/test_null_default.test",
        "test/sql/macros/typed_null_default.test",
        "test/sql/geo/null_to_geometry_promotion_stats.test"
      ]
    },
    {
      "reason": "Nested macro parameter types and defaults were added in 1.1 and are not available when ducklake_default_version is pinned to 1.0",
      "paths": [
        "test/sql/issues/issue_1116_nested_macro_parameters.test"
      ]
    },
    {
      "reason": "View column comments (ducklake_view_column_tag) were added in 1.1 and are not available when ducklake_default_version is pinned to 1.0",
      "paths": [
        "test/sql/comments/comment_on_view_column.test",
        "test/sql/comments/comment_on_view_column_conflict.test",
        "test/sql/comments/comment_on_view_column_invalid.test",
        "test/sql/comments/comment_on_view_column_update.test",
        "test/sql/comments/copy_database_view_column_comments.test",
        "test/sql/comments/drop_view_expires_view_column_tags.test"
      ]
    },
    {
      "reason": "The _ducklake_ reserved prefix and the inlined column rename migration were added in 1.1 and are not exercised when ducklake_default_version is pinned to 1.0",
      "paths": [
        "test/sql/data_inlining/inlining_reserved_column_names.test",
        "test/sql/alter/issue_944.test",
        "test/sql/migration/inlined_column_rename.test",
        "test/sql/migration/inlined_column_rename_conflict.test",
        "test/sql/migration/inlined_column_rename_partial.test",
        "test/sql/migration/inlined_column_rename_dev_conflict.test",
        "test/sql/migration/inlined_column_rename_missing_table.test",
        "test/sql/migration/inlined_column_rename_remigrate.test",
        "test/sql/migration/inlined_column_rename_hint.test",
        "test/sql/migration/inlined_column_rename_reverse_hint.test",
        "test/sql/migration/inlined_column_rename_stats_hint.test",
        "test/sql/migration/inlined_column_rename_dev_missing_table.test",
        "test/sql/migration/dev1_migration.test",
        "test/sql/migration/stale_version_after_migration.test",
        "test/sql/settings/create_table_inlining_options.test"
      ]
    },
    {
      "reason": "Merging files across schema versions requires 1.1 and is disabled when ducklake_default_version is pinned to 1.0",
      "paths": [
        "test/sql/compaction/compaction_alter_table.test",
        "test/sql/compaction/compaction_schema_version_per_table.test",
        "test/sql/compaction/merge_adjacent_cross_schema.test"
      ]
    },
    {
      "reason": "Epoch partition transforms were added in 1.1 and are not available when ducklake_default_version is pinned to 1.0",
      "paths": [
        "test/sql/add_files/add_file_epoch_partitioned.test",
        "test/sql/data_inlining/data_inlining_epoch_partitions.test",
        "test/sql/partitioning/epoch_timestamptz.test",
        "test/sql/partitioning/epoch_transform_column_types.test",
        "test/sql/partitioning/epoch_transforms.test",
        "test/sql/partitioning/update_partition_epoch.test"
      ]
    },
    {
      "reason": "Deletion vectors of several snapshots in one puffin file were added in 1.1, a catalog pinned to 1.0 writes such deletes to parquet delete files",
      "paths": [
        "test/sql/delete/delete_mixed_formats.test",
        "test/sql/delete/deletion_vector.test",
        "test/sql/delete/deletion_vector_inlined_flush.test",
        "test/sql/delete/deletion_vector_multi_snapshot.test",
        "test/sql/delete/deletion_vector_replaced_twice.test",
        "test/sql/rewrite_data_files/rewrite_deletion_vectors.test"
      ]
    }
  ]
}
